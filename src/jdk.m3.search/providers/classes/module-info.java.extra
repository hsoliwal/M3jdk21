// SLF4J API 2.0.12 (legal/slf4j.md), relocated into the concealed package jdk.internal.search.slf4j
// for OpenNLP: not exported; its provider lookup needs the uses directive.
uses jdk.internal.search.slf4j.spi.SLF4JServiceProvider;

// java.util.logging is the default logger: the slf4j-jdk14 2.0.12 provider, relocated the same way.
provides jdk.internal.search.slf4j.spi.SLF4JServiceProvider
    with jdk.internal.search.slf4j.jul.JULServiceProvider;
