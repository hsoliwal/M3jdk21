// The provider superset of jdk.m3.collections: the packages of the libraries carried in providers/classes.
// The JDK build merges these exports into the module descriptor (make/common/modules/GensrcModuleInfo.gmk);
// share/classes/module-info.java alone stays a complete descriptor of the module's own packages.

// Guava 33.4.8 (legal/guava.md): the packages Guava's own descriptor exports
exports jdk.m3.collections.guava.annotations;
exports jdk.m3.collections.guava.base;
exports jdk.m3.collections.guava.cache;
exports jdk.m3.collections.guava.collect;
exports jdk.m3.collections.guava.escape;
exports jdk.m3.collections.guava.eventbus;
exports jdk.m3.collections.guava.graph;
exports jdk.m3.collections.guava.hash;
exports jdk.m3.collections.guava.html;
exports jdk.m3.collections.guava.io;
exports jdk.m3.collections.guava.math;
exports jdk.m3.collections.guava.net;
exports jdk.m3.collections.guava.primitives;
exports jdk.m3.collections.guava.reflect;
exports jdk.m3.collections.guava.util.concurrent;
exports jdk.m3.collections.guava.util.concurrent.internal;
exports jdk.m3.collections.guava.xml;

// Apache Commons Collections, the fork's state after release 4.5.0 (legal/commons-collections.md).
// The root package jdk.m3.collections.apache is exported by share/classes/module-info.java already:
// the module owns three classes in it.
exports jdk.m3.collections.apache.bag;
exports jdk.m3.collections.apache.bidimap;
exports jdk.m3.collections.apache.bloomfilter;
exports jdk.m3.collections.apache.collection;
exports jdk.m3.collections.apache.comparators;
exports jdk.m3.collections.apache.functors;
exports jdk.m3.collections.apache.iterators;
exports jdk.m3.collections.apache.keyvalue;
exports jdk.m3.collections.apache.list;
exports jdk.m3.collections.apache.map;
exports jdk.m3.collections.apache.multimap;
exports jdk.m3.collections.apache.multiset;
exports jdk.m3.collections.apache.properties;
exports jdk.m3.collections.apache.queue;
exports jdk.m3.collections.apache.sequence;
exports jdk.m3.collections.apache.set;
exports jdk.m3.collections.apache.splitmap;
exports jdk.m3.collections.apache.trie;
exports jdk.m3.collections.apache.trie.analyzer;
