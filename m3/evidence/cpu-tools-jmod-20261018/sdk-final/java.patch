+                        HexFormat.of().formatHex(VarInts.encode(Long.parseLong(value.content()))))));
+        bind(result, "codec.varint.decode", "One hexadecimal canonical LEB128 in [0,Long.MAX_VALUE] per line -> decimal", limits, monitor,
