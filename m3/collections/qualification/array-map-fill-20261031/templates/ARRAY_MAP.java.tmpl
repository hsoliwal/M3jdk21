    /** The provider's empty iterator: every access reports that the iterator contains no elements. */
    private static final class EmptyIterator<K, V> implements ${ITERATOR_TYPE}<K, V> {
        @Override
        public boolean hasNext() {
            return false;
        }

        @Override
        public K next() {
            throw new NoSuchElementException(EMPTY_ITERATOR);
        }

        @Override
        public K getKey() {
            throw new IllegalStateException(EMPTY_ITERATOR);
        }

        @Override
        public V getValue() {
            throw new IllegalStateException(EMPTY_ITERATOR);
        }

        @Override
        public V setValue(V value) {
            throw new IllegalStateException(EMPTY_ITERATOR);
        }

        @Override
        public void remove() {
            throw new IllegalStateException(EMPTY_ITERATOR);
        }
//#if ORDERED

        @Override
        public boolean hasPrevious() {
            return false;
        }

        @Override
        public K previous() {
            throw new NoSuchElementException(EMPTY_ITERATOR);
        }
//#end
    }

    /**
     * One cursor over the slots for every iterator of this map: NEXT is the next slot (-1 at the end),
     * LAST the slot returned by the last next()/previous() (-1 after remove()). After a remove() the cursor goes on
     * with the slot after the removed one (the provider's linked iterator has a known defect there; DIVERGENCE.tsv).
     */
    private final class SlotIterator implements ${ITERATOR_TYPE}<K, V> {
        static final int KEYS = 0;
        static final int VALUES = 1;
        static final int ENTRIES = 2;
        private final int kind;
        private int next;
        private int last = -1;
        private int expectedModCount = modCount;

        SlotIterator(int kind) {
            this.kind = kind;
            this.next = first();
        }

        @Override
        public boolean hasNext() {
            return next >= 0;
        }

        int nextSlot() {
            if (modCount != expectedModCount) {
                throw new ConcurrentModificationException();
            }
            int slot = next;
            if (slot < 0) {
                throw new NoSuchElementException(NO_NEXT_ENTRY);
            }
            last = slot;
            next = following(slot);
            return slot;
        }

        @Override
        public K next() {
            return keyAt(nextSlot());
        }

        Object nextOfKind() {
            int slot = nextSlot();
            return kind == KEYS ? keys[slot] : kind == VALUES ? values[slot] : new SlotEntry(slot);
        }
//#if ORDERED

        @Override
        public boolean hasPrevious() {
            return (next >= 0 ? preceding(next) : last()) >= 0;
        }

        @Override
        public K previous() {
            if (modCount != expectedModCount) {
                throw new ConcurrentModificationException();
            }
            int slot = next >= 0 ? preceding(next) : last();
            if (slot < 0) {
                throw new NoSuchElementException(NO_PREVIOUS_ENTRY);
            }
            next = slot;
            last = slot;
            return keyAt(slot);
        }

        public void reset() {
            last = -1;
            next = first();
        }
//#end

        @Override
        public K getKey() {
            if (last < 0) {
                throw new IllegalStateException(GETKEY_INVALID);
            }
            return keyAt(last);
        }

        @Override
        public V getValue() {
            if (last < 0) {
                throw new IllegalStateException(GETVALUE_INVALID);
            }
            return valueAt(last);
        }

        @Override
        public V setValue(V value) {
            if (last < 0) {
                throw new IllegalStateException(SETVALUE_INVALID);
            }
            V old = valueAt(last);
            values[last] = value;
            return old;
        }

        @Override
        public void remove() {
            if (last < 0) {
                throw new IllegalStateException(REMOVE_INVALID);
            }
            if (modCount != expectedModCount) {
                throw new ConcurrentModificationException();
            }
            if (next == last) {
                next = following(last);
            }
            erase(last);
            last = -1;
            expectedModCount = modCount;
        }

        @Override
        public String toString() {
            return last >= 0 ? "Iterator[" + keys[last] + "=" + values[last] + "]" : "Iterator[]";
        }
    }

    /** A transient Entry flyweight over one slot (never stored). */
    private final class SlotEntry implements Map.Entry<K, V> {
        private final int slot;

        SlotEntry(int slot) {
            this.slot = slot;
        }

        @Override
        public K getKey() {
            return keyAt(slot);
        }

        @Override
        public V getValue() {
            return valueAt(slot);
        }

        @Override
        public V setValue(V value) {
            V old = valueAt(slot);
            values[slot] = value;
            return old;
        }

        @Override
        public boolean equals(Object obj) {
            if (obj == this) {
                return true;
            }
            if (!(obj instanceof Map.Entry)) {
                return false;
            }
            Map.Entry<?, ?> other = (Map.Entry<?, ?>) obj;
            return Objects.equals(getKey(), other.getKey()) && Objects.equals(getValue(), other.getValue());
        }

        @Override
        public int hashCode() {
            return Objects.hashCode(getKey()) ^ Objects.hashCode(getValue());
        }

        @Override
        public String toString() {
            return getKey() + "=" + getValue();
        }
    }

    private final class ViewIterator<T> implements Iterator<T> {
        private final SlotIterator cursor;

        ViewIterator(int kind) {
            cursor = new SlotIterator(kind);
        }

        @Override
        public boolean hasNext() {
            return cursor.hasNext();
        }

        @Override
        @SuppressWarnings("unchecked")
        public T next() {
            return (T) cursor.nextOfKind();
        }

        @Override
        public void remove() {
            cursor.remove();
        }

        @Override
        public String toString() {
            return cursor.toString();
        }
    }

    private final class EntrySet extends AbstractSet<Map.Entry<K, V>> {
        @Override
        public int size() {
            return size;
        }

        @Override
        public void clear() {
            ${CLASS}.this.clear();
        }

        @Override
        public boolean contains(Object obj) {
            if (!(obj instanceof Map.Entry)) {
                return false;
            }
            Map.Entry<?, ?> entry = (Map.Entry<?, ?>) obj;
            int slot = find(entry.getKey());
            return slot >= 0 && new SlotEntry(slot).equals(entry);
        }

        @Override
        public boolean remove(Object obj) {
            if (!(obj instanceof Map.Entry) || !contains(obj)) {
                return false;
            }
            ${CLASS}.this.remove(((Map.Entry<?, ?>) obj).getKey());
            return true;
        }

        @Override
        public Iterator<Map.Entry<K, V>> iterator() {
            return new ViewIterator<>(SlotIterator.ENTRIES);
        }
    }

    private final class KeySet extends AbstractSet<K> {
