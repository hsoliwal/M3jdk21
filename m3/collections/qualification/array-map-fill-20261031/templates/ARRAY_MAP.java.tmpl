    public V getValue(int index) {
        checkIndex(index);
        return valueAt(select(index));
    }

    public int indexOf(Object key) {
        int slot = find(key);
        return slot < 0 ? -1 : rank(slot);
    }

    public V remove(int index) {
        checkIndex(index);
        return erase(select(index));
    }

    public List<K> asList() {
        return new KeyList();
    }
//#end

    // ---------------------------------------------------------------- Object

    @Override
    @SuppressWarnings("unchecked")
    public ${CLASS}<K, V> clone() {
        try {
            ${CLASS}<K, V> copy = (${CLASS}<K, V>) super.clone();
            copy.keys = keys.clone();
            copy.values = values.clone();
            copy.hashes = hashes.clone();
            copy.index = index.clone();
            copy.liveMask = liveMask.clone();
//#if LINKS
            copy.before = before.clone();
            copy.after = after.clone();
//#end
            copy.modCount = 0;
            copy.entrySetView = null;
            copy.keySetView = null;
            copy.valuesView = null;
            return copy;
        } catch (CloneNotSupportedException ex) {
            throw new UnsupportedOperationException(ex);
        }
    }

    @Override
    public boolean equals(Object obj) {
        if (obj == this) {
            return true;
        }
        if (!(obj instanceof Map)) {
            return false;
        }
        Map<?, ?> map = (Map<?, ?>) obj;
        if (map.size() != size()) {
            return false;
        }
        try {
            for (int slot = first(); slot >= 0; slot = following(slot)) {
                Object key = keys[slot];
                Object value = values[slot];
                if (value == null) {
                    if (map.get(key) != null || !map.containsKey(key)) {
                        return false;
                    }
                } else if (!value.equals(map.get(key))) {
                    return false;
                }
            }
        } catch (ClassCastException | NullPointerException ignored) {
            return false;
        }
        return true;
    }

    @Override
    public int hashCode() {
        int total = 0;
        for (int slot = first(); slot >= 0; slot = following(slot)) {
            total += Objects.hashCode(keys[slot]) ^ Objects.hashCode(values[slot]);
        }
        return total;
    }

    @Override
    public String toString() {
        if (size == 0) {
            return "{}";
        }
        StringBuilder buf = new StringBuilder(32 * size).append('{');
        for (int slot = first(); slot >= 0; ) {
            Object key = keys[slot];
            Object value = values[slot];
            buf.append(key == this ? "(this Map)" : key).append('=').append(value == this ? "(this Map)" : value);
            slot = following(slot);
            if (slot >= 0) {
                buf.append(',').append(' ');
            }
        }
        return buf.append('}').toString();
    }

    @java.io.Serial
    private void writeObject(ObjectOutputStream out) throws IOException {
        out.defaultWriteObject();
        out.writeInt(keys.length);
        out.writeInt(size);
        for (int slot = first(); slot >= 0; slot = following(slot)) {
            out.writeObject(keys[slot]);
            out.writeObject(values[slot]);
        }
    }

    @java.io.Serial
    @SuppressWarnings("unchecked")
    private void readObject(ObjectInputStream in) throws IOException, ClassNotFoundException {
        in.defaultReadObject();
        allocate(Math.max(MIN_SLOTS, in.readInt()));
        for (int i = 0, n = in.readInt(); i < n; i++) {
            K key = (K) in.readObject();
            add(key, (V) in.readObject(), hash(key));
        }
        modCount = 0;
    }

