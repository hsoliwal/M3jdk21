<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3.qualification</groupId>
  <artifactId>filtered-navigation-runtime-20261018</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>M3JDK filtered navigation focused runtime proof</name>
  <description>Real current core and declared test closure; the owning module gate remains independent.</description>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <m3.target>${project.basedir}/../../../../..</m3.target>
    <m3.runtime.output>${project.basedir}/target/runtime</m3.runtime.output>
    <m3.native.path>${project.build.directory}/empty-lib</m3.native.path>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <directory>${m3.runtime.output}</directory>
    <sourceDirectory>${m3.target}/m3/collections/src/main/java</sourceDirectory>
    <testSourceDirectory>${m3.target}/m3/collections/src/test/java</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <proc>none</proc>
          <compilerArgs>
            <arg>-Xlint:all,-module</arg>
            <arg>-Werror</arg>
          </compilerArgs>
          <testIncludes>
            <testInclude>com/m3/collections/FilteredBatchContracts.java</testInclude>
            <testInclude>com/m3/collections/M3BoundedFilteredNavigationContract.java</testInclude>
            <testInclude>com/m3/collections/M3BoundedFilteredNavigationTest.java</testInclude>
            <testInclude>com/m3/collections/M3BudgetedMaskWindowContract.java</testInclude>
            <testInclude>com/m3/collections/M3CollectionSdkSortedFactorySelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredDequeContract.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredDequesTest.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredListsContract.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredListsDeepCompositionProof.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredListsDeepCompositionTest.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredListsEdges.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredListsMaskBridgeProof.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredListsReadonlyDepthProof.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredListsReadonlyDepthTest.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredListsSortedInteropTest.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredListsTest.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredListsWorkProof.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredNavigableFacadeSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredNavigableSetRangeContract.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredNavigableSetRangeTest.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredNavigableSetTest.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredNavigationReconciliationContract.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredNavigationReconciliationTest.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredTerminalProof.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredViewsContract.java</testInclude>
            <testInclude>com/m3/collections/M3FilteredViewsTest.java</testInclude>
            <testInclude>com/m3/collections/M3IndexMaskCompactorSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3IndexMaskCompactorTest.java</testInclude>
            <testInclude>com/m3/collections/M3IndexMaskWindowRecoverySelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3IndexMaskWindowRecoveryTest.java</testInclude>
            <testInclude>com/m3/collections/M3IndexMaskWindowSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3IndexMaskWindowTest.java</testInclude>
            <testInclude>com/m3/collections/M3IndexPathMaskWindowSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3IndexPathMasksAliasContract.java</testInclude>
            <testInclude>com/m3/collections/M3IndexPathMasksSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3IndexPathMasksTest.java</testInclude>
            <testInclude>com/m3/collections/M3IndexPathRankNativeSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3IndexPathRankSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3IndexPathRankTest.java</testInclude>
            <testInclude>com/m3/collections/M3LazyTreeMapSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3LazyTreeMapTest.java</testInclude>
            <testInclude>com/m3/collections/M3LazyValueStateSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3LongBitmapFilteredSnapshotSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3LongFilteredViewContractTest.java</testInclude>
            <testInclude>com/m3/collections/M3LongIndexPathMasksSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3LongSortedAlgebraSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3LongSortedAlgebraTest.java</testInclude>
            <testInclude>com/m3/collections/M3LongSortedLateBindingSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3LongSortedSnapshotSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3LongTreeSetTest.java</testInclude>
            <testInclude>com/m3/collections/M3MaskDenseSelectionProof.java</testInclude>
            <testInclude>com/m3/collections/M3MaskNativeParityProof.java</testInclude>
            <testInclude>com/m3/collections/M3MaskWindowSparseContract.java</testInclude>
            <testInclude>com/m3/collections/M3MutableFilteredViewsContract.java</testInclude>
            <testInclude>com/m3/collections/M3MutableFilteredViewsTest.java</testInclude>
            <testInclude>com/m3/collections/M3NativeIndexRangeSelfTest.java</testInclude>
            <testInclude>com/m3/collections/M3NativeIndexRangeTest.java</testInclude>
            <testInclude>com/m3/collections/M3PrimitiveFilteredSequencesRuntimeContract.java</testInclude>
            <testInclude>com/m3/collections/M3PrimitiveFilteredSequencesTest.java</testInclude>
            <testInclude>com/m3/collections/M3ZeroMaskArrayFastPathProof.java</testInclude>
            <testInclude>com/m3/collections/M3ZeroMaskArrayFastPathTest.java</testInclude>
          </testIncludes>
        </configuration>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <useModulePath>false</useModulePath>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <failIfNoTests>true</failIfNoTests>
          <argLine>-Xcheck:jni -Djava.library.path=${m3.native.path}</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>m3-recipe-boot</id>
      <activation>
        <file>
          <exists>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</exists>
        </file>
      </activation>
      <properties>
        <m3.recipe.boot.skip>false</m3.recipe.boot.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <inherited>true</inherited>
            <dependencies>
              <dependency>
                <groupId>com.synexia.m3</groupId>
                <artifactId>m3-pr-stack-preservation</artifactId>
                <version>1.0.0-m3boot20261021</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-recipe-boot</id>
                <phase>validate</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <skip>${m3.recipe.boot.skip}</skip>
                  <mainClass>com.synexia.m3.prstack.M3RecipeBoot</mainClass>
                  <includeProjectDependencies>false</includeProjectDependencies>
                  <includePluginDependencies>true</includePluginDependencies>
                  <arguments>
                    <argument>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</argument>
                    <argument>${project.basedir}</argument>
                    <argument>${session.projects[0].basedir.absolutePath}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
