<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <groupId>com.synexia.verification</groupId><artifactId>m3-cpu-mask-runs-recipe</artifactId><version>1</version>
 <properties><maven.compiler.release>21</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><repo.root>${project.basedir}/../../../..</repo.root></properties>
 <dependencies>
  <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java</artifactId><version>8.17.1</version></dependency>
  <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java-21</artifactId><version>8.17.1-m3-source-1</version></dependency>
 </dependencies>
 <build>
  <sourceDirectory>${repo.root}/m3/tooling/migration-recipes/src/main/java</sourceDirectory>
  <resources><resource>
   <directory>${repo.root}/m3/tooling/migration-recipes/src/main/resources</directory>
   <includes>
    <include>com/synexia/rewrite/hash-pinned-java/m3-cpu-mask-runs-20261017/**</include>
    <include>META-INF/rewrite/m3-cpu-mask-runs-20261017.yml</include>
   </includes>
  </resource></resources>
  <plugins>
   <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version><configuration>
    <includes><include>com/synexia/rewrite/M3HashPinnedJavaSnapshotRecipe.java</include></includes>
    <compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs>
   </configuration></plugin>
   <plugin><groupId>org.openrewrite.maven</groupId><artifactId>rewrite-maven-plugin</artifactId><version>5.23.1</version><configuration>
    <activeRecipes><recipe>com.synexia.m3.CpuMaskRuns20261017</recipe></activeRecipes>
    <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
    <failOnDryRunResults>false</failOnDryRunResults>
   </configuration></plugin>
  </plugins>
 </build>
</project>
