<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId>
  <artifactId>m3-collections</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>M3 collection lanes</name>
  <description>Independently built indexed collection storage, CAS lanes and primitive streams.</description>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Hitesh Soliwal</name>
      <email>hsoliwal@gmail.com</email>
    </developer>
  </developers>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency><groupId>com.m3</groupId><artifactId>m3-arrays</artifactId><version>0.1.0-SNAPSHOT</version></dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>provenance.json</include>
          <include>m3-donation.json</include>
          <include>name-mapping.json</include>
          <include>M3-DONATION-NOTICE.txt</include>
          <include>NETBEANS-NOTICE.txt</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <!-- MOVE_TO_JDK_MODULE v3 (keep-pom mode, m3/tooling/jdk-naming/move_module_area.py): the sources live in the
           JDK module src/jdk.m3.collections and the tests in test/jdk; this pom keeps its own configuration and adds them. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>jdk-module-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../../src/jdk.m3.collections/share/classes/jdk/internal/m3/collections</source>
                <source>${project.basedir}/../../src/jdk.m3.collections/share/classes/jdk/m3/collections</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>jdk-module-test-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../../test/jdk/jdk/internal/m3/collections</source>
                <source>${project.basedir}/../../test/jdk/jdk/m3/collections</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>jdk-module-resources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-resource</goal>
            </goals>
            <configuration>
              <resources>
                <resource>
                  <directory>${project.basedir}/../../src/jdk.m3.collections/share/classes</directory>
                  <includes>
                    <include>jdk/m3/collections/M3_SDK_FAMILY_CATALOG.tsv</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.basedir}/../../src/jdk.m3.collections/share/legal</directory>
                  <targetPath>META-INF</targetPath>
                  <includes>
                    <include>m3collections.md</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>jdk-module-test-resources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-test-resource</goal>
            </goals>
            <configuration>
              <resources>
                <resource>
                  <directory>${project.basedir}/../../test/jdk/jdk/m3/collections/resources</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <useModulePath>false</useModulePath>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-module</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <!-- JNI test gating (m3/search/pom.xml surefire pattern): the m3_arrays JNI-dependent classes are excluded from
               the default build and re-included by -Pm3-collections-native; see qualification/jni-test-gating-20261106. -->
          <excludes>
            <exclude>**/BagRankIndexTest.java</exclude>
            <exclude>**/ConcurrentContractTest.java</exclude>
            <exclude>**/CountedBagTest.java</exclude>
            <exclude>**/EntryFacadeCacheTest.java</exclude>
            <exclude>**/FactoryContractTest.java</exclude>
            <exclude>**/FootprintContractTest.java</exclude>
            <exclude>**/IndexedMultiValueOccurrenceTest.java</exclude>
            <exclude>**/IndexedOccurrenceArrayNativeTest.java</exclude>
            <exclude>**/IndexedTableReentrantSortTest.java</exclude>
            <exclude>**/IndexedTableReverseOffsetTest.java</exclude>
            <exclude>**/IndexedTableTest.java</exclude>
            <exclude>**/JdkCollectionDifferentialTest.java</exclude>
            <exclude>**/LinkedHashBackshiftTest.java</exclude>
            <exclude>**/M3LinkedHashMapCapacityTest.java</exclude>
            <exclude>**/MapContractTest.java</exclude>
            <exclude>**/NativeFiveLibrarySdkNoVendorTest.java</exclude>
            <exclude>**/NoRetainedStructuralEntryTest.java</exclude>
            <exclude>**/ObjectCountsTest.java</exclude>
            <exclude>**/RelationForEachTest.java</exclude>
            <exclude>**/SdkOwnerFactoryTest.java</exclude>
            <exclude>**/SequenceContractTest.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- Native tests: build make/m3/arrays and make/m3/collections with CMake first, then -Pm3-collections-native
           -Dm3.collections.native.dir=<arrays build dir> -Dm3.collections.jni.dir=<collections build dir>.
           On Windows also pass -Dm3.collections.native.suffix=.dll -Dm3.collections.jni.prefix= (the collections
           libraries carry no lib prefix there, so System.loadLibrary finds them). -->
      <id>m3-collections-native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.2.5</version>
            <configuration>
              <useModulePath>false</useModulePath>
              <excludes combine.self="override"/>
              <!-- The self-loading owners call System.loadLibrary; java.library.path must be set at JVM start. -->
              <argLine>-Djava.library.path=${m3.collections.jni.dir}</argLine>
              <systemPropertyVariables>
                <m3.arrays.native.path>${m3.collections.native.dir}/${m3.collections.native.prefix}m3_arrays${m3.collections.native.suffix}</m3.arrays.native.path>
                <m3.counted.native>${m3.collections.jni.dir}/${m3.collections.jni.prefix}m3_count_lanes${m3.collections.native.suffix}</m3.counted.native>
                <m3.totals.native>${m3.collections.jni.dir}/${m3.collections.jni.prefix}m3_count_totals${m3.collections.native.suffix}</m3.totals.native>
                <!-- One host-loaded library for the packed owners and the bit lane (NATIVE_ABSORB N3). -->
                <m3.native.path>${m3.collections.jni.dir}/${m3.collections.jni.prefix}m3_collections_packed${m3.collections.native.suffix}</m3.native.path>
                <!-- U12: the host-loaded second-lineage packed codec (PackedIntNativeTest). -->
                <lint.native.path>${m3.collections.jni.dir}/${m3.collections.jni.prefix}m3_packed_int_width${m3.collections.native.suffix}</lint.native.path>
                <!-- Owners that load only on opt-in, and the tests that then require every built backend. -->
                <m3.collections.rank.native>true</m3.collections.rank.native>
                <m3.collections.rank.pairdistance.native>true</m3.collections.rank.pairdistance.native>
                <m3.collections.signal.native>true</m3.collections.signal.native>
                <m3.collections.lane.native>true</m3.collections.lane.native>
                <m3.collections.all.native.required>true</m3.collections.all.native.required>
                <m3.mask.spans.native.required>true</m3.mask.spans.native.required>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
      <properties>
        <m3.collections.native.prefix>lib</m3.collections.native.prefix>
        <m3.collections.native.suffix>.so</m3.collections.native.suffix>
        <m3.collections.jni.dir>${m3.collections.native.dir}</m3.collections.jni.dir>
        <m3.collections.jni.prefix>lib</m3.collections.jni.prefix>
      </properties>
    </profile>
