<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3.collections</groupId><artifactId>m3-owned-guava-evicting-queue</artifactId><version>0.1.0-SNAPSHOT</version>
  <properties><maven.compiler.release>21</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><m3.module.output>${project.basedir}/target</m3.module.output></properties>
  <build>
    <directory>${m3.module.output}</directory>
    <resources><resource><directory>${project.basedir}</directory><targetPath>META-INF</targetPath><includes><include>LICENSE.txt</include><include>NOTICE.txt</include><include>THIRD_PARTY_NOTICES.md</include></includes></resource></resources>
    <plugins>
