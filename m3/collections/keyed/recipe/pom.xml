<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0; reuse isolated interop proof pattern and canonical engines. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion><groupId>com.synexia</groupId><artifactId>collections-keyed-recipe-proof</artifactId><version>1.0-SNAPSHOT</version>
  <properties><maven.compiler.release>21</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-core</artifactId><version>8.17.1</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java</artifactId><version>8.17.1</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java-21</artifactId><version>8.17.1</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.2</version><scope>test</scope></dependency>
  </dependencies>
  <build><sourceDirectory>${project.basedir}/../../counts/recipe/pinned-engine</sourceDirectory><directory>${project.basedir}/target/collections-keyed-proof</directory>
    <resources><resource><directory>src/main/resources</directory><includes><include>com/synexia/rewrite/hash-pinned-java/collections-keyed/**</include><include>com/synexia/rewrite/hash-pinned-text/collections-keyed/**</include><include>META-INF/rewrite/m3-keyed-receiver-20261017.yml</include></includes></resource></resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version><configuration><release>21</release><proc>none</proc><compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs>
        <includes><include>com/synexia/rewrite/M3HashPinnedJavaSnapshotRecipe.java</include><include>com/synexia/rewrite/M3HashPinnedTextSnapshotRecipe.java</include><include>com/synexia/rewrite/M3ScopeInference.java</include><include>com/synexia/rewrite/M3EditScope.java</include></includes>
        <testIncludes><testInclude>com/synexia/rewrite/M3CollectionsKeyedTest.java</testInclude></testIncludes>
      </configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version><configuration><useModulePath>false</useModulePath><failIfNoTests>true</failIfNoTests><includes><include>**/M3CollectionsKeyedTest.java</include></includes></configuration></plugin>
    </plugins>
  </build>
  <profiles>
    <profile><id>apply-qualified-keyed-recipe</id><activation><property><name>m3.keyed.output</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.1.1</version>
        <executions><execution><id>apply-after-passing-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
          <configuration><mainClass>com.synexia.rewrite.M3CollectionsKeyedTest</mainClass><classpathScope>test</classpathScope>
            <arguments><argument>${m3.keyed.output}</argument><argument>${project.build.directory}/surefire-reports/TEST-com.synexia.rewrite.M3CollectionsKeyedTest.xml</argument></arguments>
          </configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
