<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.synexia.m3</groupId>
  <artifactId>m3-filtered-navigable-boundary-recipe</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>M3 Filtered NavigableSet range-boundary recipe</name>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <m3.repo.root>${project.basedir}/../../../..</m3.repo.root>
    <m3.recipe.mode>--verify</m3.recipe.mode>
  </properties>
  <profiles>
    <profile>
      <id>apply</id>
      <properties><m3.recipe.mode>--apply</m3.recipe.mode></properties>
    </profile>
  </profiles>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>recipe-verify-or-apply</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>com.m3.tooling.recipe.M3NavigableBoundRecipe</mainClass>
              <arguments>
                <argument>${m3.recipe.mode}</argument>
                <argument>${m3.repo.root}/m3/collections/src/main/java/com/m3/collections/M3FilteredNavigableSet.java</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>recipe-fixed-point-and-refusal</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>com.m3.tooling.recipe.M3NavigableBoundRecipeSelfTest</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>java21-compatibility-differential-oracle</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>com.m3.tooling.recipe.M3NavigableBoundReceiverVerifier</mainClass>
              <arguments>
                <argument>${m3.repo.root}/m3/collections/src/main/java/com/m3/collections/M3FilteredNavigableSet.java</argument>
                <argument>${m3.repo.root}/m3/collections/src/test/java/com/m3/collections/M3NavigableBoundaryProof.java</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
