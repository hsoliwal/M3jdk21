+    private static <E> List<E> nested(List<E> source, Predicate<? super E> predicate, int depth) {
+        List<E> result = source;
+        for (int index = 0; index < depth; index++) {
+            result = M3FilteredLists.filtered(result, predicate);
+        }
+        return result;
+    }
