<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Separate optional runtime build. Source does not exist until the receiving recipe succeeds. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId>
  <artifactId>m3-collections-interop</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>M3 optional collection library interoperability</name>
  <description>Named JDK, Guava, Eclipse Collections, Spring Framework and Apache Commons Collections contracts over M3 storage; scoped SDK surface.</description>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.m3</groupId>
      <artifactId>m3-collections</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>33.4.8-jre</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.collections</groupId>
      <artifactId>eclipse-collections</artifactId>
      <version>11.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-core</artifactId>
      <version>6.2.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-collections4</artifactId>
      <version>4.5.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
        </includes>
      </resource>
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF/m3</targetPath>
        <includes>
          <include>README.md</include>
          <include>donor-origin.json</include>
          <include>THIRD_PARTY_NOTICES.md</include>
          <include>recipe-receipt.tsv</include>
          <include>sdk-family-bindings.tsv</include>
          <include>SDK_FAMILIES.md</include>
          <include>SDK_FAMILY_NOTICES.md</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <!-- Unqualified donor-linked interop is internal-only until source-vendored. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <version>3.1.3</version>
        <configuration><skip>true</skip></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>3.1.3</version>
        <configuration><skip>true</skip></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <proc>none</proc>
          <compilerArgs>
            <arg>-Xlint:all,-processing</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <failIfNoTests>true</failIfNoTests>
          <!-- FLLDCIM: MRL - interop bindings/gating, recipe qualification/bindings-gating-20261107. JNI test gating (m3/collections/pom.xml pattern,
               jni-test-gating-20261106): the m3_arrays JNI-dependent classes (EXCLUDED.tsv, enumerated from
               surefire XML) are excluded from the default build and re-included by -Pm3-collections-native. -->
          <excludes>
            <exclude>**/M3ApacheBagContractTest.java</exclude>
            <exclude>**/M3ApacheBidiMapContractTest.java</exclude>
            <exclude>**/M3ApacheCollectionsTest.java</exclude>
            <exclude>**/M3BiMapTest.java</exclude>
            <exclude>**/M3CountedProviderContractTest.java</exclude>
            <exclude>**/M3EclipseBagMultimapTest.java</exclude>
            <exclude>**/M3EclipseMultimapTest.java</exclude>
            <exclude>**/M3FiveFamilyPreparedSelectionTest.java</exclude>
            <exclude>**/M3FiveLibraryArrayificationTest.java</exclude>
            <exclude>**/M3FiveLibraryExpandedContractsTest.java</exclude>
            <exclude>**/M3FiveLibraryIndexViewsTest.java</exclude>
            <exclude>**/M3FiveLibraryInteropContractTest.java</exclude>
            <exclude>**/M3FiveLibraryKeyRangesTest.java</exclude>
            <exclude>**/M3FiveLibraryPreparedRowsTest.java</exclude>
            <exclude>**/M3FiveLibraryState32Test.java</exclude>
            <exclude>**/M3FiveListFamiliesTest.java</exclude>
            <exclude>**/M3FiveProviderBagContractTest.java</exclude>
            <exclude>**/M3FiveProviderCountSharingRegressionTest.java</exclude>
            <exclude>**/M3FiveProviderFlagSelectionTest.java</exclude>
            <exclude>**/M3FiveProviderIntegrationTest.java</exclude>
            <exclude>**/M3FiveProviderKeyGroupClosureTest.java</exclude>
            <exclude>**/M3FiveProviderKeyGroupsTest.java</exclude>
            <exclude>**/M3GuavaBiMapContractTest.java</exclude>
            <exclude>**/M3GuavaClassToInstanceMapsTest.java</exclude>
            <exclude>**/M3GuavaListMultimapRealTest.java</exclude>
            <exclude>**/M3GuavaRowSortedTableTest.java</exclude>
            <exclude>**/M3GuavaSetMultimapTest.java</exclude>
            <exclude>**/M3LibraryClosureTest.java</exclude>
            <exclude>**/M3LibraryCollectionsTest.java</exclude>
            <exclude>**/M3SdkFamiliesTest.java</exclude>
            <exclude>**/M3SpringArrayContractTest.java</exclude>
            <exclude>**/M3SpringCaseInsensitiveSdkFactoryTest.java</exclude>
            <exclude>**/M3SpringCaseInsensitiveTest.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- Native tests: build m3/arrays/src/main/native with CMake first, then -Pm3-collections-native -Dm3.collections.native.dir=<dir>. -->
      <id>m3-collections-native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.2.5</version>
            <configuration>
              <useModulePath>false</useModulePath>
              <excludes combine.self="override"/>
              <systemPropertyVariables>
                <m3.arrays.native.path>${m3.collections.native.dir}/${m3.collections.native.prefix}m3_arrays${m3.collections.native.suffix}</m3.arrays.native.path>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
      <properties>
        <m3.collections.native.prefix>lib</m3.collections.native.prefix>
        <m3.collections.native.suffix>.so</m3.collections.native.suffix>
      </properties>
    </profile>
  </profiles>
</project>
