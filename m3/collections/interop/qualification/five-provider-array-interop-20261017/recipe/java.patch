+        assertThrows(IllegalArgumentException.class, () -> actual.remove(null, -1));
+        assertThrows(IllegalArgumentException.class, () -> actual.setCount(null, -1));
+        assertThrows(IllegalArgumentException.class, () -> actual.setCount(null, -1, 0));
