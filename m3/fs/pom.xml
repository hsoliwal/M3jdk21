<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 Hitesh Soliwal and contributors; SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId><artifactId>m3-fs</artifactId><version>0.1.0-SNAPSHOT</version>
  <name>M3JDK21 M3FS runtime</name>
  <description>M3FS metadata, native SQLite filesystem, and attributed Apache Commons VFS provider core owned by M3JDK21.</description>
  <licenses><license><name>Apache License 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url></license></licenses>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-10-18T00:00:00Z</project.build.outputTimestamp>
    <cmake.executable>cmake</cmake.executable><ctest.executable>ctest</ctest.executable>
    <m3.fs.native.fuse>OFF</m3.fs.native.fuse><m3.fs.native.prefix></m3.fs.native.prefix>
  </properties>
  <dependencies>
    <!-- Exact qualified m3-vfs-core closure; upstream versions and bounded overrides are recorded in legal/commons-vfs2/CHANGES-M3FS.md. -->
    <dependency><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId><version>1.2</version></dependency>
    <dependency><groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><version>3.18.0</version></dependency>
    <dependency><groupId>commons-io</groupId><artifactId>commons-io</artifactId><version>2.21.0</version></dependency>
    <dependency><groupId>org.apache.commons</groupId><artifactId>commons-compress</artifactId><version>1.28.0</version></dependency>
    <dependency><groupId>commons-codec</groupId><artifactId>commons-codec</artifactId><version>1.19.0</version></dependency>
    <dependency><groupId>com.google.re2j</groupId><artifactId>re2j</artifactId><version>1.8</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.2</version><scope>test</scope></dependency>
    <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>3.45.1.0</version><scope>test</scope></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>1.7.36</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory><filtering>false</filtering></resource>
      <resource><directory>legal</directory><targetPath>META-INF/m3fs-legal</targetPath><filtering>false</filtering></resource>
    </resources>
    <plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
      <configuration>
        <!-- M3-owned source keeps its existing strict gate; imported provider sources compile in the profile execution below. -->
        <compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg><arg>-implicit:none</arg></compilerArgs>
        <excludes><exclude>com/m3/fs/vfs/**/*.java</exclude></excludes>
      </configuration>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
      <configuration><useModulePath>false</useModulePath><argLine>-Xcheck:jni</argLine>
        <systemPropertyVariables>
          <m3.fs.native.path>${project.build.directory}/native/libm3fs.so</m3.fs.native.path>
          <m3.fs.test>true</m3.fs.test><m3fs.native>required</m3fs.native>
        </systemPropertyVariables>
      </configuration>
    </plugin>
    <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.3.0</version><executions>
      <execution><id>configure-native</id><phase>generate-resources</phase><goals><goal>exec</goal></goals><configuration>
        <executable>${cmake.executable}</executable><arguments><argument>-S</argument><argument>${project.basedir}/native</argument><argument>-B</argument><argument>${project.build.directory}/native</argument><argument>-DM3FS_JNI=ON</argument><argument>-DM3FS_FUSE=${m3.fs.native.fuse}</argument><argument>-DCMAKE_PREFIX_PATH=${m3.fs.native.prefix}</argument><argument>-DBUILD_TESTING=ON</argument></arguments>
      </configuration></execution>
      <execution><id>build-native</id><phase>generate-resources</phase><goals><goal>exec</goal></goals><configuration>
        <executable>${cmake.executable}</executable><arguments><argument>--build</argument><argument>${project.build.directory}/native</argument><argument>--parallel</argument><argument>2</argument></arguments>
      </configuration></execution>
      <execution><id>module-descriptor</id><phase>prepare-package</phase><goals><goal>exec</goal></goals><configuration>
        <!-- Commons Logging 1.2 is automatic on Maven's input path; the JMOD lane injects its reviewed explicit descriptor. -->
        <classpathScope>compile</classpathScope>
        <executable>${java.home}/bin/javac</executable><arguments><argument>--release</argument><argument>21</argument><argument>-Xlint:all,-requires-automatic,-requires-transitive-automatic</argument><argument>-Werror</argument><argument>--module-path</argument><classpath/><argument>--patch-module</argument><argument>jdk.m3fs=${project.build.outputDirectory}</argument><argument>-d</argument><argument>${project.build.outputDirectory}</argument><argument>${project.basedir}/src/main/module/module-info.java</argument></arguments>
      </configuration></execution>
      <execution><id>verify-native</id><phase>verify</phase><goals><goal>exec</goal></goals><configuration>
        <executable>${ctest.executable}</executable><arguments><argument>--test-dir</argument><argument>${project.build.directory}/native</argument><argument>--output-on-failure</argument></arguments>
      </configuration></execution>
    </executions></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version><configuration><archive><manifestEntries>
      <Bundle-ManifestVersion>2</Bundle-ManifestVersion><Bundle-SymbolicName>com.m3.fs</Bundle-SymbolicName><Bundle-Version>0.1.0</Bundle-Version><Bundle-Name>M3FS</Bundle-Name><Bundle-RequiredExecutionEnvironment>JavaSE-21</Bundle-RequiredExecutionEnvironment><Export-Package>com.m3.fs;version="0.1.0",com.m3.fs.vfs;version="0.1.0",com.m3.fs.vfs.auth;version="0.1.0",com.m3.fs.vfs.cache;version="0.1.0",com.m3.fs.vfs.events;version="0.1.0",com.m3.fs.vfs.filter;version="0.1.0",com.m3.fs.vfs.function;version="0.1.0",com.m3.fs.vfs.impl;version="0.1.0",com.m3.fs.vfs.operations;version="0.1.0",com.m3.fs.vfs.operations.vcs;version="0.1.0",com.m3.fs.vfs.provider;version="0.1.0",com.m3.fs.vfs.provider.bzip2;version="0.1.0",com.m3.fs.vfs.provider.compressed;version="0.1.0",com.m3.fs.vfs.provider.gzip;version="0.1.0",com.m3.fs.vfs.provider.jar;version="0.1.0",com.m3.fs.vfs.provider.local;version="0.1.0",com.m3.fs.vfs.provider.ram;version="0.1.0",com.m3.fs.vfs.provider.res;version="0.1.0",com.m3.fs.vfs.provider.tar;version="0.1.0",com.m3.fs.vfs.provider.temp;version="0.1.0",com.m3.fs.vfs.provider.url;version="0.1.0",com.m3.fs.vfs.provider.zip;version="0.1.0",com.m3.fs.vfs.util;version="0.1.0"</Export-Package><Import-Package>javax.crypto,javax.crypto.spec,javax.xml.parsers,org.w3c.dom,org.apache.commons.compress.archivers,org.apache.commons.compress.archivers.tar,org.apache.commons.compress.compressors.bzip2,org.apache.commons.io,org.apache.commons.io.file,org.apache.commons.io.function,org.apache.commons.lang3,org.apache.commons.lang3.concurrent,org.apache.commons.lang3.reflect,org.apache.commons.lang3.time,org.apache.commons.lang3.util,org.apache.commons.logging</Import-Package>
    </manifestEntries></archive></configuration></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-install-plugin</artifactId><version>3.1.2</version></plugin>
  </plugins></build>
  <profiles>
    <profile>
      <id>m3-vfs-core</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
        <executions><execution>
          <id>compile-attributed-vfs-core</id><phase>process-sources</phase><goals><goal>compile</goal></goals>
          <configuration>
            <includes><include>com/m3/fs/vfs/**/*.java</include></includes>
            <excludes combine.self="override">
              <exclude>com/m3/fs/vfs/provider/ftp/**/*.java</exclude>
              <exclude>com/m3/fs/vfs/provider/ftps/**/*.java</exclude>
              <exclude>com/m3/fs/vfs/provider/http/**/*.java</exclude>
              <exclude>com/m3/fs/vfs/provider/https/**/*.java</exclude>
              <exclude>com/m3/fs/vfs/provider/http4/**/*.java</exclude>
              <exclude>com/m3/fs/vfs/provider/http4s/**/*.java</exclude>
              <exclude>com/m3/fs/vfs/provider/http5/**/*.java</exclude>
              <exclude>com/m3/fs/vfs/provider/http5s/**/*.java</exclude>
              <exclude>com/m3/fs/vfs/provider/sftp/**/*.java</exclude>
              <exclude>com/m3/fs/vfs/cache/LRUFilesCache.java</exclude>
              <exclude>com/m3/fs/vfs/provider/URLFileName.java</exclude>
              <exclude>com/m3/fs/vfs/provider/URLFileNameParser.java</exclude>
            </excludes>
            <!-- Preserve imported upstream diagnostics without turning historical warnings into M3 source errors. -->
            <compilerArgs combine.self="override"><arg>-Xlint:all</arg><arg>-implicit:none</arg></compilerArgs>
            <failOnWarning>false</failOnWarning><useIncrementalCompilation>false</useIncrementalCompilation>
          </configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
