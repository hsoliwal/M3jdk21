<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId>
  <artifactId>m3-search</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>M3 search kernels</name>
  <description>Exact byte search (KMP, Boyer-Moore-Horspool, bitap, adaptive engine) and string window kernels
    (minimum cover window, minimum subsequence window, fixed-word concatenation, batch subsequence match),
    received from com.synexia m3-fast-search by M3_SEARCH_RELOCATE v1.</description>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Hitesh Soliwal</name>
      <email>hsoliwal@gmail.com</email>
    </developer>
  </developers>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency><groupId>com.m3</groupId><artifactId>m3-collections</artifactId><version>0.1.0-SNAPSHOT</version></dependency>
    <dependency><groupId>com.m3</groupId><artifactId>m3-file</artifactId><version>0.1.0-SNAPSHOT</version></dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-module</arg>
            <arg>-Werror</arg>
          </compilerArgs>
          <testExcludes>
            <testExclude>**/qualification/**</testExclude>
          </testExcludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <excludes>
            <exclude>**/*Native*Test.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- Native tests: build src/main/native with CMake first, then -Pm3-search-native -Dm3.search.native.dir=<dir>. -->
      <id>m3-search-native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.2.5</version>
            <configuration>
              <useModulePath>false</useModulePath>
              <excludes combine.self="override"/>
              <systemPropertyVariables>
                <m3.native.enabled>true</m3.native.enabled>
                <m3.native.library.path>${m3.search.native.dir}/${m3.search.native.prefix}m3search${m3.search.native.suffix}</m3.native.library.path>
                <m3.minimum.cover.native.junit>true</m3.minimum.cover.native.junit>
                <m3.minimum.cover.library>${m3.search.native.dir}/${m3.search.native.prefix}m3coverwindow${m3.search.native.suffix}</m3.minimum.cover.library>
                <m3.window.native.library>${m3.search.native.dir}/${m3.search.native.prefix}m3coverwindow${m3.search.native.suffix}</m3.window.native.library>
                <m3.batch.subsequence.library>${m3.search.native.dir}/${m3.search.native.prefix}m3batchsubseq${m3.search.native.suffix}</m3.batch.subsequence.library>
                <m3.concat.native>${m3.search.native.dir}/${m3.search.native.prefix}m3wordconcat${m3.search.native.suffix}</m3.concat.native>
                <m3.pair.jni.library>${m3.search.native.dir}/${m3.search.native.prefix}m3pairsum${m3.search.native.suffix}</m3.pair.jni.library>
                <m3.subsequence.native>${m3.search.native.dir}/${m3.search.native.prefix}m3subseqwindow${m3.search.native.suffix}</m3.subsequence.native>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
      <properties>
        <m3.search.native.prefix>lib</m3.search.native.prefix>
        <m3.search.native.suffix>.so</m3.search.native.suffix>
      </properties>
    </profile>
  </profiles>
</project>
