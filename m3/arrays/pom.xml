<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId>
  <artifactId>m3-arrays</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>M3 immutable array substrate</name>
  <description>Immutable snapshot/range/join owners and explicit Java/JNI materialization boundaries.</description>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2-m3-source-1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
          <include>provenance.json</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-module</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>native-linux</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution>
                <id>configure-native</id>
                <phase>generate-test-resources</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>cmake</executable>
                  <arguments>
                    <argument>-S</argument>
                    <argument>${project.basedir}/src/main/native</argument>
                    <argument>-B</argument>
                    <argument>${project.build.directory}/native</argument>
                    <argument>-DCMAKE_BUILD_TYPE=Release</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>build-native</id>
                <phase>process-test-resources</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>cmake</executable>
                  <arguments>
                    <argument>--build</argument>
                    <argument>${project.build.directory}/native</argument>
                    <argument>--config</argument>
                    <argument>Release</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>test-native</id>
                <phase>process-test-resources</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>ctest</executable>
                  <arguments>
                    <argument>--test-dir</argument>
                    <argument>${project.build.directory}/native</argument>
                    <argument>--output-on-failure</argument>
                    <argument>-C</argument>
                    <argument>Release</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.2.5</version>
            <configuration>
              <useModulePath>false</useModulePath>
              <systemPropertyVariables>
                <m3.arrays.native.path>${project.build.directory}/native/libm3_arrays.so</m3.arrays.native.path>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>m3-synexia-atom-pattern</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.synexia</groupId>
                <artifactId>synexia-openrewrite-recipes</artifactId>
                <version>1.0.0-SNAPSHOT</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-synexia-atom-pattern-verify</id>
                <phase>verify</phase>
                <goals>
                  <goal>dryRun</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <activeRecipes>
                <recipe>com.synexia.m3.EveryModuleAtomPatternApplication</recipe>
              </activeRecipes>
              <exportDatatables>true</exportDatatables>
              <runPerSubmodule>false</runPerSubmodule>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <failOnDryRunResults>false</failOnDryRunResults>
              <additionalPlainTextMasks>
                <additionalPlainTextMask>**/*.md</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.markdown</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.adoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.asciidoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.c</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.h</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle.kts</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.sh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bash</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cmd</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bat</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ps1</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.py</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.pyi</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.csv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.tsv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ndjson</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.txt</additionalPlainTextMask>
                <additionalPlainTextMask>**/README</additionalPlainTextMask>
                <additionalPlainTextMask>**/LICENSE</additionalPlainTextMask>
                <additionalPlainTextMask>**/NOTICE</additionalPlainTextMask>
              </additionalPlainTextMasks>
              <exclusions>
                <exclusion>**/target/**</exclusion>
                <exclusion>**/generated-sources/**</exclusion>
                <exclusion>**/out/**</exclusion>
                <exclusion>**/scratch/**</exclusion>
                <exclusion>**/.merge-preserved/**</exclusion>
                <exclusion>**/.superset/**</exclusion>
                <exclusion>**/.m3/maven-superset-*/**</exclusion>
                <exclusion>**/archive-maven-projects/**</exclusion>
                <exclusion>**/tasks/**</exclusion>
                <exclusion>**/verification/**</exclusion>
                <exclusion>**/evidence/**</exclusion>
                <exclusion>**/history/**</exclusion>
                <exclusion>**/template-history/**</exclusion>
                <exclusion>**/receiving-input/**</exclusion>
                <exclusion>**/input-epoch/**</exclusion>
                <exclusion>**/src/test/resources/**</exclusion>
                <exclusion>**/upstream-excluded/**</exclusion>
                <exclusion>**/*custody*/**</exclusion>
                <exclusion>**/vendor/**</exclusion>
              </exclusions>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>m3-synexia-atom-pattern-mastery</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.synexia</groupId>
                <artifactId>synexia-openrewrite-recipes</artifactId>
                <version>1.0.0-SNAPSHOT</version>
              </dependency>
            </dependencies>
            <executions>
