<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId>
  <artifactId>m3-file</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <!-- M3FileDeltaTest (recipe receiver 9fb3cc6d) is a JUnit 5 test; same version as m3/collections -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <proc>none</proc>
          <compilerArgs>
            <arg>-Xlint:all,-module</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>file-source-class-content-contract</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>python3</executable>
              <arguments>
                <argument>${project.basedir}/verify.py</argument>
                <argument>--java-home</argument>
                <argument>${java.home}</argument>
                <argument>--classes</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>--output</argument>
                <argument>${project.build.directory}/delta-check</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>m3-recipe-boot</id>
      <activation>
        <file>
          <exists>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</exists>
        </file>
      </activation>
      <properties>
        <m3.recipe.boot.skip>false</m3.recipe.boot.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <inherited>true</inherited>
            <dependencies>
              <dependency>
                <groupId>com.synexia.m3</groupId>
                <artifactId>m3-pr-stack-preservation</artifactId>
                <version>1.0.0-m3boot20261021</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-recipe-boot</id>
                <phase>validate</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <skip>${m3.recipe.boot.skip}</skip>
                  <mainClass>com.synexia.m3.prstack.M3RecipeBoot</mainClass>
                  <includeProjectDependencies>false</includeProjectDependencies>
                  <includePluginDependencies>true</includePluginDependencies>
                  <arguments>
                    <argument>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</argument>
                    <argument>${project.basedir}</argument>
                    <argument>${session.projects[0].basedir.absolutePath}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
