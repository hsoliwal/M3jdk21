<!-- FLLDCIM: FILE_UNIFY - union of m3/file/pom.xml (blob c64ebfc3ccdf) and m3/ports/file/pom.xml (blob f928fb9071a4): every
     dependency, plugin, execution and surefire setting of both; recipe m3/qualification/file-unify-20261106/unify.py v1 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId>
  <artifactId>m3-file</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>M3JDK :: File</name>
  <description>The jdk.m3.file family (module org.m3jdk.file, packages jdk.m3.file and jdk.m3.file.json) in one module:
    the narrow NIO file-access boundary (file deltas and ledgers, build impact, shadow streams, resource locks, watcher)
    and the MIndexFile forward port (M3ByteFile, MappedM3File, the file universe with events, snapshots, token index and
    traversal, M3FmtVarints / lexicon frames / frozen dictionary, M3JniLibraryLoader with M3NativeLibrarySpec,
    M3ProgressMonitor as an adapter over the owner jdk.m3.collections.M3ProgressMonitor, M3JsonStructuralIndex). Pure
    Java 21; com.m3:m3-collections is the only dependency outside java.base; the natives under src/main/native are built
    by their CMakeLists.txt and loaded at run time through M3JniLibraryLoader. One module for the package since
    m3/qualification/file-unify-20261106 (formerly m3/file jdk.m3.file and m3/ports/file org.m3jdk.file); the first
    consumer outside this module is the native search engine (m3/search), whose loader owner is
    M3JniLibraryLoader.</description>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.m3</groupId>
      <artifactId>m3-collections</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <!-- M3FileDeltaTest (recipe receiver 9fb3cc6d) is a JUnit 5 test; same version as m3/collections -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <proc>none</proc>
          <compilerArgs>
            <!-- same gate as qualification/m3fmt-shared-lexicon-20261021/verify.sh: every lint except the
                 module-name digit lint (org.m3jdk.file), and warnings are errors -->
            <arg>-Xlint:all,-module</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <failIfNoTests>true</failIfNoTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
      <plugin>
        <!-- exposes ${com.m3:m3-collections:jar} and ${com.m3:m3-arrays:jar}, the dependency modules verify.py puts on the
             module path next to the packaged module (file-unify-20261106: the module requires jdk.m3.collections) -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>file-dependency-module-path</id>
            <phase>initialize</phase>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>file-source-class-content-contract</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>python3</executable>
              <arguments>
                <argument>${project.basedir}/verify.py</argument>
                <argument>--java-home</argument>
                <argument>${java.home}</argument>
                <argument>--classes</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>--module-path</argument>
                <argument>${com.m3:m3-collections:jar}${path.separator}${com.m3:m3-arrays:jar}</argument>
                <argument>--output</argument>
                <argument>${project.build.directory}/delta-check</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
