<!-- SPDX-License-Identifier: Apache-2.0; build integration only, upstream source remains Apache 2. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.lucene</groupId>
  <artifactId>lucene-core</artifactId>
  <version>9.10.0-m3-source-1</version>
  <name>lucene-core 9.10.0 - unchanged upstream source build for M3jdk21</name>
  <description>Source inclusion of the published org.apache.lucene:lucene-core:9.10.0 sources jar (SHA-1 a9be171b9d66f50a2f8c9db40219b7107794dbf5); no upstream implementation changes. See PROVENANCE.json.</description>
  <url>https://lucene.apache.org/</url>
  <licenses>
    <license>
      <name>Apache 2</name>
      <url>https://repo.maven.apache.org/maven2/org/apache/lucene/lucene-core/9.10.0/lucene-core-9.10.0.pom</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF/third-party/lucene-core</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>PROVENANCE.json</include>
          <include>THIRD_PARTY_NOTICES.md</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <!-- Upstream bytes are compiled as published: no annotation processing, no warnings-as-errors. M3jdk21 integration is checked separately with -Werror. -->
        <configuration>
          <release>11</release>
          <encoding>UTF-8</encoding>
          <moduleVersion>9.10.0</moduleVersion>
          <proc>none</proc>
          <compilerArgs>
            <arg>-Xlint:all,-options</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <!-- Published sources jars carry no test suite; the compile and the consumers' own tests are the proof lane. -->
        <configuration>
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <excludes>
            <exclude>META-INF/jpms.args</exclude>
          </excludes>
          <archive>
            <manifestEntries>
              <M3jdk21-Source-Inline>no upstream Automatic-Module-Name</M3jdk21-Source-Inline>
              <Multi-Release>true</Multi-Release>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <!-- upstream core-mrjar.gradle: javaN overlays compiled against the JDK N apijar (patched java.base) -->
        <executions>
          <execution>
            <id>multi-release-19-apijar</id>
            <phase>process-classes</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java.home}/bin/javac</executable>
              <arguments>
                <argument>-source</argument>
                <argument>11</argument>
                <argument>-target</argument>
                <argument>11</argument>
                <argument>-Xlint:-options</argument>
                <argument>-proc:none</argument>
                <argument>-encoding</argument>
                <argument>UTF-8</argument>
                <argument>--patch-module</argument>
                <argument>java.base=${project.basedir}/build-inputs/jdk19.apijar</argument>
                <argument>--add-exports</argument>
                <argument>java.base/java.lang.foreign=ALL-UNNAMED</argument>
                <argument>--add-exports</argument>
                <argument>java.base/jdk.incubator.vector=ALL-UNNAMED</argument>
                <argument>-classpath</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>-d</argument>
                <argument>${project.build.outputDirectory}/META-INF/versions/19</argument>
                <argument>${project.basedir}/src/main/versions/19/org/apache/lucene/store/MemorySegmentIndexInput.java</argument>
                <argument>${project.basedir}/src/main/versions/19/org/apache/lucene/store/MemorySegmentIndexInputProvider.java</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>multi-release-20-apijar</id>
            <phase>process-classes</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java.home}/bin/javac</executable>
              <arguments>
                <argument>-source</argument>
                <argument>11</argument>
                <argument>-target</argument>
                <argument>11</argument>
                <argument>-Xlint:-options</argument>
                <argument>-proc:none</argument>
                <argument>-encoding</argument>
                <argument>UTF-8</argument>
                <argument>--patch-module</argument>
                <argument>java.base=${project.basedir}/build-inputs/jdk20.apijar</argument>
                <argument>--add-exports</argument>
                <argument>java.base/java.lang.foreign=ALL-UNNAMED</argument>
                <argument>--add-exports</argument>
                <argument>java.base/jdk.incubator.vector=ALL-UNNAMED</argument>
                <argument>-classpath</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>-d</argument>
                <argument>${project.build.outputDirectory}/META-INF/versions/20</argument>
                <argument>${project.basedir}/src/main/versions/20/org/apache/lucene/internal/vectorization/PanamaVectorUtilSupport.java</argument>
                <argument>${project.basedir}/src/main/versions/20/org/apache/lucene/internal/vectorization/PanamaVectorizationProvider.java</argument>
                <argument>${project.basedir}/src/main/versions/20/org/apache/lucene/store/MemorySegmentIndexInput.java</argument>
                <argument>${project.basedir}/src/main/versions/20/org/apache/lucene/store/MemorySegmentIndexInputProvider.java</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>multi-release-21-apijar</id>
            <phase>process-classes</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java.home}/bin/javac</executable>
              <arguments>
                <argument>-source</argument>
                <argument>11</argument>
                <argument>-target</argument>
                <argument>11</argument>
                <argument>-Xlint:-options</argument>
                <argument>-proc:none</argument>
                <argument>-encoding</argument>
                <argument>UTF-8</argument>
                <argument>--patch-module</argument>
                <argument>java.base=${project.basedir}/build-inputs/jdk21.apijar</argument>
                <argument>--add-exports</argument>
                <argument>java.base/java.lang.foreign=ALL-UNNAMED</argument>
                <argument>--add-exports</argument>
                <argument>java.base/jdk.incubator.vector=ALL-UNNAMED</argument>
                <argument>-classpath</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>-d</argument>
                <argument>${project.build.outputDirectory}/META-INF/versions/21</argument>
                <argument>${project.basedir}/src/main/versions/21/org/apache/lucene/store/MemorySegmentIndexInput.java</argument>
                <argument>${project.basedir}/src/main/versions/21/org/apache/lucene/store/MemorySegmentIndexInputProvider.java</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>m3-recipe-boot</id>
      <activation>
        <file>
          <exists>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</exists>
        </file>
      </activation>
      <properties>
        <m3.recipe.boot.skip>false</m3.recipe.boot.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <inherited>true</inherited>
            <dependencies>
              <dependency>
                <groupId>com.synexia.m3</groupId>
                <artifactId>m3-pr-stack-preservation</artifactId>
                <version>1.0.0-m3boot20261021</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-recipe-boot</id>
                <phase>validate</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <skip>${m3.recipe.boot.skip}</skip>
                  <mainClass>com.synexia.m3.prstack.M3RecipeBoot</mainClass>
                  <includeProjectDependencies>false</includeProjectDependencies>
                  <includePluginDependencies>true</includePluginDependencies>
                  <arguments>
                    <argument>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</argument>
                    <argument>${project.basedir}</argument>
                    <argument>${session.projects[0].basedir.absolutePath}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
