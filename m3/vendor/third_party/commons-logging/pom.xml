<!-- SPDX-License-Identifier: Apache-2.0; build integration only, upstream source remains Apache License, Version 2.0 (from the license text; pom declares none). -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>commons-logging</groupId><artifactId>commons-logging</artifactId><version>1.3.2-m3-source-1</version>
  <name>commons-logging 1.3.2 - unchanged upstream source build for M3jdk21</name>
  <description>Source inclusion of the published commons-logging:commons-logging:1.3.2 sources jar (SHA-1 3bf2b5ce48a273d1d37bac9df0ab9f73b4ef92cb); no upstream implementation changes. See PROVENANCE.json.</description>
  <url>https://commons.apache.org/proper/commons-logging/</url>
  <licenses><license><name>Apache License, Version 2.0 (from the license text; pom declares none)</name><url>https://repo.maven.apache.org/maven2/commons-logging/commons-logging/1.3.2/commons-logging-1.3.2.pom</url><distribution>repo</distribution></license></licenses>
  <properties><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.12-m3-source-1</version><optional>true</optional><!-- source module --></dependency>
    <dependency><groupId>avalon-framework</groupId><artifactId>avalon-framework</artifactId><version>4.1.5</version><scope>provided</scope><optional>true</optional><!-- binary build input for an optional adapter (BUILD_INPUTS.tsv) --></dependency>
    <dependency><groupId>logkit</groupId><artifactId>logkit</artifactId><version>2.0</version><scope>provided</scope><optional>true</optional><!-- binary build input for an optional adapter (BUILD_INPUTS.tsv) --></dependency>
    <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId><version>2.23.1</version><scope>provided</scope><optional>true</optional><!-- binary build input for an optional adapter (BUILD_INPUTS.tsv) --></dependency>
    <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-1.2-api</artifactId><version>2.23.1</version><scope>provided</scope><optional>true</optional><!-- binary build input for an optional adapter (BUILD_INPUTS.tsv) --></dependency>
    <dependency><groupId>javax.servlet</groupId><artifactId>javax.servlet-api</artifactId><version>4.0.1</version><scope>provided</scope><optional>true</optional><!-- binary build input for an optional adapter (BUILD_INPUTS.tsv) --></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.basedir}</directory><targetPath>META-INF/third-party/commons-logging</targetPath><includes><include>LICENSE</include><include>PROVENANCE.json</include><include>THIRD_PARTY_NOTICES.md</include></includes></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
        <!-- Upstream bytes are compiled as published: no annotation processing, no warnings-as-errors. M3jdk21 integration is checked separately with -Werror. -->
        <configuration><release>8</release><encoding>UTF-8</encoding><proc>none</proc><compilerArgs><arg>-Xlint:all,-options</arg></compilerArgs></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version>
        <!-- Published sources jars carry no test suite; the compile and the consumers' own tests are the proof lane. -->
        <configuration><skipTests>true</skipTests></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version>
        <configuration><excludes><exclude>META-INF/jpms.args</exclude></excludes><archive><manifestEntries><Automatic-Module-Name>org.apache.commons.logging</Automatic-Module-Name><Multi-Release>true</Multi-Release></manifestEntries></archive></configuration>
      </plugin>
      <plugin><groupId>org.moditect</groupId><artifactId>moditect-maven-plugin</artifactId><version>1.2.2.Final</version>
        <!-- descriptors upstream generates in its build, assembled from the declaration in src/main/descriptor -->
        <executions><execution><id>add-module-info-9</id><phase>package</phase><goals><goal>add-module-info</goal></goals><configuration><jvmVersion>9</jvmVersion><overwriteExistingFiles>true</overwriteExistingFiles><failOnWarning>false</failOnWarning><version>1.3.2</version><module><moduleInfoFile>${project.basedir}/src/main/descriptor/9/module-info.java</moduleInfoFile></module></configuration></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
