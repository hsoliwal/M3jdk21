<!-- SPDX-License-Identifier: Apache-2.0; build integration only, upstream source remains LGPL-2.1-or-later. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.java.dev.jna</groupId><artifactId>jna</artifactId><version>5.18.1-m3-source-1</version>
  <name>jna 5.18.1 - unchanged upstream source build for M3jdk21</name>
  <description>Source inclusion of the published net.java.dev.jna:jna:5.18.1 sources jar (SHA-1 4bd8a21c9bfd90ed0b4d8780308b67e0ace998a3); no upstream implementation changes. See PROVENANCE.json.</description>
  <url>https://github.com/java-native-access/jna</url>
  <licenses><license><name>LGPL-2.1-or-later</name><url>https://repo.maven.apache.org/maven2/net/java/dev/jna/jna/5.18.1/jna-5.18.1.pom</url><distribution>repo</distribution></license></licenses>
  <properties><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.basedir}</directory><targetPath>META-INF/third-party/jna-5.18.1</targetPath><includes><include>LICENSE</include><include>PROVENANCE.json</include><include>THIRD_PARTY_NOTICES.md</include></includes></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
        <!-- Upstream bytes are compiled as published: no annotation processing, no warnings-as-errors. M3jdk21 integration is checked separately with -Werror. -->
        <configuration><release>8</release><encoding>UTF-8</encoding><proc>none</proc><compilerArgs><arg>-Xlint:all,-options</arg></compilerArgs></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version>
        <!-- Published sources jars carry no test suite; the compile and the consumers' own tests are the proof lane. -->
        <configuration><skipTests>true</skipTests></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version>
        <configuration><excludes><exclude>META-INF/jpms.args</exclude></excludes><archive><manifestEntries><Automatic-Module-Name>com.sun.jna</Automatic-Module-Name></manifestEntries></archive></configuration>
      </plugin>
    </plugins>
  </build>
</project>
