<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.openrewrite</groupId><artifactId>rewrite-core</artifactId><version>8.17.1-m3-source-1</version>
  <name>rewrite-core 8.17.1 - unchanged upstream source build for M3jdk21</name>
  <description>Source inclusion of the published org.openrewrite:rewrite-core:8.17.1 sources jar (SHA-1 641a1ece612dd2f8117113ffd257b68e964c26cc); no upstream implementation changes. See PROVENANCE.json.</description>
  <url>https://github.com/openrewrite/rewrite</url>
  <licenses><license><name>The Apache Software License, Version 2.0</name><url>https://repo.maven.apache.org/maven2/org/openrewrite/rewrite-core/8.17.1/rewrite-core-8.17.1.pom</url><distribution>repo</distribution></license></licenses>
  <properties><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
    <dependency><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId><version>24.1.0-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>io.github.classgraph</groupId><artifactId>classgraph</artifactId><version>4.8.165-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>org.apache.commons</groupId><artifactId>commons-compress</artifactId><version>1.26.0-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>io.quarkus.gizmo</groupId><artifactId>gizmo</artifactId><version>1.0.11.Final-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-annotations</artifactId><version>2.16.1-m3-source-1</version><optional>true</optional><!-- source module --></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-core</artifactId><version>2.16.1-m3-source-1</version><optional>true</optional><!-- source module --></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.16.1-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-smile</artifactId><version>2.16.1-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId><version>2.16.1-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>com.fasterxml.jackson.module</groupId><artifactId>jackson-module-parameter-names</artifactId><version>2.16.1-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>org.openrewrite.tools</groupId><artifactId>java-object-diff</artifactId><version>1.0.1-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>net.java.dev.jna</groupId><artifactId>jna</artifactId><version>5.14.0-m3-source-1</version><optional>true</optional><!-- source module --></dependency>
    <dependency><groupId>net.java.dev.jna</groupId><artifactId>jna-platform</artifactId><version>5.14.0-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>com.google.code.findbugs</groupId><artifactId>jsr305</artifactId><version>3.0.2-m3-source-1</version><optional>true</optional><!-- source module --></dependency>
    <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-core</artifactId><version>1.9.17-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>org.eclipse.jgit</groupId><artifactId>org.eclipse.jgit</artifactId><version>5.13.3.202401111512-r-m3-source-1</version><optional>true</optional><!-- source module --></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>1.7.36-m3-source-1</version><optional>true</optional><!-- source module --></dependency>
    <dependency><groupId>org.yaml</groupId><artifactId>snakeyaml</artifactId><version>2.2-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>com.squareup.okhttp3</groupId><artifactId>okhttp</artifactId><version>4.9.3</version><scope>provided</scope><optional>true</optional><!-- binary build input for an optional adapter (BUILD_INPUTS.tsv) --></dependency>
    <dependency><groupId>com.squareup.okio</groupId><artifactId>okio</artifactId><version>2.8.0</version><scope>provided</scope><optional>true</optional><!-- binary build input for an optional adapter (BUILD_INPUTS.tsv) --></dependency>
    <dependency><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId><version>1.4.10</version><scope>provided</scope><optional>true</optional><!-- binary build input for an optional adapter (BUILD_INPUTS.tsv) --></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.basedir}</directory><targetPath>META-INF/third-party/rewrite-core</targetPath><includes><include>LICENSE</include><include>PROVENANCE.json</include><include>THIRD_PARTY_NOTICES.md</include></includes></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
        <!-- Upstream bytes are compiled as published: no annotation processing, no warnings-as-errors. M3jdk21 integration is checked separately with -Werror. -->
        <configuration><release>17</release><encoding>UTF-8</encoding><proc>none</proc><compilerArgs><arg>-Xlint:all,-options</arg></compilerArgs></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version>
        <!-- Published sources jars carry no test suite; the compile and the consumers' own tests are the proof lane. -->
        <configuration><skipTests>true</skipTests></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version>
        <configuration><excludes><exclude>META-INF/jpms.args</exclude></excludes><archive><manifestEntries><M3jdk21-Source-Inline>no upstream Automatic-Module-Name</M3jdk21-Source-Inline></manifestEntries></archive></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version>
        <!-- upstream shadow task reproduced: include and relocate exactly what the published jar shades -->
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration><createDependencyReducedPom>true</createDependencyReducedPom><artifactSet><includes><include>org.eclipse.jgit:org.eclipse.jgit</include></includes></artifactSet><relocations><relocation><pattern>org.eclipse.jgit</pattern><shadedPattern>org.openrewrite.shaded.jgit</shadedPattern></relocation></relocations><filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/maven/**</exclude><exclude>module-info.class</exclude></excludes></filter></filters></configuration></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
