<!-- SPDX-License-Identifier: Apache-2.0; build integration only, upstream source remains UNDECLARED (see LICENSE). -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.antlr</groupId><artifactId>antlr4-runtime</artifactId><version>4.13.2-m3-source-1</version>
  <name>antlr4-runtime 4.13.2 - unchanged upstream source build for M3jdk21</name>
  <description>Source inclusion of the published org.antlr:antlr4-runtime:4.13.2 sources jar (SHA-1 391aff23db4000ad7a2fa02e182a3767f659c38d); no upstream implementation changes. See PROVENANCE.json.</description>
  <url>https://repo.maven.apache.org/maven2/org/antlr/antlr4-runtime/4.13.2/</url>
  <licenses><license><name>UNDECLARED (see LICENSE)</name><url>https://repo.maven.apache.org/maven2/org/antlr/antlr4-runtime/4.13.2/antlr4-runtime-4.13.2.pom</url><distribution>repo</distribution></license></licenses>
  <properties><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.basedir}</directory><targetPath>META-INF/third-party/antlr4-runtime-4.13.2</targetPath><includes><include>LICENSE</include><include>PROVENANCE.json</include><include>THIRD_PARTY_NOTICES.md</include></includes></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
        <!-- Upstream bytes are compiled as published: no annotation processing, no warnings-as-errors. M3jdk21 integration is checked separately with -Werror. -->
        <configuration><release>8</release><encoding>UTF-8</encoding><proc>none</proc><compilerArgs><arg>-Xlint:all,-options</arg></compilerArgs></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version>
        <!-- Published sources jars carry no test suite; the compile and the consumers' own tests are the proof lane. -->
        <configuration><skipTests>true</skipTests></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version>
        <configuration><excludes><exclude>META-INF/jpms.args</exclude></excludes><archive><manifestEntries><Automatic-Module-Name>org.antlr.antlr4.runtime</Automatic-Module-Name></manifestEntries></archive></configuration>
      </plugin>
    </plugins>
  </build>
</project>
