<!-- SPDX-License-Identifier: Apache-2.0; build integration only, upstream source remains The Apache Software License, Version 2.0. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.fasterxml.jackson.core</groupId>
  <artifactId>jackson-core</artifactId>
  <version>2.15.3-m3-source-1</version>
  <name>jackson-core 2.15.3 - upstream source build for M3jdk21, numbers parsed by java.base</name>
  <description>Source inclusion of the published com.fasterxml.jackson.core:jackson-core:2.15.3 sources jar (SHA-1 0e275b6eae6b6c71083b0305b8aeaaf72e36a2ca); one M3 overlay, JACKSON_NUMBERS_TO_JDK v1: NumberInput, BigDecimalParser and BigIntegerParser call java.base instead of the shaded FastDoubleParser. See PROVENANCE.json and OVERLAY_SOURCES.json.</description>
  <url>https://github.com/FasterXML/jackson-core</url>
  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>https://repo.maven.apache.org/maven2/com/fasterxml/jackson/core/jackson-core/2.15.3/jackson-core-2.15.3.pom</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF/third-party/jackson-core-2.15.3</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>PROVENANCE.json</include>
          <include>THIRD_PARTY_NOTICES.md</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <!-- Upstream bytes are compiled as published: no annotation processing, no warnings-as-errors. M3JDK 21 integration is checked separately with -Werror. -->
        <configuration>
          <release>8</release>
          <encoding>UTF-8</encoding>
          <proc>none</proc>
          <compilerArgs>
            <arg>-Xlint:all,-options</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <!-- Published sources jars carry no test suite; the compile and the consumers' own tests are the proof lane. -->
        <configuration>
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <excludes>
            <exclude>META-INF/jpms.args</exclude>
          </excludes>
          <archive>
            <manifestEntries>
              <M3jdk21-Source-Inline>no upstream Automatic-Module-Name</M3jdk21-Source-Inline>
              <Multi-Release>true</Multi-Release>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <!-- the published pom's shade configuration, verbatim -->
        <executions>
          <execution>
            <id>shade-jackson-core</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <relocations>
                <relocation>
                  <pattern>META-INF/LICENSE</pattern>
                  <shadedPattern>META-INF/FastDoubleParser-LICENSE</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>META-INF/NOTICE</pattern>
                  <shadedPattern>META-INF/FastDoubleParser-NOTICE</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>META-INF/jackson-core-LICENSE</pattern>
                  <shadedPattern>META-INF/LICENSE</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>META-INF/jackson-core-NOTICE</pattern>
                  <shadedPattern>META-INF/NOTICE</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <promoteTransitiveDependencies>true</promoteTransitiveDependencies>
          <createDependencyReducedPom>true</createDependencyReducedPom>
          <minimizeJar>true</minimizeJar>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.moditect</groupId>
        <artifactId>moditect-maven-plugin</artifactId>
        <version>1.2.2.Final</version>
        <!-- descriptors upstream generates in its build, assembled from the declaration in src/main/descriptor -->
        <executions>
          <execution>
            <id>add-module-info-9</id>
            <phase>package</phase>
            <goals>
              <goal>add-module-info</goal>
            </goals>
            <configuration>
              <jvmVersion>9</jvmVersion>
              <overwriteExistingFiles>true</overwriteExistingFiles>
              <failOnWarning>false</failOnWarning>
              <version>2.15.3</version>
              <module>
                <moduleInfoFile>${project.basedir}/src/main/descriptor/9/module-info.java</moduleInfoFile>
              </module>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
