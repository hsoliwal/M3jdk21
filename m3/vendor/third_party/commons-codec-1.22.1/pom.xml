<!-- SPDX-License-Identifier: Apache-2.0; build integration only, upstream source remains Apache License, Version 2.0 (from the license text; pom declares none). -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>commons-codec</groupId><artifactId>commons-codec</artifactId><version>1.22.1-m3-source-1</version>
  <name>commons-codec 1.22.1 - unchanged upstream source build for M3jdk21</name>
  <description>Source inclusion of the published commons-codec:commons-codec:1.22.1 sources jar (SHA-1 ebb7cc57bf07da8a3a82eac77691edd5a2786f4d); no upstream implementation changes. See PROVENANCE.json.</description>
  <url>https://commons.apache.org/proper/commons-codec/</url>
  <licenses><license><name>Apache License, Version 2.0 (from the license text; pom declares none)</name><url>https://repo.maven.apache.org/maven2/commons-codec/commons-codec/1.22.1/commons-codec-1.22.1.pom</url><distribution>repo</distribution></license></licenses>
  <properties><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.basedir}</directory><targetPath>META-INF/third-party/commons-codec-1.22.1</targetPath><includes><include>LICENSE</include><include>PROVENANCE.json</include><include>THIRD_PARTY_NOTICES.md</include></includes></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
        <!-- Upstream bytes are compiled as published: no annotation processing, no warnings-as-errors. M3jdk21 integration is checked separately with -Werror. -->
        <configuration><release>8</release><encoding>UTF-8</encoding><proc>none</proc><compilerArgs><arg>-Xlint:all,-options</arg></compilerArgs></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version>
        <!-- Published sources jars carry no test suite; the compile and the consumers' own tests are the proof lane. -->
        <configuration><skipTests>true</skipTests></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version>
        <configuration><excludes><exclude>META-INF/jpms.args</exclude></excludes><archive><manifestEntries><Automatic-Module-Name>org.apache.commons.codec</Automatic-Module-Name></manifestEntries></archive></configuration>
      </plugin>
    </plugins>
  </build>
</project>
