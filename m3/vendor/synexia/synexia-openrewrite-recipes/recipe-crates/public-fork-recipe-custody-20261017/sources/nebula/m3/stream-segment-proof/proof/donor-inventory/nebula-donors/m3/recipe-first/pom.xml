<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: EPL-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.eclipse.nebula.m3</groupId>
  <artifactId>nebula-m3-recipe-first</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Nebula M3 Recipe First</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rewrite.version>8.90.4</rewrite.version>
    <rewrite.maven.plugin.version>6.46.1</rewrite.maven.plugin.version>
    <junit.version>5.10.1</junit.version>
    <m3.nebula.root>${project.basedir}/../..</m3.nebula.root>
    <m3.nebula.out>${project.build.directory}/nebula-m3-inventory</m3.nebula.out>
    <m3.nebula.dag.out>${project.build.directory}/nebula-m3-dag</m3.nebula.dag.out>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.synexia.recipe</groupId>
      <artifactId>openrewrite-line-terminators</artifactId>
      <version>8.90.4-m3-f3e4bfe19654</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-core</artifactId>
      <version>${rewrite.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java</artifactId>
      <version>${rewrite.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java-21</artifactId>
      <version>${rewrite.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-test</artifactId>
      <version>${rewrite.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <release>21</release>
          <proc>none</proc>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>source-seal</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.1</version>
            <executions>
              <execution>
                <id>nebula-m3-verbatim-source-seal</id>
                <phase>verify</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>org.eclipse.nebula.m3.rewrite.exact.NebulaM3VerbatimSourceSeal</mainClass>
                  <arguments>
                    <argument>${m3.seal.root}</argument>
                    <argument>${m3.seal.path}</argument>
                    <argument>${m3.seal.sha256}</argument>
                  </arguments>
                  <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>inventory</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.1</version>
            <executions>
              <execution>
                <id>nebula-m3-inventory</id>
                <phase>verify</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>org.eclipse.nebula.m3.NebulaM3InventoryCli</mainClass>
                  <arguments>
                    <argument>${m3.nebula.root}</argument>
                    <argument>${m3.nebula.out}</argument>
                  </arguments>
                  <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>dag-manifest</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.1</version>
            <executions>
              <execution>
                <id>nebula-m3-dag-manifest</id>
                <phase>verify</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>org.eclipse.nebula.m3.rewrite.convergence.NebulaM3RecipeDagManifestCli</mainClass>
                  <arguments>
                    <argument>${m3.nebula.dag.out}</argument>
                  </arguments>
                  <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
