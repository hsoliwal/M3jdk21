<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: EPL-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.eclipse.nebula.m3</groupId>
  <artifactId>nebula-m3-compile-bootstrap</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <m3.bootstrap.root>${project.basedir}/../..</m3.bootstrap.root>
  </properties>
  <dependencies>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-core</artifactId><version>8.89.0</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java</artifactId><version>8.89.0</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java-21</artifactId><version>8.89.0</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.1</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${project.basedir}/target/compile-bootstrap</directory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
        <configuration>
          <release>21</release><proc>none</proc>
          <compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs>
          <includes>
            <include>org/eclipse/nebula/m3/rewrite/exact/NebulaM3ExactJavaSnapshotRecipe.java</include>
            <include>org/eclipse/nebula/m3/rewrite/exact/NebulaM3CompileBootstrapRecipe.java</include>
            <include>org/eclipse/nebula/m3/rewrite/exact/NebulaM3CompileBootstrapApply.java</include>
            <include>org/eclipse/nebula/m3/rewrite/exact/NebulaM3VerbatimSourceSeal.java</include>
          </includes>
          <testIncludes><testInclude>org/eclipse/nebula/m3/rewrite/exact/NebulaM3CompileBootstrapRecipeTest.java</testInclude></testIncludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version>
        <configuration><useModulePath>false</useModulePath><failIfNoTests>true</failIfNoTests></configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>apply</id>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.1</version>
        <executions><execution>
          <id>apply-tested-compilation-recipe</id><phase>verify</phase><goals><goal>java</goal></goals>
          <configuration>
            <mainClass>org.eclipse.nebula.m3.rewrite.exact.NebulaM3CompileBootstrapApply</mainClass>
            <arguments><argument>${m3.bootstrap.root}</argument></arguments>
          </configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
