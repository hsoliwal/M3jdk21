<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.synexia.rewrite.qualification</groupId>
  <artifactId>collections-package-import-rename</artifactId>
  <version>20261018</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rewrite.version>8.17.1</rewrite.version>
    <rewrite.java21.version>${rewrite.version}</rewrite.java21.version>
    <m3.require.snippet.support>false</m3.require.snippet.support>
    <m3.build.directory>${project.basedir}/target</m3.build.directory>
  </properties>
  <dependencies>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.13</version></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>2.0.13</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java-21</artifactId><version>${rewrite.java21.version}</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-xml</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-yaml</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.2</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${m3.build.directory}</directory>
    <sourceDirectory>../../src/main/java</sourceDirectory>
    <testSourceDirectory>../../src/test/java</testSourceDirectory>
    <testResources><testResource><directory>../../src/test/resources</directory><includes><include>com/synexia/rewrite/collections-package-import-rename/**</include></includes></testResource></testResources>
    <resources><resource><directory>../../src/main/resources</directory></resource></resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version><configuration>
        <proc>none</proc>
        <includes>
          <include>com/synexia/rewrite/M3CollectionsPackageRename*.java</include>
          <include>com/synexia/rewrite/M3HashPinnedPomSnapshotRecipe.java</include>
          <include>com/synexia/rewrite/M3HashPinnedTextSnapshotRecipe.java</include>
          <include>com/synexia/rewrite/M3HashPinnedJavaSnapshotRecipe.java</include>
          <include>com/synexia/rewrite/M3EditScope.java</include>
          <include>com/synexia/rewrite/M3ScopeInference.java</include>
        </includes>
        <testIncludes><testInclude>com/synexia/rewrite/M3CollectionsPackageRename*Test.java</testInclude></testIncludes>
        <compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs>
      </configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version><configuration><useModulePath>false</useModulePath><systemPropertyVariables><m3.require.snippet.support>${m3.require.snippet.support}</m3.require.snippet.support></systemPropertyVariables></configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version></plugin>
    </plugins>
  </build>
  <profiles>
    <!-- Qualification-only provider correction. Canonical root dependency pins are unchanged. -->
    <profile><id>guava-provider-8.90.4-source-fidelity</id><properties><rewrite.version>8.90.4</rewrite.version><rewrite.java21.version>8.90.4-m3-varargs-doc-anchors-20261018</rewrite.java21.version><m3.require.snippet.support>true</m3.require.snippet.support></properties></profile>
  </profiles>
</project>
