<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.synexia.m3scale</groupId>
  <artifactId>m3-convergence-validation</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>M3 Code Convergence Validation</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <lucene.version>9.9.2</lucene.version>
    <slf4j.version>2.0.16</slf4j.version>
    <lombok.version>1.18.36</lombok.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-core</artifactId>
      <version>${lucene.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-analysis-common</artifactId>
      <version>${lucene.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <testSourceDirectory>src/test/java</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <includes>
            <include>com/synexia/m3scale/inventory/FileEntry.java</include>
            <include>com/synexia/m3scale/catalog/IGlobalFileCatalog.java</include>
            <include>com/synexia/m3scale/catalog/InMemoryCatalog.java</include>
            <include>com/synexia/m3scale/dedup/ClusterType.java</include>
            <include>com/synexia/m3scale/dedup/DuplicateCluster.java</include>
            <include>com/synexia/m3scale/dedup/DedupEngine.java</include>
            <include>com/synexia/m3scale/convergence/**/*.java</include>
            <include>com/synexia/m3scale/merge/**/*.java</include>
          </includes>
          <testIncludes>
            <testInclude>com/synexia/m3scale/convergence/**/*.java</testInclude>
            <testInclude>com/synexia/m3scale/merge/**/*.java</testInclude>
          </testIncludes>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
