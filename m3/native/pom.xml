<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId>
  <artifactId>m3-native</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>M3JDK :: Native JNI Leases</name>
  <description>jdk.m3.jni (module org.m3jdk.jni): the DOOP scoped-lease table family. M3ScopedLeaseTable (explicit
    leases, pins, pool pin lane and per-ID JNI borrow lane over primitive arrays), M3NativeLeaseScan (Java/JNI parity
    kernel, optional library m3_scoped_leases), M3LeaseScopes, M3LeaseWindowScan, M3JniArrayReferences and
    M3JniByteConcat. Java 21; depends on jdk.m3.util.M3RuntimeHeap (m3/ports/collections) for amortized growth. The
    JNI library under src/main/native is built by its CMakeLists.txt (javac -h headers, C17) and loaded at run time
    through System.loadLibrary; every Java path is exact without it, and the native-required proofs refuse to pass
    without it. Relocated by recipe (recipe/scoped-leases-20261106/relocate.py, RELOCATION_MAP.tsv, PROVENANCE.tsv)
    from the donor hsoliwal/com.synexia develop 64652588f0d4; the donor's thirteen tests and the parity probe run
    or are skipped by assumption in the test phase.</description>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.artifact.version>5.11.4</junit.artifact.version>
  </properties>
  <dependencies>
    <dependency>
      <!-- jdk.m3.collections.M3RuntimeHeap, the one M3JDK owner of amortized capacity choice (m3/collections) -->
      <groupId>com.m3</groupId>
      <artifactId>m3-collections</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.artifact.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <proc>none</proc>
          <compilerArgs>
            <!-- every lint, warnings are errors, with two exceptions: requires-automatic is off because the
                 M3RuntimeHeap owner artifact has no module descriptor yet (automatic module m3.collection.port.wave1,
                 see module-info.java); missing-explicit-ctor is off because M3ScopedLeaseTable is relocated byte for
                 byte from the donor, whose implicit public constructor is its actual API (an explicit constructor
                 belongs to the donor's next revision, see RECIPE_MEMORY.tsv) -->
            <arg>-Xlint:all,-requires-automatic,-missing-explicit-ctor</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <!-- the tests are classpath code: the code-carrier oracle uses javax.tools (java.compiler), which the
                   module does not require; surefire runs them on the classpath as well -->
              <useModulePath>false</useModulePath>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <!-- the self-tests are plain mains wrapped by JUnit; classpath run, the module descriptor is for consumers -->
          <useModulePath>false</useModulePath>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
    </plugins>
  </build>
</project>
