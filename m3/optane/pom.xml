<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId>
  <artifactId>m3-optane</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>M3JDK :: Optane</name>
  <description>jdk.m3.optane (module org.m3jdk.optane): Memory Mode planning (MemoryModeProfile, ScanPlan,
    ProgressMonitor), mapped-read advice (MappedReadAdvice, optional Linux JNI library m3optane) and the fail-closed,
    file-backed persistent-memory region family M3PmemSdk, M3PmemRegion, M3PmemMapping, M3PmemTransfer, M3PmemSearch
    (FILE backend in pure Java; POSIX and optional PMDK backends through the JNI library m3pmemsdk, C17, Linux). Java
    21, no dependency outside java.base. The JNI libraries under src/main/native are built by their CMakeLists.txt
    (option M3_OPTANE_PMDK, default OFF: libpmem2 is never required and never shipped) and loaded at run time through
    System.loadLibrary; every FILE path is exact without them. The PMem family is relocated by recipe
    (recipe/pmem-region-core-20261106/relocate.py, RELOCATION_MAP.tsv, PROVENANCE.tsv) from the donor
    hsoliwal/com.synexia m3-pmem-sdk; its JUnit oracles run in the test phase (the native lanes only with the
    profile m3-optane-native and the library on java.library.path).</description>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.artifact.version>5.11.4</junit.artifact.version>
    <!-- directory holding libm3pmemsdk.so (and libm3optane.so); the CMake project's build directory -->
    <m3.optane.library.path>${project.build.directory}/native</m3.optane.library.path>
    <!-- the native lanes of the donor oracles: the 19 POSIX atoms, the KMP prefix test and the three FILE-oracle
         methods that also open a POSIX region; excluded (surefire test filter, the only parameter that takes method
         patterns) unless the profile m3-optane-native supplies the library -->
    <m3.optane.test.filter>!M3PmemAtomCorrectnessJUnitTest, !M3PmemNativeKmpPrefix32JUnitTest, !M3PmemFileBackendJUnitTest#randomizedSearchTransferAndNativeDifferential+overlappingMemmoveAliasesAndFileToFile+pathReplacementDoesNotBypassAliasRefusal</m3.optane.test.filter>
    <!-- the oracles write sparse files above 2 GiB (NTFS fills the gap): temporary files go next to the build output,
         never to the system temporary directory -->
    <m3.optane.surefire.argLine>-Djava.io.tmpdir=${project.build.directory} -Djava.library.path=${m3.optane.library.path}</m3.optane.surefire.argLine>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.artifact.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <proc>none</proc>
          <compilerArgs>
            <!-- every lint, warnings are errors: the same gate as m3/optane/verify.sh before the family arrived -->
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <!-- the donor oracles are classpath code in the owners' package (the donor ran them on the classpath
                   of its named module too); surefire runs them on the classpath as well -->
              <useModulePath>false</useModulePath>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <trimStackTrace>false</trimStackTrace>
          <argLine>${m3.optane.surefire.argLine}</argLine>
          <test>${m3.optane.test.filter}</test>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- the native lanes (Linux, libm3pmemsdk.so built by src/main/native/CMakeLists.txt into
           ${m3.optane.library.path}): mvn -Pm3-optane-native -Dm3.optane.library.path=DIR -f m3/optane/pom.xml test -->
      <id>m3-optane-native</id>
      <properties>
        <m3.optane.test.filter>*Test</m3.optane.test.filter>
        <m3.optane.surefire.argLine>-Xcheck:jni -Djava.io.tmpdir=${project.build.directory} -Djava.library.path=${m3.optane.library.path}</m3.optane.surefire.argLine>
      </properties>
    </profile>
    <profile>
      <!-- the JMOD/jlink verifier (verify.sh: javac, C17 JNI on Linux, jar, jmod, jlink, linked-image contracts);
           it was the module's whole build before the family arrived and needs a full JDK 21 with jmods -->
      <id>m3-optane-jmod</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>java-jni-jmod-contracts</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>bash</executable>
                  <arguments>
                    <argument>${project.basedir}/verify.sh</argument>
                  </arguments>
                  <environmentVariables>
                    <M3_OPTANE_BUILD>${project.build.directory}/verified</M3_OPTANE_BUILD>
                  </environmentVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
