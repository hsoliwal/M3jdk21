  "reviewed_interpretations": {
    "process_compiler_file_write_temp_network_property_mutation": "No matched occurrence in current Java/C/header sources; lexical absence is not a whole-OS effect oracle.",
    "native_main_loaders": "Nine exact names; all catch UnsatisfiedLinkError, rank and signal additionally require explicit opt-in properties. No native path is overridden. A new stock-JDK properties preflight must bind actual search directories and prove named candidates absent before Maven.",
    "standalone_loads": "M3BitLaneJumpProof and M3MaskViewportKernelContract contain System.load guarded by explicit main argument or m3.native.path. No reference to either class occurs outside its own file in the current Java source set; neither is default Surefire-named or annotated as a JUnit test.",
    "native_test_assumptions": "M3FilteredSplitsMaskSpansTest guards checked-JNI/all-native cases with m3.mask.spans.native.required and m3.collections.all.native.required. m3bitlane load follows the latter. Actual skips and reasons remain pending JNI coverage.",
    "other_native_branches": "Rank/signal opt-ins, m3.address.required, m3.interop.requireNative, all-native branches retain source-authored defaults. Some native backends select Java when unavailable; no all-native coverage is claimed.",
    "residency": "M3ObjectResidency SpillStore is an injected interface; the current test uses an in-memory HashMap store or deliberate IOException, not disk I/O. HeapSnapshot and RuntimePressureTest observe running JVM heap metrics.",
    "serialization": "java.io imports in collection implementations and GenericArrayListSelfTest are object/byte-array serialization, not filesystem output constructors.",
    "resource_reads": "M3CollectionSdkNames reads /com/m3/collections/M3_SDK_FAMILY_CATALOG.tsv from classpath; ObjectResidencyTest reads its generated annotation class as a resource. Current POM root-resource list replaces default src/main/resources, so missing catalogue may cause a legitimate unchanged-suite failure; no repair/exclusion is authorized by this plan.",
    "reflection": "Class.forName sites refer to current collection classes or a fixed JDK type list; no source URLClassLoader or ServiceLoader match. Reflection is retained, not rewritten or excluded."
  },
