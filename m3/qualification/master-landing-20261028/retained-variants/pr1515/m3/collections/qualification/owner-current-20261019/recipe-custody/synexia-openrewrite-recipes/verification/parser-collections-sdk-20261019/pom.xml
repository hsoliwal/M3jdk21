<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-FileCopyrightText: 2026 Hitesh Soliwal and Contributors to the Synexia Project -->
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.synexia.verification</groupId><artifactId>parser-collections-sdk</artifactId><version>1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rewrite.version>8.17.1</rewrite.version><junit.version>5.10.2</junit.version>
    <proof.directory>${project.basedir}/target</proof.directory>
    <m3.crate>m3-collections-owner-current-20261019</m3.crate>
    <m3.recipe>com.synexia.m3.CollectionsOwnerCurrent20261019</m3.recipe>
  </properties>
  <dependencies>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-core</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java-21</artifactId><version>${rewrite.version}</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.13</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${proof.directory}</directory>
    <sourceDirectory>${project.basedir}/../../src/main/java</sourceDirectory>
    <testSourceDirectory>${project.basedir}/../../src/test/java</testSourceDirectory>
    <resources><resource><directory>${project.basedir}/../../src/main/resources</directory><includes>
      <include>META-INF/rewrite/m3-parser-collections-20261019.yml</include>
      <include>com/synexia/rewrite/hash-pinned-java/${m3.crate}/**</include>
      <include>com/synexia/rewrite/hash-pinned-text/${m3.crate}/**</include>
    </includes></resource></resources>
    <testResources><testResource><directory>${project.basedir}/../../src/test/resources</directory><includes>
      <include>com/synexia/rewrite/hash-pinned-java/jdt-dom-layout*-20261019/**</include>
      <include>com/synexia/rewrite/hash-pinned-text/in-memory-recipe-contract-v1/**</include>
      <include>com/synexia/rewrite/hash-pinned-text/in-memory-duplicate-manifest-v1/**</include>
      <include>com/synexia/rewrite/hash-pinned-text/jdt-java21-bootstrap-refusal-20261019/**</include>
      <include>com/synexia/rewrite/jdt-java21-bootstrap-20261019/**</include>
    </includes></testResource></testResources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
        <configuration><release>21</release><proc>none</proc><parameters>true</parameters>
          <compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs>
          <includes>
            <include>com/synexia/rewrite/M3HashPinnedJavaSnapshotRecipe.java</include>
            <include>com/synexia/rewrite/M3HashPinnedTextSnapshotRecipe.java</include>
            <include>com/synexia/rewrite/M3ScopeInference.java</include>
            <include>com/synexia/rewrite/M3EditScope.java</include>
          </includes>
          <testIncludes>
            <testInclude>com/synexia/rewrite/M3ParserCollectionsSdkTest.java</testInclude>
            <testInclude>com/synexia/rewrite/M3JdtDomSourceLayoutTest.java</testInclude>
            <testInclude>com/synexia/rewrite/M3HashPinnedTextSnapshotRecipeTest.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
        <configuration><useModulePath>false</useModulePath><failIfNoTests>true</failIfNoTests><argLine>-Xmx768m</argLine>
          <systemPropertyVariables>
            <sdk.output>${project.build.directory}/sdk-output</sdk.output>
            <sdk.rewrite.version>${rewrite.version}</sdk.rewrite.version><sdk.junit.version>${junit.version}</sdk.junit.version>
            <m3.crate>${m3.crate}</m3.crate><m3.recipe>${m3.recipe}</m3.recipe>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
