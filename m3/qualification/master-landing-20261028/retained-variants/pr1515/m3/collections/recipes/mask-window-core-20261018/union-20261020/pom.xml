<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <groupId>com.synexia.recipes</groupId><artifactId>m3-mask-window-current-20261020</artifactId><version>1.1-SNAPSHOT</version><packaging>pom</packaging>
 <name>M3 existing mask-window recipe: sorted and native span composition</name>
 <properties><m3.proof.out>${project.build.directory}/union-proof</m3.proof.out></properties>
 <build><plugins><plugin>
  <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.1</version>
  <executions><execution><id>qualify-source-composition</id><phase>verify</phase><goals><goal>exec</goal></goals>
   <configuration><executable>python3</executable><arguments><argument>${project.basedir}/verify.py</argument><argument>--out</argument><argument>${m3.proof.out}</argument></arguments></configuration>
  </execution></executions>
 </plugin></plugins></build>
</project>
