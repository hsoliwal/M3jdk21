<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3.tooling</groupId>
  <artifactId>m3-parser-jmod-pack</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>M3 parser source module and JMOD qualification</name>
  <description>Ordered source/compiler-overlay, contract and linked-image qualification.</description>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <m3.parser.jdk>${java.home}</m3.parser.jdk>
    <m3.parser.proof>${project.build.directory}/parser-proof</m3.parser.proof>
    <m3.parser.python>python3</m3.parser.python>
  </properties>
  <!-- The source-built compiler overlay is required. Maven's default compiler
       cannot compile the optional M3AST API against an unmodified stock JDK. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <executable>${m3.parser.python}</executable>
          <arguments>
            <argument>${project.basedir}/build.py</argument>
            <argument>--repo-root</argument><argument>${project.basedir}/../../../..</argument>
            <argument>--jdk-home</argument><argument>${m3.parser.jdk}</argument>
            <argument>--out</argument><argument>${m3.parser.proof}</argument>
          </arguments>
        </configuration>
        <executions>
          <execution>
            <id>parser-lint</id><phase>validate</phase><goals><goal>exec</goal></goals>
            <configuration><arguments combine.children="append"><argument>--phase</argument><argument>lint</argument></arguments></configuration>
          </execution>
          <execution>
            <id>parser-compile-all</id><phase>compile</phase><goals><goal>exec</goal></goals>
            <configuration><arguments combine.children="append"><argument>--phase</argument><argument>compile</argument></arguments></configuration>
          </execution>
          <execution>
            <id>parser-contracts</id><phase>test</phase><goals><goal>exec</goal></goals>
            <configuration><arguments combine.children="append"><argument>--phase</argument><argument>test</argument></arguments></configuration>
          </execution>
          <execution>
            <id>parser-jmod-runtime</id><phase>verify</phase><goals><goal>exec</goal></goals>
            <configuration><arguments combine.children="append"><argument>--phase</argument><argument>runtime</argument></arguments></configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
