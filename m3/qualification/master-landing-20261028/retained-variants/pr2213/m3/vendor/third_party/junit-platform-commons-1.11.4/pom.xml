<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.junit.platform</groupId><artifactId>junit-platform-commons</artifactId><version>1.11.4-m3-source-1</version>
  <name>junit-platform-commons 1.11.4 - unchanged upstream source build for M3jdk21</name>
  <description>Source inclusion of the published org.junit.platform:junit-platform-commons:1.11.4 sources jar (SHA-1 1acfe264ada9081bba59c937a8b0cae0619491bc); no upstream implementation changes. See PROVENANCE.json.</description>
  <url>https://junit.org/junit5/</url>
  <licenses><license><name>Eclipse Public License v2.0</name><url>https://repo.maven.apache.org/maven2/org/junit/platform/junit-platform-commons/1.11.4/junit-platform-commons-1.11.4.pom</url><distribution>repo</distribution></license></licenses>
  <properties><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
    <dependency><groupId>org.apiguardian</groupId><artifactId>apiguardian-api</artifactId><version>1.1.2-m3-source-1</version><!-- source module --></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.basedir}</directory><targetPath>META-INF/third-party/junit-platform-commons-1.11.4</targetPath><includes><include>LICENSE</include><include>PROVENANCE.json</include><include>THIRD_PARTY_NOTICES.md</include></includes></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
        <!-- Upstream bytes are compiled as published: no annotation processing, no warnings-as-errors. M3jdk21 integration is checked separately with -Werror. -->
        <configuration><release>8</release><encoding>UTF-8</encoding><proc>none</proc><compilerArgs><arg>-Xlint:all,-options</arg></compilerArgs></configuration>
        <executions><execution><id>multi-release-9</id><phase>process-classes</phase><goals><goal>compile</goal></goals><configuration><release>9</release><compileSourceRoots><compileSourceRoot>${project.basedir}/src/main/versions/9</compileSourceRoot></compileSourceRoots><multiReleaseOutput>true</multiReleaseOutput></configuration></execution><execution><id>module-descriptor-root</id><phase>process-classes</phase><goals><goal>compile</goal></goals><configuration><release>9</release><compileSourceRoots><compileSourceRoot>${project.basedir}/src/main/descriptor/root</compileSourceRoot></compileSourceRoots><multiReleaseOutput>false</multiReleaseOutput><moduleVersion>1.11.4</moduleVersion><compilerArgs><arg>--patch-module</arg><arg>org.junit.platform.commons=${project.build.outputDirectory}</arg></compilerArgs></configuration></execution></executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version>
        <!-- Published sources jars carry no test suite; the compile and the consumers' own tests are the proof lane. -->
        <configuration><skipTests>true</skipTests></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version>
        <configuration><excludes><exclude>META-INF/jpms.args</exclude></excludes><archive><manifestEntries><M3jdk21-Source-Inline>no upstream Automatic-Module-Name</M3jdk21-Source-Inline><Multi-Release>true</Multi-Release></manifestEntries></archive></configuration>
      </plugin>
    </plugins>
  </build>
</project>
