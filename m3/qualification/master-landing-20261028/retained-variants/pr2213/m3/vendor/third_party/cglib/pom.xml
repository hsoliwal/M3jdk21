<!-- SPDX-License-Identifier: Apache-2.0; build integration only, upstream source remains Apache License, Version 2.0 (from the license text; pom declares none). -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>cglib</groupId><artifactId>cglib</artifactId><version>3.3.0-m3-source-1</version>
  <name>cglib 3.3.0 - unchanged upstream source build for M3jdk21</name>
  <description>Source inclusion of the published cglib:cglib:3.3.0 sources jar (SHA-1 b9b848fda50c0ca9b80d5422f021d0755044d2d6); no upstream implementation changes. See PROVENANCE.json.</description>
  <url>https://repo.maven.apache.org/maven2/cglib/cglib/3.3.0/</url>
  <licenses><license><name>Apache License, Version 2.0 (from the license text; pom declares none)</name><url>https://repo.maven.apache.org/maven2/cglib/cglib/3.3.0/cglib-3.3.0.pom</url><distribution>repo</distribution></license></licenses>
  <properties><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
    <dependency><groupId>org.ow2.asm</groupId><artifactId>asm</artifactId><version>9.10.1-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>org.apache.ant</groupId><artifactId>ant</artifactId><version>1.10.14</version><scope>provided</scope><optional>true</optional><!-- binary build input for an optional adapter (BUILD_INPUTS.tsv) --></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.basedir}</directory><targetPath>META-INF/third-party/cglib</targetPath><includes><include>LICENSE</include><include>PROVENANCE.json</include><include>THIRD_PARTY_NOTICES.md</include></includes></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
        <!-- Upstream bytes are compiled as published: no annotation processing, no warnings-as-errors. M3jdk21 integration is checked separately with -Werror. -->
        <configuration><release>8</release><encoding>UTF-8</encoding><proc>none</proc><compilerArgs><arg>-Xlint:all,-options</arg></compilerArgs></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version>
        <!-- Published sources jars carry no test suite; the compile and the consumers' own tests are the proof lane. -->
        <configuration><skipTests>true</skipTests></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version>
        <configuration><excludes><exclude>META-INF/jpms.args</exclude></excludes><archive><manifestEntries><M3jdk21-Source-Inline>no upstream Automatic-Module-Name</M3jdk21-Source-Inline></manifestEntries></archive></configuration>
      </plugin>
    </plugins>
  </build>
</project>
