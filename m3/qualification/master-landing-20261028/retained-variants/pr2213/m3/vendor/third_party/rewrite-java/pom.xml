<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.openrewrite</groupId><artifactId>rewrite-java</artifactId><version>8.17.1-m3-source-1</version>
  <name>rewrite-java 8.17.1 - unchanged upstream source build for M3jdk21</name>
  <description>Source inclusion of the published org.openrewrite:rewrite-java:8.17.1 sources jar (SHA-1 3e97e633ecbada1bbdd4e3875b75a9b0d2d1d57c); no upstream implementation changes. See PROVENANCE.json.</description>
  <url>https://github.com/openrewrite/rewrite</url>
  <licenses><license><name>The Apache Software License, Version 2.0</name><url>https://repo.maven.apache.org/maven2/org/openrewrite/rewrite-java/8.17.1/rewrite-java-8.17.1.pom</url><distribution>repo</distribution></license></licenses>
  <properties><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
    <dependency><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId><version>24.1.0-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>org.antlr</groupId><artifactId>antlr4-runtime</artifactId><version>4.11.1-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>org.ow2.asm</groupId><artifactId>asm</artifactId><version>9.6-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>org.ow2.asm</groupId><artifactId>asm-util</artifactId><version>9.6-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>io.github.classgraph</groupId><artifactId>classgraph</artifactId><version>4.8.165-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>org.apache.commons</groupId><artifactId>commons-lang3</artifactId><version>3.14.0-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>org.apache.commons</groupId><artifactId>commons-text</artifactId><version>1.11.0-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>io.github.fastfilter</groupId><artifactId>fastfilter</artifactId><version>1.0.2-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-annotations</artifactId><version>2.16.1-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-core</artifactId><version>2.16.1-m3-source-1</version><optional>true</optional><!-- source module --></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.16.1-m3-source-1</version><optional>true</optional><!-- source module --></dependency>
    <dependency><groupId>com.fasterxml.jackson.module</groupId><artifactId>jackson-module-parameter-names</artifactId><version>2.16.1-m3-source-1</version><optional>true</optional><!-- source module --></dependency>
    <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-core</artifactId><version>1.9.17-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-core</artifactId><version>8.17.1-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-test</artifactId><version>8.17.1-m3-source-1</version><optional>true</optional><!-- source module --></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-xml</artifactId><version>8.17.1-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-yaml</artifactId><version>8.17.1-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>org.xerial.snappy</groupId><artifactId>snappy-java</artifactId><version>1.1.10.5-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>com.puppycrawl.tools</groupId><artifactId>checkstyle</artifactId><version>9.3</version><scope>provided</scope><optional>true</optional><!-- binary build input for an optional adapter (BUILD_INPUTS.tsv) --></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.basedir}</directory><targetPath>META-INF/third-party/rewrite-java</targetPath><includes><include>LICENSE</include><include>PROVENANCE.json</include><include>THIRD_PARTY_NOTICES.md</include></includes></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
        <!-- Upstream bytes are compiled as published: no annotation processing, no warnings-as-errors. M3jdk21 integration is checked separately with -Werror. -->
        <configuration><release>8</release><encoding>UTF-8</encoding><proc>none</proc><compilerArgs><arg>-Xlint:all,-options</arg></compilerArgs></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version>
        <!-- Published sources jars carry no test suite; the compile and the consumers' own tests are the proof lane. -->
        <configuration><skipTests>true</skipTests></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version>
        <configuration><excludes><exclude>META-INF/jpms.args</exclude></excludes><archive><manifestEntries><M3jdk21-Source-Inline>no upstream Automatic-Module-Name</M3jdk21-Source-Inline></manifestEntries></archive></configuration>
      </plugin>
    </plugins>
  </build>
</project>
