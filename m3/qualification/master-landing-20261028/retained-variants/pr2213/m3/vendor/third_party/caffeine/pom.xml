<!-- SPDX-License-Identifier: Apache-2.0; build integration only, upstream source remains Apache License, Version 2.0. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.github.ben-manes.caffeine</groupId><artifactId>caffeine</artifactId><version>3.1.8-m3-source-1</version>
  <name>caffeine 3.1.8 - unchanged upstream source build for M3jdk21</name>
  <description>Source inclusion of the published com.github.ben-manes.caffeine:caffeine:3.1.8 sources jar (SHA-1 352209f02df83046de6ebfd647b22d726ca3a954); no upstream implementation changes. See PROVENANCE.json.</description>
  <url>https://github.com/ben-manes/caffeine</url>
  <licenses><license><name>Apache License, Version 2.0</name><url>https://repo.maven.apache.org/maven2/com/github/ben-manes/caffeine/caffeine/3.1.8/caffeine-3.1.8.pom</url><distribution>repo</distribution></license></licenses>
  <properties><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
    <dependency><groupId>org.checkerframework</groupId><artifactId>checker-qual</artifactId><version>3.37.0-m3-source-1</version><!-- source module --></dependency>
    <dependency><groupId>com.google.errorprone</groupId><artifactId>error_prone_annotations</artifactId><version>2.21.1-m3-source-1</version><!-- source module --></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.basedir}</directory><targetPath>META-INF/third-party/caffeine</targetPath><includes><include>LICENSE</include><include>PROVENANCE.json</include><include>THIRD_PARTY_NOTICES.md</include></includes></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
        <!-- Upstream bytes are compiled as published: no annotation processing, no warnings-as-errors. M3jdk21 integration is checked separately with -Werror. -->
        <configuration><release>11</release><encoding>UTF-8</encoding><useModuleVersion>false</useModuleVersion><proc>none</proc><compilerArgs><arg>-Xlint:all,-options</arg></compilerArgs></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version>
        <!-- Published sources jars carry no test suite; the compile and the consumers' own tests are the proof lane. -->
        <configuration><skipTests>true</skipTests></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version>
        <configuration><excludes><exclude>META-INF/jpms.args</exclude></excludes><archive><manifestEntries><Automatic-Module-Name>com.github.benmanes.caffeine</Automatic-Module-Name></manifestEntries></archive></configuration>
      </plugin>
    </plugins>
  </build>
</project>
