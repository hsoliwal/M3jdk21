<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId>
  <artifactId>m3-tornadovm-bulk-adapter</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <tornadovm.version>7.2.0</tornadovm.version>
    <m3.gpu>false</m3.gpu>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.github.beehive-lab</groupId>
      <artifactId>tornado-api</artifactId>
      <version>${tornadovm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}-m3-source-1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF</targetPath>
        <includes><include>LICENSE</include><include>NOTICE</include></includes>
      </resource>
      <resource>
        <directory>${project.basedir}/source-custody</directory>
        <targetPath>META-INF/m3/source-custody</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>compile-m3-java-base-bulk-contract</id>
            <phase>generate-sources</phase>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/bulk-patch-src/jdk/internal/vm/parallel"/>
                <mkdir dir="${project.build.directory}/bulk-patch-classes"/>
                <copy todir="${project.build.directory}/bulk-patch-src/jdk/internal/vm/parallel">
                  <fileset dir="${project.basedir}/../../../src/java.base/share/classes/jdk/internal/vm/parallel">
                    <include name="BulkTask.java"/>
                    <include name="BulkExecutor.java"/>
                    <include name="BulkExecution.java"/>
                    <include name="BulkExecutorProvider.java"/>
                    <include name="BulkScheduler.java"/>
                  </fileset>
                </copy>
                <javac
                    srcdir="${project.build.directory}/bulk-patch-src"
                    destdir="${project.build.directory}/bulk-patch-classes"
                    source="21"
                    target="21"
                    includeantruntime="false"
                    encoding="UTF-8">
                  <compilerarg line="--patch-module java.base=${project.build.directory}/bulk-patch-src"/>
                  <compilerarg line="-Xlint:all -Werror"/>
                </javac>
              </target>
            </configuration>
            <goals><goal>run</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <source>21</source>
          <target>21</target>
          <proc>none</proc>
          <fork>true</fork>
          <enablePreview>true</enablePreview>
          <compilerArgs>
            <arg>--patch-module</arg>
            <arg>java.base=${project.build.directory}/bulk-patch-classes</arg>
            <arg>--add-exports</arg>
            <arg>java.base/jdk.internal.vm.parallel=jdk.m3.tornado,ALL-UNNAMED</arg>
            <arg>-Xlint:all,-preview,-module,-exports,-missing-explicit-ctor</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>--enable-preview --patch-module java.base=${project.build.directory}/bulk-patch-classes --add-exports java.base/jdk.internal.vm.parallel=jdk.m3.tornado,ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <m3.gpu>${m3.gpu}</m3.gpu>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>m3-synexia-atom-pattern</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.synexia</groupId>
                <artifactId>synexia-openrewrite-recipes</artifactId>
                <version>1.0.0-SNAPSHOT</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-synexia-atom-pattern-verify</id>
                <phase>verify</phase>
                <goals><goal>dryRun</goal></goals>
              </execution>
            </executions>
            <configuration>
              <activeRecipes><recipe>com.synexia.m3.EveryModuleAtomPatternApplication</recipe></activeRecipes>
              <exportDatatables>true</exportDatatables>
              <runPerSubmodule>false</runPerSubmodule>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <failOnDryRunResults>false</failOnDryRunResults>
              <additionalPlainTextMasks>
                <additionalPlainTextMask>**/*.md</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.markdown</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.adoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.asciidoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.c</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.h</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle.kts</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.sh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bash</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cmd</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bat</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ps1</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.py</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.pyi</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.csv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.tsv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ndjson</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.txt</additionalPlainTextMask>
                <additionalPlainTextMask>**/README</additionalPlainTextMask>
                <additionalPlainTextMask>**/LICENSE</additionalPlainTextMask>
                <additionalPlainTextMask>**/NOTICE</additionalPlainTextMask>
              </additionalPlainTextMasks>
              <exclusions>
                <exclusion>**/target/**</exclusion>
                <exclusion>**/generated-sources/**</exclusion>
                <exclusion>**/out/**</exclusion>
                <exclusion>**/scratch/**</exclusion>
                <exclusion>**/.merge-preserved/**</exclusion>
                <exclusion>**/.superset/**</exclusion>
                <exclusion>**/.m3/maven-superset-*/**</exclusion>
                <exclusion>**/archive-maven-projects/**</exclusion>
                <exclusion>**/tasks/**</exclusion>
                <exclusion>**/verification/**</exclusion>
                <exclusion>**/evidence/**</exclusion>
                <exclusion>**/history/**</exclusion>
                <exclusion>**/template-history/**</exclusion>
                <exclusion>**/receiving-input/**</exclusion>
                <exclusion>**/input-epoch/**</exclusion>
                <exclusion>**/src/test/resources/**</exclusion>
                <exclusion>**/upstream-excluded/**</exclusion>
                <exclusion>**/*custody*/**</exclusion>
                <exclusion>**/vendor/**</exclusion>
              </exclusions>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>m3-synexia-atom-pattern-mastery</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.synexia</groupId>
                <artifactId>synexia-openrewrite-recipes</artifactId>
                <version>1.0.0-SNAPSHOT</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-synexia-atom-pattern-mastery-verify</id>
                <phase>verify</phase>
                <goals><goal>dryRun</goal></goals>
              </execution>
            </executions>
            <configuration>
              <activeRecipes><recipe>com.synexia.m3.EveryModuleAtomPatternMastery</recipe></activeRecipes>
              <exportDatatables>true</exportDatatables>
              <runPerSubmodule>false</runPerSubmodule>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <failOnDryRunResults>false</failOnDryRunResults>
              <additionalPlainTextMasks>
                <additionalPlainTextMask>**/*.md</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.markdown</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.adoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.asciidoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.c</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.h</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle.kts</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.sh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bash</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cmd</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bat</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ps1</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.py</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.pyi</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.csv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.tsv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ndjson</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.txt</additionalPlainTextMask>
                <additionalPlainTextMask>**/README</additionalPlainTextMask>
                <additionalPlainTextMask>**/LICENSE</additionalPlainTextMask>
                <additionalPlainTextMask>**/NOTICE</additionalPlainTextMask>
              </additionalPlainTextMasks>
              <exclusions>
                <exclusion>**/target/**</exclusion>
                <exclusion>**/generated-sources/**</exclusion>
                <exclusion>**/out/**</exclusion>
                <exclusion>**/scratch/**</exclusion>
                <exclusion>**/.merge-preserved/**</exclusion>
                <exclusion>**/.superset/**</exclusion>
                <exclusion>**/.m3/maven-superset-*/**</exclusion>
                <exclusion>**/archive-maven-projects/**</exclusion>
                <exclusion>**/tasks/**</exclusion>
                <exclusion>**/verification/**</exclusion>
                <exclusion>**/evidence/**</exclusion>
                <exclusion>**/history/**</exclusion>
                <exclusion>**/template-history/**</exclusion>
                <exclusion>**/receiving-input/**</exclusion>
                <exclusion>**/input-epoch/**</exclusion>
                <exclusion>**/src/test/resources/**</exclusion>
                <exclusion>**/upstream-excluded/**</exclusion>
                <exclusion>**/*custody*/**</exclusion>
                <exclusion>**/vendor/**</exclusion>
              </exclusions>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
