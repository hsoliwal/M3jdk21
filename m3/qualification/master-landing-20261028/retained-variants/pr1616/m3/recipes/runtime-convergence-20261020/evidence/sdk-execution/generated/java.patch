+            } finally {
+                activator.stop(context);
+                context.removeServiceListener(listener);
+            }
+        } finally {
+            framework.stop();
+            assertEquals(FrameworkEvent.STOPPED, framework.waitForStop(10000).getType());
+        }
+    }
+}
