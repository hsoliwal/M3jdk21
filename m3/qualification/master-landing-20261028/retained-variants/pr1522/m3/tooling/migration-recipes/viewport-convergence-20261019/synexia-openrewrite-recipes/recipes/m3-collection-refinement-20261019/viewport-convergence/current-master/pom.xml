<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.synexia.proof</groupId>
  <artifactId>m3-current-master-convergence-20261019</artifactId>
  <version>1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rewrite.version>8.17.1</rewrite.version>
    <refinement.template.directory>${project.basedir}/../../../../src/main/resources</refinement.template.directory>
    <refinement.before.directory>${project.basedir}/before</refinement.before.directory>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java</artifactId>
      <version>${rewrite.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.13</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>${project.basedir}/../../../../src/main/java</sourceDirectory>
    <testSourceDirectory>${project.basedir}/../../../../src/test/java</testSourceDirectory>
    <resources>
      <resource>
        <directory>${refinement.template.directory}</directory>
        <includes>
          <include>com/synexia/rewrite/m3-current-master-convergence-20261019/**</include>
                              <include>META-INF/rewrite/m3-current-master-convergence-20261019.yml</include>
        </includes>
      </resource>
    </resources>
    <testResources>
      <testResource>
        <directory>${refinement.before.directory}</directory>
        <targetPath>com/synexia/rewrite/m3-current-master-convergence-20261019/before</targetPath>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <overwrite>true</overwrite>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <includes>
            <include>com/synexia/rewrite/M3GpuToolJoinManifest.java</include>
            <include>com/synexia/rewrite/M3GpuToolJoinRecipe.java</include>
            <include>com/synexia/rewrite/M3CurrentMasterConvergence20261019.java</include>
          </includes>
          <testIncludes>
            <testInclude>com/synexia/rewrite/M3CurrentMasterConvergence20261019Test.java</testInclude>
          </testIncludes>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <includes>
            <include>**/M3CurrentMasterConvergence20261019Test.java</include>
          </includes>
          <failIfNoTests>true</failIfNoTests>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
