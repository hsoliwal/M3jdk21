+    private static void streamingAndM3PieceInterop() {
+        M3BigString value = M3BigString.of("A", "\uD83D", "\uDE00", "\uD800", "B");
+        eq(5L, value.codeUnits().count(), "lazy long code-unit stream count");
+        eq(4L, value.codePoints().count(), "cross-chunk code-point stream count");
+        StringBuilder points = new StringBuilder();
+        value.codePoints().forEachOrdered(codePoint ->
+                points.appendCodePoint(Math.toIntExact(codePoint)));
+        eq("A\uD83D\uDE00\uD800B", points.toString(),
+                "code-point stream merges pairs and retains unpaired surrogates");
+
+        LocalM3Arena arena = new LocalM3Arena();
+        M3StringPiece first = arena.copyLatin1(new byte[] {'a', 'b'});
+        M3StringPiece second = arena.copyUtf16(new char[] {'c', '\uD83D', '\uDE00'});
+        M3StringPiece joined = M3StringPiece.join(first, second);
+        M3BigString pieceBacked = M3BigString.of(joined, "tail");
+        eq("abc\uD83D\uDE00tail", pieceBacked.flatten(),
+                "existing M3StringPiece can be a non-flattened rope chunk");
+        eq("c\uD83D\uDE00t", pieceBacked.subSequence(2, 6).flatten(),
+                "range spans inner piece and next rope chunk");
+        eq(3L, pieceBacked.indexOf("\uD83D\uDE00t", 0),
+                "literal search through existing M3 piece and rope boundary");
+        eq(8L, pieceBacked.summary().codePointCount(),
+                "summary reuses immutable M3 piece code-point semantics");
