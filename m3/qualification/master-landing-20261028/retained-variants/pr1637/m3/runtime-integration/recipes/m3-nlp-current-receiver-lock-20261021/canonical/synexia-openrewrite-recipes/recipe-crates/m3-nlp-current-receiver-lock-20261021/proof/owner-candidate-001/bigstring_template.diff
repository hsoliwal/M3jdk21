     /** Number of UTF-16 code units; unlike CharSequence.length(), this can exceed int range. */
     public long length() { return end - start; }
 
+    /**
+     * Lazily expose UTF-16 code units as primitive long values. The stream is ordered and
+     * long-indexed, so its range and count do not narrow the text length to int.
+     */
+    public LongStream codeUnits() {
+        return LongStream.range(0L, length()).map(index -> charAt(index));
+    }
+
+    /**
+     * Lazily expose Unicode code points as primitive long values, merging surrogate pairs
+     * even when their two UTF-16 code units live in different chunks. Unpaired surrogates
+     * are emitted as their code-unit values, matching String.codePoints() semantics.
+     */
+    public LongStream codePoints() {
+        long size = length();
+        return LongStream.range(0L, size)
+                .filter(index -> {
+                    char current = charAt(index);
+                    return !(Character.isLowSurrogate(current)
+                            && index > 0
+                            && Character.isHighSurrogate(charAt(index - 1)));
+                })
+                .map(index -> {
+                    char first = charAt(index);
+                    if (Character.isHighSurrogate(first) && index + 1 < size) {
+                        char second = charAt(index + 1);
+                        if (Character.isLowSurrogate(second)) {
+                            return Character.toCodePoint(first, second);
+                        }
+                    }
+                    return first;
+                });
+    }
