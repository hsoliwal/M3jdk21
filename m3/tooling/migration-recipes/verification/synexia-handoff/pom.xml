<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3.verification</groupId>
  <artifactId>synexia-source-bridge-v1</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <properties>
    <m3.root>${project.basedir}/../../../..</m3.root>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <executions>
          <execution>
            <id>synexia-handoff-receiver</id>
            <phase>verify</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>mvn</executable>
              <workingDirectory>${m3.root}</workingDirectory>
              <arguments>
                <argument>-B</argument>
                <argument>-ntp</argument>
                <argument>-f</argument>
                <argument>m3/tooling/migration-recipes/pom.xml</argument>
                <argument>-Dtest=M3SynexiaHandoffGuardRecipeTest,M3SynexiaHandoffImportTest</argument>
                <argument>test</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
