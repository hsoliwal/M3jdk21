<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3.tooling</groupId><artifactId>migration-recipes</artifactId><version>0.1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rewrite.version>8.17.1</rewrite.version>
    <jacoco.version>0.8.15</jacoco.version>
    <m3.synexia.version>1.0.0-SNAPSHOT</m3.synexia.version>
  </properties>
  <dependencies>
    <!-- OpenRewrite 8.17.1 publishes PlainText from rewrite-core transitively; there is no rewrite-text artifact. -->
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java-21</artifactId><version>${rewrite.version}</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-test</artifactId><version>${rewrite.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.2</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version><configuration><useModulePath>false</useModulePath><failIfNoTests>true</failIfNoTests></configuration></plugin>
    <plugin><groupId>org.openrewrite.maven</groupId><artifactId>rewrite-maven-plugin</artifactId><version>5.23.1</version></plugin>
    <plugin>
      <groupId>org.jacoco</groupId>
      <artifactId>jacoco-maven-plugin</artifactId>
      <version>${jacoco.version}</version>
      <executions>
        <execution>
          <id>m3-coverage-agent</id>
          <goals><goal>prepare-agent</goal></goals>
        </execution>
        <execution>
          <id>m3-coverage-report</id>
          <phase>verify</phase>
          <goals><goal>report</goal></goals>
        </execution>
        <execution>
          <id>m3-coverage-check</id>
          <phase>verify</phase>
          <goals><goal>check</goal></goals>
          <configuration>
            <includes>
              <include>com/m3/rewrite/scope/*</include>
              <include>com/m3/rewrite/atom/*</include>
            </includes>
            <rules>
              <rule>
                <element>BUNDLE</element>
                <limits>
                  <limit>
                    <counter>LINE</counter>
                    <value>COVEREDRATIO</value>
                    <minimum>0.99</minimum>
                  </limit>
                  <limit>
                    <counter>BRANCH</counter>
                    <value>COVEREDRATIO</value>
                    <minimum>0.99</minimum>
                  </limit>
                </limits>
              </rule>
            </rules>
          </configuration>
        </execution>
      </executions>
    </plugin>
  </plugins></build>

  <profiles>
    <!--
      Canonical reusable recipes are owned by hsoliwal/com.synexia.
      This profile is intentionally opt-in so a missing/unpublished local Synexia snapshot cannot
      break the default M3JDK21 receiver build. Install the pinned Synexia reactor first, then
      activate this profile and select a com.synexia.* recipe explicitly.
    -->
    <profile>
      <id>m3-synexia-recipe-ownership-audit</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.synexia</groupId>
                <artifactId>synexia-openrewrite-recipes</artifactId>
                <version>${m3.synexia.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <exportDatatables>true</exportDatatables>
              <activeRecipes combine.self="override">
                <recipe>com.synexia.rewrite.M3Jdk21RecipeOwnershipAudit</recipe>
              </activeRecipes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>m3-synexia-canonical-recipes</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.synexia</groupId>
                <artifactId>synexia-openrewrite-recipes</artifactId>
                <version>${m3.synexia.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>m3-synexia-recipe-mirror-v2</id>
      <dependencies>
        <dependency>
          <groupId>com.synexia</groupId>
          <artifactId>synexia-m3jdk21-recipe-mirror-verifier</artifactId>
          <version>${m3.synexia.version}</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>verify-proof-bound-synexia-recipe-mirror</id>
                <phase>verify</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>com.synexia.rewrite.M3Jdk21RecipeMirrorSnapshotCli</mainClass>
                  <arguments>
                    <argument>${project.basedir}/receiver/synexia-recipe-mirror-v2/m3jdk21-recipe-tree-audit-v2.tsv</argument>
                    <argument>${project.basedir}/receiver/synexia-recipe-mirror-v2/m3jdk21-recipe-tree-audit-v2.root</argument>
                    <argument>80b8534ad1e45002185fb3eeab233f98d3a7c0bd</argument>
                  </arguments>
                  <classpathScope>runtime</classpathScope>
                  <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
