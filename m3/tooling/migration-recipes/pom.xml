<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3.tooling</groupId><artifactId>migration-recipes</artifactId><version>0.1.0-SNAPSHOT</version>
  <properties><maven.compiler.release>21</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><rewrite.version>8.17.1</rewrite.version><jacoco.version>0.8.15</jacoco.version></properties>
  <dependencies>
    <dependency><groupId>com.m3</groupId><artifactId>m3indexdb</artifactId><version>0.1.0-SNAPSHOT</version></dependency>
    <!-- OpenRewrite 8.17.1 publishes PlainText from rewrite-core transitively; there is no rewrite-text artifact. -->
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java-21</artifactId><version>${rewrite.version}</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-test</artifactId><version>${rewrite.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.2</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version><configuration><compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs></configuration></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version><configuration><useModulePath>false</useModulePath><failIfNoTests>true</failIfNoTests></configuration></plugin>
    <plugin><groupId>org.openrewrite.maven</groupId><artifactId>rewrite-maven-plugin</artifactId><version>5.23.1</version><configuration><exportDatatables>true</exportDatatables><failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes></configuration></plugin>
    <plugin>
      <groupId>org.jacoco</groupId>
      <artifactId>jacoco-maven-plugin</artifactId>
      <version>${jacoco.version}</version>
      <executions>
        <execution>
          <id>m3-coverage-agent</id>
          <goals><goal>prepare-agent</goal></goals>
        </execution>
        <execution>
          <id>m3-coverage-report</id>
          <phase>verify</phase>
          <goals><goal>report</goal></goals>
        </execution>
        <execution>
          <id>m3-coverage-check</id>
          <phase>verify</phase>
          <goals><goal>check</goal></goals>
          <configuration>
            <includes>
              <include>com/m3/rewrite/scope/*</include>
              <include>com/m3/rewrite/atom/*</include>
              <include>com/m3/rewrite/index/*</include>
              <include>com/m3/rewrite/pass/*</include>
            </includes>
            <rules>
              <rule>
                <element>BUNDLE</element>
                <limits>
                  <limit>
                    <counter>LINE</counter>
                    <value>COVEREDRATIO</value>
                    <minimum>0.99</minimum>
                  </limit>
                  <limit>
                    <counter>BRANCH</counter>
                    <value>COVEREDRATIO</value>
                    <minimum>0.99</minimum>
                  </limit>
                </limits>
              </rule>
            </rules>
          </configuration>
        </execution>
      </executions>
    </plugin>
  </plugins></build>

  <profiles>
    <profile>
      <id>m3-dna-base</id>
      <properties>
        <m3.dna.role>BASELINE</m3.dna.role>
        <m3.dna.rev>jdk-21+35</m3.dna.rev>
        <m3.dna.root>${maven.multiModuleProjectDirectory}/..</m3.dna.root>
        <m3.dna.out>${project.build.directory}/m3-dna-base</m3.dna.out>
        <m3.dna.threads>4</m3.dna.threads>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution>
                <id>m3-dna-base</id>
                <phase>verify</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>com.m3.rewrite.convergence.M3Dna</mainClass>
                  <classpathScope>runtime</classpathScope>
                  <arguments>
                    <argument>${m3.dna.role}</argument>
                    <argument>${m3.dna.rev}</argument>
                    <argument>${m3.dna.root}</argument>
                    <argument>${m3.dna.out}</argument>
                    <argument>${m3.dna.threads}</argument>
                  </arguments>
                  <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>m3-dna-donor</id>
      <properties>
        <m3.dna.donor.out>${project.build.directory}/m3-dna-donor</m3.dna.donor.out>
        <m3.dna.donor.threads>4</m3.dna.donor.threads>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>require-explicit-donor-normalization-input</id>
                <phase>validate</phase>
                <goals><goal>enforce</goal></goals>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>m3.dna.donor.root</property>
                      <message>m3.dna.donor.root must point to a detached pinned donor checkout</message>
                    </requireProperty>
                    <requireProperty>
                      <property>m3.dna.donor.rev</property>
                      <message>m3.dna.donor.rev must be the exact RELEASE_DONOR_REFS.tsv ref</message>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution>
                <id>m3-dna-donor</id>
                <phase>verify</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>com.m3.rewrite.convergence.M3Dna</mainClass>
                  <classpathScope>runtime</classpathScope>
                  <arguments>
                    <argument>DONOR</argument>
                    <argument>${m3.dna.donor.rev}</argument>
                    <argument>${m3.dna.donor.root}</argument>
                    <argument>${m3.dna.donor.out}</argument>
                    <argument>${m3.dna.donor.threads}</argument>
                  </arguments>
                  <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
