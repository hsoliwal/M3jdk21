<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3.tooling</groupId><artifactId>migration-recipes</artifactId><version>0.1.0-SNAPSHOT</version>
  <properties><maven.compiler.release>21</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><rewrite.version>8.17.1</rewrite.version><jacoco.version>0.8.15</jacoco.version><m3.convergence.skip>true</m3.convergence.skip><m3.jdk.root>${project.basedir}/../../..</m3.jdk.root><m3.convergence.output>${project.build.directory}/m3-jdk-source-convergence</m3.convergence.output><m3.convergence.threads>4</m3.convergence.threads></properties>
  <dependencies>
    <dependency><groupId>com.m3</groupId><artifactId>m3indexdb</artifactId><version>0.1.0-SNAPSHOT</version></dependency>
    <!-- OpenRewrite 8.17.1 publishes PlainText from rewrite-core transitively; there is no rewrite-text artifact. -->
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java-21</artifactId><version>${rewrite.version}</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-test</artifactId><version>${rewrite.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.2</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version><configuration><compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs></configuration></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version><configuration><useModulePath>false</useModulePath><failIfNoTests>true</failIfNoTests></configuration></plugin>
    <plugin><groupId>org.openrewrite.maven</groupId><artifactId>rewrite-maven-plugin</artifactId><version>5.23.1</version><configuration><exportDatatables>true</exportDatatables><failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes></configuration></plugin>
    <plugin>
      <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.6.4</version>
      <executions><execution><id>m3-jdk-source-convergence</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <skip>${m3.convergence.skip}</skip>
          <mainClass>com.m3.rewrite.convergence.M3Jdk21SourceConvergenceMain</mainClass>
          <arguments><argument>${m3.jdk.root}</argument><argument>${m3.convergence.output}</argument><argument>${m3.convergence.threads}</argument></arguments>
          <cleanupDaemonThreads>false</cleanupDaemonThreads>
        </configuration>
      </execution></executions>
    </plugin>
    <plugin>
      <groupId>org.jacoco</groupId>
      <artifactId>jacoco-maven-plugin</artifactId>
      <version>${jacoco.version}</version>
      <executions>
        <execution>
          <id>m3-coverage-agent</id>
          <goals><goal>prepare-agent</goal></goals>
        </execution>
        <execution>
          <id>m3-coverage-report</id>
          <phase>verify</phase>
          <goals><goal>report</goal></goals>
        </execution>
        <execution>
          <id>m3-coverage-check</id>
          <phase>verify</phase>
          <goals><goal>check</goal></goals>
          <configuration>
            <includes>
              <include>com/m3/rewrite/scope/*</include>
              <include>com/m3/rewrite/atom/*</include>
              <include>com/m3/rewrite/index/*</include>
              <include>com/m3/rewrite/pass/*</include>
            </includes>
            <rules>
              <rule>
                <element>BUNDLE</element>
                <limits>
                  <limit>
                    <counter>LINE</counter>
                    <value>COVEREDRATIO</value>
                    <minimum>0.99</minimum>
                  </limit>
                  <limit>
                    <counter>BRANCH</counter>
                    <value>COVEREDRATIO</value>
                    <minimum>0.99</minimum>
                  </limit>
                </limits>
              </rule>
            </rules>
          </configuration>
        </execution>
      </executions>
    </plugin>
  </plugins></build>
  <profiles>
    <profile><id>m3-jdk-source-convergence</id><properties><m3.convergence.skip>false</m3.convergence.skip></properties></profile>
    <profile><id>m3-jdk-absorption</id><properties><m3.convergence.skip>false</m3.convergence.skip></properties></profile>
  </profiles>
</project>
