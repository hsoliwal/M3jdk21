/**
 * Exact current mapping recovery through the retained text owner.
 * The unresolved template must be bound to an actual verified publication before execution.
 * This finite metadata proof grants no source-export or rebuilt-JDK acceptance authority.
 */
final class JccMergeMappingRecoveryV04Test {
    private static final String CRATE = "jcc-merge-recovery-20261006-mapping-v04";
    private static final String ROOT = "/com/m3/rewrite/backport/jdk21-hash-pinned-text/" + CRATE + "/";
