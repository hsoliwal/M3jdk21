BEGIN_RAW_FILE bootstrap-2/06-materialization.diff sha256=fa6359471bf347b02af3ea66ebb27e21ef6b0980a161a0cd3ef2cc7b6537ee0e
--- src/main/java/com/m3/rewrite/atom/M3AtomizePureIntReturnRecipe.java
+++ src/main/java/com/m3/rewrite/atom/M3AtomizePureIntReturnRecipe.java
@@ -1,14 +1,18 @@
 // SPDX-License-Identifier: Apache-2.0
 package com.m3.rewrite.atom;
 
+import java.util.ArrayList;
+import java.util.List;
 import java.util.Set;
 import org.openrewrite.ExecutionContext;
 import org.openrewrite.Recipe;
 import org.openrewrite.TreeVisitor;
 import org.openrewrite.java.JavaIsoVisitor;
 import org.openrewrite.java.JavaTemplate;
+import org.openrewrite.java.tree.Comment;
 import org.openrewrite.java.tree.Expression;
 import org.openrewrite.java.tree.J;
+import org.openrewrite.java.tree.Statement;
 
 /**
  * File-local M3 atomization for a deliberately tiny proven semantic domain.
@@ -64,10 +68,24 @@
                 }
 
                 Expression expression = M3PureIntAtomEligibility.returnedExpression(candidate);
-                return atomize.apply(
+                J.Block originalBody = candidate.getBody();
+                J.Return originalReturn = (J.Return) originalBody.getStatements().getFirst();
+                J.MethodDeclaration atomized = atomize.apply(
                         updateCursor(candidate),
                         candidate.getCoordinates().replaceBody(),
                         expression);
+                J.Block body = atomized.getBody();
+                J.VariableDeclarations atom =
+                        (J.VariableDeclarations) body.getStatements().getFirst();
+                // Semantic memory belongs to the original leaf, including expression comments.
+                atom = atom.withVariables(List.of(
+                        atom.getVariables().getFirst().withInitializer(expression)));
+                List<Comment> comments = new ArrayList<>(originalReturn.getComments());
+                comments.addAll(atom.getComments());
+                List<Statement> statements = new ArrayList<>(body.getStatements());
+                statements.set(0, atom.withComments(comments));
+                return atomized.withBody(body.withStatements(statements)
+                        .withPrefix(originalBody.getPrefix()).withEnd(originalBody.getEnd()));
             }
         };
     }

END_RAW_FILE bootstrap-2/06-materialization.diff

