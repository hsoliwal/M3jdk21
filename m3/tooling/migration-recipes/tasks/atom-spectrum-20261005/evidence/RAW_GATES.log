+            @JsonProperty("lst") Boolean lst) {
         if (crateName == null || !crateName.matches("[a-z0-9][a-z0-9-]{0,79}")) {
             throw new IllegalArgumentException("invalid hash-pinned Java crate");
         }
         this.crateName = crateName;
