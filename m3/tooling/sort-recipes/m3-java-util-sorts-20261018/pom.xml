<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0; Copyright 2026 Hitesh Soliwal and contributors -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.synexia.recipes</groupId>
  <artifactId>m3-java-util-sorts-20261018</artifactId>
  <version>1.0.0</version>
  <name>M3 java.util sorting source-sealed recipe</name>
  <description>Bounded application of canonical Synexia Java/text recipes to an additive M3JDK21 sorting candidate.</description>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rewrite.version>8.90.4</rewrite.version>
    <targetRoot>UNSET</targetRoot>
    <applyMode>dry-run</applyMode>
    <buildRoot>${project.basedir}/target</buildRoot>
    <payloadRoot>${project.basedir}/payload</payloadRoot>
    <receiptPath>${project.build.directory}/application-receipt.tsv</receiptPath>
  </properties>
  <licenses><license><name>Apache License 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0</url></license></licenses>
  <dependencies>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java-21</artifactId><version>${rewrite.version}</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId><version>24.1.0</version></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>2.0.20</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.2</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${buildRoot}</directory>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${payloadRoot}/java</directory><targetPath>com/synexia/rewrite/hash-pinned-java/m3-java-util-sorts-20261018</targetPath><filtering>false</filtering></resource>
      <resource><directory>${payloadRoot}/text</directory><targetPath>com/synexia/rewrite/hash-pinned-text/m3-java-util-sorts-20261018</targetPath><filtering>false</filtering></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
        <configuration><release>21</release><proc>none</proc><compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
        <configuration>
          <failIfNoTests>true</failIfNoTests><useModulePath>false</useModulePath>
          <argLine>-Xmx1024m -Djava.io.tmpdir=${project.build.directory}</argLine>
          <forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
          <systemPropertyVariables><crateRoot>${project.basedir}</crateRoot></systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.1</version></plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.1</version>
        <configuration>
          <mainClass>com.synexia.rewrite.sorts.M3JavaUtilSortsApply</mainClass>
          <arguments><argument>${targetRoot}</argument><argument>${applyMode}</argument><argument>${receiptPath}</argument></arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
