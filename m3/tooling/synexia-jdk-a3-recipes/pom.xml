<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.synexia</groupId>
  <artifactId>synexia-jdk-a3-recipes</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>M3JDK21 :: Public Synexia A3 recipe mirror</name>
  <description>Target-side build wrapper around the exact Apache-2.0 Synexia A3 export snapshot.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rewrite.version>8.17.1</rewrite.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java</artifactId>
      <version>${rewrite.version}-m3-source-1</version>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java-21</artifactId>
      <version>${rewrite.version}-m3-source-1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}-m3-source-1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}/../../vendor/synexia/synexia-openrewrite-recipes/src/main/java</sourceDirectory>
    <resources>
      <resource>
        <directory>${project.basedir}/../../vendor/synexia/synexia-openrewrite-recipes/src/main/resources</directory>
        <includes>
          <include>META-INF/m3/jdk-a3-recipe-export.tsv</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <proc>none</proc>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
            <arg>-implicit:none</arg>
          </compilerArgs>
          <includes>
            <include>com/synexia/rewrite/atom/M3AtomizePureIntReturnRecipe.java</include>
            <include>com/synexia/rewrite/atom/M3DocumentPureIntAtomRecipe.java</include>
            <include>com/synexia/rewrite/atom/M3FileAtomCandidateTable.java</include>
            <include>com/synexia/rewrite/atom/M3InventoryPureIntAtomCandidates.java</include>
            <include>com/synexia/rewrite/atom/M3PatternizePureIntAtomRecipe.java</include>
            <include>com/synexia/rewrite/atom/M3PureIntAtomEligibility.java</include>
            <include>com/synexia/rewrite/atom/M3PureIntConvergenceRecipe.java</include>
            <include>com/synexia/rewrite/M3RecipeMasteryPortableReceipt.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <failIfNoTests>true</failIfNoTests>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>m3-synexia-atom-pattern</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.synexia</groupId>
                <artifactId>synexia-openrewrite-recipes</artifactId>
                <version>1.0.0-SNAPSHOT</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-synexia-atom-pattern-verify</id>
                <phase>verify</phase>
                <goals>
                  <goal>dryRun</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <activeRecipes>
                <recipe>com.synexia.m3.EveryModuleAtomPatternApplication</recipe>
              </activeRecipes>
              <exportDatatables>true</exportDatatables>
              <runPerSubmodule>false</runPerSubmodule>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <failOnDryRunResults>false</failOnDryRunResults>
              <additionalPlainTextMasks>
                <additionalPlainTextMask>**/*.md</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.markdown</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.adoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.asciidoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.c</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.h</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle.kts</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.sh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bash</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cmd</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bat</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ps1</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.py</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.pyi</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.csv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.tsv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ndjson</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.txt</additionalPlainTextMask>
                <additionalPlainTextMask>**/README</additionalPlainTextMask>
                <additionalPlainTextMask>**/LICENSE</additionalPlainTextMask>
                <additionalPlainTextMask>**/NOTICE</additionalPlainTextMask>
              </additionalPlainTextMasks>
              <exclusions>
                <exclusion>**/target/**</exclusion>
                <exclusion>**/generated-sources/**</exclusion>
                <exclusion>**/out/**</exclusion>
                <exclusion>**/scratch/**</exclusion>
                <exclusion>**/.merge-preserved/**</exclusion>
                <exclusion>**/.superset/**</exclusion>
                <exclusion>**/.m3/maven-superset-*/**</exclusion>
                <exclusion>**/archive-maven-projects/**</exclusion>
                <exclusion>**/tasks/**</exclusion>
                <exclusion>**/verification/**</exclusion>
                <exclusion>**/evidence/**</exclusion>
                <exclusion>**/history/**</exclusion>
                <exclusion>**/template-history/**</exclusion>
                <exclusion>**/receiving-input/**</exclusion>
                <exclusion>**/input-epoch/**</exclusion>
                <exclusion>**/src/test/resources/**</exclusion>
                <exclusion>**/upstream-excluded/**</exclusion>
                <exclusion>**/*custody*/**</exclusion>
                <exclusion>**/vendor/**</exclusion>
              </exclusions>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>m3-synexia-atom-pattern-mastery</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.synexia</groupId>
                <artifactId>synexia-openrewrite-recipes</artifactId>
                <version>1.0.0-SNAPSHOT</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-synexia-atom-pattern-mastery-verify</id>
                <phase>verify</phase>
                <goals>
                  <goal>dryRun</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <activeRecipes>
                <recipe>com.synexia.m3.EveryModuleAtomPatternMastery</recipe>
              </activeRecipes>
              <exportDatatables>true</exportDatatables>
              <runPerSubmodule>false</runPerSubmodule>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <failOnDryRunResults>false</failOnDryRunResults>
              <additionalPlainTextMasks>
                <additionalPlainTextMask>**/*.md</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.markdown</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.adoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.asciidoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.c</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.h</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle.kts</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.sh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bash</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cmd</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bat</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ps1</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.py</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.pyi</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.csv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.tsv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ndjson</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.txt</additionalPlainTextMask>
                <additionalPlainTextMask>**/README</additionalPlainTextMask>
                <additionalPlainTextMask>**/LICENSE</additionalPlainTextMask>
                <additionalPlainTextMask>**/NOTICE</additionalPlainTextMask>
              </additionalPlainTextMasks>
              <exclusions>
                <exclusion>**/target/**</exclusion>
                <exclusion>**/generated-sources/**</exclusion>
                <exclusion>**/out/**</exclusion>
                <exclusion>**/scratch/**</exclusion>
                <exclusion>**/.merge-preserved/**</exclusion>
                <exclusion>**/.superset/**</exclusion>
                <exclusion>**/.m3/maven-superset-*/**</exclusion>
                <exclusion>**/archive-maven-projects/**</exclusion>
                <exclusion>**/tasks/**</exclusion>
                <exclusion>**/verification/**</exclusion>
                <exclusion>**/evidence/**</exclusion>
                <exclusion>**/history/**</exclusion>
                <exclusion>**/template-history/**</exclusion>
                <exclusion>**/receiving-input/**</exclusion>
                <exclusion>**/input-epoch/**</exclusion>
                <exclusion>**/src/test/resources/**</exclusion>
                <exclusion>**/upstream-excluded/**</exclusion>
                <exclusion>**/*custody*/**</exclusion>
                <exclusion>**/vendor/**</exclusion>
              </exclusions>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>m3-recipe-boot</id>
      <activation>
        <file>
          <exists>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</exists>
        </file>
      </activation>
      <properties>
        <m3.recipe.boot.skip>false</m3.recipe.boot.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <inherited>true</inherited>
            <dependencies>
              <dependency>
                <groupId>com.synexia.m3</groupId>
                <artifactId>m3-pr-stack-preservation</artifactId>
                <version>1.0.0-m3boot20261021</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-recipe-boot</id>
                <phase>validate</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <skip>${m3.recipe.boot.skip}</skip>
                  <mainClass>com.synexia.m3.prstack.M3RecipeBoot</mainClass>
                  <includeProjectDependencies>false</includeProjectDependencies>
                  <includePluginDependencies>true</includePluginDependencies>
                  <arguments>
                    <argument>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</argument>
                    <argument>${project.basedir}</argument>
                    <argument>${session.projects[0].basedir.absolutePath}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
