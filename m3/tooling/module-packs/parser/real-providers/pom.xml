<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Only an external *test* dependency closure; none are required by jdk.m3.parser. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <groupId>com.m3.validation</groupId>
 <artifactId>m3-ast-real-providers</artifactId>
 <version>1.0.0-SNAPSHOT</version>
 <packaging>pom</packaging>
 <repositories>
  <repository>
   <id>gradle-releases</id>
   <url>https://repo.gradle.org/gradle/libs-releases</url>
  </repository>
 </repositories>
 <dependencies>
  <dependency>
   <groupId>org.eclipse.jdt</groupId>
   <artifactId>org.eclipse.jdt.core</artifactId>
   <version>3.40.0</version>
  </dependency>
  <dependency>
   <groupId>org.apache.maven</groupId>
   <artifactId>maven-model-builder</artifactId>
   <version>3.9.11</version>
  </dependency>
  <dependency>
   <groupId>org.apache.groovy</groupId>
   <artifactId>groovy</artifactId>
   <version>4.0.26</version>
  </dependency>
  <dependency>
   <groupId>org.gradle</groupId>
   <artifactId>gradle-tooling-api</artifactId>
   <version>8.12</version>
  </dependency>
  <dependency>
   <groupId>org.jetbrains.kotlin</groupId>
   <artifactId>kotlin-compiler-embeddable</artifactId>
   <version>2.0.21</version>
  </dependency>
  <dependency>
   <groupId>com.fasterxml.jackson.core</groupId>
   <artifactId>jackson-core</artifactId>
   <version>2.19.2</version>
  </dependency>
 </dependencies>
 <profiles>
  <profile>
   <id>m3-recipe-boot</id>
   <activation>
    <file>
     <exists>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</exists>
    </file>
   </activation>
   <properties>
    <m3.recipe.boot.skip>false</m3.recipe.boot.skip>
   </properties>
   <build>
    <plugins>
     <plugin>
      <groupId>org.codehaus.mojo</groupId>
      <artifactId>exec-maven-plugin</artifactId>
      <version>3.5.0</version>
      <inherited>true</inherited>
      <dependencies>
       <dependency>
        <groupId>com.synexia.m3</groupId>
        <artifactId>m3-pr-stack-preservation</artifactId>
        <version>1.0.0-m3boot20261021</version>
       </dependency>
      </dependencies>
      <executions>
       <execution>
        <id>m3-recipe-boot</id>
        <phase>validate</phase>
        <goals>
         <goal>java</goal>
        </goals>
        <configuration>
         <skip>${m3.recipe.boot.skip}</skip>
         <mainClass>com.synexia.m3.prstack.M3RecipeBoot</mainClass>
         <includeProjectDependencies>false</includeProjectDependencies>
         <includePluginDependencies>true</includePluginDependencies>
         <arguments>
          <argument>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</argument>
          <argument>${project.basedir}</argument>
          <argument>${session.projects[0].basedir.absolutePath}</argument>
         </arguments>
        </configuration>
       </execution>
      </executions>
     </plugin>
    </plugins>
   </build>
  </profile>
 </profiles>
</project>
