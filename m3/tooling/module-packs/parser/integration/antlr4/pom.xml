<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <groupId>jdk.m3.parser.test</groupId>
 <artifactId>m3-original-antlr4-real-runtime</artifactId>
 <version>1.0.0-SNAPSHOT</version>
 <properties><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
 <!-- Test-only ANTLR4 runtime; NOT a production parser-module dependency. -->
 <dependencies>
  <dependency>
   <groupId>org.antlr</groupId><artifactId>antlr4-runtime</artifactId>
   <version>4.13.2</version><scope>compile</scope>
  </dependency>
 </dependencies>
 <build>
  <plugins>
   <plugin>
    <groupId>org.antlr</groupId><artifactId>antlr4-maven-plugin</artifactId>
    <version>4.13.2</version>
    <executions><execution><goals><goal>antlr4</goal></goals></execution></executions>
   </plugin>
  </plugins>
 </build>
</project>
