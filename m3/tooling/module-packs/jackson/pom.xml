<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3.tooling</groupId>
  <artifactId>jackson-jmod-pack</artifactId>
  <version>2.19.2-m3-1</version>
  <packaging>pom</packaging>
  <name>M3 Jackson ObjectMapper source and JMOD pack</name>
  <description>Build the pinned in-repository Jackson source modules, retain their JPMS identities, and execute the M3 integration contracts on a linked JDK 21 image.</description>
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <m3.jackson.python>python3</m3.jackson.python>
    <m3.jackson.jdk>${java.home}</m3.jackson.jdk>
    <m3.jackson.maven>${maven.home}/bin/mvn</m3.jackson.maven>
    <m3.jackson.maven.repo>${settings.localRepository}</m3.jackson.maven.repo>
    <m3.jackson.maven.offline>true</m3.jackson.maven.offline>
    <m3.jackson.repo.root>${project.basedir}/../../../..</m3.jackson.repo.root>
    <m3.jackson.out>${project.build.directory}/pack</m3.jackson.out>
    <m3.jackson.stage>runtime</m3.jackson.stage>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <id>source-jmod-and-linked-contracts</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${m3.jackson.python}</executable>
              <arguments>
                <argument>${project.basedir}/build.py</argument>
                <argument>--jdk-home</argument>
                <argument>${m3.jackson.jdk}</argument>
                <argument>--maven</argument>
                <argument>${m3.jackson.maven}</argument>
                <argument>--maven-repo</argument>
                <argument>${m3.jackson.maven.repo}</argument>
                <argument>--maven-offline</argument>
                <argument>${m3.jackson.maven.offline}</argument>
                <argument>--repo-root</argument>
                <argument>${m3.jackson.repo.root}</argument>
                <argument>--stage</argument>
                <argument>${m3.jackson.stage}</argument>
                <argument>--out</argument>
                <argument>${m3.jackson.out}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>m3-recipe-boot</id>
      <activation>
        <file>
          <exists>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</exists>
        </file>
      </activation>
      <properties>
        <m3.recipe.boot.skip>false</m3.recipe.boot.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <inherited>true</inherited>
            <dependencies>
              <dependency>
                <groupId>com.synexia.m3</groupId>
                <artifactId>m3-pr-stack-preservation</artifactId>
                <version>1.0.0-m3boot20261021</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-recipe-boot</id>
                <phase>validate</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <skip>${m3.recipe.boot.skip}</skip>
                  <mainClass>com.synexia.m3.prstack.M3RecipeBoot</mainClass>
                  <includeProjectDependencies>false</includeProjectDependencies>
                  <includePluginDependencies>true</includePluginDependencies>
                  <arguments>
                    <argument>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</argument>
                    <argument>${project.basedir}</argument>
                    <argument>${session.projects[0].basedir.absolutePath}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
