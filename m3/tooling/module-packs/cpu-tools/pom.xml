<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3.tooling</groupId>
  <artifactId>m3-cpu-tools-pack</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>M3 CPU tools JMOD and linked-image qualification</name>
  <description>Reuse existing M3 text, file, compiler and JMOD owners to build and test twenty optional modules.</description>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <m3.jdk>${java.home}</m3.jdk>
    <m3.python>python3</m3.python>
    <m3.cpu.out>${project.build.directory}/cpu-tools-image</m3.cpu.out>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <id>cpu-build-path-and-timeout-contracts</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${m3.python}</executable>
              <arguments>
                <argument>-B</argument>
                <argument>${project.basedir}/fixtures/test_build.py</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>compile-package-link-and-run-cpu-tools</id>
            <phase>verify</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${m3.python}</executable>
              <arguments>
                <argument>-B</argument>
                <argument>${project.basedir}/build.py</argument>
                <argument>--jdk-home</argument><argument>${m3.jdk}</argument>
                <argument>--out</argument><argument>${m3.cpu.out}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
