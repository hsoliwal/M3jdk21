{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M3 naming authority with permanent migration extension v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "mappings": {
      "type": "array"
    },
    "migration": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "baseline_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "observed_tip": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "visibility": {
              "enum": [
                "public",
                "private"
              ]
            },
            "tracking_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "repo",
            "baseline_commit",
            "visibility"
          ],
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "baseline_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "observed_tip": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "visibility": {
              "enum": [
                "public",
                "private"
              ]
            },
            "tracking_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "repo",
            "baseline_commit",
            "visibility"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "source_tree_complete": {
              "type": "boolean"
            },
            "dependency_closure_complete": {
              "type": "boolean"
            },
            "inventory_receipt": {
              "type": [
                "string",
                "null"
              ]
            },
            "uninspected_domains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "source_tree_complete",
            "dependency_closure_complete",
            "inventory_receipt",
            "uninspected_domains"
          ],
          "additionalProperties": false
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "open",
                  "passed",
                  "failed",
                  "blocked",
                  "not-applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "status",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      },
      "required": [
        "version",
        "source",
        "target",
        "coverage",
        "gates",
        "records"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "mappings",
    "migration"
  ],
  "additionalProperties": true,
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "git_blob_sha1": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision_role": {
          "enum": [
            "pinned",
            "candidate",
            "unobserved"
          ]
        },
        "tracking_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "repo",
        "commit",
        "module",
        "path",
        "symbol",
        "signatures",
        "sha256",
        "git_blob_sha1",
        "fingerprint",
        "revision_role"
      ],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "direct-port",
            "rename",
            "adapter",
            "consolidation",
            "specialization",
            "dependency-reuse",
            "pending",
            "excluded",
            "tombstone"
          ]
        },
        "status": {
          "enum": [
            "implemented-tested",
            "implemented-unverified",
            "pending",
            "blocked",
            "excluded",
            "tombstone"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "generation": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "namespace",
            "generation"
          ],
          "additionalProperties": false
        },
        "contract": {
          "type": "object",
          "properties": {
            "differences": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "compatibility_obligations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "public_surface": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "differences",
            "compatibility_obligations",
            "public_surface"
          ],
          "additionalProperties": false
        },
        "format": {
          "type": "object",
          "properties": {
            "schema": {
              "type": [
                "string",
                "null"
              ]
            },
            "abi": {
              "type": [
                "string",
                "null"
              ]
            },
            "bootstrap": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "schema",
            "abi",
            "bootstrap"
          ],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "resolution": {
                "enum": [
                  "resolved",
                  "pending",
                  "blocked"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "resolution",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "materialization": {
          "type": "object",
          "properties": {
            "admission": {
              "type": "string",
              "minLength": 1
            },
            "joins": {
              "type": "string",
              "minLength": 1
            },
            "outputs": {
              "type": "string",
              "minLength": 1
            },
            "cached_facts": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "admission",
            "joins",
            "outputs",
            "cached_facts"
          ],
          "additionalProperties": false
        },
        "recipe": {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "preconditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rollback": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "version",
            "path",
            "sha256",
            "preconditions",
            "rollback"
          ],
          "additionalProperties": false
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "receipt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "receipt"
            ],
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "license": {
              "type": "string",
              "minLength": 1
            },
            "publication": {
              "type": "string",
              "minLength": 1
            },
            "copied_code": {
              "type": "boolean"
            }
          },
          "required": [
            "license",
            "publication",
            "copied_code"
          ],
          "additionalProperties": false
        },
        "sync": {
          "type": "object",
          "properties": {
            "source_revision": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "target_revision": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "direction": {
              "enum": [
                "source-to-target",
                "target-to-source-proposal",
                "traceability-only"
              ]
            },
            "target_adaptations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pending": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "conflicts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "source_revision",
            "target_revision",
            "direction",
            "target_adaptations",
            "pending",
            "conflicts"
          ],
          "additionalProperties": false
        },
        "lineage": {
          "type": "object",
          "properties": {
            "previous_sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/artifact"
              }
            },
            "previous_targets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/artifact"
              }
            },
            "supersedes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "previous_sources",
            "previous_targets",
            "supersedes"
          ],
          "additionalProperties": false
        },
        "source_state": {
          "enum": [
            "implemented",
            "experimental",
            "proposed",
            "duplicate",
            "superseded",
            "partial",
            "blocked",
            "absent",
            "uninspected"
          ]
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "reason",
        "sources",
        "targets",
        "owner",
        "identity",
        "contract",
        "format",
        "dependencies",
        "materialization",
        "recipe",
        "tests",
        "provenance",
        "sync",
        "lineage"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "exit_code": {
                "type": "integer"
              },
              "command": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "stdout_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "stdout_path": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "required": [
              "id",
              "status",
              "exit_code",
              "command",
              "stdout_sha256",
              "inputs"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "runs"
      ],
      "additionalProperties": true
    }
  }
}
