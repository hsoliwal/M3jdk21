<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.m3</groupId>
    <artifactId>m3jdk21-control-reactor</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>a3</artifactId>
  <name>M3 A3 absorption tooling</name>

  <properties>
    <m3.synexia.a3.version>1.0.0-SNAPSHOT</m3.synexia.a3.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.synexia</groupId>
      <artifactId>synexia-jdk-a3-recipes</artifactId>
      <version>${m3.synexia.a3.version}</version>
    </dependency>
    <dependency>
      <groupId>com.m3.tooling</groupId>
      <artifactId>migration-recipes</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2-m3-source-1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <failIfNoTests>true</failIfNoTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>m3-a3-backport-completion</id>
      <properties>
        <m3.a3.root>${maven.multiModuleProjectDirectory}/..</m3.a3.root>
        <m3.a3.queue>m3/build/backports/COMPATIBILITY_QUEUE.tsv</m3.a3.queue>
        <m3.a3.completion.out>m3/build/a3/completion</m3.a3.completion.out>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>m3-a3-inventory-current-tree</id>
                <phase>verify</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>com.m3.a3.A3</mainClass>
                  <arguments>
                    <argument>inv</argument>
                    <argument>--root</argument>
                    <argument>${m3.a3.root}</argument>
                    <argument>--out</argument>
                    <argument>m3/build/a3/inventory.tsv</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>m3-a3-fan-in-backport-queue</id>
                <phase>verify</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>com.m3.a3.A3</mainClass>
                  <arguments>
                    <argument>complete</argument>
                    <argument>--root</argument>
                    <argument>${m3.a3.root}</argument>
                    <argument>--inventory</argument>
                    <argument>m3/build/a3/inventory.tsv</argument>
                    <argument>--queue</argument>
                    <argument>${m3.a3.queue}</argument>
                    <argument>--out</argument>
                    <argument>${m3.a3.completion.out}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>m3-a3-algorithm-catalogue</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.m3.tooling</groupId>
                <artifactId>migration-recipes</artifactId>
                <version>${project.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <activeRecipes>
                <recipe>com.m3.a3.AlgorithmCatalogue</recipe>
              </activeRecipes>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <failOnDryRunResults>false</failOnDryRunResults>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>m3-a3-serial-file-work</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.m3.tooling</groupId>
                <artifactId>migration-recipes</artifactId>
                <version>${project.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <activeRecipes>
                <recipe>com.m3.a3.SerialFileWork</recipe>
              </activeRecipes>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <failOnDryRunResults>false</failOnDryRunResults>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
      <profile>
      <id>m3-synexia-atom-pattern</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.synexia</groupId>
                <artifactId>synexia-openrewrite-recipes</artifactId>
                <version>1.0.0-SNAPSHOT</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-synexia-atom-pattern-verify</id>
                <phase>verify</phase>
                <goals><goal>dryRun</goal></goals>
              </execution>
            </executions>
            <configuration>
              <activeRecipes><recipe>com.synexia.m3.EveryModuleAtomPatternApplication</recipe></activeRecipes>
              <exportDatatables>true</exportDatatables>
              <runPerSubmodule>false</runPerSubmodule>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <failOnDryRunResults>false</failOnDryRunResults>
              <additionalPlainTextMasks>
                <additionalPlainTextMask>**/*.md</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.markdown</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.adoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.asciidoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.c</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.h</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle.kts</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.sh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bash</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cmd</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bat</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ps1</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.py</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.pyi</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.csv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.tsv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ndjson</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.txt</additionalPlainTextMask>
                <additionalPlainTextMask>**/README</additionalPlainTextMask>
                <additionalPlainTextMask>**/LICENSE</additionalPlainTextMask>
                <additionalPlainTextMask>**/NOTICE</additionalPlainTextMask>
              </additionalPlainTextMasks>
              <exclusions>
                <exclusion>**/target/**</exclusion>
                <exclusion>**/generated-sources/**</exclusion>
                <exclusion>**/out/**</exclusion>
                <exclusion>**/scratch/**</exclusion>
                <exclusion>**/.merge-preserved/**</exclusion>
                <exclusion>**/.superset/**</exclusion>
                <exclusion>**/.m3/maven-superset-*/**</exclusion>
                <exclusion>**/archive-maven-projects/**</exclusion>
                <exclusion>**/tasks/**</exclusion>
                <exclusion>**/verification/**</exclusion>
                <exclusion>**/evidence/**</exclusion>
                <exclusion>**/history/**</exclusion>
                <exclusion>**/template-history/**</exclusion>
                <exclusion>**/receiving-input/**</exclusion>
                <exclusion>**/input-epoch/**</exclusion>
                <exclusion>**/src/test/resources/**</exclusion>
                <exclusion>**/upstream-excluded/**</exclusion>
                <exclusion>**/*custody*/**</exclusion>
                <exclusion>**/vendor/**</exclusion>
              </exclusions>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>m3-synexia-atom-pattern-mastery</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.synexia</groupId>
                <artifactId>synexia-openrewrite-recipes</artifactId>
                <version>1.0.0-SNAPSHOT</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-synexia-atom-pattern-mastery-verify</id>
                <phase>verify</phase>
                <goals><goal>dryRun</goal></goals>
              </execution>
            </executions>
            <configuration>
              <activeRecipes><recipe>com.synexia.m3.EveryModuleAtomPatternMastery</recipe></activeRecipes>
              <exportDatatables>true</exportDatatables>
              <runPerSubmodule>false</runPerSubmodule>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <failOnDryRunResults>false</failOnDryRunResults>
              <additionalPlainTextMasks>
                <additionalPlainTextMask>**/*.md</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.markdown</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.adoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.asciidoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.c</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.h</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle.kts</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.sh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bash</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cmd</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bat</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ps1</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.py</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.pyi</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.csv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.tsv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ndjson</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.txt</additionalPlainTextMask>
                <additionalPlainTextMask>**/README</additionalPlainTextMask>
                <additionalPlainTextMask>**/LICENSE</additionalPlainTextMask>
                <additionalPlainTextMask>**/NOTICE</additionalPlainTextMask>
              </additionalPlainTextMasks>
              <exclusions>
                <exclusion>**/target/**</exclusion>
                <exclusion>**/generated-sources/**</exclusion>
                <exclusion>**/out/**</exclusion>
                <exclusion>**/scratch/**</exclusion>
                <exclusion>**/.merge-preserved/**</exclusion>
                <exclusion>**/.superset/**</exclusion>
                <exclusion>**/.m3/maven-superset-*/**</exclusion>
                <exclusion>**/archive-maven-projects/**</exclusion>
                <exclusion>**/tasks/**</exclusion>
                <exclusion>**/verification/**</exclusion>
                <exclusion>**/evidence/**</exclusion>
                <exclusion>**/history/**</exclusion>
                <exclusion>**/template-history/**</exclusion>
                <exclusion>**/receiving-input/**</exclusion>
                <exclusion>**/input-epoch/**</exclusion>
                <exclusion>**/src/test/resources/**</exclusion>
                <exclusion>**/upstream-excluded/**</exclusion>
                <exclusion>**/*custody*/**</exclusion>
                <exclusion>**/vendor/**</exclusion>
              </exclusions>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
</profiles>

</project>
