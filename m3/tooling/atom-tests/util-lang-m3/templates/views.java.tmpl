//@@ PATTERN ARRAY_STABLE_SORT | uses=SLOT_VALUES | oracle=List.sort stable order; bulk-copy runs; reentrancy rejected
    /** ${atom}(indexes, comparator, version, stateAware) stably sorts slot indexes by their payloads. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 4);
        Fixture f = new Fixture();
        for (int i = 0; i < ITEMS * QUARTER; i++) {
            f.append(new Item(i < ITEMS * 2 ? 0 : i % RANKS, ITEMS + i));
        }
        int[] slots = new int[f.model.size()];
        for (int i = 0; i < slots.length; i++) {
            slots[i] = (int) f.backing.handleAt(i);
        }
        List<Item> expected = new ArrayList<>(f.model);
        expected.sort(BY_RANK);
        atom.invoke(f.backing, slots, BY_RANK, f.backing.version(), false);
        assertEquals(expected, slotValues(f, slots), "${atom} matches List.sort");
        Comparator<Item> mutating = (x, y) -> {
            f.append(new Item(0, -1));
            return 0;
        };
        int[] again = slots.clone();
        assertThrows(ConcurrentModificationException.class,
                () -> atom.invoke(f.backing, again, mutating, f.backing.version(), false));
        int[] single = {slots[0]};
        atom.invoke(f.backing, single, mutating, f.backing.version(), false);
        assertEquals(slots[0], single[0], "fewer than two slots never compare");
    }
