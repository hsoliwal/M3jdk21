//@@ PATTERN ARRAY_ALLOCATE_SLOT | uses= | oracle=LIFO free-list reuse; fresh slots start at generation 1
    /** ${atom}() reuses the most recently freed slot first, else allocates the next slot at generation 1. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 0);
        Fixture f = new Fixture();
        int allocated = (int) OWNER.field("allocated").get(f.backing);
        long first = f.handles.get(0);
        long second = f.handles.get(2);
        assertTrue(f.backing.remove(first));
        assertTrue(f.backing.remove(second));
        assertEquals((int) second, (int) atom.invoke(f.backing), "the last freed slot is reused first");
        assertEquals((int) first, (int) atom.invoke(f.backing));
        int fresh = (int) atom.invoke(f.backing);
        assertEquals(allocated, fresh, "then a new slot");
        assertEquals(1, ((int[]) OWNER.field("generations").get(f.backing))[fresh]);
    }
//@@ PATTERN ARRAY_VALID_SLOT | uses= | oracle=generation-qualified handle validation
    /** ${atom}(handle) accepts live handles and rejects stale, forged or out-of-range ones. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 1);
        Fixture f = new Fixture();
        long live = f.handles.get(0);
        assertEquals((int) live, (int) atom.invoke(f.backing, live));
        long removable = f.handles.get(2);
        assertTrue(f.backing.remove(removable));
        long recycled = f.backing.append(new Item(1, ITEMS));
        assertEquals((int) removable, (int) recycled, "the slot is reused under a new generation");
        String stale = "stale or invalid M3 handle";
        for (long bad : new long[] {removable, (int) live, live + ((long) ITEMS << Integer.SIZE), (long) ITEMS * ITEMS, -1L}) {
            assertEquals(stale, assertThrows(IllegalArgumentException.class, () -> atom.invoke(f.backing, bad)).getMessage(),
                    "${atom} rejects " + Long.toHexString(bad));
        }
    }
//@@ PATTERN ARRAY_UPDATE_LEASE_MASK | uses= | oracle=LIVE, plus LEASED when count > 0 and SHARED when count > 1; state epoch bump
    /** ${atom}(slot) derives the state bits from the lease count and bumps only the state epoch. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 1);
        Fixture f = new Fixture();
        int slot = (int) (long) f.handles.get(0);
        int[] leases = (int[]) OWNER.field("leaseCounts").get(f.backing);
        int[] expectedStates = {M3IndexedArray.LIVE, M3IndexedArray.LIVE | M3IndexedArray.LEASED,
                M3IndexedArray.LIVE | M3IndexedArray.LEASED | M3IndexedArray.SHARED};
        for (int owners = 0; owners < expectedStates.length; owners++) {
            leases[slot] = owners;
            long version = f.backing.version();
            long epoch = stateVersion(f);
            atom.invoke(f.backing, slot);
            assertEquals(expectedStates[owners], ((int[]) OWNER.field("states").get(f.backing))[slot], "owners=" + owners);
            assertEquals(version, f.backing.version(), "values unchanged");
            assertEquals(epoch + 1, stateVersion(f), "${atom} bumps the state epoch");
        }
        leases[slot] = 0;
        atom.invoke(f.backing, slot);
    }
