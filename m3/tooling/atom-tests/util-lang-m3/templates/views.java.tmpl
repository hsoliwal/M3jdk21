//@@ PATTERN VIEW_ITERATOR_FOR | uses= | oracle=ArrayList.subList(origin, origin + count).listIterator(index)
    /** ${atom}(expected, origin, count, index) iterates the root directory window [origin, origin + count). */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 4);
        forEachKind((f, kind, view, expected) -> {
            int n = view.size();
            int origin = n / QUARTER;
            int count = n - 2 * origin;
            for (int index : new int[] {0, count / 2, count}) {
                @SuppressWarnings("unchecked")
                ListIterator<Item> it = (ListIterator<Item>) atom.invoke(view, version(f, kind), origin, count, index);
