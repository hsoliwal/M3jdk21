//@@ PATTERN VIEW_REFRESH | uses= | oracle=lazy directory identity and AbstractList.modCount
    /** ${atom}() selects lazily, reuses the directory while the epoch is unchanged and rebuilds after a change. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 0);
        VarHandle indexedVersion = OWNER.field("indexedVersion");
        VarHandle modCount = new Access("java.util.AbstractList").field("modCount");
        forEachKind((f, kind, view, expected) -> {
            assertEquals(Long.MIN_VALUE, (long) indexedVersion.get(view), "nothing selected before use");
            assertEquals(0, indexes(view).length);
            atom.invoke(view);
            int[] first = indexes(view);
            assertEquals(version(f, kind), (long) indexedVersion.get(view));
            assertEquals(expected.size(), first.length, "${atom} selection size " + kind);
            int mods = (int) modCount.get(view);
            atom.invoke(view);
            assertSame(first, indexes(view), "unchanged epoch keeps the directory");
            assertEquals(mods, (int) modCount.get(view));
            f.append(new Item(1, ITEMS));
            atom.invoke(view);
            assertNotSame(first, indexes(view), "a new epoch rebuilds the directory");
            assertEquals(mods + 1, (int) modCount.get(view), "each rebuild bumps modCount");
            assertEquals(f.expected(kind), view);
        });
    }
