    }
//@@ PATTERN VIEW_RANGE | uses= | oracle=ArrayList.subList contents; exact range messages
    /** ${atom}(expected, origin, count, from, to) windows absolute coordinates and validates the range. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 5);
        forEachKind((f, kind, view, expected) -> {
            int n = view.size();
            long v = version(f, kind);
            int origin = n / QUARTER;
            int count = n - origin;
            @SuppressWarnings("unchecked")
            List<Item> window = (List<Item>) atom.invoke(view, v, origin, count, 1, count);
            assertEquals(expected.subList(origin + 1, origin + count), window, "${atom} " + kind);
            assertEquals("fromIndex = -1",
                    assertThrows(IndexOutOfBoundsException.class, () -> atom.invoke(view, v, origin, count, -1, 0))
                            .getMessage());
            assertEquals("toIndex = " + (count + 1),
                    assertThrows(IndexOutOfBoundsException.class, () -> atom.invoke(view, v, origin, count, 0, count + 1))
                            .getMessage());
            assertEquals("fromIndex(1) > toIndex(0)",
                    assertThrows(IllegalArgumentException.class, () -> atom.invoke(view, v, origin, count, 1, 0))
                            .getMessage());
        });
    }
//@@ PATTERN VIEW_CURRENT_VERSION | uses= | oracle=M3IndexedArray.version / stateVersion epochs
    /** ${atom}() is the value epoch for plain views and the state epoch for state-aware views. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 0);
        forEachKind((f, kind, view, expected) -> {
            assertEquals(version(f, kind), (long) atom.invoke(view), "${atom} " + kind);
            long before = (long) atom.invoke(view);
            f.lease(0);
            assertEquals(kind.stateAware, before != (long) atom.invoke(view), "a lease moves only the state epoch");
            f.append(new Item(1, ITEMS));
            assertEquals(version(f, kind), (long) atom.invoke(view), "${atom} after append " + kind);
        });
    }
