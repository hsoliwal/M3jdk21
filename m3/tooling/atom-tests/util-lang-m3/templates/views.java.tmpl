//@@ CONSTANTS
    /** Backing size, rank alphabet and the deterministic rank stride of the fixture. */
    private static final int ITEMS = 40;
    private static final int RANKS = 7;
    private static final int RANK_STRIDE = 5;
    /** Items whose rank is a multiple of this are filtered out by KEEP. */
    private static final int KEEP_MODULUS = 3;
    /** Every LEASE_PERIOD-th item (offset 1) holds one lease; item SHARED_ITEM holds two. */
    private static final int LEASE_PERIOD = 4;
    private static final int SHARED_ITEM = 5;
    private static final int QUARTER = 4;
    private static final Comparator<Item> BY_RANK = Comparator.comparingInt(Item::rank);
    private static final Predicate<Item> KEEP = item -> item.rank() % KEEP_MODULUS != 0;
    private static final String READ_ONLY = "read-only M3 view";
//@@ HELPERS
    record Item(int rank, int id) { }

    /** The seven view factories of M3IndexedArray: predicate, comparator and state-mask selection. */
    enum Kind {
        FILTERED(true, false, false), SORTED(false, true, false), FILTERED_SORTED(true, true, false),
        MASKED(false, false, true), MASKED_SORTED(false, true, true), FILTERED_MASKED(true, false, true),
        FILTERED_MASKED_SORTED(true, true, true);

        final boolean filtered;
        final boolean sorted;
        final boolean stateAware;

        Kind(boolean filtered, boolean sorted, boolean stateAware) {
            this.filtered = filtered;
            this.sorted = sorted;
            this.stateAware = stateAware;
        }
    }

    /** A backing store and its java.util.ArrayList model with lease counts: the oracle for every view. */
    static final class Fixture {
        final M3IndexedArray<Item> backing = new M3IndexedArray<>();
        final List<Item> model = new ArrayList<>();
        final List<Long> handles = new ArrayList<>();
        final Map<Long, Integer> leases = new HashMap<>();

        Fixture() {
            for (int i = 0; i < ITEMS; i++) {
                append(new Item(i * RANK_STRIDE % RANKS, i));
            }
            for (int i = 1; i < ITEMS; i += LEASE_PERIOD) {
                lease(i);
            }
            lease(SHARED_ITEM);
        }

        void append(Item item) {
            handles.add(backing.append(item));
            model.add(item);
        }

        void lease(int index) {
            long handle = handles.get(index);
            backing.retain(handle);
            leases.merge(handle, 1, Integer::sum);
        }

        List<Item> view(Kind kind) {
            int live = M3IndexedArray.LIVE;
            int leased = M3IndexedArray.LEASED;
            return switch (kind) {
                case FILTERED -> backing.filtered(KEEP);
                case SORTED -> backing.sorted(BY_RANK);
                case FILTERED_SORTED -> backing.filteredSorted(KEEP, BY_RANK);
                case MASKED -> backing.maskedStates(live, leased);
                case MASKED_SORTED -> backing.maskedSortedStates(live, leased, BY_RANK);
                case FILTERED_MASKED -> backing.filteredMaskedStates(KEEP, live, leased);
                case FILTERED_MASKED_SORTED -> backing.filteredMaskedSortedStates(KEEP, live, leased, BY_RANK);
            };
        }

        /** Logical order, then predicate and unleased-state selection, then a stable sort (List.sort). */
        List<Item> expected(Kind kind) {
            List<Item> out = new ArrayList<>();
            for (int i = 0; i < model.size(); i++) {
                Item item = model.get(i);
                boolean unleased = leases.getOrDefault(handles.get(i), 0) == 0;
                if ((!kind.filtered || KEEP.test(item)) && (!kind.stateAware || unleased)) {
                    out.add(item);
                }
            }
            if (kind.sorted) {
                out.sort(BY_RANK);
            }
            return out;
        }
    }

    interface KindCheck {
        void check(Fixture f, Kind kind, List<Item> view, List<Item> expected) throws Throwable;
    }

    static void forEachKind(KindCheck check) throws Throwable {
        for (Kind kind : Kind.values()) {
            Fixture f = new Fixture();
            check.check(f, kind, f.view(kind), f.expected(kind));
        }
    }

    /** The class or "none" of the first throwable raised by {@code action}. */
    static String thrown(Supplier<?> action) {
        try {
            action.get();
            return "none";
        } catch (RuntimeException e) {
            return e.getClass().getName();
        }
    }

    /** Scripted forward-then-backward walk recording only the focused ListIterator method. */
    static List<Object> trace(ListIterator<Item> it, String focus) {
        List<Object> out = new ArrayList<>();
        while (true) {
            observe(it, focus, out);
            if (!it.hasNext()) {
                break;
            }
            Item value = it.next();
            if (focus.equals("next")) {
                out.add(value);
            }
        }
        if (focus.equals("next")) {
            out.add(thrown(it::next));
        }
        while (true) {
            observe(it, focus, out);
            if (!it.hasPrevious()) {
                break;
            }
            Item value = it.previous();
            if (focus.equals("previous")) {
                out.add(value);
            }
        }
        if (focus.equals("previous")) {
            out.add(thrown(it::previous));
        }
        return out;
    }

    private static void observe(ListIterator<Item> it, String focus, List<Object> out) {
        switch (focus) {
            case "hasNext" -> out.add(it.hasNext());
            case "hasPrevious" -> out.add(it.hasPrevious());
            case "nextIndex" -> out.add(it.nextIndex());
            case "previousIndex" -> out.add(it.previousIndex());
            default -> { }
        }
    }

    /** All elements of a spliterator, splitting recursively; split sizes are part of the record. */
    static List<Object> splitTrace(Spliterator<Item> s) {
        List<Object> out = new ArrayList<>();
        Spliterator<Item> prefix = s.trySplit();
        if (prefix != null) {
            out.add("split" + prefix.estimateSize() + "/" + s.estimateSize());
            out.addAll(splitTrace(prefix));
            out.addAll(splitTrace(s));
        } else {
            s.forEachRemaining(out::add);
        }
        return out;
    }

    static long version(Fixture f, Kind kind) {
        return kind.stateAware ? stateVersion(f) : f.backing.version();
    }

    static long stateVersion(Fixture f) {
        try {
            return (long) new Access("jdk.internal.m3.M3IndexedArray").method("stateVersion", 0).invoke(f.backing);
        } catch (Throwable e) {
            throw new AssertionError(e);
        }
    }

    static int[] indexes(List<Item> view) {
        return (int[]) OWNER.field("indexes").get(view);
    }
