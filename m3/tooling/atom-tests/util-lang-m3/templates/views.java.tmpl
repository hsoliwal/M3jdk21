//@@ PATTERN SPLIT_TRY_ADVANCE | uses= | oracle=ArrayList spliterator order; NPE; fail-fast after the action
    /** ${atom}(action) delivers in order, ends with false, rejects null and fails fast after a mutating action. */
    @Test
    void ${test}() throws Throwable {
        forEachKind((f, kind, view, expected) -> {
            Spliterator<Item> s = view.spliterator();
            List<Item> seen = new ArrayList<>();
            while (s.${atom}(seen::add)) {
                assertTrue(seen.size() <= expected.size(), "${atom} terminates");
            }
            assertEquals(expected, seen, "${atom} " + kind);
            assertFalse(s.${atom}(seen::add), "${atom} stays exhausted");
            assertThrows(NullPointerException.class, () -> view.spliterator().${atom}(null));
            Spliterator<Item> mutating = view.spliterator();
            List<Item> delivered = new ArrayList<>();
            assertThrows(ConcurrentModificationException.class, () -> mutating.${atom}(item -> {
                delivered.add(item);
                f.append(new Item(1, ITEMS));
            }));
            assertEquals(List.of(expected.get(0)), delivered, "the value is delivered before the epoch check");
        });
    }
