//@@ PATTERN LEAF_NEXT | uses= | oracle=leaf count of the tuple DAG; coalescing of adjacent ranges of one owner
    /** ${atom}() visits every leaf once (or merged adjacent ranges of one owner) and then returns false. */
    @Test
    void ${test}() throws Throwable {
        Access cursor = new Access("java.lang.M3StringLeafCursor");
        MethodHandle make = cursor.constructor("M3StringLeafCursor", 2);
        MethodHandle atom = cursor.method("${atom}", 0);
        String a = "alpha".repeat(PIECE_UNITS);
        String b = "beta" + PAIR;
        Object atomA = m3(a);
        Object split = tupleOf(((CharSequence) atomA).subSequence(0, PIECE_UNITS),
                ((CharSequence) atomA).subSequence(PIECE_UNITS, a.length()));
        Object source = tupleOf(split, m3(b));
        int raw = 0;
        Object c = make.invoke(source, false);
        while ((boolean) atom.invoke(c)) {
            raw++;
        }
        assertFalse((boolean) atom.invoke(c), "${atom} stays exhausted");
        int merged = 0;
        Object d = make.invoke(source, true);
        while ((boolean) atom.invoke(d)) {
            merged++;
        }
        assertEquals(text(source), a + b);
        assertEquals(1 + 1 + 1, raw, "three visible leaf occurrences");
        assertEquals(1 + 1, merged, "two adjacent ranges of one owner coalesce into one leaf");
    }
//@@ PATTERN LEAF_ACCESSOR | uses= | oracle=leaf range text equals the next unread slice of the source
    /** ${atom}() describes the current leaf: its range text is the next unread slice of the source. */
    @Test
    void ${test}() throws Throwable {
        Access cursor = new Access("java.lang.M3StringLeafCursor");
        String left = "x".repeat(PIECE_UNITS) + PAIR;
        String right = "y" + (char) E_ACUTE;
        Object source = m3Tuple(left, right);
        Object c = cursor.constructor("M3StringLeafCursor", 2).invoke(source, false);
        int consumed = 0;
        String expected = left + right;
        while ((boolean) cursor.method("next", 0).invoke(c)) {
            Object owner = cursor.method("owner", 0).invoke(c);
            int start = (int) cursor.method("start", 0).invoke(c);
            int length = (int) cursor.method("length", 0).invoke(c);
            assertTrue(length > 0, "${atom}: empty leaves are never reported");
            int ownerLength = (int) new Access("java.lang.M3StringOwner").field("length").get(owner);
            assertTrue(start >= 0 && start + length <= ownerLength, "${atom}: range inside the owner");
            assertEquals(expected.substring(consumed, consumed + length), text(RANGE.invoke(owner, start, length)),
                    "${atom} at " + consumed);
            consumed += length;
        }
        assertEquals(expected.length(), consumed);
    }
//@@ PATTERN LEAF_PUSH | uses= | oracle=pending stack size, doubling growth and range check
    /** ${atom}(owner, offset, count) stacks a range (doubling the lanes) and skips empty ranges. */
    @Test
    void ${test}() throws Throwable {
        Access cursor = new Access("java.lang.M3StringLeafCursor");
        Object source = m3("pushed-" + "z".repeat(PIECE_UNITS));
        Object owner = OWNER_OF.invoke(source);
        Object c = cursor.constructor("M3StringLeafCursor", 2).invoke(m3(""), false);
        MethodHandle atom = cursor.method("${atom}", 3);
        VarHandle size = cursor.field("pendingSize");
        int initial = ((Object[]) cursor.field("pendingOwners").get(c)).length;
        atom.invoke(c, owner, 0, 0);
        assertEquals(0, (int) size.get(c), "empty ranges are not stacked");
        for (int i = 0; i <= initial; i++) {
            atom.invoke(c, owner, i, 1);
        }
        assertEquals(initial + 1, (int) size.get(c));
        assertEquals(initial * 2, ((Object[]) cursor.field("pendingOwners").get(c)).length, "${atom} doubles");
        assertThrows(IndexOutOfBoundsException.class, () -> atom.invoke(c, owner, 1, ((CharSequence) source).length()));
        StringBuilder lifo = new StringBuilder();
        while ((boolean) cursor.method("next", 0).invoke(c)) {
            lifo.append(text(RANGE.invoke(cursor.method("owner", 0).invoke(c),
                    (int) cursor.method("start", 0).invoke(c), (int) cursor.method("length", 0).invoke(c))));
        }
        assertEquals(new StringBuilder(text(source).substring(0, initial + 1)).reverse().toString(), lifo.toString(),
                "the pending stack is consumed last-in first-out");
    }
