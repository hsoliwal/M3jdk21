//@@ PATTERN LANE_COPY_OUT | uses=LANE_SCRIPT | oracle=java.lang.StringBuilder logical content, prefix preserved
    /** ${atom}(flat, flatCoder, flatCount, dst, dstBegin, dstCoder) writes the logical content at dstBegin. */
    @Test
    void ${test}() throws Throwable {
        for (boolean wideFlat : new boolean[] {false, true}) {
            for (boolean widePiece : new boolean[] {false, true}) {
                LaneScript script = new LaneScript(wideFlat, widePiece);
                byte coder = script.logicalCoder();
                String prefix = "<<";
                byte[] dst = encode(prefix + "?".repeat(script.logical.length()), coder);
                script.lane.method("${atom}", 6).invoke(script.instance, script.flatBytes(), script.flatCoder,
                        script.flat.length(), dst, prefix.length(), coder);
                assertEquals(prefix + script.logical, decode(dst, 0, prefix.length() + script.logical.length(), coder),
                        "${atom} wideFlat=" + wideFlat + " widePiece=" + widePiece);
            }
        }
    }
//@@ PATTERN LANE_COPY_FLAT | uses= | oracle=same-coder copy and Latin-1 inflation
    /** ${atom}(src, srcCoder, from, to, dst, out, dstCoder) copies or inflates [from, to) and returns the new end. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = new Access("java.lang.M3StringBuilderLane").method("${atom}", 7);
        String latin = "flat-" + (char) E_ACUTE + "-chunk";
        byte[][] cases = {{LATIN1, LATIN1}, {UTF16, UTF16}, {LATIN1, UTF16}};
        for (byte[] coders : cases) {
            byte[] src = encode(latin, coders[0]);
            byte[] dst = encode("_".repeat(latin.length() + 1), coders[1]);
            int end = (int) atom.invoke(src, coders[0], 2, latin.length() - 1, dst, 1, coders[1]);
            assertEquals(1 + latin.length() - 1 - 2, end, "${atom} returns out + length");
            String copied = latin.substring(2, latin.length() - 1);
            String expected = new StringBuilder("_".repeat(latin.length() + 1))
                    .replace(1, 1 + copied.length(), copied).toString();
            assertEquals(expected, decode(dst, 0, latin.length() + 1, coders[1]), "${atom} " + Arrays.toString(coders));
        }
    }
//@@ PATTERN LANE_DETACHED | uses=LANE_SCRIPT | oracle=exact-length copy of the StringBuilder content
    /** ${atom}(flat, flatCoder, flatCount, logicalCoder) is an exact-length copy of the logical content. */
    @Test
    void ${test}() throws Throwable {
        for (boolean widePiece : new boolean[] {false, true}) {
            LaneScript script = new LaneScript(false, widePiece);
            byte coder = script.logicalCoder();
            byte[] copy = (byte[]) script.lane.method("${atom}", 4).invoke(script.instance, script.flatBytes(),
                    script.flatCoder, script.flat.length(), coder);
            assertEquals(script.logical.length() * (coder == LATIN1 ? 1 : 2), copy.length, "${atom} exact length");
            assertEquals(script.logical.toString(), decode(copy, 0, script.logical.length(), coder));
        }
    }
//@@ PATTERN LANE_COMPOSE | uses= | oracle=admitted flat chunk text; cache identity; null while admission is off
    /** ${atom}(flat, coder, count) admits a piece-free lane's flat chunk once (cached) and declines while admitting. */
    @Test
    void ${test}() throws Throwable {
        Access lane = new Access("java.lang.M3StringBuilderLane");
        Object l = lane.constructor("M3StringBuilderLane", 1).invoke(PIECE_UNITS);
        String flat = "compose-" + (char) E_ACUTE + "-flat";
        byte[] bytes = encode(flat, LATIN1);
        MethodHandle atom = lane.method("${atom}", 3);
        ThreadLocal<Boolean> admitting = (ThreadLocal<Boolean>) M3_STRING.constant("ADMITTING");
        admitting.set(Boolean.TRUE);
        try {
            assertEquals(null, atom.invoke(l, bytes, LATIN1, flat.length()), "${atom} declines while admitting");
        } finally {
            admitting.remove();
        }
        Object composed = atom.invoke(l, bytes, LATIN1, flat.length());
        assertEquals(flat, text(composed), "${atom} text");
        assertSame(composed, atom.invoke(l, bytes, LATIN1, flat.length()), "${atom} caches per (flatCount, pieces)");
        Object shorter = atom.invoke(l, bytes, LATIN1, flat.length() - 1);
        assertEquals(flat.substring(0, flat.length() - 1), text(shorter), "a new flat count recomposes");
    }
