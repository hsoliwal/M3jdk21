//@@ CONSTANTS
    private static final Access M3_STRING = new Access("java.lang.M3String");
    private static final Access POOL = new Access("java.lang.M3StringPool");
    private static final Access JAVA_STRING = new Access("java.lang.String");
    private static final MethodHandle INTERN_CHARS = POOL.method("internChars", 3);
    private static final MethodHandle CONCAT = POOL.method("concat", 2);
    private static final MethodHandle RANGE = M3_STRING.method("range", 3);
    private static final MethodHandle OWNER_OF = M3_STRING.method("owner", 0);
    private static final MethodHandle START_OF = M3_STRING.method("start", 0);
    private static final MethodHandle COORDINATE_OF = M3_STRING.method("coordinate", 0);
    private static final byte LATIN1 = (byte) JAVA_STRING.constant("LATIN1");
    private static final byte UTF16 = (byte) JAVA_STRING.constant("UTF16");
    private static final long SEED = 0x4D33_5354_5247L;
    private static final int E_ACUTE = 0xE9;
    private static final int CJK = 0x4E2D;
    private static final int EMOJI = 0x1F600;
    private static final int[] CORPUS_LENGTHS = {1, 2, 3, 7, 31, 64, 65, 200, 600};
    /** Corpus strings up to this length are checked over every (begin, end) / (index, offset) pair. */
    private static final int EXHAUSTIVE = 64;
    private static final int PIECE_UNITS = 70;
    private static final int QUARTER = 4;
    private static final String PAIR = new String(Character.toChars(EMOJI));
    private static final String HIGH = String.valueOf(Character.MIN_HIGH_SURROGATE);
    private static final String LOW = String.valueOf(Character.MIN_LOW_SURROGATE);
    private static final String[] ALPHABET = {"a", "Z", String.valueOf((char) E_ACUTE), String.valueOf((char) CJK),
            PAIR, HIGH, LOW};

    static {
        try {
            M3_STRING.method("activate", 1).invoke((String) null);
        } catch (Throwable e) {
            throw new ExceptionInInitializerError(e);
        }
    }
//@@ HELPERS
    /** A pool-interned M3String holding {@code s}. */
    static Object m3(String s) throws Throwable {
        return INTERN_CHARS.invoke(s.toCharArray(), 0, s.length());
    }

    /** A tuple-backed M3String: the pool concatenation of two interned halves. */
    static Object m3Tuple(String left, String right) throws Throwable {
        return CONCAT.invoke(m3(left), m3(right));
    }

    /** The UTF-16 text of an M3String, read through java.lang.CharSequence only. */
    static String text(Object m3) {
        return new StringBuilder((CharSequence) m3).toString();
    }

    /** Deterministic corpus: Latin-1, BMP, paired and unpaired surrogates in every adjacency. */
    static List<String> corpus() {
        List<String> out = new ArrayList<>(List.of("a", PAIR, HIGH, LOW, LOW + HIGH, HIGH + HIGH + LOW,
                PAIR + PAIR, "ab" + PAIR + "c" + LOW + PAIR + HIGH, HIGH + LOW + LOW + HIGH));
        Random r = new Random(SEED);
        for (int n : CORPUS_LENGTHS) {
            StringBuilder b = new StringBuilder();
            while (b.length() < n) {
                b.append(ALPHABET[r.nextInt(ALPHABET.length)]);
            }
            out.add(b.toString());
        }
        return out;
    }

    /** The class or "none" of the first throwable raised by {@code action}, else its value. */
    static Object outcome(Supplier<?> action) {
        try {
            return action.get();
        } catch (RuntimeException e) {
            return e.getClass().getName();
        }
    }

    static Object invokeOutcome(MethodHandle h, Object... args) {
        try {
            return h.invokeWithArguments(args);
        } catch (RuntimeException e) {
            return e.getClass().getName();
        } catch (Throwable e) {
            throw new AssertionError(e);
        }
    }

    /** Positions q of low surrogates immediately preceded by a high surrogate. */
    static int[] pairedLows(String s) {
        return IntStream.range(1, s.length())
                .filter(q -> Character.isHighSurrogate(s.charAt(q - 1)) && Character.isLowSurrogate(s.charAt(q)))
                .toArray();
    }

    static Charset utf16Native() {
        return ByteOrder.nativeOrder() == ByteOrder.BIG_ENDIAN ? StandardCharsets.UTF_16BE : StandardCharsets.UTF_16LE;
    }

    /** Builder-shaped flat bytes: one byte per char for LATIN1, native-order UTF-16 otherwise. */
    static byte[] encode(String s, byte coder) {
        return s.getBytes(coder == LATIN1 ? StandardCharsets.ISO_8859_1 : utf16Native());
    }

    static String decode(byte[] bytes, int fromChar, int chars, byte coder) {
        int unit = coder == LATIN1 ? 1 : 2;
        return new String(bytes, fromChar * unit, chars * unit, coder == LATIN1 ? StandardCharsets.ISO_8859_1 : utf16Native());
    }

    private static final MethodHandle TUPLE = new Access("java.lang.M3StringTuple").constructor("M3StringTuple", 4);
    private static final MethodHandle WHOLE = M3_STRING.method("whole", 1);
    private static long nextTupleId = SEED;

    /** A hand-built tuple over two existing M3Strings: no pool canonicalization or flattening. */
    static Object tupleOf(Object left, Object right) throws Throwable {
        long id = nextTupleId++;
        return WHOLE.invoke(TUPLE.invoke(left, right, id, id));
    }
//@@ SUPPORT LANE_SCRIPT
    /**
     * Deterministic builder lane script: flat appends and lifted pieces in the same logical order as a
     * java.lang.StringBuilder reference. Pieces are ranges of long Strings; one piece is empty.
     */
    static final class LaneScript {
        final Access lane = new Access("java.lang.M3StringBuilderLane");
        final Object instance;
        final StringBuilder flat = new StringBuilder();
        final StringBuilder logical = new StringBuilder();
        final byte flatCoder;
        int pieces;

        LaneScript(boolean wideFlat, boolean widePiece) throws Throwable {
            instance = lane.constructor("M3StringBuilderLane", 1).invoke(PIECE_UNITS);
            flatCoder = wideFlat ? UTF16 : LATIN1;
            String latin = "latin-".repeat(PIECE_UNITS / QUARTER);
            String wide = (String.valueOf((char) CJK) + "x").repeat(PIECE_UNITS);
            flat("ab" + (wideFlat ? String.valueOf((char) CJK) : "c"));
            piece(latin, QUARTER, PIECE_UNITS);
            flat("");
            piece(widePiece ? wide : latin, 1, PIECE_UNITS);
            flat("mid" + (char) E_ACUTE);
            piece(latin, 0, 0);
            piece(latin, PIECE_UNITS / 2, PIECE_UNITS / 2);
            flat("tail");
            piece(latin, 0, PIECE_UNITS);
            piece(latin, 1, PIECE_UNITS);
        }

        void flat(String s) {
            flat.append(s);
            logical.append(s);
        }

        void piece(String s, int start, int length) throws Throwable {
            lane.method("push", 5).invoke(instance, s, start, length, flat.length(), flatCoder);
            logical.append(s, start, start + length);
            pieces++;
        }

        byte[] flatBytes() {
            return encode(flat.toString(), flatCoder);
        }

        byte logicalCoder() throws Throwable {
            return (byte) lane.method("logicalCoder", 1).invoke(instance, flatCoder);
        }
    }
//@@ PATTERN CP_PREPARE | uses= | oracle=java.lang.String.codePointCount pair count; cache identity; empty/over-budget refusal
    /** ${atom}(source) builds geometry once per (owner, coordinate) and refuses empty or over-budget ranges. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 1);
        Access geometry = new Access("java.lang.M3StringCodePointPrecompute$$Geometry");
        for (String s : corpus()) {
            Object source = m3(s);
            Object g = atom.invoke(source);
            assertEquals(s.length(), (int) geometry.field("utf16Length").get(g), "${atom} length");
            assertEquals(s.length() - s.codePointCount(0, s.length()),
                    (int) geometry.method("pairedLowCount", 0).invoke(g), "${atom} pairs of " + s.length());
            assertSame(g, atom.invoke(source), "${atom} cache hit");
        }
        Object straddling = m3Tuple("ab" + HIGH, LOW + "cd");
        Object g = atom.invoke(straddling);
        assertEquals(1, (int) geometry.method("pairedLowCount", 0).invoke(g), "a pair across tuple leaves");
        int max = (int) OWNER.constant("MAX_SOURCE_UNITS");
        assertEquals(null, atom.invoke(m3("")), "empty source");
        assertEquals(null, atom.invoke(m3("x".repeat(max + 1))), "over the source budget");
    }
//@@ PATTERN CP_MAX_RETAINED | uses= | oracle=SLOTS * MAX_SOURCE_UNITS / 2 * Integer.BYTES
    /** ${atom}() bounds the cache: every slot holding the densest geometry of the largest admitted range. */
    @Test
    void ${test}() throws Throwable {
        long slots = (int) OWNER.constant("SLOTS");
        long units = (int) OWNER.constant("MAX_SOURCE_UNITS");
        assertEquals(slots * (units / 2) * Integer.BYTES, (long) OWNER.method("${atom}", 0).invoke());
        String densest = PAIR.repeat((int) units / 2);
        Object g = OWNER.method("prepare", 1).invoke(m3(densest));
        long one = (long) new Access("java.lang.M3StringCodePointPrecompute$$Geometry").method("retainedPrimitiveBytes", 0)
                .invoke(g);
        assertEquals(slots * one, (long) OWNER.method("${atom}", 0).invoke(), "the bound is attained by dense pairs");
    }
//@@ PATTERN CP_SLOT | uses= | oracle=range [0, SLOTS), determinism and the cache slot used by prepare
    /** ${atom}(owner, coordinate) is a deterministic slot in [0, SLOTS) where prepare caches its entry. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 2);
        int slots = (int) OWNER.constant("SLOTS");
        AtomicReferenceArray<?> cache = (AtomicReferenceArray<?>) OWNER.constant("CACHE");
        Access entry = new Access("java.lang.M3StringCodePointPrecompute$$Entry");
        for (String s : corpus()) {
            Object source = m3(s);
            Object owner = OWNER_OF.invoke(source);
            long coordinate = (long) COORDINATE_OF.invoke(source);
            int slot = (int) atom.invoke(owner, coordinate);
            assertTrue(slot >= 0 && slot < slots, "${atom} range");
            assertEquals(slot, (int) atom.invoke(owner, coordinate), "${atom} deterministic");
            Object g = OWNER.method("prepare", 1).invoke(source);
            assertSame(g, entry.field("geometry").get(cache.get(slot)), "prepare caches at ${atom}");
        }
    }
//@@ PATTERN CP_LOWER_BOUND | uses= | oracle=linear count of smaller values
    /** ${atom}(values, key) is the number of sorted values strictly below key. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 2);
        int[][] lanes = {{}, {2}, {2, 4, 9}, {1, 3, 5, 7, 9, 11, 13}};
        for (int[] values : lanes) {
            for (int key = -1; key <= values.length * 2 + QUARTER; key++) {
                final int k = key;
                long below = Arrays.stream(values).filter(v -> v < k).count();
                assertEquals((int) below, (int) atom.invoke(values, key), "${atom} key=" + key);
            }
        }
    }
//@@ PATTERN CP_GEOMETRY_CONSTRUCTOR | uses= | oracle=java.lang.String.codePointCount over every range
    /** ${atom}(utf16Length, pairedLowOffsets) answers String.codePointCount for independently derived offsets. */
    @Test
    void ${test}() throws Throwable {
        Access geometry = new Access("java.lang.M3StringCodePointPrecompute$$Geometry");
        MethodHandle ctor = geometry.constructor("${atom}", 2);
        MethodHandle count = geometry.method("codePointCount", 2);
        for (String s : corpus()) {
            if (s.length() > EXHAUSTIVE) {
                continue;
            }
            Object g = ctor.invoke(s.length(), pairedLows(s));
            for (int begin = 0; begin <= s.length(); begin++) {
                for (int end = begin; end <= s.length(); end++) {
                    assertEquals(s.codePointCount(begin, end), (int) count.invoke(g, begin, end), "${atom}");
                }
            }
        }
    }
//@@ PATTERN CP_CODE_POINT_COUNT | uses= | oracle=java.lang.String.codePointCount values and exceptions
    /** ${atom}(begin, end) equals String.codePointCount, including the range exceptions. */
    @Test
    void ${test}() throws Throwable {
        Access geometry = new Access("java.lang.M3StringCodePointPrecompute$$Geometry");
        MethodHandle atom = geometry.method("${atom}", 2);
        for (String s : corpus()) {
            Object g = OWNER.method("prepare", 1).invoke(m3(s));
            int n = s.length();
            int step = n > EXHAUSTIVE ? n / EXHAUSTIVE : 1;
            for (int begin = -1; begin <= n + 1; begin += step) {
                for (int end = begin - 1; end <= n + 1; end += step) {
                    final int b = begin;
                    final int e = end;
                    assertEquals(outcome(() -> s.codePointCount(b, e)), invokeOutcome(atom, g, b, e),
                            "${atom}(" + b + ", " + e + ") n=" + n);
                }
            }
        }
    }
