//@@ PATTERN LANE_GROW | uses=LANE_SCRIPT | oracle=ArraysSupport.newLength doubling with content preserved
    /** ${atom}() doubles all four parallel lanes and keeps every recorded piece. */
    @Test
    void ${test}() throws Throwable {
        Access lane = new Access("java.lang.M3StringBuilderLane");
        Object l = lane.constructor("M3StringBuilderLane", 1).invoke(PIECE_UNITS);
        String[] before = ((String[]) lane.field("text").get(l)).clone();
        lane.method("${atom}", 0).invoke(l);
        String[] after = (String[]) lane.field("text").get(l);
        assertEquals(before.length * 2, after.length, "${atom} doubles text");
        assertEquals(before.length * 2, ((long[]) lane.field("span").get(l)).length);
        assertEquals(before.length * 2, ((int[]) lane.field("flatAt").get(l)).length);
        assertEquals(before.length * 2, ((int[]) lane.field("logicalEnd").get(l)).length);
        LaneScript script = new LaneScript(false, true);
        assertTrue(script.pieces > before.length, "the script itself grows past the initial lanes");
        assertEquals(script.pieces, (int) script.lane.method("pieceCount", 0).invoke(script.instance));
    }
//@@ PATTERN LANE_CHAR_AT | uses=LANE_SCRIPT | oracle=java.lang.StringBuilder.charAt at every logical index
    /** ${atom}(flat, flatCoder, index) equals StringBuilder.charAt across flat chunks, pieces and empty pieces. */
    @Test
    void ${test}() throws Throwable {
        for (boolean wideFlat : new boolean[] {false, true}) {
            for (boolean widePiece : new boolean[] {false, true}) {
                LaneScript script = new LaneScript(wideFlat, widePiece);
                byte[] flat = script.flatBytes();
                MethodHandle atom = script.lane.method("${atom}", 3);
                for (int i = 0; i < script.logical.length(); i++) {
                    assertEquals(script.logical.charAt(i), (char) atom.invoke(script.instance, flat, script.flatCoder, i),
                            "${atom}(" + i + ") wideFlat=" + wideFlat + " widePiece=" + widePiece);
                }
            }
        }
    }
//@@ PATTERN LANE_FLAT_CHAR_AT | uses= | oracle=ISO-8859-1 / native UTF-16 decoding
    /** ${atom}(flat, coder, index) decodes one unsigned Latin-1 byte or one native-order UTF-16 unit. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = new Access("java.lang.M3StringBuilderLane").method("${atom}", 3);
        String s = "a" + (char) E_ACUTE + "z";
        String w = "a" + (char) CJK + PAIR;
        for (int i = 0; i < s.length(); i++) {
            assertEquals(s.charAt(i), (char) atom.invoke(encode(s, LATIN1), LATIN1, i), "LATIN1 " + i);
        }
        for (int i = 0; i < w.length(); i++) {
            assertEquals(w.charAt(i), (char) atom.invoke(encode(w, UTF16), UTF16, i), "UTF16 " + i);
        }
    }
//@@ PATTERN LANE_RESERVE_LOGICAL | uses= | oracle=java.lang.StringBuilder.ensureCapacity then capacity()
    /** ${atom}(minimum, coder) grows virtualCapacity exactly as StringBuilder.ensureCapacity would. */
    @Test
    void ${test}() throws Throwable {
        Access lane = new Access("java.lang.M3StringBuilderLane");
        int[] capacities = {0, 1, 16, 100};
        int[] minimums = {-1, 0, 1, 17, 34, 35, 201, 1000};
        for (byte coder : new byte[] {LATIN1, UTF16}) {
            for (int capacity : capacities) {
                for (int minimum : minimums) {
                    Object l = lane.constructor("M3StringBuilderLane", 1).invoke(capacity);
                    lane.method("${atom}", 2).invoke(l, minimum, coder);
                    StringBuilder oracle = new StringBuilder(capacity);
                    if (coder == UTF16) {
                        if (capacity == 0) {
                            continue;
                        }
                        oracle.append((char) CJK).setLength(0);
                    }
                    oracle.ensureCapacity(minimum);
                    assertEquals(oracle.capacity(), (int) lane.field("virtualCapacity").get(l),
                            "${atom}(" + minimum + ") from " + capacity + " coder=" + coder);
                }
            }
        }
    }
//@@ PATTERN LANE_RESERVE | uses=LANE_SCRIPT | oracle=StringBuilder.ensureCapacity(flatMinimum + units); OOME on overflow
    /** ${atom}(flatMinimum, coder) reserves flatMinimum + units logical chars; an int overflow is an OOME. */
    @Test
    void ${test}() throws Throwable {
        LaneScript script = new LaneScript(false, false);
        int units = (int) script.lane.field("units").get(script.instance);
        int capacity = (int) script.lane.field("virtualCapacity").get(script.instance);
        int flatMinimum = capacity * 2;
        script.lane.method("${atom}", 2).invoke(script.instance, flatMinimum, LATIN1);
        StringBuilder oracle = new StringBuilder(capacity);
        oracle.ensureCapacity(flatMinimum + units);
        assertEquals(oracle.capacity(), (int) script.lane.field("virtualCapacity").get(script.instance));
        assertThrows(OutOfMemoryError.class,
                () -> script.lane.method("${atom}", 2).invoke(script.instance, Integer.MAX_VALUE, LATIN1));
    }
