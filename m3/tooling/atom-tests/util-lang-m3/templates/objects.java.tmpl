//@@ PATTERN OBJ_OF_LOCKED | uses= | oracle=registry growth and reuse
    /** ${atom}(source) registers new owners, reusing them, and grows the weak registry when full. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 1);
        List<Object> retained = new ArrayList<>();
        List<Node> sources = new ArrayList<>();
        locked(() -> {
            for (int i = 0; i < MANY_OWNERS; i++) {
                Node n = new Node();
                sources.add(n);
                retained.add(atom.invoke(n));
            }
            for (int i = 0; i < MANY_OWNERS; i++) {
                assertSame(retained.get(i), atom.invoke(sources.get(i)), "${atom} reuses " + i);
            }
        });
        assertTrue(((Object[]) OWNER.field("owners").get()).length >= MANY_OWNERS, "${atom} grew the registry");
    }
