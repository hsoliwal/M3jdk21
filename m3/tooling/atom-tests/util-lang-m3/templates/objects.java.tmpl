//@@ PATTERN OBJ_LISTEN | uses= | oracle=argument validation; open subscription; delivery
    /** ${atom}(owner, field, mask, listener) validates, admits a subscription and delivers to it. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 4);
        Node node = new Node();
        M3Object owner = M3Object.of(node);
        Recorder r = new Recorder();
        assertEquals("listener", assertThrows(NullPointerException.class,
                () -> atom.invoke(owner, (M3Object.Field) null, ObjectEvent.CONTENT, (ObjectChangeListener) null)).getMessage());
        for (int bad : new int[] {0, UNKNOWN_MASK_BIT}) {
            assertEquals("invalid event mask", assertThrows(IllegalArgumentException.class,
                    () -> atom.invoke(owner, (M3Object.Field) null, bad, r)).getMessage());
        }
        ObjectSubscription s = (ObjectSubscription) atom.invoke(owner, (M3Object.Field) null, ObjectEvent.CONTENT, r);
        assertFalse(s.isClosed());
        owner.contentChanged();
        assertEquals(ObjectEvent.CONTENT, r.next().mask());
        s.close();
    }
//@@ PATTERN OBJ_CLOSE | uses= | oracle=closed subscriptions receive nothing; idempotent
    /** ${atom}(subscription) detaches the subscriber exactly once; later changes are not delivered. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 1);
        Node node = new Node();
        Recorder r = new Recorder();
        ObjectSubscription s = M3Object.of(node).listen(ObjectEvent.CONTENT, r);
        atom.invoke(s);
        assertTrue(s.isClosed());
