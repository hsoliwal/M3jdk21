import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.BlockingQueue;
import java.util.concurrent.LinkedBlockingQueue;
import java.util.concurrent.TimeUnit;
//@@ CONSTANTS
    private static final MethodHandles.Lookup LOOKUP = MethodHandles.lookup();
    private static final Access STATE = new Access("java.lang.M3ObjectRuntime$State");
    private static final Access PLAN = new Access("java.lang.M3ObjectRuntime$AccessPlan");
    private static final Access FIELD = new Access("java.lang.M3Object$Field");
    private static final Access M3_OBJECT = new Access("java.lang.M3Object");
    private static final long EVENT_TIMEOUT_SECONDS = 10;
    private static final long QUIET_MILLIS = 200;
    /** Owners created by the ofLocked growth check; retained so the weak registry keeps them. */
    private static final int MANY_OWNERS = 40;
    private static final int UNKNOWN_MASK_BIT = 8;
    private static final int INITIAL_LANES = 4;
//@@ HELPERS
    /** Observation payload with reference, primitive and floating fields. */
    static class Node {
        Object ref;
        int count;
        float ratio;
    }

    static final class SubNode extends Node {
    }

    /** Listener recording deliveries from the framework dispatch thread. */
    static final class Recorder implements ObjectChangeListener {
        final BlockingQueue<ObjectEvent> events = new LinkedBlockingQueue<>();
        final List<Thread> threads = new ArrayList<>();

        @Override
        public void onChange(ObjectEvent event) {
            synchronized (threads) {
                threads.add(Thread.currentThread());
            }
            events.add(event);
        }

        ObjectEvent next() throws InterruptedException {
            ObjectEvent e = events.poll(EVENT_TIMEOUT_SECONDS, TimeUnit.SECONDS);
            assertTrue(e != null, "an event is delivered");
            return e;
        }

        void quiet() throws InterruptedException {
            assertEquals(null, events.poll(QUIET_MILLIS, TimeUnit.MILLISECONDS), "no event is delivered");
        }
    }

    static M3Object.Field field(Object source, String name, Class<?> type) {
        return M3Object.of(source).field(LOOKUP, Node.class, name, type);
    }

    static Object lock() {
        return OWNER.constant("LOCK");
    }

    static Object state(Object source) {
        return M3_OBJECT.field("state").get(M3Object.of(source));
    }

    static Object plan(M3Object.Field f) {
        return FIELD.field("plan").get(f);
    }

    static Object planOf(String name, Class<?> type) throws Throwable {
        return PLAN.constructor("AccessPlan", 4).invoke(LOOKUP, Node.class, name, type);
    }

    /** Runs {@code body} on an InnocuousThread, as the framework dispatch thread does. */
    static void onInnocuousThread(Runnable body) throws InterruptedException {
        Thread t = jdk.internal.misc.InnocuousThread.newSystemThread("m3-atom-test", body);
        t.start();
        t.join(TimeUnit.SECONDS.toMillis(EVENT_TIMEOUT_SECONDS));
        assertFalse(t.isAlive(), "the innocuous body finished");
    }

    interface LockedAction {
        void run() throws Throwable;
    }

    static void locked(LockedAction action) throws Throwable {
        synchronized (lock()) {
            action.run();
        }
    }
