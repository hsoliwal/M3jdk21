//@@ PATTERN PLAN_MATCHES | uses= | oracle=exact (declaringType, name, type) key
    /** ${atom}(declaringType, name, type) compares the exact key. */
    @Test
    void ${test}() throws Throwable {
        Object p = planOf("count", int.class);
        MethodHandle atom = PLAN.method("${atom}", 3);
        assertTrue((boolean) atom.invoke(p, Node.class, "count", int.class));
        assertFalse((boolean) atom.invoke(p, SubNode.class, "count", int.class), "subclass is a different key");
        assertFalse((boolean) atom.invoke(p, Node.class, "ratio", int.class));
        assertFalse((boolean) atom.invoke(p, Node.class, "count", long.class));
        assertTrue((boolean) atom.invoke(p, Node.class, new String("count"), int.class), "names compare by value");
    }
//@@ PATTERN PLAN_RESOLVE | uses= | oracle=findVarHandle on the declared field; cached; IAE for missing or inherited
    /** ${atom}() resolves and caches a VarHandle on the declaring class only. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = PLAN.method("${atom}", 0);
        Object p = planOf("count", int.class);
        VarHandle h = (VarHandle) atom.invoke(p);
        assertSame(h, atom.invoke(p), "${atom} caches");
        Node node = new Node();
        node.count = INITIAL_LANES;
        assertEquals(INITIAL_LANES, (int) h.get(node));
        Object missing = planOf("missing", int.class);
        assertEquals("cannot resolve instance field " + Node.class.getName() + ".missing",
                assertThrows(IllegalArgumentException.class, () -> atom.invoke(missing)).getMessage());
        Object inherited = PLAN.constructor("AccessPlan", 4).invoke(LOOKUP, SubNode.class, "count", int.class);
        assertThrows(IllegalArgumentException.class, () -> atom.invoke(inherited), "inherited members do not resolve");
    }
//@@ PATTERN PLAN_CHECK_VALUE | uses= | oracle=boxing rules and reference assignability
    /** ${atom}(value) rejects null primitives and values of the wrong (boxed) type. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = PLAN.method("${atom}", 1);
        Object count = planOf("count", int.class);
        atom.invoke(count, 1);
        assertEquals("primitive value", assertThrows(NullPointerException.class, () -> atom.invoke(count, null)).getMessage());
        assertEquals("value is not java.lang.Integer",
                assertThrows(ClassCastException.class, () -> atom.invoke(count, 1L)).getMessage());
        Object ratio = planOf("ratio", float.class);
        atom.invoke(ratio, 1f);
        assertThrows(ClassCastException.class, () -> atom.invoke(ratio, 1d));
        Object typed = PLAN.constructor("AccessPlan", 4).invoke(LOOKUP, Node.class, "ref", Node.class);
        atom.invoke(typed, null);
        atom.invoke(typed, new SubNode());
        assertEquals("value is not " + Node.class.getName(),
                assertThrows(ClassCastException.class, () -> atom.invoke(typed, "x")).getMessage());
    }
//@@ PATTERN PLAN_SAME | uses= | oracle=reference identity; primitive bit identity (NaN, signed zero)
    /** ${atom}(left, right) is identity for references and bit identity for primitives. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = PLAN.method("${atom}", 2);
        Object ref = planOf("ref", Object.class);
        String a = "same";
        assertTrue((boolean) atom.invoke(ref, a, a));
        assertFalse((boolean) atom.invoke(ref, a, new String(a)), "equal but not identical");
        Object ratio = planOf("ratio", float.class);
        assertTrue((boolean) atom.invoke(ratio, Float.NaN, Float.NaN), "NaN is bit-identical to itself");
        assertFalse((boolean) atom.invoke(ratio, 0f, -0f), "signed zeros differ in bits");
        Object count = planOf("count", int.class);
        assertTrue((boolean) atom.invoke(count, Integer.valueOf(Short.MAX_VALUE + 1), Integer.valueOf(Short.MAX_VALUE + 1)),
                "boxes compare by value");
    }
//@@ PATTERN PLAN_BITS | uses= | oracle=consistency with same(); unsupported reference plans
    /** ${atom}(value) distinguishes primitive values and is undefined (AssertionError) for references. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = PLAN.method("${atom}", 1);
        Object count = planOf("count", int.class);
        assertEquals((long) atom.invoke(count, 1), (long) atom.invoke(count, 1));
        assertTrue((long) atom.invoke(count, 1) != (long) atom.invoke(count, 2));
        Object ratio = planOf("ratio", float.class);
        assertTrue((long) atom.invoke(ratio, 0f) != (long) atom.invoke(ratio, -0f));
        Object flag = PLAN.constructor("AccessPlan", 4).invoke(LOOKUP, Node.class, "flag", boolean.class);
        assertTrue((long) atom.invoke(flag, true) != (long) atom.invoke(flag, false));
        assertEquals("unsupported primitive field",
                assertThrows(AssertionError.class, () -> atom.invoke(planOf("ref", Object.class), "x")).getMessage());
    }
