//@@ PATTERN OBJ_DISPATCH | uses= | oracle=worker stack runs dispatch; deliveries happen on the worker
    /** ${atom}() is the worker loop: events arrive on the worker thread, which idles inside ${atom}. */
    @Test
    void ${test}() throws Throwable {
        Node node = new Node();
        Recorder r = new Recorder();
        try (ObjectSubscription s = M3Object.of(node).listen(ObjectEvent.CONTENT, r)) {
            M3Object.of(node).contentChanged();
            r.next();
            Thread worker = (Thread) OWNER.field("worker").get();
            synchronized (r.threads) {
                assertEquals(List.of(worker), r.threads, "delivered on the dispatch worker");
            }
            boolean inLoop = false;
            for (StackTraceElement frame : worker.getStackTrace()) {
                inLoop |= frame.getClassName().equals("java.lang.M3ObjectRuntime") && frame.getMethodName().equals("${atom}");
            }
            assertTrue(inLoop, "the worker idles in ${atom}");
        }
    }
//@@ PATTERN OBJ_DRAIN | uses= | oracle=synchronous delivery and pending reset on the calling innocuous thread
    /** ${atom}(state) delivers each pending subscriber once on the calling thread and clears its lanes. */
    @Test
    void ${test}() throws Throwable {
        Node node = new Node();
        Recorder r = new Recorder();
        try (ObjectSubscription s = M3Object.of(node).listen(ObjectEvent.CONTENT, r)) {
            Object st = state(node);
            int index = (int) new Access("java.lang.ObjectSubscription").field("index").get(s);
            locked(() -> {
                ((int[]) STATE.field("pending").get(st))[index] = ObjectEvent.CONTENT;
                ((long[]) STATE.field("sequences").get(st))[index] = 1;
            });
            onInnocuousThread(() -> {
                try {
                    OWNER.method("${atom}", 1).invoke(st);
                } catch (Throwable e) {
                    throw new AssertionError(e);
                }
            });
            ObjectEvent e = r.next();
            assertEquals(ObjectEvent.CONTENT, e.mask());
            assertEquals(1, e.sequence());
            assertEquals(0, ((int[]) STATE.field("pending").get(st))[index], "${atom} cleared the lane");
            synchronized (r.threads) {
                assertEquals("m3-atom-test", r.threads.get(0).getName(), "delivered on the calling thread");
            }
        }
    }
