        Object st = STATE.constructor("State", 2).invoke(M3Object.of(node), 1L);
        MethodHandle atom = STATE.method("${atom}", 1);
        int ref = (int) atom.invoke(st, field(node, "ref", Object.class));
        assertEquals(ref, (int) atom.invoke(st, field(node, "ref", Object.class)), "equal key, same slot");
        int count = (int) atom.invoke(st, field(node, "count", int.class));
        assertTrue(count != ref, "a new key gets a new slot");
        assertEquals(1L, ((long[]) STATE.field("generations").get(st))[count], "allocation bumps the generation");
        atom.invoke(st, field(node, "ratio", float.class));
        atom.invoke(st, field(node, "ref", String.class));
        assertEquals(INITIAL_LANES, ((Object[]) STATE.field("fields").get(st)).length);
        assertEquals(INITIAL_LANES, (int) atom.invoke(st, field(node, "count", long.class)),
                "a full table doubles and returns the first new slot");
        assertEquals(2 * INITIAL_LANES, ((Object[]) STATE.field("fields").get(st)).length);
        assertEquals(2 * INITIAL_LANES, ((Object[]) STATE.field("children").get(st)).length);
    }
//@@ PATTERN STATE_ENSURE_PARENT_CAPACITY | uses= | oracle=4 initial parent lanes, doubling when full
    /** ${atom}() allocates 4 parent lanes and doubles them when parentCount reaches capacity. */
    @Test
    void ${test}() throws Throwable {
        Object st = STATE.constructor("State", 2).invoke(M3Object.of(new Node()), 1L);
        MethodHandle atom = STATE.method("${atom}", 0);
        atom.invoke(st);
        assertEquals(INITIAL_LANES, ((Object[]) STATE.field("parents").get(st)).length);
        atom.invoke(st);
        assertEquals(INITIAL_LANES, ((Object[]) STATE.field("parents").get(st)).length, "not full, no growth");
        STATE.field("parentCount").set(st, INITIAL_LANES);
        atom.invoke(st);
        assertEquals(2 * INITIAL_LANES, ((Object[]) STATE.field("parents").get(st)).length);
        assertEquals(2 * INITIAL_LANES, ((int[]) STATE.field("parentSlots").get(st)).length);
        assertEquals(2 * INITIAL_LANES, ((long[]) STATE.field("parentGenerations").get(st)).length);
    }
//@@ PATTERN STATE_ADD_PARENT | uses= | oracle=edge lanes on both ends
    /** ${atom}(parent, slot) records the edge, its generation and the reverse edge index. */
    @Test
    void ${test}() throws Throwable {
        Node node = new Node();
        Object parent = STATE.constructor("State", 2).invoke(M3Object.of(node), 1L);
        int slot = (int) STATE.method("fieldSlot", 1).invoke(parent, field(node, "ref", Object.class));
        Object child = STATE.constructor("State", 2).invoke(M3Object.of(new Node()), 2L);
        STATE.method("ensureParentCapacity", 0).invoke(child);
        STATE.method("${atom}", 2).invoke(child, parent, slot);
        assertEquals(1, (int) STATE.field("parentCount").get(child));
        assertSame(parent, ((Object[]) STATE.field("parents").get(child))[0]);
        assertEquals(slot, ((int[]) STATE.field("parentSlots").get(child))[0]);
        assertEquals(((long[]) STATE.field("generations").get(parent))[slot], ((long[]) STATE.field("parentGenerations").get(child))[0]);
        assertEquals(0, ((int[]) STATE.field("childEdges").get(parent))[slot]);
    }
//@@ PATTERN STATE_CLEAR_PENDING | uses= | oracle=all seven pending lanes reset at one index
    /** ${atom}(index) resets every pending lane at that index and leaves the others. */
    @Test
    void ${test}() throws Throwable {
        Object st = STATE.constructor("State", 2).invoke(M3Object.of(new Node()), 1L);
        STATE.method("subscriberSlot", 0).invoke(st);
        for (String lane : new String[] {"firstSequences", "sequences", "pendingGenerations", "origins", "originSequences"}) {
            java.util.Arrays.fill((long[]) STATE.field(lane).get(st), 1L);
        }
        java.util.Arrays.fill((int[]) STATE.field("pending").get(st), ObjectEvent.ALL);
        java.util.Arrays.fill((boolean[]) STATE.field("coalesced").get(st), true);
        STATE.method("${atom}", 1).invoke(st, 1);
        assertEquals(0, ((int[]) STATE.field("pending").get(st))[1]);
        assertEquals(ObjectEvent.ALL, ((int[]) STATE.field("pending").get(st))[0], "other indexes untouched");
        assertFalse(((boolean[]) STATE.field("coalesced").get(st))[1]);
        for (String lane : new String[] {"firstSequences", "sequences", "pendingGenerations", "origins", "originSequences"}) {
            assertEquals(0L, ((long[]) STATE.field(lane).get(st))[1], lane);
        }
    }
//@@ PATTERN PLAN_CONSTRUCTOR | uses= | oracle=field round trip; lazy handle
    /** ${atom}(lookup, declaringType, name, type) records the key and resolves nothing eagerly. */
    @Test
