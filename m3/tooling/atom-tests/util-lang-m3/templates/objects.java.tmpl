//@@ PATTERN STATE_SUBSCRIBER_SLOT | uses= | oracle=first free slot; complete lane-set doubling
    /** ${atom}() returns the first free slot, growing all subscriber lanes together (4, then doubling). */
    @Test
    void ${test}() throws Throwable {
        Object st = STATE.constructor("State", 2).invoke(M3Object.of(new Node()), 1L);
        MethodHandle atom = STATE.method("${atom}", 0);
        assertEquals(0, (int) atom.invoke(st));
        Object[] subscriptions = (Object[]) STATE.field("subscriptions").get(st);
        assertEquals(INITIAL_LANES, subscriptions.length);
        assertEquals(0, (int) atom.invoke(st), "a free slot is reused");
        for (int i = 0; i < INITIAL_LANES; i++) {
            subscriptions[i] = new Access("java.lang.ObjectSubscription").constant("CLOSED");
        }
        assertEquals(INITIAL_LANES, (int) atom.invoke(st), "a full lane set grows");
        for (String lane : new String[] {"listeners", "selected", "requested", "slots", "pending", "firstSequences",
                "sequences", "pendingGenerations", "origins", "originSequences", "coalesced", "subscriptions"}) {
            assertEquals(2 * INITIAL_LANES, java.lang.reflect.Array.getLength(STATE.field(lane).get(st)), lane);
        }
    }
//@@ PATTERN STATE_FIND_FIELD | uses= | oracle=plan match by (declaringType, name, type)
