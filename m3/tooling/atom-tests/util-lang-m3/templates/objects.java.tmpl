//@@ PATTERN OBJ_CAPTURE_LOCKED | uses= | oracle=requested-mask filtering and origin bookkeeping
    /** ${atom}(state, slot, mask, origin, originSequence) records accepted bits and the origin for delivery. */
    @Test
    void ${test}() throws Throwable {
        Node node = new Node();
        Recorder r = new Recorder();
        long origin = 1L << Integer.SIZE;
        long originSequence = 1L << Short.SIZE;
        try (ObjectSubscription s = M3Object.of(node).listen(ObjectEvent.CONTENT, r)) {
            Object st = state(node);
            MethodHandle atom = OWNER.method("${atom}", 5);
            locked(() -> atom.invoke(st, -1, ObjectEvent.VALUE, origin, originSequence));
            r.quiet();
            locked(() -> atom.invoke(st, -1, ObjectEvent.CONTENT | ObjectEvent.VALUE, origin, originSequence));
            ObjectEvent e = r.next();
            assertEquals(ObjectEvent.CONTENT, e.mask(), "only requested bits are accepted");
            assertEquals(origin, e.originId());
            assertEquals(originSequence, e.originSequence());
        }
    }
//@@ PATTERN OBJ_ENQUEUE_LOCKED | uses= | oracle=dispatch queue membership; dispatch drains it
    /** ${atom}(state) appends the owner once to the dispatch queue; the worker then dequeues it. */
    @Test
    void ${test}() throws Throwable {
        Node node = new Node();
        Recorder r = new Recorder();
        try (ObjectSubscription s = M3Object.of(node).listen(ObjectEvent.CONTENT, r)) {
            Object st = state(node);
            MethodHandle atom = OWNER.method("${atom}", 1);
            locked(() -> {
                atom.invoke(st);
                assertTrue((boolean) STATE.field("queued").get(st), "${atom} marks the owner queued");
                assertSame(st, OWNER.field("last").get(), "appended at the tail");
                atom.invoke(st);
                assertEquals(null, STATE.field("next").get(st), "a queued owner is not appended twice");
            });
            long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(EVENT_TIMEOUT_SECONDS);
            while ((boolean) STATE.field("queued").get(st) && System.nanoTime() < deadline) {
                Thread.onSpinWait();
            }
            assertFalse((boolean) STATE.field("queued").get(st), "the dispatch worker dequeued the owner");
            r.quiet();
        }
    }
//@@ PATTERN OBJ_REMOVE_IF_CLEAN | uses= | oracle=queue removal only without pending work
    /** ${atom}(state) unlinks a queued owner with no pending work and keeps one with pending work. */
    @Test
    void ${test}() throws Throwable {
        Node node = new Node();
        Recorder r = new Recorder();
        try (ObjectSubscription s = M3Object.of(node).listen(ObjectEvent.CONTENT, r)) {
            Object st = state(node);
            MethodHandle atom = OWNER.method("${atom}", 1);
            int index = (int) new Access("java.lang.ObjectSubscription").field("index").get(s);
            locked(() -> {
                OWNER.method("enqueueLocked", 1).invoke(st);
                ((int[]) STATE.field("pending").get(st))[index] = ObjectEvent.CONTENT;
                atom.invoke(st);
                assertTrue((boolean) STATE.field("queued").get(st), "pending work keeps the owner queued");
                ((int[]) STATE.field("pending").get(st))[index] = 0;
                atom.invoke(st);
                assertFalse((boolean) STATE.field("queued").get(st), "${atom} unlinks a clean owner");
                assertNotSame(st, OWNER.field("first").get());
            });
            r.quiet();
        }
    }
