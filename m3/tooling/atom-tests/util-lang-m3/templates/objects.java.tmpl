//@@ PATTERN OBJ_SET | uses= | oracle=field value, type checks, one event per real change
    /** ${atom}(field, value) writes, type-checks, and publishes only real changes. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 2);
        Node node = new Node();
        M3Object.Field ref = field(node, "ref", Object.class);
        M3Object.Field count = field(node, "count", int.class);
        Recorder r = new Recorder();
        try (ObjectSubscription s = ref.listen(ObjectEvent.REFERENCE, r)) {
            String value = "v";
            atom.invoke(ref, value);
            assertSame(value, node.ref);
            assertEquals(ObjectEvent.REFERENCE, r.next().mask());
            atom.invoke(ref, value);
            r.quiet();
        }
        atom.invoke(count, 1 + 1);
        assertEquals(1 + 1, node.count);
        assertEquals("value is not java.lang.Integer",
                assertThrows(ClassCastException.class, () -> atom.invoke(count, "x")).getMessage());
        assertEquals("primitive value", assertThrows(NullPointerException.class, () -> atom.invoke(count, null)).getMessage());
    }
