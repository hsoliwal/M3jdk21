    /** ${atom}(a, c, work, workBase, workLen) sizes tmp storage and the run stack from a.length. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle ctor = OWNER.constructor("${atom}", 5);
        int initial = (int) OWNER.constant("INITIAL_TMP_STORAGE_LENGTH");
        // listsort.txt stack bounds carried by the OpenJDK donor: length thresholds and stack sizes.
        int[][] stackBounds = {{119, 5}, {120, 10}, {1541, 10}, {1542, 24}, {119150, 24}, {119151, 49}};
        VarHandle tmp = OWNER.field("tmp");
        VarHandle tmpLen = OWNER.field("tmpLen");
        VarHandle tmpBase = OWNER.field("tmpBase");
        VarHandle runBase = OWNER.field("runBase");
        for (int[] bound : stackBounds) {
            int length = bound[0];
            int[] keys = new int[length];
            Object ts = ctor.invoke(identity(length), context(keys), (int[]) null, 0, 0);
            int expectedTmp = length < 2 * initial ? length >>> 1 : initial;
            assertEquals(expectedTmp, ((int[]) tmp.get(ts)).length, "tmp for " + length);
            assertEquals(expectedTmp, (int) tmpLen.get(ts));
            assertEquals(0, (int) tmpBase.get(ts));
            assertEquals(bound[1], ((int[]) runBase.get(ts)).length, "run stack for " + length);
            int[] work = new int[length];
            Object borrowed = ctor.invoke(identity(length), context(keys), work, 1, length - 1);
            assertSame(work, tmp.get(borrowed), "an adequate work lane is borrowed");
