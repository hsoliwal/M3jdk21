//@@ PATTERN CONTEXT_STEP | uses= | oracle=recording ProgressMonitor batches + cancellation
    /** ${atom}() reports work every FLUSH_BATCH steps and then checks cancellation. */
    @Test
    void ${test}() throws Throwable {
        RecordingMonitor monitor = new RecordingMonitor();
        Object context = OWNER.constructor("M3SortContext", 2).invoke((IntBinaryOperator) Integer::compare,
                (ProgressMonitor) monitor);
        MethodHandle atom = OWNER.method("${atom}", 0);
        for (int i = 1; i < FLUSH_BATCH; i++) {
            atom.invoke(context);
        }
        assertEquals(List.of(), monitor.worked, "no report before a full batch");
        assertEquals(FLUSH_BATCH - 1, (int) OWNER.field("pending").get(context));
        atom.invoke(context);
        assertEquals(List.of((long) FLUSH_BATCH), monitor.worked, "one batch reported");
        assertEquals(0, (int) OWNER.field("pending").get(context));
        assertEquals(CONSTRUCTION_CHECKS + 1, monitor.cancelChecks, "construction and flush check cancellation");
        monitor.cancelled = true;
        for (int i = 1; i < FLUSH_BATCH; i++) {
            atom.invoke(context);
        }
        assertThrows(CancellationException.class, () -> atom.invoke(context), "cancellation surfaces at the batch");
        Object silent = OWNER.constructor("M3SortContext", 2).invoke((IntBinaryOperator) Integer::compare,
                (ProgressMonitor) null);
        for (int i = 0; i < FLUSH_BATCH; i++) {
            atom.invoke(silent);
        }
        assertEquals(0, (int) OWNER.field("pending").get(silent), "no monitor, no pending count");
    }
//@@ PATTERN CONTEXT_FINISH | uses= | oracle=recording ProgressMonitor partial batch
    /** ${atom}() flushes a partial batch; with no monitor it is a no-op. */
    @Test
    void ${test}() throws Throwable {
        RecordingMonitor monitor = new RecordingMonitor();
        MethodHandle ctor = OWNER.constructor("M3SortContext", 2);
        Object context = ctor.invoke((IntBinaryOperator) Integer::compare, (ProgressMonitor) monitor);
        MethodHandle step = OWNER.method("step", 0);
        MethodHandle atom = OWNER.method("${atom}", 0);
        int partial = FLUSH_BATCH / QUARTER;
        for (int i = 0; i < partial; i++) {
            step.invoke(context);
        }
        atom.invoke(context);
        assertEquals(List.of((long) partial), monitor.worked, "${atom} reports the partial batch");
        atom.invoke(context);
        assertEquals(List.of((long) partial), monitor.worked, "${atom} with nothing pending reports nothing");
        assertEquals(CONSTRUCTION_CHECKS + 2, monitor.cancelChecks, "both ${atom} calls check cancellation");
        ctor.invoke((IntBinaryOperator) Integer::compare, (ProgressMonitor) null);
        atom.invoke(ctor.invoke((IntBinaryOperator) Integer::compare, (ProgressMonitor) null));
    }
//@@ PATTERN CONTEXT_FLUSH | uses= | oracle=recording ProgressMonitor report-then-cancel order
    /** ${atom}() reports pending work, resets it, then throws if the monitor is cancelled. */
    @Test
    void ${test}() throws Throwable {
        RecordingMonitor monitor = new RecordingMonitor();
        Object context = OWNER.constructor("M3SortContext", 2).invoke((IntBinaryOperator) Integer::compare,
                (ProgressMonitor) monitor);
        MethodHandle step = OWNER.method("step", 0);
        MethodHandle atom = OWNER.method("${atom}", 0);
        step.invoke(context);
        step.invoke(context);
        monitor.cancelled = true;
        assertThrows(CancellationException.class, () -> atom.invoke(context));
        assertEquals(List.of(2L), monitor.worked, "${atom} reports before checking cancellation");
        assertEquals(0, (int) OWNER.field("pending").get(context), "${atom} resets pending");
        monitor.cancelled = false;
        atom.invoke(context);
        assertEquals(List.of(2L), monitor.worked, "empty ${atom} reports nothing");
    }
//@@ PATTERN DIST_DISPATCH | uses= | oracle=Arrays.sort(Integer[], comparingLong) stable order
    /** ${atom}(order, keys, base, algorithm, c): numeric algorithms sort; comparison-only ones are rejected. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 5);
        for (SortAlgorithm algorithm : SortAlgorithm.values()) {
            if (!algorithm.requiresNumericKeys()) {
                long[] keys = longKeys(SIZES[0], LongShape.FEW);
                IllegalArgumentException e = assertThrows(IllegalArgumentException.class,
                        () -> atom.invoke(identity(keys.length), keys, 0, algorithm, longContext(keys, 0)));
                assertEquals("Not a numeric algorithm: " + algorithm, e.getMessage());
                continue;
            }
            boolean bounded = algorithm == SortAlgorithm.COUNTING || algorithm == SortAlgorithm.PIGEONHOLE;
            forEachLongVector(bounded, (keys, base, order) -> {
                int[] a = order.clone();
                atom.invoke(a, keys, base, algorithm, longContext(keys, base));
                assertLongSorted(keys, base, order, a, 0, a.length, algorithm.isStable(), algorithm.name());
            });
        }
        int[] single = {3};
        atom.invoke(single, new long[] {1}, 3, SortAlgorithm.QUICK, longContext(new long[] {1}, 3));
        assertArrayEquals(new int[] {3}, single, "length < 2 returns before dispatch");
    }
