//@@ PATTERN DIST_HISTOGRAM_SPAN | uses= | oracle=Sorts.MAX_HISTOGRAM_SPAN bounds
    /** ${atom}(min, max) = max - min + 1 below Sorts.MAX_HISTOGRAM_SPAN; wider or overflowing spans are rejected. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 2);
        long span = Sorts.MAX_HISTOGRAM_SPAN;
        assertEquals(1, (int) atom.invoke(5L, 5L));
        assertEquals((int) NARROW_SPAN + 1, (int) atom.invoke(NARROW_MIN, NARROW_MIN + NARROW_SPAN));
        assertEquals((int) span, (int) atom.invoke(-1L, span - 2));
        assertEquals((int) span, (int) atom.invoke(0L, span - 1));
        long[][] rejected = {{0, span}, {-1, span}, {Long.MIN_VALUE, Long.MAX_VALUE}, {Long.MIN_VALUE, 0}};
        for (long[] r : rejected) {
            IllegalArgumentException e = assertThrows(IllegalArgumentException.class, () -> atom.invoke(r[0], r[1]));
            assertTrue(e.getMessage().startsWith("Numeric key span exceeds " + span), e.getMessage());
        }
    }
//@@ PATTERN DIST_DIGIT | uses= | oracle=BigInteger sign-biased digit + top-digit monotonicity
    /** ${atom}(index, keys, base, shift) is byte shift/8 of the sign-biased key; the top digit is order-preserving. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 4);
        forEachLongVector(false, (keys, base, order) -> {
            for (int index : order) {
                for (int shift = 0; shift < Long.SIZE; shift += DIGIT_BITS) {
                    assertEquals(biasedDigit(keys[index - base], shift), (int) atom.invoke(index, keys, base, shift),
                            "${atom} shift=" + shift);
                }
            }
        });
        long[] ordered = {Long.MIN_VALUE, -1L << TOP_SHIFT, -1L, 0L, 1L << TOP_SHIFT, Long.MAX_VALUE};
        for (int i = 1; i < ordered.length; i++) {
            assertTrue((int) atom.invoke(i - 1, ordered, 0, TOP_SHIFT) <= (int) atom.invoke(i, ordered, 0, TOP_SHIFT),
                    "${atom} top digit preserves signed order");
        }
    }
//@@ PATTERN DIST_BOUNDARIES | uses= | oracle=running prefix sum
    /** ${atom}(counts, from, c): starts[0] = from and starts[b + 1] = starts[b] + counts[b]. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 3);
        Random r = new Random(SEED);
        int[] counts = IntStream.range(0, RADIX).map(i -> r.nextInt(FEW_DISTINCT + 1)).toArray();
        for (int from : BASES) {
            int[] starts = (int[]) atom.invoke(counts, from, longContext(new long[0], 0));
            assertEquals(RADIX + 1, starts.length);
            int running = from;
            for (int b = 0; b < RADIX; b++) {
                assertEquals(running, starts[b], "${atom} start of bucket " + b);
                running += counts[b];
            }
            assertEquals(running, starts[RADIX], "${atom} end");
        }
    }
//@@ PATTERN DIST_HISTOGRAM | uses= | oracle=BigInteger sign-biased digit counts
    /** ${atom}(order, keys, base, from, to, shift, c) counts each digit over [from, to). */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 7);
        forEachLongVector(false, (keys, base, order) -> {
            int n = order.length;
            for (int shift : new int[] {0, DIGIT_BITS * THIRD, TOP_SHIFT}) {
                int[] counts = (int[]) atom.invoke(order, keys, base, n / QUARTER, n, shift, longContext(keys, base));
                int[] expected = new int[RADIX];
                for (int i = n / QUARTER; i < n; i++) {
                    expected[biasedDigit(keys[order[i] - base], shift)]++;
                }
                assertArrayEquals(expected, counts, "${atom} shift=" + shift);
            }
        });
    }
//@@ SUPPORT AVL_TREE
    private static List<Integer> inOrder(int node, int[] left, int[] right) {
        List<Integer> out = new ArrayList<>();
        if (node >= 0) {
            if (left[node] != 0) {
                out.addAll(inOrder(left[node] - 1, left, right));
            }
            out.add(node);
            if (right[node] != 0) {
                out.addAll(inOrder(right[node] - 1, left, right));
            }
        }
        return out;
    }

    private static void link(int parent, int child, int side, int[] left, int[] right) {
        if (side < 0) {
            left[parent] = child + 1;
        } else {
            right[parent] = child + 1;
        }
    }
//@@ SUPPORT BOXED
    private static List<Integer> boxed(int[] a) {
        return IntStream.of(a).boxed().collect(java.util.stream.Collectors.toCollection(ArrayList::new));
    }
//@@ SUPPORT TIM_STATE
    private static Object timSort(int[] keys) throws Throwable {
        return timSort(keys, identity(keys.length));
    }

    private static Object timSort(int[] keys, int[] a) throws Throwable {
        return OWNER.constructor("M3TimSort", 5).invoke(a, context(keys), (int[]) null, 0, 0);
    }

    /** Labels sorted stably within each consecutive run of the given lengths. */
    private static int[] runs(int[] keys, int[] lengths) {
        int[] a = identity(keys.length);
        int base = 0;
        for (int len : lengths) {
            a = stableOrder(keys, a, base, base + len);
            base += len;
        }
        return a;
    }
