//@@ PATTERN MEDIAN_OF_THREE | uses= | oracle=Arrays.sort of the three sampled keys
    /** ${atom}(a, lo, hi, c) returns the label holding the median key of first, middle and last. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 4);
        forEachVector(MEDIAN_SAMPLES, (keys, labels) -> {
            int n = labels.length;
            int lo = n / QUARTER;
            int[] a = labels.clone();
            int first = a[lo];
            int middle = a[lo + ((n - lo) >>> 1)];
            int last = a[n - 1];
            int[] three = {keys[first], keys[middle], keys[last]};
            Arrays.sort(three);
            int pivot = (int) atom.invoke(a, lo, n, context(keys));
            assertTrue(pivot == first || pivot == middle || pivot == last, "${atom} returns a sampled label");
            assertEquals(three[1], keys[pivot], "${atom} median key");
            assertArrayEquals(labels, a, "${atom} does not move labels");
        });
    }
//@@ PATTERN PARTITION_THREE_WAY | uses= | oracle=per-index signum against the pivot + permutation
    /** ${atom}(a, lo, hi, pivot, c) packs [equalLo, equalHi) with keys below, equal and above the pivot. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 5);
        forEachVector(1, (keys, labels) -> {
            int n = labels.length;
            int lo = n / QUARTER;
            int pivot = labels[lo + (n - lo) / 2];
            int[] a = labels.clone();
            long bounds = (long) atom.invoke(a, lo, n, pivot, context(keys));
            int equalLo = (int) (bounds >>> Integer.SIZE);
            int equalHi = (int) bounds;
            assertTrue(lo <= equalLo && equalLo < equalHi && equalHi <= n, "${atom} bounds");
            for (int i = lo; i < n; i++) {
                int expected = i < equalLo ? -1 : i < equalHi ? 0 : 1;
                assertEquals(expected, Integer.signum(Integer.compare(keys[a[i]], keys[pivot])), "${atom} at " + i);
            }
            assertSortedPermutation(keys, labels, stableOrder(keys, a, lo, n), lo, n, false, "${atom}");
        });
    }
//@@ PATTERN RUN_ASCENDING | uses= | oracle=linear run scan + reversal check
    /** ${atom}(a, lo, hi, c) measures the maximal run at lo (${run_measure}), reversing a strictly descending run. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 4);
        forEachVector(2, (keys, labels) -> {
            int n = labels.length;
            for (int lo : new int[] {0, (n - 2) / 2, n - 2}) {
                int[] a = labels.clone();
                boolean descending = keys[a[lo + 1]] < keys[a[lo]];
                int end = lo + 2;
                while (end < n && (descending ? keys[a[end]] < keys[a[end - 1]] : keys[a[end]] >= keys[a[end - 1]])) {
                    end++;
                }
                int result = (int) atom.invoke(a, lo, n, context(keys));
                assertEquals(${run_result}, result, "${atom} run end from " + lo);
                for (int i = lo; i < end; i++) {
                    assertEquals(descending ? labels[end - 1 - (i - lo)] : labels[i], a[i], "${atom} run order");
                }
                assertArrayEquals(Arrays.copyOfRange(labels, end, n), Arrays.copyOfRange(a, end, n), "${atom} tail");
            }
            assertEquals(${single_result}, (int) atom.invoke(labels.clone(), n - 1, n, context(keys)),
                    "${atom} one-element run");
        });
    }
