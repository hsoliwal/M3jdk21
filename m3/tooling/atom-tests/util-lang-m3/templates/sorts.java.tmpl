        assertEquals("comparator", npe.getMessage());
        assertEquals(null, OWNER.field("monitor").get(ctor.invoke(natural, ProgressMonitor.NONE)), "NONE is dropped");
        RecordingMonitor live = new RecordingMonitor();
        Object context = ctor.invoke(natural, (ProgressMonitor) live);
        assertSame(live, OWNER.field("monitor").get(context));
        assertEquals(1, live.cancelChecks, "construction checks cancellation once");
        RecordingMonitor cancelled = new RecordingMonitor();
        cancelled.cancelled = true;
        assertThrows(CancellationException.class, () -> ctor.invoke(natural, (ProgressMonitor) cancelled));
    }
//@@ PATTERN CONTEXT_COMPARE | uses= | oracle=comparator value + recording ProgressMonitor
