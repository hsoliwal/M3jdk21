//@@ PATTERN TIM_MIN_RUN | uses= | oracle=listsort.txt top-bits formula
    /** ${atom}(n): n below MIN_MERGE, else the top bits of n plus one when any lower bit is set (listsort.txt). */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 1);
        int minMerge = (int) OWNER.constant("MIN_MERGE");
        int keptBits = Integer.SIZE - Integer.numberOfLeadingZeros(minMerge) - 1;
        IntStream probes = IntStream.concat(IntStream.range(0, minMerge * minMerge),
                IntStream.of(Integer.MAX_VALUE, Integer.MAX_VALUE - 1, 1 << (Integer.SIZE - 2)));
        for (int n : probes.toArray()) {
            int expected;
            if (n < minMerge) {
                expected = n;
            } else {
                int shift = (Integer.SIZE - Integer.numberOfLeadingZeros(n)) - keptBits;
                expected = (n >>> shift) + ((n & ((1 << shift) - 1)) != 0 ? 1 : 0);
                assertTrue(expected >= minMerge / 2 && expected <= minMerge, "${atom} bound for " + n);
            }
            assertEquals(expected, (int) atom.invoke(n), "${atom}(" + n + ")");
        }
    }
