//@@ PATTERN GALLOP | uses= | oracle=linear scan bound for every hint
    /** ${atom}(key, a, base, len, hint, c): offset k with the TimSort ${gallop_side} gallop contract, for every hint. */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 6);
        forEachVector(1, (keys, labels) -> {
            int n = labels.length;
            int base = n / QUARTER;
            int len = n - base;
            if (len == 0) {
                return;
            }
            int[] a = stableOrder(keys, labels, base, n);
            Object c = context(keys);
            for (int key = 0; key < n; key++) {
                int expected = 0;
                while (expected < len && ${gallop_advance}) {
                    expected++;
                }
                for (int hint = 0; hint < len; hint++) {
                    assertEquals(expected, (int) atom.invoke(key, a, base, len, hint, c),
                            "${atom} key=" + key + " hint=" + hint);
                }
            }
        });
    }
//@@ PATTERN HEAP_SIFT_MAX | uses= | oracle=max-heap property + permutation
    /** ${atom}(a, lo, size, root, c): bottom-up sifting builds a max-heap on [lo, lo + size). */
    @Test
    void ${test}() throws Throwable {
        MethodHandle atom = OWNER.method("${atom}", 5);
        forEachVector(1, (keys, labels) -> {
            int n = labels.length;
            int lo = n / QUARTER;
            int size = n - lo;
            int[] a = labels.clone();
            Object c = context(keys);
            for (int parent = (size >>> 1) - 1; parent >= 0; parent--) {
                atom.invoke(a, lo, size, parent, c);
            }
            for (int child = 1; child < size; child++) {
                assertTrue(keys[a[lo + (child - 1) / 2]] >= keys[a[lo + child]], "${atom} heap order at " + child);
            }
            assertSortedPermutation(keys, labels, stableOrder(keys, a, lo, n), lo, n, false, "${atom}");
        });
    }
