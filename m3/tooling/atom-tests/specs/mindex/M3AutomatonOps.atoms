// Atoms of M3AutomatonOps.java (automaton algebra, powerset determinization, Hopcroft minimization and their
// private set/list helpers). Oracles: java.util.regex languages over exhaustive texts (AutomatonOracle),
// java.util.HashMap/TreeSet/TreeMap/LinkedList models of the private helper structures, BFS reachability.
#class M3AutomatonOpsAtomTest
#summary Per-atom contracts of jdk.internal.mindex.M3AutomatonOps against java.util.regex and java.util models
#build AutomatonOracle
#import jdk.internal.mindex.M3Automaton jdk.internal.mindex.M3AutomatonOps java.util.ArrayDeque java.util.ArrayList java.util.BitSet java.util.HashMap java.util.LinkedList java.util.List java.util.Map java.util.SplittableRandom java.util.TreeMap java.util.TreeSet
#const int REFUSED_STATES = 3 // states reported by the TooComplex refusal
#const int REFUSED_TRANSITIONS = 4 // transitions reported by the TooComplex refusal
#const int REFUSED_EFFORT = 5 // work limit reported by the TooComplex refusal
#const int EDGE_TEXT_LENGTH = 2 // texts up to two units over EDGES reach both extreme units
#const int REPEAT_MIN = 2 // lower bound of the bounded and at-least repetitions
#const int REPEAT_MAX = 3 // upper bound of the bounded repetitions
#const int LIST_STATES = 6 // states of the acceptList automaton
#const int MIDDLE_ACCEPT = 4 // second accepting state of the acceptList automaton
#const int LAST_ACCEPT = 5 // last (and third accepting) state of the acceptList automaton
#const int ACCEPT_OFFSET = 10 // state offset added by acceptList
#const int EXHAUSTIVE_LENGTH = 4 // longest text of the complement and reverse checks
#const int TOTALIZE_LENGTH = 3 // longest text of the totalize language check over EDGES
#const int EXPONENT = 2 // n of the (a|b)*a(a|b){n} automaton of the liveness, determinize and minimize checks
#const int[] MEMBERS = {2, 5, 9} // sorted members of a state set
#const int[] MEMBERS_INSERTED = {9, 2, 5} // MEMBERS in insertion order
#const int[] PAIR = {1, 3} // a two-member state set
#const int REPEATED_MEMBER = 4 // member added twice, counted once
#const int[] HASHED_MEMBERS = {3, 7, 11} // members of the longHash check
#const int[] SPREAD_MEMBERS = {1, 40, 63} // members across one 64-state word
#const int[] EQUAL_MEMBERS = {6, 2, 8} // members of the live set and of its frozen copy
#const int DFA_STATE = 7 // DFA state given to the frozen copy and found through the live set
#const int OTHER_MEMBER = 2 // only member of the other set (also a member of EQUAL_MEMBERS)
#const int[] FIELD_VALUES = {1, 2} // members passed to the FrozenSet constructor
#const long FIELD_HASH = 42L // hash passed to the FrozenSet constructor
#const int FIELD_STATE = 9 // DFA state passed to the FrozenSet constructor
#const int[] ARRAY_VALUES = {4, 8} // members of the same-array check
#const int[] SIZE_VALUES = {4, 8, 15} // members of the size check
#const int FROZEN_MEMBER = 5 // member added before the freeze
#const int FREEZE_STATE = 3 // DFA state given by freeze
#const int LATE_MEMBER = 9 // member added after the freeze; must not reach the frozen copy
#const int[] UNSORTED_WITH_DUPLICATE = {40, 3, 17, 3} // insertion order with a repeated member
#const int[] SORTED_DISTINCT = {3, 17, 40} // UNSORTED_WITH_DUPLICATE sorted and distinct
#const int SECOND_MEMBER = 2 // the member next to member 1
#const int DISTINCT_MEMBERS = 2 // distinct members of a two-member counting set
#const int TRANSITION_INTS = 3 // ints per packed transition: dest, min, max
#const int LOW_POINT = 3 // the smaller point of the comparison
#const int HIGH_POINT = 7 // the larger point of the comparison
#const int RESET_POINT = 12 // point given by reset
#const int SAME_POINT = 5 // point both objects share
#const int OTHER_POINT = 6 // a different point
#const int HASHED_POINT = 77 // a point; its hash is the point
#const int FIRST_POINT = 4 // point of the first slot object
#const int REUSED_POINT = 9 // point given to the reused first slot after reset
#const int POINT_SPREAD = 2 // points are drawn from [0, POINT_SPREAD * MANY_POINTS): repeats and new points mix
#const int RANGE_SPAN = 3 // generated ranges span one to three units
#const int STATE_STRIDE = 3 // list states are i * STATE_STRIDE: distinct and not consecutive
#const int SECOND_Q = 2 // state of the second linked node
#const int LINKED_NODES = 2 // nodes linked into the list
#helper <<<
    private static final Class<?> OPS = M3AutomatonOps.class;
    private static final Class<?> STATE_KEY = M3AtomKit.type("M3AutomatonOps$StateKey");
    private static final Class<?> FROZEN = M3AtomKit.type("M3AutomatonOps$FrozenSet");
    private static final Class<?> COUNTING = M3AtomKit.type("M3AutomatonOps$CountingSet");
    private static final Class<?> TLIST = M3AtomKit.type("M3AutomatonOps$TransitionList");
    private static final Class<?> POINT = M3AtomKit.type("M3AutomatonOps$PointTransitions");
    private static final Class<?> POINTS = M3AtomKit.type("M3AutomatonOps$PointTransitionSet");
    private static final Class<?> SLIST = M3AtomKit.type("M3AutomatonOps$StateList");
    private static final Class<?> SNODE = M3AtomKit.type("M3AutomatonOps$StateListNode");
    /** Work limit used by the algebra checks, and a limit too small for the exponential DFA. */
    private static final int WORK = M3AutomatonOps.DEFAULT_WORK_LIMIT;
    private static final int TINY_WORK = 10;
    /** Distinct start points beyond the linear-to-hash cutover of PointTransitionSet (30). */
    private static final int HASH_CUTOVER = 30;
    private static final int MANY_POINTS = 40;
    /** Model sizes of the private helper checks. */
    private static final int SET_STATES = 64;
    private static final int MIX_SAMPLES = 100_000;
    /** fmix32 constants of the documented local mixer (Lucene hppc BitMixer.mix32). */
    private static final int PHI = 0x9E3779B9;
    private static final int C1 = 0x85EBCA6B;
    private static final int C2 = 0xC2B2AE35;
    private static final int SHIFT_A = 16;
    private static final int SHIFT_B = 13;

    /** withDeadStates: 0 -a-> 1 -b-> 2 (accepting), 0 -b-> 3 (dead end), 4 -c-> 2 (unreachable). */
    private static final int FIXTURE_STATES = 5;
    private static final int FIXTURE_ACCEPT = 2;
    private static final int FIXTURE_DEAD = 3;
    private static final int FIXTURE_UNREACHABLE = 4;
    /** States of withDeadStates that are reachable and co-reachable: 0, 1 and 2. */
    private static final int FIXTURE_LIVE = 3;

    private static M3Automaton w(String word) {
        return M3AutomatonOps.makeUnits(word);
    }

    private static M3Automaton chr(char c) {
        return M3AutomatonOps.makeUnitRange(c, c);
    }

    /** (a|b)*a(a|b){n}: its minimal DFA has 2^(n+1) states. */
    private static M3Automaton exponential(int n) {
        M3Automaton ab = M3AutomatonOps.union(chr('a'), chr('b'));
        return M3AutomatonOps.concatenate(M3AutomatonOps.repeat(ab), chr('a'), M3AutomatonOps.repeat(ab, n, n));
    }

    private static void assertLanguage(M3Automaton a, String regex) {
        AutomatonOracle.assertLanguage(a, regex, AutomatonOracle.ABC, AutomatonOracle.MAX_LENGTH);
    }

    private static long fmix(int key) {
        int h = key * PHI;
        h ^= h >>> SHIFT_A;
        h *= C1;
        h ^= h >>> SHIFT_B;
        h *= C2;
        h ^= h >>> SHIFT_A;
        return h;
    }

    private static BitSet reachable(M3Automaton a) {
        BitSet seen = new BitSet();
        if (a.getNumStates() == 0) return seen;
        ArrayDeque<Integer> queue = new ArrayDeque<>(List.of(0));
        seen.set(0);
        while (!queue.isEmpty()) {
            for (int[] t : AutomatonOracle.transitions(a, queue.removeFirst())) {
                if (!seen.get(t[0])) {
                    seen.set(t[0]);
                    queue.add(t[0]);
                }
            }
        }
        return seen;
    }

    private static BitSet coReachable(M3Automaton a) {
        BitSet live = new BitSet();
        for (int s = 0; s < a.getNumStates(); s++) if (a.isAccept(s)) live.set(s);
        boolean changed = true;
        while (changed) {
            changed = false;
            for (int s = 0; s < a.getNumStates(); s++) {
                for (int[] t : AutomatonOracle.transitions(a, s)) {
                    if (live.get(t[0]) && !live.get(s)) {
                        live.set(s);
                        changed = true;
                    }
                }
            }
        }
        return live;
    }

    /** NFA with unreachable and dead states for the liveness checks. */
    private static M3Automaton withDeadStates() {
        M3Automaton a = new M3Automaton();
        for (int i = 0; i < FIXTURE_STATES; i++) a.createState();
        a.addTransition(0, 1, 'a');
        a.addTransition(0, FIXTURE_DEAD, 'b');
        a.addTransition(1, FIXTURE_ACCEPT, 'b');
        a.addTransition(FIXTURE_UNREACHABLE, FIXTURE_ACCEPT, 'c');
        a.finishState();
        a.setAccept(FIXTURE_ACCEPT, true);
        return a;
    }

    private static Object counting(int states) throws Throwable {
        return M3AtomKit.findConstructor(COUNTING, "CountingSet", MethodType.methodType(void.class, int.class)).invoke(states);
    }

    private static MethodHandle v(Class<?> owner, String name, MethodType type) {
        return M3AtomKit.findVirtual(owner, name, type);
    }

    private static M3Automaton.Transition transition(int dest, int min, int max) {
        M3Automaton.Transition t = new M3Automaton.Transition();
        t.dest = dest;
        t.min = min;
        t.max = max;
        return t;
    }

    private static int[] sorted(Map<Integer, Integer> counts) {
        return new TreeSet<>(counts.keySet()).stream().mapToInt(Integer::intValue).toArray();
    }
>>>

@atom M3AutomatonOps.M3AutomatonOps 1 UTILITY_CTOR java.lang.reflect.Modifier
type = M3AutomatonOps

@atom M3AutomatonOps.TooComplex.TooComplex 1 SCENARIO message+determinize-refusal
check <<<
M3AutomatonOps.TooComplex refusal = new M3AutomatonOps.TooComplex(REFUSED_STATES, REFUSED_TRANSITIONS, REFUSED_EFFORT);
assertEquals("Determinizing automaton with " + REFUSED_STATES + " states and " + REFUSED_TRANSITIONS
        + " transitions would require more than " + REFUSED_EFFORT + " effort.", refusal.getMessage());
assertTrue(refusal instanceof RuntimeException);
M3Automaton nfa = exponential(SHIFT_B);
M3AutomatonOps.TooComplex thrown = assertThrows(M3AutomatonOps.TooComplex.class,
        () -> M3AutomatonOps.determinize(nfa, TINY_WORK));
assertTrue(thrown.getMessage().contains(nfa.getNumStates() + " states"), thrown.getMessage());
>>>

@atom M3AutomatonOps.makeEmpty 1 LANGUAGE_DIFF java.util.regex
automaton = M3AutomatonOps.makeEmpty()
regex = (?!)
alphabet = AutomatonOracle.EDGES
max = AutomatonOracle.MAX_LENGTH
extra = assertTrue(M3AutomatonOps.isEmpty(M3AutomatonOps.makeEmpty()));

@atom M3AutomatonOps.makeEmptyString 1 LANGUAGE_DIFF java.util.regex
automaton = M3AutomatonOps.makeEmptyString()
regex =
alphabet = AutomatonOracle.EDGES
max = AutomatonOracle.MAX_LENGTH
extra = assertEquals(1, M3AutomatonOps.makeEmptyString().getNumStates());

@atom M3AutomatonOps.makeAnyString 1 LANGUAGE_DIFF java.util.regex
automaton = M3AutomatonOps.makeAnyString()
regex = .*
alphabet = AutomatonOracle.EDGES
max = AutomatonOracle.MAX_LENGTH
extra = assertTrue(M3AutomatonOps.isTotal(M3AutomatonOps.makeAnyString()));

@atom M3AutomatonOps.makeUnitRange 1 SCENARIO java.util.regex(char-class)
check <<<
assertLanguage(M3AutomatonOps.makeUnitRange('b', 'c'), "[b-c]");
assertLanguage(M3AutomatonOps.makeUnitRange('a', 'a'), "a");
assertLanguage(M3AutomatonOps.makeUnitRange('c', 'b'), "(?!)");
AutomatonOracle.assertLanguage(M3AutomatonOps.makeUnitRange(0, AutomatonOracle.MAX_LABEL), "[\\x{0}-\\x{ffff}]",
        AutomatonOracle.EDGES, EDGE_TEXT_LENGTH);
>>>

@atom M3AutomatonOps.makeUnits 1 SCENARIO java.util.regex(quoted)
check <<<
for (String word : List.of("", "a", "abc", "dcba", "aaaa")) {
    assertLanguage(M3AutomatonOps.makeUnits(word), java.util.regex.Pattern.quote(word));
    assertEquals(word.length() + 1, M3AutomatonOps.makeUnits(word).getNumStates());
}
>>>

@atom M3AutomatonOps.concatenate 1 SCENARIO java.util.regex(concatenation)
check <<<
assertLanguage(M3AutomatonOps.concatenate(w("ab"), w("c")), "abc");
assertLanguage(M3AutomatonOps.concatenate(M3AutomatonOps.optional(w("a")), M3AutomatonOps.optional(w("b")), w("c")), "a?b?c");
assertLanguage(M3AutomatonOps.concatenate(M3AutomatonOps.repeat(chr('a')), M3AutomatonOps.makeEmptyString(), w("b")), "a*b");
assertLanguage(M3AutomatonOps.concatenate(w("a"), M3AutomatonOps.makeEmpty(), w("b")), "(?!)");
assertLanguage(M3AutomatonOps.concatenate(), "(?!)");
assertEquals(1, M3AutomatonOps.concatenate().getNumStates(), "no operands: one non-accepting state (Lucene 9.10 Operations parity)");
assertLanguage(M3AutomatonOps.concatenate(M3AutomatonOps.optional(w("a")), M3AutomatonOps.optional(w("b"))), "a?b?");
>>>

@atom M3AutomatonOps.union 1 SCENARIO java.util.regex(alternation)
check <<<
assertLanguage(M3AutomatonOps.union(w("ab"), w("c"), w("")), "ab|c|");
assertLanguage(M3AutomatonOps.union(w("a"), M3AutomatonOps.makeEmpty()), "a");
assertLanguage(M3AutomatonOps.union(), "(?!)");
assertLanguage(M3AutomatonOps.union(M3AutomatonOps.repeat(chr('a')), w("bb")), "a*|bb");
>>>

@atom M3AutomatonOps.optional 1 SCENARIO java.util.regex(?)
check <<<
assertLanguage(M3AutomatonOps.optional(w("ab")), "(ab)?");
assertLanguage(M3AutomatonOps.optional(M3AutomatonOps.makeEmpty()), "");
assertLanguage(M3AutomatonOps.optional(M3AutomatonOps.repeat(chr('c'))), "c*");
>>>

@atom M3AutomatonOps.repeat 1 SCENARIO java.util.regex(*)
check <<<
assertLanguage(M3AutomatonOps.repeat(w("ab")), "(ab)*");
assertLanguage(M3AutomatonOps.repeat(M3AutomatonOps.union(w("a"), w("bc"))), "(a|bc)*");
M3Automaton empty = M3AutomatonOps.makeEmpty();
assertSame(empty, M3AutomatonOps.repeat(empty), "the empty language is returned as is");
assertLanguage(M3AutomatonOps.repeat(M3AutomatonOps.optional(w("b"))), "b*");
>>>

@atom M3AutomatonOps.repeat 2 SCENARIO java.util.regex({min,})
check <<<
assertLanguage(M3AutomatonOps.repeat(w("a"), 0), "a*");
assertLanguage(M3AutomatonOps.repeat(w("a"), REPEAT_MIN), "a{" + REPEAT_MIN + ",}");
assertLanguage(M3AutomatonOps.repeat(w("ab"), 1), "(ab){1,}");
>>>

@atom M3AutomatonOps.repeat 3 SCENARIO java.util.regex({min,max})
check <<<
assertLanguage(M3AutomatonOps.repeat(w("a"), 1, REPEAT_MAX), "a{1," + REPEAT_MAX + "}");
assertLanguage(M3AutomatonOps.repeat(w("ab"), 0, REPEAT_MIN), "(ab){0," + REPEAT_MIN + "}");
assertLanguage(M3AutomatonOps.repeat(w("b"), REPEAT_MIN, REPEAT_MIN), "b{" + REPEAT_MIN + "}");
assertLanguage(M3AutomatonOps.repeat(w("c"), REPEAT_MAX, 1), "(?!)");
assertLanguage(M3AutomatonOps.repeat(M3AutomatonOps.optional(w("a")), REPEAT_MIN, REPEAT_MAX),
        "(?:a?){" + REPEAT_MIN + "," + REPEAT_MAX + "}");
>>>

@atom M3AutomatonOps.acceptList 1 SCENARIO java.util.BitSet-iteration+offset
setup <<<
MethodHandle atom = M3AtomKit.findStatic(OPS, "acceptList", MethodType.methodType(int[].class, M3Automaton.class, int.class));
M3Automaton a = new M3Automaton();
for (int i = 0; i < LIST_STATES; i++) a.createState();
a.setAccept(1, true);
a.setAccept(MIDDLE_ACCEPT, true);
a.setAccept(LAST_ACCEPT, true);
>>>
check <<<
assertArrayEquals(new int[] {1, MIDDLE_ACCEPT, LAST_ACCEPT}, (int[]) atom.invokeExact(a, 0));
assertArrayEquals(new int[] {ACCEPT_OFFSET + 1, ACCEPT_OFFSET + MIDDLE_ACCEPT, ACCEPT_OFFSET + LAST_ACCEPT},
        (int[]) atom.invokeExact(a, ACCEPT_OFFSET));
assertArrayEquals(new int[0], (int[]) atom.invokeExact(M3AutomatonOps.makeEmpty(), 0));
>>>

@atom M3AutomatonOps.complement 1 SCENARIO language-negation
check <<<
for (M3Automaton a : List.of(w("ab"), M3AutomatonOps.repeat(chr('a')), M3AutomatonOps.makeEmpty(),
        M3AutomatonOps.makeAnyString(), M3AutomatonOps.union(w(""), w("c")))) {
    M3Automaton c = M3AutomatonOps.complement(a, WORK);
    AutomatonOracle.assertWellFormed(c);
    for (String text : AutomatonOracle.texts(AutomatonOracle.EDGES, EXHAUSTIVE_LENGTH)) {
        assertEquals(!AutomatonOracle.accepts(a, text), AutomatonOracle.accepts(c, text), text);
    }
}
assertTrue(M3AutomatonOps.isEmpty(M3AutomatonOps.complement(M3AutomatonOps.makeAnyString(), WORK)));
>>>

@atom M3AutomatonOps.isEmpty 1 SCENARIO exhaustive-acceptance
check <<<
assertTrue(M3AutomatonOps.isEmpty(M3AutomatonOps.makeEmpty()));
assertTrue(M3AutomatonOps.isEmpty(new M3Automaton()));
assertFalse(M3AutomatonOps.isEmpty(M3AutomatonOps.makeEmptyString()));
assertFalse(M3AutomatonOps.isEmpty(w("abc")));
M3Automaton deadEnd = new M3Automaton();
deadEnd.createState();
deadEnd.createState();
deadEnd.addTransition(0, 1, 'a');
deadEnd.finishState();
assertTrue(M3AutomatonOps.isEmpty(deadEnd), "reachable states but none accepts");
M3Automaton deep = withDeadStates();
assertFalse(M3AutomatonOps.isEmpty(deep));
>>>

@atom M3AutomatonOps.isTotal 1 SCENARIO single-full-range-self-loop
check <<<
assertTrue(M3AutomatonOps.isTotal(M3AutomatonOps.makeAnyString()));
assertTrue(M3AutomatonOps.isTotal(M3AutomatonOps.minimize(M3AutomatonOps.complement(M3AutomatonOps.makeEmpty(), WORK), WORK)));
assertFalse(M3AutomatonOps.isTotal(M3AutomatonOps.repeat(chr('a'))));
assertFalse(M3AutomatonOps.isTotal(M3AutomatonOps.makeEmpty()));
assertFalse(M3AutomatonOps.isTotal(M3AutomatonOps.makeUnitRange(0, AutomatonOracle.MAX_LABEL)));
>>>

@atom M3AutomatonOps.reverse 1 SCENARIO reversed-text-acceptance
check <<<
for (M3Automaton a : List.of(w("abc"), M3AutomatonOps.concatenate(M3AutomatonOps.repeat(chr('a')), w("bc")),
        M3AutomatonOps.union(w("ab"), w("ca"), w("")), withDeadStates())) {
    M3Automaton r = M3AutomatonOps.reverse(a);
    for (String text : AutomatonOracle.texts(AutomatonOracle.ABC, EXHAUSTIVE_LENGTH)) {
        assertEquals(AutomatonOracle.accepts(a, new StringBuilder(text).reverse()), AutomatonOracle.accepts(r, text), text);
    }
}
assertEquals(0, M3AutomatonOps.reverse(M3AutomatonOps.makeEmpty()).getNumStates());
>>>

@atom M3AutomatonOps.totalize 1 SCENARIO full-label-coverage+same-language
setup <<<
MethodHandle atom = M3AtomKit.findStatic(OPS, "totalize", MethodType.methodType(M3Automaton.class, M3Automaton.class));
>>>
check <<<
for (M3Automaton a : List.of(w("ab"), M3AutomatonOps.makeUnitRange(0, 0), M3AutomatonOps.makeUnitRange(AutomatonOracle.MAX_LABEL, AutomatonOracle.MAX_LABEL), M3AutomatonOps.determinize(withDeadStates(), WORK))) {
    M3Automaton t = (M3Automaton) atom.invokeExact(a);
    assertEquals(a.getNumStates() + 1, t.getNumStates(), "one dead state");
    for (int s = 0; s < t.getNumStates(); s++) {
        int next = 0;
        for (int[] tr : AutomatonOracle.transitions(t, s)) {
            assertEquals(next, tr[AutomatonOracle.MIN], "contiguous coverage of state " + s);
            next = tr[AutomatonOracle.MAX] + 1;
        }
        assertEquals(AutomatonOracle.MAX_LABEL + 1, next, "covers every unit");
    }
    AutomatonOracle.assertSameLanguage(a, t, AutomatonOracle.EDGES, TOTALIZE_LENGTH);
}
>>>

@atom M3AutomatonOps.removeDeadStates 1 SCENARIO BFS-liveness+same-language
check <<<
M3Automaton a = withDeadStates();
M3Automaton r = M3AutomatonOps.removeDeadStates(a);
BitSet live = reachable(r);
live.and(coReachable(r));
assertEquals(r.getNumStates(), live.cardinality(), "every remaining state is live");
assertEquals(FIXTURE_LIVE, r.getNumStates());
AutomatonOracle.assertSameLanguage(a, r, AutomatonOracle.ABC, AutomatonOracle.MAX_LENGTH);
assertEquals(0, M3AutomatonOps.removeDeadStates(M3AutomatonOps.makeEmpty()).getNumStates());
>>>

@atom M3AutomatonOps.liveFromInitial 1 SCENARIO BFS-reachability
setup <<<
MethodHandle atom = M3AtomKit.findStatic(OPS, "liveFromInitial", MethodType.methodType(BitSet.class, M3Automaton.class));
>>>
check <<<
for (M3Automaton a : List.of(withDeadStates(), w("abc"), new M3Automaton(), exponential(EXPONENT))) {
    assertEquals(reachable(a), (BitSet) atom.invokeExact(a));
}
>>>

@atom M3AutomatonOps.liveToAccept 1 SCENARIO fixed-point-co-reachability
setup <<<
MethodHandle atom = M3AtomKit.findStatic(OPS, "liveToAccept", MethodType.methodType(BitSet.class, M3Automaton.class));
>>>
check <<<
for (M3Automaton a : List.of(withDeadStates(), w("abc"), new M3Automaton(), exponential(EXPONENT))) {
    assertEquals(coReachable(a), (BitSet) atom.invokeExact(a));
}
>>>

@atom M3AutomatonOps.determinize 1 SCENARIO same-language+recomputed-determinism+work-limit
check <<<
for (M3Automaton a : List.of(exponential(EXPONENT), M3AutomatonOps.union(w("ab"), w("ac"), M3AutomatonOps.repeat(chr('a'))), withDeadStates(),
        M3AutomatonOps.concatenate(M3AutomatonOps.repeat(M3AutomatonOps.makeUnitRange('a', 'c')), w("cb")))) {
    M3Automaton d = M3AutomatonOps.determinize(a, WORK);
    assertTrue(d.isDeterministic());
    assertTrue(AutomatonOracle.computedDeterministic(d));
    AutomatonOracle.assertSameLanguage(a, d, AutomatonOracle.ABC, AutomatonOracle.MAX_LENGTH);
}
M3Automaton dfa = w("abc");
assertSame(dfa, M3AutomatonOps.determinize(dfa, WORK), "deterministic input is returned as is");
M3Automaton many = M3AutomatonOps.union(java.util.stream.IntStream.range(0, MANY_POINTS)
        .mapToObj(i -> M3AutomatonOps.concatenate(chr((char) ('A' + i)), w("x"))).toArray(M3Automaton[]::new));
M3Automaton manyNfa = M3AutomatonOps.union(many, M3AutomatonOps.concatenate(M3AutomatonOps.makeUnitRange('A', 'z'), w("y")));
M3Automaton manyDfa = M3AutomatonOps.determinize(manyNfa, WORK);
for (int i = 0; i < MANY_POINTS; i++) {
    String head = String.valueOf((char) ('A' + i));
    assertTrue(AutomatonOracle.accepts(manyDfa, head + "x") && AutomatonOracle.accepts(manyDfa, head + "y"), head);
}
assertTrue(manyDfa.isDeterministic());
assertThrows(M3AutomatonOps.TooComplex.class, () -> M3AutomatonOps.determinize(exponential(SHIFT_B), TINY_WORK));
>>>

@atom M3AutomatonOps.mix 1 SCENARIO fmix32-reference+bijection
setup <<<
MethodHandle atom = M3AtomKit.findStatic(OPS, "mix", MethodType.methodType(long.class, int.class));
SplittableRandom random = M3AtomKit.random("mix");
java.util.HashSet<Long> images = new java.util.HashSet<>();
>>>
check <<<
for (int key : M3AtomKit.intDomain("mix", Integer.MIN_VALUE, Integer.MAX_VALUE)) {
    assertEquals(fmix(key), (long) atom.invokeExact(key), "key " + key);
}
for (int i = 0; i < MIX_SAMPLES; i++) images.add((long) atom.invokeExact(i));
assertEquals(MIX_SAMPLES, images.size(), "fmix32 is a bijection: no collisions");
assertEquals(0L, (long) atom.invokeExact(0));
long negative = (long) atom.invokeExact(random.nextInt());
assertEquals((long) (int) negative, negative, "int image sign-extended to long");
>>>

@atom M3AutomatonOps.StateKey.array 1 SCENARIO virtual-dispatch(FrozenSet,CountingSet)
setup <<<
MethodHandle array = v(STATE_KEY, "array", MethodType.methodType(int[].class));
MethodHandle incr = v(COUNTING, "incr", MethodType.methodType(void.class, int.class));
Object frozen = M3AtomKit.findConstructor(FROZEN, MethodType.methodType(void.class, int[].class, long.class, int.class))
        .invoke(MEMBERS.clone(), 0L, 0);
Object counting = counting(SET_STATES);
>>>
check <<<
assertArrayEquals(MEMBERS, (int[]) array.invoke(frozen));
for (int s : MEMBERS_INSERTED) incr.invoke(counting, s);
assertArrayEquals(MEMBERS, (int[]) array.invoke(counting), "sorted view of the counting set");
>>>

