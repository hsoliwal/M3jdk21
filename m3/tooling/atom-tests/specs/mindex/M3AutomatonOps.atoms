@atom M3AutomatonOps.StateListNode.remove 1 SCENARIO java.util.LinkedList-remove
setup <<<
Object list = M3AtomKit.findConstructor(SLIST, MethodType.methodType(void.class)).invoke();
MethodHandle add = v(SLIST, "add", MethodType.methodType(SNODE, int.class));
MethodHandle remove = v(SNODE, "remove", MethodType.methodType(void.class));
MethodHandle first = M3AtomKit.findGetter(SLIST, "first", SNODE);
MethodHandle size = M3AtomKit.findGetter(SLIST, "size", int.class);
MethodHandle q = M3AtomKit.findGetter(SNODE, "q", int.class);
MethodHandle next = M3AtomKit.findGetter(SNODE, "next", SNODE);
SplittableRandom random = M3AtomKit.random("StateListNode.remove");
List<Object> nodes = new ArrayList<>();
LinkedList<Integer> model = new LinkedList<>();
>>>
check <<<
for (int i = 0; i < SET_STATES; i++) {
    nodes.add(add.invoke(list, i));
    model.add(i);
}
while (!nodes.isEmpty()) {
    int at = random.nextInt(nodes.size());
