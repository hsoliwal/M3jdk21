@atom M3AutomatonOps.CountingSet.incr 1 SCENARIO java.util.HashMap-multiset
setup <<<
MethodHandle incr = v(COUNTING, "incr", MethodType.methodType(void.class, int.class));
MethodHandle array = v(COUNTING, "array", MethodType.methodType(int[].class));
SplittableRandom random = M3AtomKit.random("CountingSet.incr");
Object counting = counting(SET_STATES);
Map<Integer, Integer> model = new HashMap<>();
>>>
check <<<
for (int k = 0; k < M3AtomKit.OPERATIONS; k++) {
    int s = random.nextInt(SET_STATES);
    incr.invoke(counting, s);
    model.merge(s, 1, Integer::sum);
    assertArrayEquals(sorted(model), (int[]) array.invoke(counting));
}
>>>

@atom M3AutomatonOps.CountingSet.decr 1 SCENARIO java.util.HashMap-multiset
setup <<<
MethodHandle incr = v(COUNTING, "incr", MethodType.methodType(void.class, int.class));
MethodHandle decr = v(COUNTING, "decr", MethodType.methodType(void.class, int.class));
MethodHandle array = v(COUNTING, "array", MethodType.methodType(int[].class));
MethodHandle hash = v(COUNTING, "longHash", MethodType.methodType(long.class));
SplittableRandom random = M3AtomKit.random("CountingSet.decr");
Object counting = counting(SET_STATES);
Map<Integer, Integer> model = new HashMap<>();
>>>
check <<<
for (int k = 0; k < M3AtomKit.OPERATIONS; k++) {
    int s = random.nextInt(SET_STATES);
    if (model.getOrDefault(s, 0) > 0 && random.nextBoolean()) {
        decr.invoke(counting, s);
        model.computeIfPresent(s, (key, c) -> c == 1 ? null : c - 1);
    } else {
        incr.invoke(counting, s);
        model.merge(s, 1, Integer::sum);
    }
    assertArrayEquals(sorted(model), (int[]) array.invoke(counting));
    long expected = model.size();
    for (int member : model.keySet()) expected += fmix(member);
    assertEquals(expected, (long) hash.invoke(counting), "hash tracks swap-removal");
}
>>>

