@atom M3Automaton.Builder.addTransition 1 SCENARIO single-label
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
b.createState();
b.setAccept(b.createState(), true);
b.addTransition(0, 1, 'z');
AutomatonOracle.assertLanguage(b.finish(), "z", AutomatonOracle.ABC, 2);
>>>

@atom M3Automaton.Builder.addTransition 2 SCENARIO any-order=sorted-direct
setup <<<
SplittableRandom random = M3AtomKit.random("Builder.addTransition");
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    M3Automaton direct = random(random, GEN_STATES);
    M3Automaton built = viaBuilder(direct, random);
    for (int s = 0; s < direct.getNumStates(); s++) {
        assertArrayEquals(AutomatonOracle.transitions(direct, s), AutomatonOracle.transitions(built, s), "state " + s);
    }
    assertEquals(direct.isDeterministic(), built.isDeterministic());
}
M3Automaton.Builder grow = new M3Automaton.Builder(0, 0);
grow.createState();
for (int i = 0; i < MANY; i++) grow.addTransition(0, 0, i);
assertEquals(1, grow.finish().getNumTransitions(), "growth then merge of adjacent labels");
>>>

@atom M3Automaton.Builder.addEpsilon 1 SCENARIO java.util.regex(x|xy)
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
int s0 = b.createState(), s1 = b.createState(), s2 = b.createState(), s3 = b.createState();
b.addTransition(s1, s2, 'a');
b.addTransition(s2, s3, 'b');
b.setAccept(s2, true);
b.setAccept(s3, true);
b.addEpsilon(s0, s1);
AutomatonOracle.assertLanguage(b.finish(), "ab?", AutomatonOracle.ABC, AutomatonOracle.MAX_LENGTH);
M3Automaton.Builder later = new M3Automaton.Builder();
later.createState();
later.createState();
later.addEpsilon(0, 1);
later.addTransition(1, 1, 'a');
assertEquals(0, later.finish().getNumTransitions(0), "only transitions recorded so far are copied");
>>>

@atom M3Automaton.Builder.finish 1 SCENARIO sorted-finished-automaton
setup <<<
SplittableRandom random = M3AtomKit.random("Builder.finish");
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    M3Automaton direct = random(random, GEN_STATES);
    M3Automaton built = viaBuilder(direct, random);
    AutomatonOracle.assertWellFormed(built);
    AutomatonOracle.assertSameLanguage(direct, built, lettersAlphabet(), 3);
}
>>>

@atom M3Automaton.Builder.createState 1 SCENARIO sequential-ids
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
for (int i = 0; i < MANY; i++) assertEquals(i, b.createState());
assertEquals(MANY, b.finish().getNumStates());
>>>

@atom M3Automaton.Builder.setAccept 1 SCENARIO java.util.BitSet-flags
setup <<<
M3Automaton.Builder b = new M3Automaton.Builder();
for (int i = 0; i < GEN_STATES; i++) b.createState();
>>>
check <<<
b.setAccept(3, true);
b.setAccept(4, true);
b.setAccept(4, false);
M3Automaton a = b.finish();
for (int i = 0; i < GEN_STATES; i++) assertEquals(i == 3, a.isAccept(i));
M3AtomKit.expect(IndexOutOfBoundsException.class, () -> b.setAccept(GEN_STATES, true));
>>>

@atom M3Automaton.Builder.isAccept 1 SCENARIO flag-read
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
b.setAccept(b.createState(), true);
b.createState();
assertTrue(b.isAccept(0));
assertFalse(b.isAccept(1));
>>>

@atom M3Automaton.Builder.getNumStates 1 SCENARIO count
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
b.copyStates(AutomatonOracle.word("abc"));
assertEquals(4, b.getNumStates());
>>>

@atom M3Automaton.Builder.copy 1 SCENARIO renumbering+java.util.regex
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
b.createState();
b.copy(AutomatonOracle.word("ab"));
b.copy(AutomatonOracle.word("c"));
b.addEpsilon(0, 1);
b.addEpsilon(0, 4);
AutomatonOracle.assertLanguage(b.finish(), "ab|c", AutomatonOracle.ABC, AutomatonOracle.MAX_LENGTH);
>>>

@atom M3Automaton.Builder.copyStates 1 SCENARIO states-and-flags-only
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
b.createState();
b.copyStates(AutomatonOracle.word("ab"));
assertEquals(4, b.getNumStates());
assertTrue(b.isAccept(3));
assertFalse(b.isAccept(1));
assertEquals(0, b.finish().getNumTransitions(), "no transitions are copied");
>>>
