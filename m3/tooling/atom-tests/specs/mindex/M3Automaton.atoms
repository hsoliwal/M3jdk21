@atom M3Automaton.finishState 1 SCENARIO idempotent+required
check <<<
M3Automaton a = new M3Automaton();
a.createState();
a.createState();
a.addTransition(1, 0, 'b');
a.addTransition(1, 0, 'a');
a.finishState();
a.finishState();
assertArrayEquals(new int[] {0, 'a', 'b'}, AutomatonOracle.transitions(a, 1)[0], "finished and merged once");
assertEquals(1, a.getNumTransitions());
>>>

@atom M3Automaton.getNumStates 1 SCENARIO count
check <<<
M3Automaton a = AutomatonOracle.word("abc");
assertEquals(4, a.getNumStates());
assertEquals(0, new M3Automaton().getNumStates());
>>>

@atom M3Automaton.getNumTransitions 1 SCENARIO count-after-merge
check <<<
M3Automaton a = AutomatonOracle.word("abc");
assertEquals(3, a.getNumTransitions());
M3Automaton merged = new M3Automaton();
merged.createState();
merged.addTransition(0, 0, 'a');
merged.addTransition(0, 0, 'b');
merged.finishState();
assertEquals(1, merged.getNumTransitions(), "merged ranges count once");
