// Copyright (c) 2026 Synexia, Hitesh Soliwal (hsoliwal@gmail.com) and others
// Atoms of M3Automaton.java (packed-lane automaton, its Transition cursor and Builder).
// Oracles: AutomatonOracle set-of-states simulation + java.util.regex languages, java.util.TreeSet start points,
// stable java.util.List.sort for tuple sorting, recomputed determinism.
#class M3AutomatonAtomTest
#summary Per-atom contracts of jdk.internal.mindex.M3Automaton against java.util collections and java.util.regex
#build AutomatonOracle
#import jdk.internal.mindex.M3Automaton java.util.ArrayList java.util.Arrays java.util.BitSet java.util.Comparator java.util.List java.util.SplittableRandom java.util.TreeSet
#const int RANGE_WIDTHS = 2 // generated label ranges span one or two letters
#const int ACCEPT_ODDS = 3 // one generated state in ACCEPT_ODDS accepts
#const int LANGUAGE_LENGTH = 3 // longest text of the language comparisons over the LABELS letters
#const int FIRST_ACCEPT = 2 // first accepting state of the live-view check
#const int SECOND_ACCEPT = 5 // second accepting state of the live-view check
#const int LATE_ACCEPT = 7 // state accepted after the view was taken
#const int AB_STATES = 3 // states of the word automaton "ab"
#const int AB_ACCEPT = 2 // accepting (leaf) state of the word automaton "ab"
#const int ABC_STATES = 4 // states of the word automaton "abc": |w| + 1
#const int ABC_TRANSITIONS = 3 // transitions of the word automaton "abc": |w|
#const int CHAIN_STATES = 3 // states of the chain 0 -> 1 -> 2; also the first state index past it
#const int CHAIN_LAST = 2 // last state of the chain
#const int LEFT_OFFSET = 1 // states created before the first copy: the copied state s becomes LEFT_OFFSET + s
#const int FORK_STATES = 3 // states of the fork 0 -> {1, 2}
#const int FORK_OTHER = 2 // second destination of the fork
#const int MERGED_RANGES = 3 // ranges left after merging: [a-f] and [m-p] to 1, [x-z] to 2
#const int STAR_STATES = 4 // states of the star 0 -> {1, 2, 3}
#const int STAR_ARMS = 3 // transitions of the star
#const int A_ARM = 1 // destination of the star's 'a' transition
#const int M_ARM = 2 // destination of the star's 'm' transition
#const int X_ARM = 3 // destination of the star's 'x' transition
#const int G_K_ARM = 2 // destination of the star's 'g'..'k' transition
#const int CURSOR_PAST_TWO = 2 // transition index after the star's first two transitions
#const int MAX_FROM = 3 // a sorted run starts at one of the first MAX_FROM tuples
#const int[][] KEY_ORDERS = {{0, 1, 2}, {1, 2, 0}, {0}, {2, 1}} // sort-key orders over the first three tuple fields
#const int[] TUPLE_LANE = {9, 9, 1, 5, 3, 1, 5, 3, 1, 4, 2} // two padding words, then the tuples {1, 5, 3}, {1, 5, 3}, {1, 4, 2}
#const int TUPLE_BASE = 2 // offset of the first tuple of TUPLE_LANE, after its padding
#const int THIRD_TUPLE = 2 // index of the tuple {1, 4, 2}
#const int THIRD_KEY = 2 // index of the third tuple field
#const int[] ALL_KEYS = {0, 1, 2} // every field of a packed transition tuple, in order
#const int SHORT_TEXT_LENGTH = 2 // texts up to two letters: "z" is accepted, "zz" is not
#const int KEPT_ACCEPT = 3 // state that stays accepting
#const int CLEARED_ACCEPT = 4 // state accepted, then cleared
#helper <<<
    private static final Class<?> OWNER = M3Automaton.class;
    /** States and transitions of the growth checks (well past the initial lane capacity). */
    private static final int MANY = 1_000;
    /** Labels of the random automata. */
    private static final int LABELS = 8;
    private static final int GEN_STATES = 12;
    private static final int GEN_FANOUT = 4;
    /** Width of the packed transition tuples (dest, min, max) and builder tuples (src, dest, min, max). */
    private static final int TUPLE = 3;
    private static final int BUILDER_TUPLE = 4;
    /** Fields of a recorded edge {src, dest, min, max}. */
    private static final int EDGE_SRC = 0;
    private static final int EDGE_DEST = 1;
    private static final int EDGE_MIN = 2;
    private static final int EDGE_MAX = 3;

    /** Random automaton with transitions over 'a'..'a'+LABELS, recorded per source in source order. */
    private static M3Automaton random(SplittableRandom random, int states) {
        M3Automaton a = new M3Automaton();
        for (int s = 0; s < states; s++) a.createState();
        for (int s = 0; s < states; s++) {
            int fanout = random.nextInt(GEN_FANOUT);
            for (int i = 0; i < fanout; i++) {
                int min = 'a' + random.nextInt(LABELS);
                int max = Math.min('a' + LABELS - 1, min + random.nextInt(RANGE_WIDTHS));
                a.addTransition(s, random.nextInt(states), min, max);
            }
            a.setAccept(s, random.nextInt(ACCEPT_ODDS) == 0);
        }
        a.finishState();
        return a;
    }

    /** The same transitions recorded through the Builder in a shuffled order. */
    private static M3Automaton viaBuilder(M3Automaton a, SplittableRandom random) {
        List<int[]> edges = new ArrayList<>();
        for (int s = 0; s < a.getNumStates(); s++) {
            for (int[] t : AutomatonOracle.transitions(a, s)) edges.add(new int[] {s, t[AutomatonOracle.DEST], t[AutomatonOracle.MIN], t[AutomatonOracle.MAX]});
        }
        java.util.Collections.shuffle(edges, new java.util.Random(random.nextLong()));
        M3Automaton.Builder b = new M3Automaton.Builder();
        for (int s = 0; s < a.getNumStates(); s++) b.setAccept(b.createState(), a.isAccept(s));
        for (int[] e : edges) b.addTransition(e[EDGE_SRC], e[EDGE_DEST], e[EDGE_MIN], e[EDGE_MAX]);
        return b.finish();
    }

    private static List<String> lettersAlphabet() {
        List<String> out = new ArrayList<>();
        for (int i = 0; i < LABELS; i++) out.add(String.valueOf((char) ('a' + i)));
        return out;
    }
>>>

@atom M3Automaton.M3Automaton 1 SCENARIO empty-automaton
check <<<
M3Automaton a = new M3Automaton();
assertEquals(0, a.getNumStates());
assertEquals(0, a.getNumTransitions());
assertTrue(a.isDeterministic());
assertFalse(AutomatonOracle.accepts(a, ""));
>>>

@atom M3Automaton.M3Automaton 2 SCENARIO capacity-hint-is-not-behaviour
setup <<<
SplittableRandom random = M3AtomKit.random("M3Automaton(int,int)");
>>>
check <<<
for (int[] hint : new int[][] {{0, 0}, {1, 1}, {GEN_STATES, GEN_STATES * GEN_FANOUT}, {MANY, MANY}}) {
    M3Automaton reference = random(random, GEN_STATES);
    M3Automaton sized = new M3Automaton(hint[0], hint[1]);
    sized.copy(reference);
    assertEquals(0, new M3Automaton(hint[0], hint[1]).getNumStates(), "hint creates no state");
    AutomatonOracle.assertSameLanguage(reference, sized, lettersAlphabet(), LANGUAGE_LENGTH);
}
>>>

@atom M3Automaton.createState 1 SCENARIO sequential-ids
check <<<
M3Automaton a = new M3Automaton();
for (int i = 0; i < MANY; i++) {
    assertEquals(i, a.createState());
    assertEquals(i + 1, a.getNumStates());
    assertFalse(a.isAccept(i));
    assertEquals(0, a.getNumTransitions(i));
}
>>>

@atom M3Automaton.setAccept 1 SCENARIO java.util.BitSet-flags
setup <<<
M3Automaton a = new M3Automaton();
BitSet model = new BitSet();
SplittableRandom random = M3AtomKit.random("setAccept");
for (int i = 0; i < GEN_STATES; i++) a.createState();
>>>
check <<<
for (int k = 0; k < M3AtomKit.OPERATIONS; k++) {
    int s = random.nextInt(GEN_STATES);
    boolean accept = random.nextBoolean();
    a.setAccept(s, accept);
    model.set(s, accept);
    for (int q = 0; q < GEN_STATES; q++) assertEquals(model.get(q), a.isAccept(q));
}
M3AtomKit.expect(IndexOutOfBoundsException.class, () -> a.setAccept(GEN_STATES, true));
M3AtomKit.expect(IndexOutOfBoundsException.class, () -> a.setAccept(-1, true));
>>>

@atom M3Automaton.acceptStates 1 SCENARIO live-java.util.BitSet-view
setup <<<
MethodHandle atom = M3AtomKit.findVirtual(OWNER, "acceptStates", MethodType.methodType(BitSet.class));
M3Automaton a = new M3Automaton();
for (int i = 0; i < GEN_STATES; i++) a.createState();
>>>
check <<<
a.setAccept(FIRST_ACCEPT, true);
a.setAccept(SECOND_ACCEPT, true);
BitSet view = (BitSet) atom.invokeExact(a);
assertEquals(BitSet.valueOf(new long[] {(1L << FIRST_ACCEPT) | (1L << SECOND_ACCEPT)}), view);
a.setAccept(LATE_ACCEPT, true);
assertTrue(view.get(LATE_ACCEPT), "the accept lane is shared, not copied");
>>>

@atom M3Automaton.isAccept 1 SCENARIO flag-read
check <<<
M3Automaton a = AutomatonOracle.word("ab");
assertFalse(a.isAccept(0));
assertFalse(a.isAccept(1));
assertTrue(a.isAccept(AB_ACCEPT));
assertFalse(a.isAccept(MANY), "beyond the states reads false");
>>>

@atom M3Automaton.addTransition 1 SCENARIO single-label=range[label,label]
check <<<
M3Automaton a = new M3Automaton();
a.createState();
a.createState();
a.addTransition(0, 1, 'q');
a.finishState();
assertArrayEquals(new int[] {1, 'q', 'q'}, AutomatonOracle.transitions(a, 0)[0]);
>>>

@atom M3Automaton.addTransition 2 SCENARIO contiguous-per-source+bounds
setup <<<
M3Automaton a = new M3Automaton();
for (int i = 0; i < CHAIN_STATES; i++) a.createState();
>>>
check <<<
a.addTransition(0, 1, 'a', 'c');
a.addTransition(1, CHAIN_LAST, 'd', 'f');
M3AtomKit.expectMessage(IllegalStateException.class, "already had transitions", () -> a.addTransition(0, CHAIN_LAST, 'x', 'x'));
M3AtomKit.expect(IndexOutOfBoundsException.class, () -> a.addTransition(CHAIN_STATES, 0, 'a', 'a'));
M3AtomKit.expect(IndexOutOfBoundsException.class, () -> a.addTransition(0, CHAIN_STATES, 'a', 'a'));
a.finishState();
assertArrayEquals(new int[] {1, 'a', 'c'}, AutomatonOracle.transitions(a, 0)[0]);
assertArrayEquals(new int[] {CHAIN_LAST, 'd', 'f'}, AutomatonOracle.transitions(a, 1)[0]);
>>>

@atom M3Automaton.addEpsilon 1 SCENARIO java.util.regex(a|ab)
check <<<
M3Automaton a = new M3Automaton();
int s0 = a.createState(), s1 = a.createState(), s2 = a.createState(), s3 = a.createState();
a.addTransition(s1, s2, 'a');
a.addTransition(s2, s3, 'b');
a.finishState();
a.setAccept(s2, true);
a.setAccept(s3, true);
a.addEpsilon(s0, s1);
a.finishState();
AutomatonOracle.assertLanguage(a, "ab?", AutomatonOracle.ABC, AutomatonOracle.MAX_LENGTH);
M3Automaton accepting = new M3Automaton();
accepting.createState();
accepting.createState();
accepting.setAccept(1, true);
accepting.addEpsilon(0, 1);
assertTrue(accepting.isAccept(0), "epsilon copies the accept flag");
>>>

@atom M3Automaton.copy 1 SCENARIO renumbering+java.util.regex
setup <<<
M3Automaton left = AutomatonOracle.word("ab");
M3Automaton right = AutomatonOracle.word("c");
>>>
check <<<
M3Automaton a = new M3Automaton();
a.createState();
a.copy(left);
a.copy(right);
assertEquals(1 + left.getNumStates() + right.getNumStates(), a.getNumStates());
assertEquals(left.getNumTransitions() + right.getNumTransitions(), a.getNumTransitions());
assertArrayEquals(new int[] {LEFT_OFFSET + 1, 'a', 'a'}, AutomatonOracle.transitions(a, 1)[0], "destinations renumbered");
assertTrue(a.isAccept(LEFT_OFFSET + AB_ACCEPT) && a.isAccept(LEFT_OFFSET + left.getNumStates() + 1));
a.addEpsilon(0, 1);
a.addEpsilon(0, 1 + left.getNumStates());
a.finishState();
AutomatonOracle.assertLanguage(a, "ab|c", AutomatonOracle.ABC, AutomatonOracle.MAX_LENGTH);
M3Automaton nondeterministic = new M3Automaton();
nondeterministic.createState();
nondeterministic.createState();
nondeterministic.addTransition(0, 0, 'a', 'b');
nondeterministic.addTransition(0, 1, 'b', 'c');
nondeterministic.finishState();
M3Automaton target = AutomatonOracle.word("a");
target.copy(nondeterministic);
assertFalse(target.isDeterministic(), "nondeterminism propagates");
>>>

@atom M3Automaton.finishCurrentState 1 SCENARIO sort+merge+determinism
check <<<
M3Automaton a = new M3Automaton();
for (int i = 0; i < FORK_STATES; i++) a.createState();
a.addTransition(0, 1, 'm', 'p');
a.addTransition(0, 1, 'a', 'c');
a.addTransition(0, 1, 'd', 'f');
a.addTransition(0, FORK_OTHER, 'x', 'z');
a.addTransition(0, 1, 'b', 'e');
a.finishState();
int[][] ts = AutomatonOracle.transitions(a, 0);
assertEquals(MERGED_RANGES, ts.length, "adjacent and overlapping ranges to one destination merge");
assertArrayEquals(new int[] {1, 'a', 'f'}, ts[0]);
assertArrayEquals(new int[] {1, 'm', 'p'}, ts[1]);
assertArrayEquals(new int[] {FORK_OTHER, 'x', 'z'}, ts[MERGED_RANGES - 1]);
assertTrue(a.isDeterministic());
AutomatonOracle.assertWellFormed(a);
>>>

@atom M3Automaton.put 1 SCENARIO tuple-write
setup <<<
MethodHandle atom = M3AtomKit.findVirtual(OWNER, "put",
        MethodType.methodType(int.class, int.class, int.class, int.class, int.class, int.class));
M3Automaton a = new M3Automaton();
a.createState();
a.createState();
a.addTransition(0, 1, 'a');
a.finishState();
>>>
check <<<
assertEquals(1, (int) atom.invokeExact(a, 0, 0, 0, (int) 'k', (int) 'n'));
assertArrayEquals(new int[] {0, 'k', 'n'}, AutomatonOracle.transitions(a, 0)[0]);
>>>

@atom M3Automaton.isDeterministic 1 SCENARIO recomputed-overlap
setup <<<
SplittableRandom random = M3AtomKit.random("isDeterministic");
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    M3Automaton a = random(random, GEN_STATES);
    assertEquals(AutomatonOracle.computedDeterministic(a), a.isDeterministic());
}
>>>

@atom M3Automaton.finishState 1 SCENARIO idempotent+required
check <<<
M3Automaton a = new M3Automaton();
a.createState();
a.createState();
a.addTransition(1, 0, 'b');
a.addTransition(1, 0, 'a');
a.finishState();
a.finishState();
assertArrayEquals(new int[] {0, 'a', 'b'}, AutomatonOracle.transitions(a, 1)[0], "finished and merged once");
assertEquals(1, a.getNumTransitions());
>>>

@atom M3Automaton.getNumStates 1 GETTER_DIFF count
setup = M3Automaton a = AutomatonOracle.word("abc");
expected = ABC_STATES
receiver = a
extra = assertEquals(0, new M3Automaton().getNumStates());

@atom M3Automaton.getNumTransitions 1 GETTER_DIFF count-after-merge
setup = M3Automaton a = AutomatonOracle.word("abc");
expected = ABC_TRANSITIONS
receiver = a
extra <<<
M3Automaton merged = new M3Automaton();
merged.createState();
merged.addTransition(0, 0, 'a');
merged.addTransition(0, 0, 'b');
merged.finishState();
assertEquals(1, merged.getNumTransitions(), "merged ranges count once");
>>>

@atom M3Automaton.getNumTransitions 2 SCENARIO per-state-count
check <<<
M3Automaton a = AutomatonOracle.word("ab");
assertEquals(1, a.getNumTransitions(0));
assertEquals(1, a.getNumTransitions(1));
assertEquals(0, a.getNumTransitions(AB_ACCEPT), "accepting leaf");
>>>

@atom M3Automaton.growStates 1 SCENARIO capacity-growth
check <<<
M3Automaton a = new M3Automaton(0, 0);
for (int i = 0; i < MANY; i++) {
    a.createState();
    a.setAccept(i, i % M3AtomKit.PARITY == 0);
}
assertEquals(MANY, a.getNumStates());
for (int i = 0; i < MANY; i++) assertEquals(i % M3AtomKit.PARITY == 0, a.isAccept(i));
>>>

@atom M3Automaton.growTransitions 1 SCENARIO capacity-growth
check <<<
M3Automaton a = new M3Automaton(0, 0);
for (int i = 0; i <= MANY; i++) a.createState();
for (int i = 0; i < MANY; i++) a.addTransition(i, i + 1, i % AutomatonOracle.MAX_LABEL);
a.finishState();
assertEquals(MANY, a.getNumTransitions());
for (int i = 0; i < MANY; i++) assertArrayEquals(new int[] {i + 1, i, i}, AutomatonOracle.transitions(a, i)[0]);
>>>

@atom M3Automaton.initTransition 1 SCENARIO cursor-start
check <<<
M3Automaton a = AutomatonOracle.word("ab");
M3Automaton.Transition t = new M3Automaton.Transition();
assertEquals(1, a.initTransition(1, t));
assertEquals(1, t.source);
assertEquals(0, a.initTransition(AB_ACCEPT, t), "leaf state");
>>>

@atom M3Automaton.getNextTransition 1 SCENARIO cursor-order
check <<<
M3Automaton a = new M3Automaton();
for (int i = 0; i < STAR_STATES; i++) a.createState();
a.addTransition(0, X_ARM, 'x');
a.addTransition(0, A_ARM, 'a');
a.addTransition(0, M_ARM, 'm');
a.finishState();
M3Automaton.Transition t = new M3Automaton.Transition();
a.initTransition(0, t);
int[] dests = new int[STAR_ARMS];
for (int i = 0; i < STAR_ARMS; i++) {
    a.getNextTransition(t);
    dests[i] = t.dest;
}
assertArrayEquals(new int[] {A_ARM, M_ARM, X_ARM}, dests, "ascending label order");
>>>

@atom M3Automaton.getTransition 1 SCENARIO indexed-read
check <<<
String word = "xyz";
M3Automaton a = AutomatonOracle.word(word);
M3Automaton.Transition t = new M3Automaton.Transition();
for (int s = 0; s < word.length(); s++) {
    a.getTransition(s, 0, t);
    assertEquals(s, t.source);
    assertEquals(s + 1, t.dest);
    assertEquals(word.charAt(s), t.min);
    assertEquals(word.charAt(s), t.max);
}
>>>

@atom M3Automaton.getStartPoints 1 SCENARIO java.util.TreeSet
setup <<<
SplittableRandom random = M3AtomKit.random("getStartPoints");
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    M3Automaton a = random(random, GEN_STATES);
    int maxLabel = 'a' + LABELS - 1 - (k % M3AtomKit.PARITY);
    TreeSet<Integer> expected = new TreeSet<>();
    expected.add(0);
    for (int s = 0; s < a.getNumStates(); s++) {
        for (int[] t : AutomatonOracle.transitions(a, s)) {
            expected.add(t[AutomatonOracle.MIN]);
            if (t[AutomatonOracle.MAX] < maxLabel) expected.add(t[AutomatonOracle.MAX] + 1);
        }
    }
    assertArrayEquals(expected.stream().mapToInt(Integer::intValue).toArray(), a.getStartPoints(0, maxLabel));
}
>>>

@atom M3Automaton.step 1 SCENARIO linear-scan
setup <<<
SplittableRandom random = M3AtomKit.random("step");
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    M3Automaton a = random(random, GEN_STATES);
    if (!a.isDeterministic()) continue;
    for (int s = 0; s < a.getNumStates(); s++) {
        for (int label = 'a' - 1; label <= 'a' + LABELS; label++) {
            int expected = -1;
            for (int[] t : AutomatonOracle.transitions(a, s)) {
                if (t[AutomatonOracle.MIN] <= label && label <= t[AutomatonOracle.MAX]) expected = t[AutomatonOracle.DEST];
            }
            assertEquals(expected, a.step(s, label));
        }
    }
}
>>>

@atom M3Automaton.next 1 SCENARIO monotone-cursor=step
setup <<<
SplittableRandom random = M3AtomKit.random("next");
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    M3Automaton a = random(random, GEN_STATES);
    if (!a.isDeterministic()) continue;
    for (int s = 0; s < a.getNumStates(); s++) {
        M3Automaton.Transition t = new M3Automaton.Transition();
        t.source = s;
        for (int label = 'a' - 1; label <= 'a' + LABELS; label++) {
            int dest = a.next(t, label);
            assertEquals(a.step(s, label), dest, "state " + s + " label " + label);
            assertEquals(dest, t.dest);
        }
    }
}
>>>

@atom M3Automaton.next 2 SCENARIO binary-search=linear-scan
setup <<<
MethodHandle atom = M3AtomKit.findVirtual(OWNER, "next", MethodType.methodType(int.class, int.class, int.class,
        int.class, M3Automaton.Transition.class));
M3Automaton a = new M3Automaton();
for (int i = 0; i < STAR_STATES; i++) a.createState();
a.addTransition(0, 1, 'a', 'c');
a.addTransition(0, G_K_ARM, 'g', 'k');
a.addTransition(0, X_ARM, 'x', 'x');
a.finishState();
>>>
check <<<
M3Automaton.Transition t = new M3Automaton.Transition();
assertEquals(G_K_ARM, (int) atom.invokeExact(a, 0, 0, (int) 'h', t));
assertEquals('g', t.min);
assertEquals('k', t.max);
assertEquals(-1, (int) atom.invokeExact(a, 0, 0, (int) 'd', t));
assertEquals(-1, t.dest);
assertEquals(-1, (int) atom.invokeExact(a, 0, CURSOR_PAST_TWO, (int) 'b', t), "search starts at the cursor");
assertEquals(1, (int) atom.invokeExact(a, 0, 0, (int) 'b', (M3Automaton.Transition) null), "null cursor");
>>>

@atom M3Automaton.sortTuples 1 SCENARIO stable-java.util.List.sort
setup <<<
MethodHandle atom = M3AtomKit.findStatic(OWNER, "sortTuples", MethodType.methodType(void.class, int[].class,
        int.class, int.class, int.class, int[].class));
SplittableRandom random = M3AtomKit.random("sortTuples");
int[][] keyOrders = KEY_ORDERS;
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    int width = k % M3AtomKit.PARITY == 0 ? TUPLE : BUILDER_TUPLE;
    int count = random.nextInt(0, GEN_STATES * GEN_FANOUT);
    int from = random.nextInt(MAX_FROM);
    int[] keys = keyOrders[k % keyOrders.length];
    int[] a = random.ints((from + count + 1) * width, 0, LABELS).toArray();
    List<int[]> tuples = new ArrayList<>();
    for (int i = 0; i < count; i++) tuples.add(Arrays.copyOfRange(a, (from + i) * width, (from + i + 1) * width));
    Comparator<int[]> order = (x, y) -> {
        for (int key : keys) {
            int c = Integer.compare(x[key], y[key]);
            if (c != 0) return c;
        }
        return 0;
    };
    tuples.sort(order);
    int[] expected = a.clone();
    for (int i = 0; i < count; i++) System.arraycopy(tuples.get(i), 0, expected, (from + i) * width, width);
    atom.invokeExact(a, width, from, count, keys);
    assertArrayEquals(expected, a, "stable sort of " + count + " tuples");
}
>>>

@atom M3Automaton.compareTuples 1 SCENARIO lexicographic-Integer.compare
setup <<<
MethodHandle atom = M3AtomKit.findStatic(OWNER, "compareTuples", MethodType.methodType(int.class, int[].class,
        int.class, int.class, int.class, int.class, int[].class));
int[] a = TUPLE_LANE.clone();
>>>
check <<<
assertEquals(0, (int) atom.invokeExact(a, TUPLE_BASE, TUPLE, 0, 1, ALL_KEYS.clone()), "equal tuples");
assertTrue((int) atom.invokeExact(a, TUPLE_BASE, TUPLE, 1, THIRD_TUPLE, new int[] {1}) > 0, "5 > 4 on key 1");
assertTrue((int) atom.invokeExact(a, TUPLE_BASE, TUPLE, THIRD_TUPLE, 1, new int[] {1}) < 0);
assertTrue((int) atom.invokeExact(a, TUPLE_BASE, TUPLE, 0, THIRD_TUPLE, new int[] {THIRD_KEY}) > 0, "3 > 2 on key 2");
assertTrue((int) atom.invokeExact(a, TUPLE_BASE, TUPLE, 0, THIRD_TUPLE, ALL_KEYS.clone()) > 0, "first differing key decides");
assertEquals(0, (int) atom.invokeExact(a, TUPLE_BASE, TUPLE, 0, THIRD_TUPLE, new int[] {0}), "equal on key 0");
assertEquals(0, (int) atom.invokeExact(a, TUPLE_BASE, TUPLE, 0, 1, new int[0]), "no keys compare equal");
>>>

@atom M3Automaton.Transition.Transition 1 SCENARIO default-cursor
check <<<
M3Automaton.Transition t = new M3Automaton.Transition();
assertEquals(0, t.source);
assertEquals(0, t.dest);
assertEquals(0, t.min);
assertEquals(0, t.max);
MethodHandle upto = M3AtomKit.findGetter(M3Automaton.Transition.class, "transitionUpto", int.class);
assertEquals(-1, (int) upto.invokeExact(t), "uninitialized cursor position");
>>>

@atom M3Automaton.Builder.Builder 1 SCENARIO empty-builder
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
assertEquals(0, b.getNumStates());
M3Automaton a = b.finish();
assertEquals(0, a.getNumStates());
>>>

@atom M3Automaton.Builder.Builder 2 SCENARIO capacity-hint-is-not-behaviour
setup <<<
SplittableRandom random = M3AtomKit.random("Builder(int,int)");
>>>
check <<<
for (int[] hint : new int[][] {{0, 0}, {1, 1}, {MANY, MANY}}) {
    M3Automaton reference = random(random, GEN_STATES);
    M3Automaton.Builder b = new M3Automaton.Builder(hint[0], hint[1]);
    b.copy(reference);
    AutomatonOracle.assertSameLanguage(reference, b.finish(), lettersAlphabet(), LANGUAGE_LENGTH);
}
>>>

@atom M3Automaton.Builder.addTransition 1 SCENARIO single-label
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
b.createState();
b.setAccept(b.createState(), true);
b.addTransition(0, 1, 'z');
AutomatonOracle.assertLanguage(b.finish(), "z", AutomatonOracle.ABC, SHORT_TEXT_LENGTH);
>>>

@atom M3Automaton.Builder.addTransition 2 SCENARIO any-order=sorted-direct
setup <<<
SplittableRandom random = M3AtomKit.random("Builder.addTransition");
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    M3Automaton direct = random(random, GEN_STATES);
    M3Automaton built = viaBuilder(direct, random);
    for (int s = 0; s < direct.getNumStates(); s++) {
        assertArrayEquals(AutomatonOracle.transitions(direct, s), AutomatonOracle.transitions(built, s), "state " + s);
    }
    assertEquals(direct.isDeterministic(), built.isDeterministic());
}
M3Automaton.Builder grow = new M3Automaton.Builder(0, 0);
grow.createState();
for (int i = 0; i < MANY; i++) grow.addTransition(0, 0, i);
assertEquals(1, grow.finish().getNumTransitions(), "growth then merge of adjacent labels");
>>>

@atom M3Automaton.Builder.addEpsilon 1 SCENARIO java.util.regex(x|xy)
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
int s0 = b.createState(), s1 = b.createState(), s2 = b.createState(), s3 = b.createState();
b.addTransition(s1, s2, 'a');
b.addTransition(s2, s3, 'b');
b.setAccept(s2, true);
b.setAccept(s3, true);
b.addEpsilon(s0, s1);
AutomatonOracle.assertLanguage(b.finish(), "ab?", AutomatonOracle.ABC, AutomatonOracle.MAX_LENGTH);
M3Automaton.Builder later = new M3Automaton.Builder();
later.createState();
later.createState();
later.addEpsilon(0, 1);
later.addTransition(1, 1, 'a');
assertEquals(0, later.finish().getNumTransitions(0), "only transitions recorded so far are copied");
>>>

@atom M3Automaton.Builder.finish 1 SCENARIO sorted-finished-automaton
setup <<<
SplittableRandom random = M3AtomKit.random("Builder.finish");
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    M3Automaton direct = random(random, GEN_STATES);
    M3Automaton built = viaBuilder(direct, random);
    AutomatonOracle.assertWellFormed(built);
    AutomatonOracle.assertSameLanguage(direct, built, lettersAlphabet(), LANGUAGE_LENGTH);
}
>>>

@atom M3Automaton.Builder.createState 1 SCENARIO sequential-ids
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
for (int i = 0; i < MANY; i++) assertEquals(i, b.createState());
assertEquals(MANY, b.finish().getNumStates());
>>>

@atom M3Automaton.Builder.setAccept 1 SCENARIO java.util.BitSet-flags
setup <<<
M3Automaton.Builder b = new M3Automaton.Builder();
for (int i = 0; i < GEN_STATES; i++) b.createState();
>>>
check <<<
b.setAccept(KEPT_ACCEPT, true);
b.setAccept(CLEARED_ACCEPT, true);
b.setAccept(CLEARED_ACCEPT, false);
M3Automaton a = b.finish();
for (int i = 0; i < GEN_STATES; i++) assertEquals(i == KEPT_ACCEPT, a.isAccept(i));
M3AtomKit.expect(IndexOutOfBoundsException.class, () -> b.setAccept(GEN_STATES, true));
>>>

@atom M3Automaton.Builder.isAccept 1 SCENARIO flag-read
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
b.setAccept(b.createState(), true);
b.createState();
assertTrue(b.isAccept(0));
assertFalse(b.isAccept(1));
>>>

@atom M3Automaton.Builder.getNumStates 1 GETTER_DIFF count
setup <<<
M3Automaton.Builder b = new M3Automaton.Builder();
b.copyStates(AutomatonOracle.word("abc"));
>>>
expected = ABC_STATES
receiver = b

@atom M3Automaton.Builder.copy 1 SCENARIO renumbering+java.util.regex
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
b.createState();
b.copy(AutomatonOracle.word("ab"));
b.copy(AutomatonOracle.word("c"));
b.addEpsilon(0, 1);
b.addEpsilon(0, 1 + AB_STATES);
AutomatonOracle.assertLanguage(b.finish(), "ab|c", AutomatonOracle.ABC, AutomatonOracle.MAX_LENGTH);
>>>

@atom M3Automaton.Builder.copyStates 1 SCENARIO states-and-flags-only
check <<<
M3Automaton.Builder b = new M3Automaton.Builder();
b.createState();
b.copyStates(AutomatonOracle.word("ab"));
assertEquals(1 + AB_STATES, b.getNumStates());
assertTrue(b.isAccept(1 + AB_ACCEPT));
assertFalse(b.isAccept(1));
assertEquals(0, b.finish().getNumTransitions(), "no transitions are copied");
>>>
