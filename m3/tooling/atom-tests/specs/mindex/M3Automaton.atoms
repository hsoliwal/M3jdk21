@atom M3Automaton.getNumTransitions 2 SCENARIO per-state-count
check <<<
M3Automaton a = AutomatonOracle.word("ab");
assertEquals(1, a.getNumTransitions(0));
assertEquals(1, a.getNumTransitions(1));
assertEquals(0, a.getNumTransitions(2), "accepting leaf");
>>>

@atom M3Automaton.growStates 1 SCENARIO capacity-growth
check <<<
M3Automaton a = new M3Automaton(0, 0);
for (int i = 0; i < MANY; i++) {
    a.createState();
    a.setAccept(i, i % 2 == 0);
}
assertEquals(MANY, a.getNumStates());
for (int i = 0; i < MANY; i++) assertEquals(i % 2 == 0, a.isAccept(i));
>>>

@atom M3Automaton.growTransitions 1 SCENARIO capacity-growth
check <<<
M3Automaton a = new M3Automaton(0, 0);
for (int i = 0; i <= MANY; i++) a.createState();
for (int i = 0; i < MANY; i++) a.addTransition(i, i + 1, i % AutomatonOracle.MAX_LABEL);
a.finishState();
assertEquals(MANY, a.getNumTransitions());
for (int i = 0; i < MANY; i++) assertArrayEquals(new int[] {i + 1, i, i}, AutomatonOracle.transitions(a, i)[0]);
>>>

@atom M3Automaton.initTransition 1 SCENARIO cursor-start
check <<<
M3Automaton a = AutomatonOracle.word("ab");
M3Automaton.Transition t = new M3Automaton.Transition();
assertEquals(1, a.initTransition(1, t));
assertEquals(1, t.source);
assertEquals(0, a.initTransition(2, t), "leaf state");
>>>

@atom M3Automaton.getNextTransition 1 SCENARIO cursor-order
check <<<
M3Automaton a = new M3Automaton();
for (int i = 0; i < 4; i++) a.createState();
a.addTransition(0, 3, 'x');
a.addTransition(0, 1, 'a');
a.addTransition(0, 2, 'm');
a.finishState();
M3Automaton.Transition t = new M3Automaton.Transition();
a.initTransition(0, t);
int[] dests = new int[3];
for (int i = 0; i < 3; i++) {
    a.getNextTransition(t);
    dests[i] = t.dest;
}
assertArrayEquals(new int[] {1, 2, 3}, dests, "ascending label order");
>>>

@atom M3Automaton.getTransition 1 SCENARIO indexed-read
check <<<
M3Automaton a = AutomatonOracle.word("xyz");
M3Automaton.Transition t = new M3Automaton.Transition();
for (int s = 0; s < 3; s++) {
    a.getTransition(s, 0, t);
    assertEquals(s, t.source);
    assertEquals(s + 1, t.dest);
    assertEquals("xyz".charAt(s), t.min);
    assertEquals("xyz".charAt(s), t.max);
}
>>>

@atom M3Automaton.getStartPoints 1 SCENARIO java.util.TreeSet
setup <<<
SplittableRandom random = M3AtomKit.random("getStartPoints");
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    M3Automaton a = random(random, GEN_STATES);
    int maxLabel = 'a' + LABELS - 1 - (k % 2);
    TreeSet<Integer> expected = new TreeSet<>();
    expected.add(0);
    for (int s = 0; s < a.getNumStates(); s++) {
        for (int[] t : AutomatonOracle.transitions(a, s)) {
            expected.add(t[1]);
            if (t[2] < maxLabel) expected.add(t[2] + 1);
        }
    }
    assertArrayEquals(expected.stream().mapToInt(Integer::intValue).toArray(), a.getStartPoints(0, maxLabel));
}
>>>

@atom M3Automaton.step 1 SCENARIO linear-scan
setup <<<
SplittableRandom random = M3AtomKit.random("step");
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    M3Automaton a = random(random, GEN_STATES);
    if (!a.isDeterministic()) continue;
    for (int s = 0; s < a.getNumStates(); s++) {
        for (int label = 'a' - 1; label <= 'a' + LABELS; label++) {
            int expected = -1;
            for (int[] t : AutomatonOracle.transitions(a, s)) if (t[1] <= label && label <= t[2]) expected = t[0];
            assertEquals(expected, a.step(s, label));
        }
    }
}
>>>

@atom M3Automaton.next 1 SCENARIO monotone-cursor=step
setup <<<
SplittableRandom random = M3AtomKit.random("next");
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    M3Automaton a = random(random, GEN_STATES);
    if (!a.isDeterministic()) continue;
    for (int s = 0; s < a.getNumStates(); s++) {
        M3Automaton.Transition t = new M3Automaton.Transition();
        t.source = s;
        for (int label = 'a' - 1; label <= 'a' + LABELS; label++) {
            int dest = a.next(t, label);
            assertEquals(a.step(s, label), dest, "state " + s + " label " + label);
            assertEquals(dest, t.dest);
        }
    }
}
>>>

@atom M3Automaton.next 2 SCENARIO binary-search=linear-scan
setup <<<
MethodHandle atom = M3AtomKit.findVirtual(OWNER, "next", MethodType.methodType(int.class, int.class, int.class,
        int.class, M3Automaton.Transition.class));
M3Automaton a = new M3Automaton();
for (int i = 0; i < 4; i++) a.createState();
a.addTransition(0, 1, 'a', 'c');
a.addTransition(0, 2, 'g', 'k');
a.addTransition(0, 3, 'x', 'x');
a.finishState();
>>>
check <<<
M3Automaton.Transition t = new M3Automaton.Transition();
assertEquals(2, (int) atom.invokeExact(a, 0, 0, (int) 'h', t));
assertEquals('g', t.min);
assertEquals('k', t.max);
assertEquals(-1, (int) atom.invokeExact(a, 0, 0, (int) 'd', t));
assertEquals(-1, t.dest);
assertEquals(-1, (int) atom.invokeExact(a, 0, 2, (int) 'b', t), "search starts at the cursor");
assertEquals(1, (int) atom.invokeExact(a, 0, 0, (int) 'b', (M3Automaton.Transition) null), "null cursor");
>>>

@atom M3Automaton.sortTuples 1 SCENARIO stable-java.util.List.sort
setup <<<
MethodHandle atom = M3AtomKit.findStatic(OWNER, "sortTuples", MethodType.methodType(void.class, int[].class,
        int.class, int.class, int.class, int[].class));
SplittableRandom random = M3AtomKit.random("sortTuples");
int[][] keyOrders = {{0, 1, 2}, {1, 2, 0}, {0}, {2, 1}};
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    int width = k % 2 == 0 ? TUPLE : BUILDER_TUPLE;
    int count = random.nextInt(0, GEN_STATES * GEN_FANOUT);
    int from = random.nextInt(3);
    int[] keys = keyOrders[k % keyOrders.length];
    int[] a = random.ints((from + count + 1) * width, 0, LABELS).toArray();
    List<int[]> tuples = new ArrayList<>();
    for (int i = 0; i < count; i++) tuples.add(Arrays.copyOfRange(a, (from + i) * width, (from + i + 1) * width));
    Comparator<int[]> order = (x, y) -> {
        for (int key : keys) {
            int c = Integer.compare(x[key], y[key]);
            if (c != 0) return c;
        }
        return 0;
    };
    tuples.sort(order);
    int[] expected = a.clone();
    for (int i = 0; i < count; i++) System.arraycopy(tuples.get(i), 0, expected, (from + i) * width, width);
    atom.invokeExact(a, width, from, count, keys);
    assertArrayEquals(expected, a, "stable sort of " + count + " tuples");
}
>>>

@atom M3Automaton.compareTuples 1 SCENARIO lexicographic-Integer.compare
setup <<<
MethodHandle atom = M3AtomKit.findStatic(OWNER, "compareTuples", MethodType.methodType(int.class, int[].class,
        int.class, int.class, int.class, int.class, int[].class));
int[] a = {9, 9, 1, 5, 3, 1, 5, 3, 1, 4, 2};
>>>
check <<<
assertEquals(0, (int) atom.invokeExact(a, 2, TUPLE, 0, 1, new int[] {0, 1, 2}), "equal tuples");
assertTrue((int) atom.invokeExact(a, 2, TUPLE, 1, 2, new int[] {1}) > 0, "5 > 4 on key 1");
assertTrue((int) atom.invokeExact(a, 2, TUPLE, 2, 1, new int[] {1}) < 0);
assertTrue((int) atom.invokeExact(a, 2, TUPLE, 0, 2, new int[] {2}) > 0, "3 > 2 on key 2");
assertTrue((int) atom.invokeExact(a, 2, TUPLE, 0, 2, new int[] {0, 1, 2}) > 0, "first differing key decides");
assertEquals(0, (int) atom.invokeExact(a, 2, TUPLE, 0, 2, new int[] {0}), "equal on key 0");
assertEquals(0, (int) atom.invokeExact(a, 2, TUPLE, 0, 1, new int[0]), "no keys compare equal");
>>>

@atom M3Automaton.Transition.Transition 1 SCENARIO default-cursor
check <<<
M3Automaton.Transition t = new M3Automaton.Transition();
assertEquals(0, t.source);
assertEquals(0, t.dest);
assertEquals(0, t.min);
assertEquals(0, t.max);
MethodHandle upto = M3AtomKit.findGetter(M3Automaton.Transition.class, "transitionUpto", int.class);
assertEquals(-1, (int) upto.invokeExact(t), "uninitialized cursor position");
>>>

@atom M3Automaton.Builder.Builder 1 SCENARIO empty-builder
