// Copyright (c) 2026 Synexia, Hitesh Soliwal (hsoliwal@gmail.com) and others
// Atoms of M3RegexDpPlan.java (Boolean dot/star execution plan and its Effect relations).
// Oracles: java.util.regex.Pattern.matches over exhaustive texts (language), DotStarOracle BitSet NFA (state sets),
// RelationOracle (relation products).
#class M3RegexDpPlanAtomTest
#summary Per-atom contracts of jdk.internal.mindex.M3RegexDpPlan against java.util.regex and a BitSet NFA
#build DotStarOracle RelationOracle
#import jdk.internal.mindex.M3RegexDpPlan java.util.ArrayList java.util.BitSet java.util.List java.util.SplittableRandom java.util.concurrent.atomic.AtomicInteger
#helper <<<
    private static final Class<?> PLAN = M3RegexDpPlan.class;
    private static final Class<?> EFFECT = M3RegexDpPlan.Effect.class;
    /** Literal alphabet of generated programs and the probes used by the language checks. */
    private static final String LETTERS = "aB1";
    private static final List<String> UNITS = List.of("a", "B", "1", "x", "\n", " ");
    private static final List<String> UNITS_UTF16 = List.of("a", "B", DotStarOracle.SUPPLEMENTARY,
            String.valueOf(DotStarOracle.HIGH), String.valueOf(DotStarOracle.LOW), "\r");
    /** Atom budget of generated programs, number of programs and exhaustive text length. */
    private static final int GEN_ATOMS = 6;
    private static final int GEN_PATTERNS = 40;
    private static final int TEXT_LENGTH = 5;
    /** Checkpoint cadence of summarize: every 256 units plus once at the end. */
    private static final int CHECKPOINT_STRIDE = 256;
    /** Programs with 16 or more states take the wide (JNI-eligible) composition lane. */
    private static final String WIDE = "a*.*B*.*1*a*.*B*.*1*a*.*B*.*1*a*.*B*";
    private static final String ALL_STARS = "a*B*1*.*a*B*1*.*a*B*1*.*a*B*1*.*a*";
    /** Repeat counts: small, and at the native-eligibility threshold (count >= 256). */
    private static final long[] REPEATS = {0, 1, 2, 3, 5, 256, 300};
    /** Maximal run of starred atoms (63 atoms) exercising all six nullable doubling levels. */
    private static final String MAX_STAR_RUN = "a*".repeat(DotStarOracle.MAX_TOKENS);

    private static List<String> corpus() {
        List<String> out = new ArrayList<>(List.of("a*", "a.*", ".*", "a*B", "aB*1", ".*a.*", "a*a*a", "B*.1*",
                WIDE, ALL_STARS, MAX_STAR_RUN, "a" + ".*".repeat(DotStarOracle.MAX_TOKENS - 1)));
        SplittableRandom random = M3AtomKit.random("corpus");
        for (int i = 0; i < GEN_PATTERNS; i++) {
            out.add(DotStarOracle.randomPattern(random, GEN_ATOMS, LETTERS));
        }
        return out;
    }

    private static M3RegexDpPlan plan(String pattern) {
        M3RegexDpPlan plan = M3RegexDpPlan.prepare(pattern);
        assertNotNull(plan, "admitted " + pattern);
        return plan;
    }

    /** Runs the plan unit by unit with advance(); -1 marks unsupported input. */
    private static boolean runAdvance(M3RegexDpPlan plan, String text) {
        long frontier = plan.initialState();
        for (int i = 0; i < text.length(); i++) {
            frontier = plan.advance(frontier, text.charAt(i));
        }
        return plan.accepts(frontier);
    }

    /** Effect equality: same length and the same image of every singleton frontier. */
    private static void assertSameEffect(M3RegexDpPlan plan, M3RegexDpPlan.Effect expected, M3RegexDpPlan.Effect actual,
            String what) {
        assertEquals(expected.length(), actual.length(), what + " length");
        for (int q = 0; q < plan.stateCount(); q++) {
            assertEquals(expected.apply(1L << q), actual.apply(1L << q), what + " row " + q);
        }
    }

    private static long universe(M3RegexDpPlan plan) {
        return plan.stateCount() == Long.SIZE ? -1L : (1L << plan.stateCount()) - 1L;
    }

    private static MethodHandle virtual(String name, MethodType type) {
        return M3AtomKit.findVirtual(PLAN, name, type);
    }

    private static MethodHandle effectVirtual(String name, MethodType type) {
        return M3AtomKit.findVirtual(EFFECT, name, type);
    }

    /** Relation rows of an effect, observed through apply on singleton frontiers. */
    private static long[] rows(M3RegexDpPlan plan, M3RegexDpPlan.Effect effect) {
        long[] rows = new long[plan.stateCount()];
        for (int q = 0; q < rows.length; q++) rows[q] = effect.apply(1L << q);
        return rows;
    }
>>>

@atom M3RegexDpPlan.M3RegexDpPlan 1 SCENARIO DotStarOracle.initial+java.util.regex
setup <<<
MethodHandle ctor = M3AtomKit.findConstructor(PLAN, MethodType.methodType(void.class, long[].class, long.class,
        long.class, int.class));
long[] literals = new long[DotStarOracle.LITERALS.length()];
literals[DotStarOracle.LITERALS.indexOf('a')] = 1L << 1;
>>>
check <<<
M3RegexDpPlan direct = (M3RegexDpPlan) ctor.invoke(literals, 1L << 2, 1L << 1, 2);
M3RegexDpPlan parsed = plan("a*.");
assertEquals(parsed.stateCount(), direct.stateCount());
assertEquals(parsed.initialState(), direct.initialState(), "same program, same closure of the start state");
for (String text : DotStarOracle.texts(UNITS, TEXT_LENGTH)) {
    assertEquals(DotStarOracle.javaMatches("a*.", text), runAdvance(direct, text), text);
}
>>>

@atom M3RegexDpPlan.prepare 1 SCENARIO DotStarOracle.admitted+java.util.regex
setup <<<
List<String> refused = List.of("a", "", "*a", "a**", "ab", "a+", "a?", "[a]*", "a*é", "a*".repeat(64),
        "a*" + "b".repeat(DotStarOracle.MAX_PATTERN), "(a)*", "a*|b", "a\\*");
>>>
check <<<
for (String pattern : corpus()) {
    assertTrue(DotStarOracle.admitted(pattern), pattern);
    M3RegexDpPlan plan = plan(pattern);
    for (String text : DotStarOracle.texts(UNITS, TEXT_LENGTH)) {
        assertEquals(DotStarOracle.javaMatches(pattern, text), runAdvance(plan, text), pattern + " / " + text);
    }
}
for (String pattern : refused) {
    assertEquals(DotStarOracle.admitted(pattern), M3RegexDpPlan.prepare(pattern) != null, pattern);
    assertNull(M3RegexDpPlan.prepare(pattern), pattern);
}
M3AtomKit.expectMessage(NullPointerException.class, "pattern", () -> M3RegexDpPlan.prepare(null));
>>>

@atom M3RegexDpPlan.stateCount 1 SCENARIO DotStarOracle.parse
check <<<
for (String pattern : corpus()) {
    assertEquals(DotStarOracle.parse(pattern).tokens() + 1, plan(pattern).stateCount(), pattern);
}
assertEquals(Long.SIZE, plan(MAX_STAR_RUN).stateCount(), "63 atoms use all 64 state bits");
>>>

@atom M3RegexDpPlan.initialState 1 SCENARIO DotStarOracle.initial+java.util.regex(empty)
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    assertEquals(DotStarOracle.bits(DotStarOracle.initial(DotStarOracle.parse(pattern))), plan.initialState(), pattern);
    assertEquals(DotStarOracle.javaMatches(pattern, ""), plan.accepts(plan.initialState()), pattern);
}
>>>

@atom M3RegexDpPlan.accepts 1 SCENARIO accepting-bit+foreign-bits
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    int tokens = plan.stateCount() - 1;
    assertTrue(plan.accepts(1L << tokens), pattern);
    assertFalse(plan.accepts(universe(plan) & ~(1L << tokens)), pattern);
    assertFalse(plan.accepts(0L));
    if (plan.stateCount() < Long.SIZE) {
        long foreign = 1L << plan.stateCount();
        M3AtomKit.expectMessage(IllegalArgumentException.class, "foreign state bits", () -> plan.accepts(foreign));
    }
}
>>>

@atom M3RegexDpPlan.supports 1 SCENARIO Character.isSurrogate
setup <<<
M3RegexDpPlan plan = plan("a*");
>>>
check <<<
for (int c = Character.MIN_VALUE; c <= Character.MAX_VALUE; c++) {
    assertEquals(!Character.isSurrogate((char) c), plan.supports((char) c), "unit " + c);
}
>>>

@atom M3RegexDpPlan.advance 1 SCENARIO DotStarOracle.step
setup <<<
SplittableRandom random = M3AtomKit.random("advance");
char[] probes = {'a', 'B', '1', 'x', '\n', '\r', '\u0085', ' ', ' ', 'é', 'z'};
>>>
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    DotStarOracle.Program program = DotStarOracle.parse(pattern);
    for (int k = 0; k < M3AtomKit.CASES; k++) {
        BitSet states = DotStarOracle.closure(program, DotStarOracle.set(random.nextLong() & universe(plan)));
        char unit = probes[random.nextInt(probes.length)];
        assertEquals(DotStarOracle.bits(DotStarOracle.step(program, states, unit)),
                plan.advance(DotStarOracle.bits(states), unit), pattern + " unit " + (int) unit);
    }
    M3AtomKit.expectMessage(IllegalArgumentException.class, "surrogate",
            () -> plan.advance(plan.initialState(), DotStarOracle.HIGH));
}
>>>

@atom M3RegexDpPlan.matchingMask 1 SCENARIO java.util.regex(single-atom)
setup <<<
MethodHandle atom = virtual("matchingMask", MethodType.methodType(long.class, char.class));
char[] probes = {'a', 'B', '1', 'x', '\n', '\r', '\u0085', ' ', ' ', 'é', '.'};
>>>
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    DotStarOracle.Program program = DotStarOracle.parse(pattern);
    for (char unit : probes) {
        long expected = 0L;
        for (int j = 1; j <= program.tokens(); j++) {
            String atomRegex = program.atoms()[j] == '.' ? "." : String.valueOf(program.atoms()[j]);
            if (java.util.regex.Pattern.matches(atomRegex, String.valueOf(unit))) expected |= 1L << j;
        }
        assertEquals(expected, (long) atom.invokeExact(plan, unit), pattern + " unit " + (int) unit);
    }
}
>>>

@atom M3RegexDpPlan.advanceMatched 1 SCENARIO DotStarOracle.step
setup <<<
MethodHandle atom = virtual("advanceMatched", MethodType.methodType(long.class, long.class, long.class));
MethodHandle mask = virtual("matchingMask", MethodType.methodType(long.class, char.class));
SplittableRandom random = M3AtomKit.random("advanceMatched");
>>>
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    DotStarOracle.Program program = DotStarOracle.parse(pattern);
    for (int k = 0; k < M3AtomKit.CASES; k++) {
        BitSet states = DotStarOracle.closure(program, DotStarOracle.set(random.nextLong() & universe(plan)));
        char unit = UNITS.get(random.nextInt(UNITS.size())).charAt(0);
        long matched = (long) mask.invokeExact(plan, unit);
        assertEquals(DotStarOracle.bits(DotStarOracle.step(program, states, unit)),
                (long) atom.invokeExact(plan, DotStarOracle.bits(states), matched), pattern);
    }
}
>>>

@atom M3RegexDpPlan.literalIndex 1 SCENARIO String.indexOf(62-literal-alphabet)
setup <<<
MethodHandle atom = M3AtomKit.findStatic(PLAN, "literalIndex", MethodType.methodType(int.class, char.class));
>>>
check <<<
for (int c = Character.MIN_VALUE; c <= Character.MAX_VALUE; c++) {
    assertEquals(DotStarOracle.LITERALS.indexOf((char) c), (int) atom.invokeExact((char) c), "unit " + c);
}
>>>

@atom M3RegexDpPlan.nullableLevels 1 SCENARIO longest-star-run-bit-length
setup <<<
MethodHandle atom = M3AtomKit.findStatic(PLAN, "nullableLevels", MethodType.methodType(int.class, long.class));
SplittableRandom random = M3AtomKit.random("nullableLevels");
final int maxLevels = 6;
>>>
check <<<
for (int k = 0; k < M3AtomKit.OPERATIONS; k++) {
    long stars = random.nextLong() & random.nextLong() | (k % Long.SIZE == 0 ? -1L >>> (k % maxLevels) : 0L);
    int run = 0;
    int best = 0;
    for (int bit = 0; bit < Long.SIZE; bit++) {
        run = (stars & (1L << bit)) != 0 ? run + 1 : 0;
        best = Math.max(best, run);
    }
    int expected = best == 0 ? 0 : Math.min(maxLevels, Integer.SIZE - Integer.numberOfLeadingZeros(best));
    assertEquals(expected, (int) atom.invokeExact(stars), Long.toBinaryString(stars));
}
>>>

@atom M3RegexDpPlan.close 1 SCENARIO DotStarOracle.closure
setup <<<
MethodHandle atom = virtual("close", MethodType.methodType(long.class, long.class));
SplittableRandom random = M3AtomKit.random("close");
>>>
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    DotStarOracle.Program program = DotStarOracle.parse(pattern);
    for (int k = 0; k < M3AtomKit.CASES; k++) {
        long frontier = random.nextLong() & universe(plan) & (k % 2 == 0 ? 1L : -1L);
        assertEquals(DotStarOracle.bits(DotStarOracle.closure(program, DotStarOracle.set(frontier))),
                (long) atom.invokeExact(plan, frontier), pattern);
    }
}
>>>

@atom M3RegexDpPlan.lineTerminator 1 SCENARIO java.util.regex(dot-excludes)
setup <<<
MethodHandle atom = M3AtomKit.findStatic(PLAN, "lineTerminator", MethodType.methodType(boolean.class, char.class));
java.util.regex.Pattern dot = java.util.regex.Pattern.compile(".");
>>>
check <<<
for (int c = Character.MIN_VALUE; c <= Character.MAX_VALUE; c++) {
    if (Character.isSurrogate((char) c)) continue;
    assertEquals(!dot.matcher(String.valueOf((char) c)).matches(), (boolean) atom.invokeExact((char) c), "unit " + c);
}
>>>

@atom M3RegexDpPlan.summarize 1 SCENARIO java.util.regex+checkpoint-cadence
setup <<<
AtomicInteger calls = new AtomicInteger();
>>>
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    for (String text : DotStarOracle.texts(UNITS, TEXT_LENGTH - 1)) {
        M3RegexDpPlan.Effect effect = plan.summarize(text, null);
        assertEquals(DotStarOracle.javaMatches(pattern, text), plan.accepts(effect.apply(plan.initialState())), text);
        assertEquals(text.length(), effect.length());
    }
    String longText = "aB1x".repeat(CHECKPOINT_STRIDE);
    calls.set(0);
    M3RegexDpPlan.Effect effect = plan.summarize(longText, calls::incrementAndGet);
    assertEquals((longText.length() + CHECKPOINT_STRIDE - 1) / CHECKPOINT_STRIDE + 1, calls.get(), "cadence");
    assertEquals(DotStarOracle.javaMatches(pattern, longText), plan.accepts(effect.apply(plan.initialState())));
    assertNull(plan.summarize("a" + DotStarOracle.SUPPLEMENTARY, null), "surrogates are not admitted");
}
M3AtomKit.expectMessage(NullPointerException.class, "text", () -> plan("a*").summarize(null, null));
>>>

@atom M3RegexDpPlan.summarizeUtf16 1 SCENARIO java.util.regex(code-points)+split-pair
setup <<<
AtomicInteger calls = new AtomicInteger();
>>>
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    for (String text : DotStarOracle.texts(UNITS_UTF16, TEXT_LENGTH - 1)) {
        M3RegexDpPlan.Effect effect = plan.summarizeUtf16(text, null);
        assertEquals(DotStarOracle.javaMatches(pattern, text), plan.accepts(effect.apply(plan.initialState())),
                pattern + " / " + text);
        for (int cut = 1; cut < text.length(); cut++) {
            M3RegexDpPlan.Effect joined = plan.summarizeUtf16(text.substring(0, cut), null)
                    .then(plan.summarizeUtf16(text.substring(cut), null), null);
            assertEquals(effect.apply(plan.initialState()), joined.apply(plan.initialState()), "split at " + cut);
        }
    }
    String longText = (DotStarOracle.SUPPLEMENTARY + "a").repeat(CHECKPOINT_STRIDE);
    calls.set(0);
    M3RegexDpPlan.Effect effect = plan.summarizeUtf16(longText, calls::incrementAndGet);
    assertEquals((longText.length() + CHECKPOINT_STRIDE - 1) / CHECKPOINT_STRIDE + 1, calls.get(), "same cadence");
    assertEquals(DotStarOracle.javaMatches(pattern, longText), plan.accepts(effect.apply(plan.initialState())));
}
>>>

@atom M3RegexDpPlan.advanceUtf16Rows 1 SCENARIO documented-lane-bits+advanceRows
setup <<<
MethodHandle atom = virtual("advanceUtf16Rows", MethodType.methodType(int.class, long[].class, long[].class,
        long.class, long.class, int.class, boolean.class));
MethodHandle advanceRows = virtual("advanceRows", MethodType.methodType(void.class, long[].class, long.class));
MethodHandle identityRows = virtual("identityRows", MethodType.methodType(long[].class));
final int primaryZero = 4, skippedZero = 8, previous = 16;
M3RegexDpPlan plan = plan(WIDE);
long matched = 1L << 1;
>>>
check <<<
long[] rows = (long[]) identityRows.invokeExact(plan);
long[] skipped = (long[]) identityRows.invokeExact(plan);
long[] expectedRows = rows.clone();
long[] expectedSkipped = skipped.clone();
advanceRows.invokeExact(plan, expectedRows, matched);
advanceRows.invokeExact(plan, expectedSkipped, matched);
assertEquals(0, (int) atom.invokeExact(plan, rows, skipped, matched, 0L, 0, false), "no fixed-point search");
assertArrayEquals(expectedRows, rows);
assertArrayEquals(expectedSkipped, skipped);
int zero = (int) atom.invokeExact(plan, rows, skipped, 0L, matched, previous, true);
assertEquals(primaryZero | skippedZero | previous | 1 | 2, zero, "zero predicate absorbs both lanes");
assertArrayEquals(new long[plan.stateCount()], rows);
assertArrayEquals(new long[plan.stateCount()], skipped);
int primaryOnly = (int) atom.invokeExact(plan, rows, (long[]) null, 0L, matched, 0, true);
assertEquals(primaryZero | previous | 1, primaryOnly, "zero predicate without a skipped lane");
>>>

@atom M3RegexDpPlan.advanceRowsToFixedPoint 1 SCENARIO DotStarOracle.step(fixed-point)
setup <<<
MethodHandle atom = virtual("advanceRowsToFixedPoint", MethodType.methodType(boolean.class, long[].class, long.class));
MethodHandle identityRows = virtual("identityRows", MethodType.methodType(long[].class));
MethodHandle mask = virtual("matchingMask", MethodType.methodType(long.class, char.class));
>>>
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    long matched = (long) mask.invokeExact(plan, 'a');
    long[] rows = (long[]) identityRows.invokeExact(plan);
    boolean fixed = false;
    for (int step = 0; step <= plan.stateCount() + 1 && !fixed; step++) {
        long[] before = rows.clone();
        fixed = (boolean) atom.invokeExact(plan, rows, matched);
        assertEquals(java.util.Arrays.equals(before, rows), fixed, pattern + " step " + step);
    }
    assertTrue(fixed, "a constant predicate reaches a fixed point within the state count: " + pattern);
}
>>>

@atom M3RegexDpPlan.advanceRows 1 SCENARIO DotStarOracle.step(per-row)
setup <<<
MethodHandle atom = virtual("advanceRows", MethodType.methodType(void.class, long[].class, long.class));
MethodHandle mask = virtual("matchingMask", MethodType.methodType(long.class, char.class));
>>>
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    DotStarOracle.Program program = DotStarOracle.parse(pattern);
    long[] rows = new long[plan.stateCount()];
    for (int q = 0; q < rows.length; q++) rows[q] = DotStarOracle.bits(DotStarOracle.closure(program, DotStarOracle.set(1L << q)));
    long[] expected = new long[rows.length];
    for (int q = 0; q < rows.length; q++) expected[q] = DotStarOracle.bits(DotStarOracle.step(program, DotStarOracle.set(rows[q]), 'B'));
    atom.invokeExact(plan, rows, (long) mask.invokeExact(plan, 'B'));
    assertArrayEquals(expected, rows, pattern);
}
>>>

@atom M3RegexDpPlan.identity 1 SCENARIO relation-identity
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    M3RegexDpPlan.Effect identity = plan.identity();
    assertEquals(0L, identity.length());
    for (int q = 0; q < plan.stateCount(); q++) assertEquals(1L << q, identity.apply(1L << q), "exact, not closed");
    M3RegexDpPlan.Effect text = plan.summarize("aB", null);
    assertSameEffect(plan, text, identity.then(text, null), "left identity");
    assertSameEffect(plan, text, text.then(identity, null), "right identity");
}
>>>

@atom M3RegexDpPlan.identityRows 1 SCENARIO RelationOracle.identity
setup <<<
MethodHandle atom = virtual("identityRows", MethodType.methodType(long[].class));
>>>
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    long[] first = (long[]) atom.invokeExact(plan);
    assertArrayEquals(RelationOracle.identity(plan.stateCount()), first, pattern);
    assertNotSame(first, (long[]) atom.invokeExact(plan), "fresh rows per call");
}
>>>

@atom M3RegexDpPlan.Effect.Effect 1 SCENARIO private-constructor(rows,length)
setup <<<
MethodHandle ctor = M3AtomKit.findConstructor(EFFECT, "Effect", MethodType.methodType(void.class, PLAN, long[].class, long.class));
M3RegexDpPlan plan = plan("a*B");
>>>
check <<<
long[] rows = rows(plan, plan.summarize("aaB", null));
M3RegexDpPlan.Effect effect = (M3RegexDpPlan.Effect) ctor.invoke(plan, rows, 3L);
assertEquals(3L, effect.length());
assertSameEffect(plan, plan.summarize("aaB", null), effect, "constructed from observed rows");
>>>

@atom M3RegexDpPlan.Effect.Effect 2 SCENARIO private-constructor(rows,length,withoutLeadingLow,trailingHigh)
setup <<<
MethodHandle ctor = M3AtomKit.findConstructor(EFFECT, "Effect", MethodType.methodType(void.class, PLAN, long[].class,
        long.class, long[].class, boolean.class));
M3RegexDpPlan plan = plan("a.*");
>>>
check <<<
long[] identity = RelationOracle.identity(plan.stateCount());
M3RegexDpPlan.Effect pendingHigh = (M3RegexDpPlan.Effect) ctor.invoke(plan, identity, 1L, (long[]) null, true);
M3RegexDpPlan.Effect reference = plan.summarizeUtf16(String.valueOf(DotStarOracle.HIGH), null);
assertSameEffect(plan, reference, pendingHigh, "lone high surrogate flushes as a dot on apply");
M3RegexDpPlan.Effect plain = (M3RegexDpPlan.Effect) ctor.invoke(plan, identity, 0L, (long[]) null, false);
assertSameEffect(plan, plan.identity(), plain, "no boundary metadata");
>>>

@atom M3RegexDpPlan.Effect.length 1 SCENARIO Math.addExact/multiplyExact
setup <<<
M3RegexDpPlan plan = plan("a*");
M3RegexDpPlan.Effect three = plan.summarize("aaa", null);
>>>
check <<<
assertEquals(3L, three.length());
assertEquals(6L, three.then(three, null).length());
assertEquals(3L * REPEATS[REPEATS.length - 1], three.repeated(REPEATS[REPEATS.length - 1], null).length());
assertEquals(0L, three.repeated(0, null).length());
M3AtomKit.expect(ArithmeticException.class, () -> three.repeated(Long.MAX_VALUE, null));
>>>

@atom M3RegexDpPlan.Effect.apply 1 SCENARIO DotStarOracle.run
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    DotStarOracle.Program program = DotStarOracle.parse(pattern);
    for (String text : List.of("", "a", "aB1", "x\na", "B" + DotStarOracle.SUPPLEMENTARY)) {
        M3RegexDpPlan.Effect effect = plan.summarizeUtf16(text, null);
        for (int q = 0; q < plan.stateCount(); q++) {
            assertEquals(DotStarOracle.bits(DotStarOracle.run(program, DotStarOracle.set(1L << q), text)),
                    effect.apply(1L << q), pattern + " / " + text + " from " + q);
        }
    }
    if (plan.stateCount() < Long.SIZE) {
        long foreign = 1L << plan.stateCount();
        M3AtomKit.expectMessage(IllegalArgumentException.class, "foreign state bits", () -> plan.identity().apply(foreign));
    }
}
>>>

@atom M3RegexDpPlan.Effect.then 1 SCENARIO concatenation-homomorphism
setup <<<
SplittableRandom random = M3AtomKit.random("then");
AtomicInteger calls = new AtomicInteger();
>>>
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    for (int k = 0; k < M3AtomKit.CASES / 4; k++) {
        String a = DotStarOracle.texts(UNITS, 2).get(random.nextInt(43));
        String b = DotStarOracle.texts(UNITS, 2).get(random.nextInt(43));
        String c = DotStarOracle.texts(UNITS, 2).get(random.nextInt(43));
        M3RegexDpPlan.Effect ea = plan.summarize(a, null), eb = plan.summarize(b, null), ec = plan.summarize(c, null);
        assertSameEffect(plan, plan.summarize(a + b, null), ea.then(eb, null), "homomorphism " + a + "|" + b);
        assertSameEffect(plan, ea.then(eb, null).then(ec, null), ea.then(eb.then(ec, null), null), "associative");
    }
    calls.set(0);
    plan.identity().then(plan.identity(), calls::incrementAndGet);
    assertEquals(2, calls.get(), "checkpoint before and after composition");
    M3AtomKit.expectMessage(IllegalArgumentException.class, "different regex plan",
            () -> plan.identity().then(plan("a*").identity(), null));
    M3AtomKit.expectMessage(NullPointerException.class, "right", () -> plan.identity().then(null, null));
}
>>>

@atom M3RegexDpPlan.Effect.appendOpen 1 SCENARIO RelationOracle.compose(+dot-flush)
setup <<<
MethodHandle atom = effectVirtual("appendOpen", MethodType.methodType(long[].class, long[].class, long[].class, boolean.class));
MethodHandle advanceRows = virtual("advanceRows", MethodType.methodType(void.class, long[].class, long.class));
MethodHandle mask = virtual("matchingMask", MethodType.methodType(long.class, char.class));
>>>
check <<<
for (String pattern : List.of("a*", WIDE, ALL_STARS, "a.*B")) {
    M3RegexDpPlan plan = plan(pattern);
    M3RegexDpPlan.Effect any = plan.identity();
    long[] prefix = rows(plan, plan.summarize("aB", null));
    long[] suffix = rows(plan, plan.summarize("1a", null));
    assertArrayEquals(RelationOracle.compose(prefix, suffix), (long[]) atom.invokeExact(any, prefix, suffix, false), pattern);
    long[] flushed = prefix.clone();
    advanceRows.invokeExact(plan, flushed, (long) mask.invokeExact(plan, 'x'));
    assertArrayEquals(RelationOracle.compose(flushed, suffix), (long[]) atom.invokeExact(any, prefix, suffix, true),
            pattern + " pending high is a dot before the suffix");
}
>>>

@atom M3RegexDpPlan.Effect.repeatedUtf16 1 SCENARIO java.util.regex(repeated-boundary-text)
setup <<<
MethodHandle atom = effectVirtual("repeatedUtf16", MethodType.methodType(EFFECT, long.class, long.class, Runnable.class));
>>>
check <<<
for (String pattern : List.of("a*", ".*", "a.*B", WIDE)) {
    M3RegexDpPlan plan = plan(pattern);
    for (String unit : List.of(DotStarOracle.LOW + "a" + DotStarOracle.HIGH, "B" + DotStarOracle.HIGH, DotStarOracle.LOW + "1")) {
        M3RegexDpPlan.Effect effect = plan.summarizeUtf16(unit, null);
        for (long count : new long[] {0, 1, 2, 3, 7}) {
            M3RegexDpPlan.Effect direct = (M3RegexDpPlan.Effect) atom.invoke(effect, count, count * unit.length(), (Runnable) null);
            M3RegexDpPlan.Effect expected = plan.summarizeUtf16(unit.repeat((int) count), null);
            assertSameEffect(plan, expected, direct, pattern + " " + count + "x");
            assertSameEffect(plan, expected, effect.repeated(count, null), "public entry " + count + "x");
        }
    }
}
>>>

@atom M3RegexDpPlan.Effect.repeated 1 SCENARIO java.util.regex(repeated-text)+RelationOracle.power
setup <<<
AtomicInteger calls = new AtomicInteger();
>>>
check <<<
for (String pattern : List.of("a*", "a*B", ".*1*", WIDE, ALL_STARS)) {
    M3RegexDpPlan plan = plan(pattern);
    for (String unit : List.of("a", "aB", "1x", "B\n")) {
        M3RegexDpPlan.Effect effect = plan.summarize(unit, null);
        for (long count : REPEATS) {
            M3RegexDpPlan.Effect expected = plan.summarize(unit.repeat((int) count), null);
            assertSameEffect(plan, expected, effect.repeated(count, null), pattern + " " + unit + " x" + count);
            calls.set(0);
            assertSameEffect(plan, expected, effect.repeated(count, calls::incrementAndGet), "checkpointed");
            assertTrue(calls.get() >= 2, "checkpoint before and after");
        }
        assertArrayEquals(RelationOracle.power(rows(plan, effect), REPEATS[REPEATS.length - 2]),
                rows(plan, effect.repeated(REPEATS[REPEATS.length - 2], null)), "relation power");
    }
    M3AtomKit.expectMessage(IllegalArgumentException.class, "negative repeat count", () -> plan.identity().repeated(-1, null));
}
>>>

@atom M3RegexDpPlan.compose 1 SCENARIO RelationOracle.compose
setup <<<
MethodHandle atom = virtual("compose", MethodType.methodType(long[].class, long[].class, long[].class));
>>>
check <<<
for (String pattern : List.of("a*", WIDE, ALL_STARS, MAX_STAR_RUN)) {
    M3RegexDpPlan plan = plan(pattern);
    long[] left = rows(plan, plan.summarize("aB1", null));
    long[] right = rows(plan, plan.summarize("Ba", null));
    assertArrayEquals(RelationOracle.compose(left, right), (long[]) atom.invokeExact(plan, left, right), pattern);
    long[] single = RelationOracle.identity(plan.stateCount());
    assertArrayEquals(right, (long[]) atom.invokeExact(plan, single, right), "singleton rows select directly");
}
>>>

@atom M3RegexDpPlan.needsRowUnion 1 SCENARIO Long.bitCount>1
setup <<<
MethodHandle atom = M3AtomKit.findStatic(PLAN, "needsRowUnion", MethodType.methodType(boolean.class, long[].class));
SplittableRandom random = M3AtomKit.random("needsRowUnion");
>>>
check <<<
for (int k = 0; k < M3AtomKit.OPERATIONS; k++) {
    long[] rows = new long[random.nextInt(1, Long.SIZE)];
    for (int q = 0; q < rows.length; q++) rows[q] = k % 2 == 0 ? 1L << random.nextInt(Long.SIZE) : random.nextLong();
    if (k % 3 == 0) rows[0] = 0L;
    boolean expected = false;
    for (long row : rows) expected |= Long.bitCount(row) > 1;
    assertEquals(expected, (boolean) atom.invokeExact(rows));
}
>>>

@atom M3RegexDpPlan.composeJava 1 SCENARIO RelationOracle.compose
setup <<<
MethodHandle atom = M3AtomKit.findStatic(PLAN, "composeJava", MethodType.methodType(void.class, long[].class,
        long[].class, long[].class));
SplittableRandom random = M3AtomKit.random("composeJava");
final double density = 0.3;
>>>
check <<<
for (int k = 0; k < M3AtomKit.CASES; k++) {
    int states = random.nextInt(1, Long.SIZE + 1);
    long[] left = RelationOracle.randomRelation(random, states, density);
    long[] right = RelationOracle.randomRelation(random, states, density);
    long[] result = new long[states];
    atom.invokeExact(left, right, result);
    assertArrayEquals(RelationOracle.compose(left, right), result);
}
>>>

