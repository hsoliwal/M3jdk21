@atom M3RegexDpPlan.checkBits 1 SCENARIO universe-mask
setup <<<
MethodHandle atom = virtual("checkBits", MethodType.methodType(void.class, long.class));
>>>
check <<<
for (String pattern : corpus()) {
    M3RegexDpPlan plan = plan(pattern);
    atom.invokeExact(plan, universe(plan));
    atom.invokeExact(plan, 0L);
    if (plan.stateCount() < Long.SIZE) {
        long foreign = universe(plan) + 1;
        M3AtomKit.expectMessage(IllegalArgumentException.class, "foreign state bits", () -> { atom.invokeExact(plan, foreign); });
    }
}
>>>

