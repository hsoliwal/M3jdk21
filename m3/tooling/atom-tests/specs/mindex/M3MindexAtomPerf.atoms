// Copyright (c) 2026 Synexia, Hitesh Soliwal (hsoliwal@gmail.com) and others
// JIT/perf harness of the hot jdk.internal.mindex atoms (lookup, index, relation and DP steps).
// Every batch calls the atom through a constant MethodHandle with invokeExact and checks its checksum against
// an oracle computed before timing (java.util.regex, BitSet NFA, RelationOracle, AutomatonOracle, fmix32).
#class M3MindexAtomPerf
#template PERF_CLASS
#entry M3AtomPerf.named
#returns M3AtomPerf.Batch
#summary Per-atom MethodHandle invokeExact perf harness of the jdk.internal.mindex lookup/index hot paths
#build AutomatonOracle DotStarOracle RelationOracle TokenRegexOracle
#runopts -XX:+UnlockDiagnosticVMOptions -XX:+PrintCompilation
#import jdk.internal.mindex.M3Automaton jdk.internal.mindex.M3AutomatonOps jdk.internal.mindex.M3RegexDpPlan jdk.internal.mindex.M3TokenMatcher java.util.BitSet java.util.SplittableRandom java.util.regex.Matcher
#helper <<<
    /** Calls per batch of the scalar atoms and of the composite atoms. */
    private static final int OPS = 4_096;
    private static final int COMPOSITE_OPS = 256;
    /** Relation dimension and transfer dimension of the composite cases. */
    private static final int STATES = Long.SIZE;
    private static final int TRANSFER_STATES = 256;
    private static final int TOKENS = 64;
    private static final double DENSITY = 0.2;
    private static final double DEAD_RATE = 0.1;
    /** Labels of the DFA lookup case and letters of the token tape. */
    private static final int LABELS = 8;
    private static final int TAPE = 64;
    /** fmix32 constants (Lucene hppc BitMixer.mix32), the reference of M3AutomatonOps.mix. */
    private static final int PHI = 0x9E3779B9, C1 = 0x85EBCA6B, C2 = 0xC2B2AE35, SHIFT_A = 16, SHIFT_B = 13;
    /** Program of the DP-step cases: 16 or more states with a star run. */
    private static final String PROGRAM = "a*.*B*.*1*a*.*B*.*1*a*.*B*.*1*a*.*B*";

    private static final Class<?> BITS = M3AtomKit.type("M3Bits");
    private static final Class<?> RELATION = M3AtomKit.type("M3StateRelation");
    private static final Class<?> TRANSITIONS = M3AtomKit.type("M3RX7Transitions");
    private static final Class<?> ENGINE = M3AtomKit.type("M3TokenEngine");
    private static final Class<?> RESULT = M3AtomKit.type("M3TokenEngine$Result");
    private static final MethodHandle WORD_INDEX = M3AtomKit.findStatic(BITS, "wordIndex", MethodType.methodType(int.class, int.class));
    private static final MethodHandle BIT_MASK = M3AtomKit.findStatic(BITS, "bitMask", MethodType.methodType(long.class, int.class));
    private static final MethodHandle WORDS_FOR_BITS = M3AtomKit.findStatic(BITS, "wordsForBits", MethodType.methodType(int.class, int.class));
    private static final MethodHandle STEP = M3AtomKit.findVirtual(M3Automaton.class, "step",
            MethodType.methodType(int.class, int.class, int.class));
    private static final MethodHandle MIX = M3AtomKit.findStatic(M3AutomatonOps.class, "mix", MethodType.methodType(long.class, int.class));
    private static final MethodHandle ADVANCE = M3AtomKit.findVirtual(M3RegexDpPlan.class, "advance",
            MethodType.methodType(long.class, long.class, char.class));
    private static final MethodHandle APPLY = M3AtomKit.findVirtual(M3RegexDpPlan.Effect.class, "apply",
            MethodType.methodType(long.class, long.class));
    private static final MethodHandle COMPOSE = M3AtomKit.findStatic(RELATION, "compose", MethodType.methodType(void.class,
            long[].class, int.class, long[].class, int.class, long[].class, int.class, int.class));
    private static final MethodHandle APPLY_ROWS = M3AtomKit.findStatic(RELATION, "applyRows",
            MethodType.methodType(long.class, long[].class, int.class, long.class));
    private static final MethodHandle TRANSFER = M3AtomKit.findStatic(TRANSITIONS, "compose",
            MethodType.methodType(short[].class, short[].class, short[].class));
    private static final MethodHandle TOKEN_RANGE = M3AtomKit.findStatic(TRANSITIONS, "tokens", MethodType.methodType(
            short[].class, short[].class, int.class, int.class, int[].class, int.class, int.class));
    private static final MethodHandle FIND = M3AtomKit.findVirtual(ENGINE, "find", MethodType.methodType(RESULT, int.class))
            .asType(MethodType.methodType(Object.class, Object.class, int.class));
    private static final MethodHandle RESET = M3AtomKit.findVirtual(ENGINE, "reset", MethodType.methodType(void.class))
            .asType(MethodType.methodType(void.class, Object.class));
    private static final MethodHandle REGISTERS = M3AtomKit.findVirtual(RESULT, "registers", MethodType.methodType(int[].class))
            .asType(MethodType.methodType(int[].class, Object.class));
    private static final MethodHandle NEW_ENGINE = M3AtomKit.findConstructor(ENGINE, MethodType.methodType(void.class,
            jdk.internal.mindex.M3TokenPredicateCache.class, boolean.class))
            .asType(MethodType.methodType(Object.class, jdk.internal.mindex.M3TokenPredicateCache.class, boolean.class));

    private static int[] ints(String atom, int bound) {
        return M3AtomKit.random(atom).ints(OPS, 0, bound).toArray();
    }

    private static long fmix(int key) {
        int h = key * PHI;
        h ^= h >>> SHIFT_A;
        h *= C1;
        h ^= h >>> SHIFT_B;
        h *= C2;
        h ^= h >>> SHIFT_A;
        return h;
    }

    /** One relation product per call; the row picked by the call index feeds the checksum. */
    private static long composeRow(long[] left, long[] right, long[] out, int i) throws Throwable {
        COMPOSE.invokeExact(left, 0, right, 0, out, 0, STATES);
        return out[i % STATES];
    }

    /** One FIND_NEXT scan of the whole tape from a reset engine; checksum of every (start, end). */
    private static long scan(Object engine) throws Throwable {
        RESET.invokeExact(engine);
        long sum = 0;
        for (Object r = (Object) FIND.invokeExact(engine, M3TokenMatcher.FIND_NEXT); r != null;
                r = (Object) FIND.invokeExact(engine, M3TokenMatcher.FIND_NEXT)) {
            int[] registers = (int[]) REGISTERS.invokeExact(r);
            sum += registers[0] * (long) TAPE + registers[1];
        }
        return sum;
    }

    private static M3Automaton dfa() {
        M3Automaton any = M3AutomatonOps.makeUnitRange('a', 'a' + LABELS - 1);
        M3Automaton nfa = M3AutomatonOps.concatenate(M3AutomatonOps.repeat(any), M3AutomatonOps.makeUnits("abc"),
                M3AutomatonOps.repeat(M3AutomatonOps.makeUnitRange('d', 'f'), 1, 3));
        return M3AutomatonOps.minimize(nfa, M3AutomatonOps.DEFAULT_WORK_LIMIT);
    }
>>>

@atom M3Bits.wordIndex 1 PERF Math.floorDiv
setup <<<
int[] in = ints("wordIndex", Integer.MAX_VALUE);
long reference = 0;
for (int x : in) reference += Math.floorDiv(x, Long.SIZE);
>>>
expected = reference
ops = OPS
call = (int) WORD_INDEX.invokeExact(in[i])

@atom M3Bits.bitMask 1 PERF Long.rotateLeft
setup <<<
int[] in = ints("bitMask", Integer.MAX_VALUE);
long reference = 0;
for (int x : in) reference += Long.rotateLeft(1L, Math.floorMod(x, Long.SIZE));
>>>
expected = reference
ops = OPS
call = (long) BIT_MASK.invokeExact(in[i])

@atom M3Bits.wordsForBits 1 PERF Math.ceilDiv
setup <<<
int[] in = ints("wordsForBits", Integer.MAX_VALUE);
long reference = 0;
for (int x : in) reference += Math.ceilDiv((long) x, Long.SIZE);
>>>
expected = reference
ops = OPS
call = (int) WORDS_FOR_BITS.invokeExact(in[i])

@atom M3Automaton.step 1 PERF AutomatonOracle.transitions(linear-scan)
setup <<<
M3Automaton dfa = dfa();
int[] states = ints("step.states", dfa.getNumStates());
int[] labels = ints("step.labels", LABELS + 2);
for (int k = 0; k < OPS; k++) labels[k] += 'a' - 1;
long reference = 0;
for (int k = 0; k < OPS; k++) {
    int dest = -1;
    for (int[] t : AutomatonOracle.transitions(dfa, states[k])) if (t[1] <= labels[k] && labels[k] <= t[2]) dest = t[0];
    reference += dest;
}
>>>
expected = reference
ops = OPS
call = (int) STEP.invokeExact(dfa, states[i], labels[i])

@atom M3AutomatonOps.mix 1 PERF fmix32
setup <<<
int[] in = M3AtomKit.random("mix").ints(OPS).toArray();
long reference = 0;
for (int x : in) reference += fmix(x);
>>>
expected = reference
ops = OPS
call = (long) MIX.invokeExact(in[i])

@atom M3RegexDpPlan.advance 1 PERF DotStarOracle.step
setup <<<
M3RegexDpPlan plan = M3RegexDpPlan.prepare(PROGRAM);
DotStarOracle.Program program = DotStarOracle.parse(PROGRAM);
SplittableRandom random = M3AtomKit.random("advance");
long universe = plan.stateCount() == Long.SIZE ? -1L : (1L << plan.stateCount()) - 1;
long[] frontiers = new long[OPS];
char[] units = new char[OPS];
String alphabet = "aB1x\n";
long reference = 0;
for (int k = 0; k < OPS; k++) {
    frontiers[k] = DotStarOracle.bits(DotStarOracle.closure(program, DotStarOracle.set(random.nextLong() & universe)));
    units[k] = alphabet.charAt(random.nextInt(alphabet.length()));
    reference += DotStarOracle.bits(DotStarOracle.step(program, DotStarOracle.set(frontiers[k]), units[k]));
}
>>>
expected = reference
ops = OPS
call = (long) ADVANCE.invokeExact(plan, frontiers[i], units[i])

@atom M3RegexDpPlan.Effect.apply 1 PERF DotStarOracle.run
setup <<<
M3RegexDpPlan plan = M3RegexDpPlan.prepare(PROGRAM);
DotStarOracle.Program program = DotStarOracle.parse(PROGRAM);
String text = "aB1xaB1xaB1x";
M3RegexDpPlan.Effect effect = plan.summarize(text, null);
SplittableRandom random = M3AtomKit.random("Effect.apply");
long universe = plan.stateCount() == Long.SIZE ? -1L : (1L << plan.stateCount()) - 1;
long[] frontiers = new long[OPS];
long reference = 0;
for (int k = 0; k < OPS; k++) {
    frontiers[k] = random.nextLong() & universe;
    reference += DotStarOracle.bits(DotStarOracle.run(program, DotStarOracle.set(frontiers[k]), text));
}
>>>
expected = reference
ops = OPS
call = (long) APPLY.invokeExact(effect, frontiers[i])

@atom M3StateRelation.compose 1 PERF RelationOracle.compose
setup <<<
SplittableRandom random = M3AtomKit.random("compose");
long[] left = RelationOracle.randomRelation(random, STATES, DENSITY);
long[] right = RelationOracle.randomRelation(random, STATES, DENSITY);
long[] out = new long[STATES];
long[] product = RelationOracle.compose(left, right);
long reference = 0;
for (int k = 0; k < COMPOSITE_OPS; k++) reference += product[k % STATES];
>>>
expected = reference
ops = COMPOSITE_OPS
call = composeRow(left, right, out, i)

@atom M3StateRelation.applyRows 1 PERF RelationOracle.compose(row)
setup <<<
SplittableRandom random = M3AtomKit.random("applyRows");
long[] rows = RelationOracle.randomRelation(random, STATES, DENSITY);
long[] active = random.longs(OPS).toArray();
long reference = 0;
for (long a : active) reference += RelationOracle.compose(new long[] {a}, rows)[0];
>>>
expected = reference
ops = OPS
call = (long) APPLY_ROWS.invokeExact(rows, 0, active[i])

@atom M3RX7Transitions.compose 1 PERF RelationOracle.composeTransfer
setup <<<
SplittableRandom random = M3AtomKit.random("transfer");
short[] left = RelationOracle.randomTransfer(random, TRANSFER_STATES, DEAD_RATE);
short[] right = RelationOracle.randomTransfer(random, TRANSFER_STATES, DEAD_RATE);
short[] product = RelationOracle.composeTransfer(left, right);
long reference = 0;
for (int k = 0; k < COMPOSITE_OPS; k++) reference += product[k % TRANSFER_STATES];
>>>
expected = reference
ops = COMPOSITE_OPS
call = ((short[]) TRANSFER.invokeExact(left, right))[i % TRANSFER_STATES]

@atom M3RX7Transitions.tokens 1 PERF RelationOracle.tokens
setup <<<
SplittableRandom random = M3AtomKit.random("tokens");
short[] rows = RelationOracle.randomTable(random, TRANSFER_STATES, TOKENS, DEAD_RATE / 4);
int[] ids = random.ints(TOKENS, 0, TOKENS).toArray();
short[] run = RelationOracle.tokens(rows, TRANSFER_STATES, TOKENS, ids, 0, ids.length);
long reference = 0;
for (int k = 0; k < COMPOSITE_OPS; k++) reference += run[k % TRANSFER_STATES];
>>>
expected = reference
ops = COMPOSITE_OPS
call = ((short[]) TOKEN_RANGE.invokeExact(rows, TRANSFER_STATES, TOKENS, ids, 0, ids.length))[i % TRANSFER_STATES]

@atom M3TokenEngine.find 1 PERF java.util.regex.Matcher.find
setup <<<
String letters = TokenRegexOracle.letters(M3AtomKit.random("engine.tape"), TAPE);
String pattern = "a b* (?<x> c)?";
Object engine = NEW_ENGINE.invokeExact(TokenRegexOracle.bind(pattern, TokenRegexOracle.tape(letters, false)), false);
Matcher m = TokenRegexOracle.javaMatcher(pattern, letters);
long perScan = 0;
while (m.find()) perScan += m.start() * (long) TAPE + m.end();
long reference = perScan * COMPOSITE_OPS;
>>>
expected = reference
ops = COMPOSITE_OPS
call = scan(engine)
