// CLASS_ONLY atoms of M3Field.java (field view; mirrors java.lang.reflect.Field).
#class M3FieldAtomTest
#summary Per-atom contracts of jdk.internal.mindex.M3Field against java.lang.reflect.Field
#build ReflectOracle
#import jdk.internal.mindex.M3CI jdk.internal.mindex.M3Field jdk.internal.mindex.M3MemberKind java.lang.reflect.Field java.util.TreeSet
#helper <<<
    private static final M3CI CI = ReflectOracle.snapshot();
    private static final MethodHandle NEW = M3AtomKit.findConstructor(M3Field.class, "M3Field",
            MethodType.methodType(void.class, M3CI.class, int.class));

    private static M3Field view(int member) throws Throwable {
        return (M3Field) NEW.invoke(CI, member);
    }

    private static void each(ReflectOracle.MemberCheck check) throws Throwable {
        assertTrue(ReflectOracle.forEachMember(CI, M3MemberKind.FIELD, check) > 0);
    }

    private static Field reflective(ReflectOracle.Declared d) {
        return (Field) d.element();
    }
>>>

@atom M3Field.M3Field 1 SCENARIO kind-checked-constructor
setup <<<
int other = ReflectOracle.firstMember(CI, M3MemberKind.CONSTRUCTOR);
>>>
check <<<
each((member, d) -> assertEquals(member, view(member).row()));
M3AtomKit.expectMessage(IllegalArgumentException.class, "not a field", () -> NEW.invoke(CI, other));
>>>

@atom M3Field.getModifiers 1 SCENARIO Field.getModifiers
check <<<
each((member, d) -> assertEquals(reflective(d).getModifiers(), view(member).getModifiers(), d.toString()));
>>>

@atom M3Field.isSynthetic 1 SCENARIO Field.isSynthetic
check <<<
each((member, d) -> assertEquals(reflective(d).isSynthetic(), view(member).isSynthetic(), d.toString()));
>>>

@atom M3Field.isEnumConstant 1 SCENARIO Field.isEnumConstant
check <<<
each((member, d) -> assertEquals(reflective(d).isEnumConstant(), view(member).isEnumConstant(), d.toString()));
>>>

@atom M3Field.annotationCount 1 SCENARIO getDeclaredAnnotations
check <<<
each((member, d) -> assertEquals(reflective(d).getDeclaredAnnotations().length, view(member).annotationCount(), d.toString()));
>>>

@atom M3Field.annotationTypeNameAt 1 SCENARIO getDeclaredAnnotations(type-names)
check <<<
each((member, d) -> {
    TreeSet<String> got = new TreeSet<>();
    for (int k = 0; k < view(member).annotationCount(); k++) got.add(view(member).annotationTypeNameAt(k));
    assertEquals(ReflectOracle.annotationNames(d.element()), got);
});
>>>

@atom M3Field.structuralHash64 1 SCENARIO delegates-to-M3CI
check <<<
each((member, d) -> assertEquals(CI.memberStructuralHash64(member), view(member).structuralHash64()));
>>>
