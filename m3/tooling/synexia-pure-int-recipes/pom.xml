<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.m3</groupId>
    <artifactId>m3jdk21-control-reactor</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <groupId>com.synexia</groupId>
  <artifactId>synexia-openrewrite-pure-int-recipes</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>Synexia :: Pure-int atom recipes (pinned M3 receiver subset)</name>
  <description>Builds only the seven hash-inventoried pure-int atom recipes from the pinned Synexia source snapshot.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <openrewrite.version>8.17.1</openrewrite.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java</artifactId>
      <version>${openrewrite.version}</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}/../../vendor/synexia/synexia-openrewrite-recipes/src/main/java</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <includes>
            <include>com/synexia/rewrite/atom/M3AtomizePureIntReturnRecipe.java</include>
            <include>com/synexia/rewrite/atom/M3DocumentPureIntAtomRecipe.java</include>
            <include>com/synexia/rewrite/atom/M3FileAtomCandidateTable.java</include>
            <include>com/synexia/rewrite/atom/M3InventoryPureIntAtomCandidates.java</include>
            <include>com/synexia/rewrite/atom/M3PatternizePureIntAtomRecipe.java</include>
            <include>com/synexia/rewrite/atom/M3PureIntAtomEligibility.java</include>
            <include>com/synexia/rewrite/atom/M3PureIntConvergenceRecipe.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
