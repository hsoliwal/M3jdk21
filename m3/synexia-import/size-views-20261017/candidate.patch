diff --git a/m3/collections/src/main/native/collections/m3_object_size.c b/m3/collections/src/main/native/collections/m3_object_size.c
--- /dev/null
+++ b/m3/collections/src/main/native/collections/m3_object_size.c
@@ -0,0 +1,57 @@
+/* Copyright 2026 Hitesh Soliwal and contributors. SPDX-License-Identifier: Apache-2.0 */
+/* Target-specific JVMTI adapter; no heap walk, object-address table or GC hooks. */
+#include <jni.h>
+#include <jvmti.h>
+#include <stdio.h>
+#include "com_m3_collections_M3ObjectSize.h"
+
+/* Created once during library loading. JVMTI environments may be used across threads.
+ * No capabilities/events/global object references are requested or retained. */
+static jvmtiEnv *m3_size_env = NULL;
+
+static void m3_size_throw(JNIEnv *env, const char *type, const char *message) {
+    jclass exception = (*env)->FindClass(env, type);
+    if (exception != NULL) {
+        (*env)->ThrowNew(env, exception, message);
+        (*env)->DeleteLocalRef(env, exception);
+    }
+}
+
+JNIEXPORT jint JNICALL JNI_OnLoad(JavaVM *vm, void *reserved) {
+    (void)reserved;
+    void *environment = NULL;
+    if ((*vm)->GetEnv(vm, &environment, JVMTI_VERSION_1_2) != JNI_OK) return JNI_ERR;
+    m3_size_env = (jvmtiEnv *)environment;
+    return JNI_VERSION_1_8;
+}
+
+JNIEXPORT void JNICALL JNI_OnUnload(JavaVM *vm, void *reserved) {
+    (void)vm;
+    (void)reserved;
+    if (m3_size_env != NULL) {
+        (void)(*m3_size_env)->DisposeEnvironment(m3_size_env);
+        m3_size_env = NULL;
+    }
+}
+
+JNIEXPORT jlong JNICALL Java_com_m3_collections_M3ObjectSize_sizeOf0(
+        JNIEnv *env, jclass owner, jobject object) {
+    (void)owner;
+    if (object == NULL) {
+        m3_size_throw(env, "java/lang/NullPointerException", "object");
+        return 0;
+    }
+    if (m3_size_env == NULL) {
+        m3_size_throw(env, "java/lang/UnsatisfiedLinkError", "JVMTI sizing unavailable");
+        return 0;
+    }
+    jlong bytes = 0;
+    jvmtiError error = (*m3_size_env)->GetObjectSize(m3_size_env, object, &bytes);
+    if (error != JVMTI_ERROR_NONE || bytes < 0) {
+        char message[96];
+        (void)snprintf(message, sizeof(message), "JVMTI GetObjectSize failed: %d", (int)error);
+        m3_size_throw(env, "java/lang/IllegalStateException", message);
+        return 0;
+    }
+    return bytes;
+}
