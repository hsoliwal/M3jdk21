@@ -0,0 +1,50 @@
+/* Copyright 2026 Hitesh Soliwal and contributors. SPDX-License-Identifier: Apache-2.0 */
+package com.m3.collections;
+
+import java.util.IdentityHashMap;
+import java.util.Objects;
+
+/**
+ * Optional JNI/JVMTI shallow-size diagnostic, not a retained-size or ownership oracle.
+ * No object layout is guessed and no supplied object is retained after the call.
+ * Loading uses the ordinary Java native-library/class-loader rules. Unavailable JNI
+ * or JVMTI fails explicitly; no approximate Java fallback is silently substituted.
+ */
+public final class M3ObjectSize {
+    private M3ObjectSize() { }
+
+    /** VM-reported shallow storage in bytes; excludes referenced objects and native payloads. */
+    public static long shallowSizeOf(Object object) {
+        Objects.requireNonNull(object, "object");
+        NativeLibrary.ensureLoaded();
+        return sizeOf0(object);
+    }
+
+    /**
+     * Sum the shallow sizes of explicitly supplied allocations, once per object identity.
+     * This does not traverse an object graph or discover a view's backing allocation.
+     * Caller must keep the supplied array stable during this call. Null elements refuse
+     * before native loading. An empty list is zero without requiring the native library.
+     * O(n) expected time and O(u) temporary identity slots for u distinct supplied objects.
+     */
+    public static long uniqueShallowSizeOf(Object... allocations) {
+        Objects.requireNonNull(allocations, "allocations");
+        for (Object object : allocations) Objects.requireNonNull(object, "allocation");
+        if (allocations.length == 0) return 0L;
+        IdentityHashMap<Object, Boolean> seen = new IdentityHashMap<>();
+        long total = 0L;
+        for (Object object : allocations) {
+            if (seen.put(object, Boolean.TRUE) == null) {
+                total = Math.addExact(total, shallowSizeOf(object));
+            }
+        }
+        return total;
+    }
+
+    private static final class NativeLibrary {
+        static { System.loadLibrary("m3_object_size"); }
+        private static void ensureLoaded() { }
+    }
+
+    private static native long sizeOf0(Object object);
+}
