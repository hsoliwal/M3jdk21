<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId>
  <artifactId>jdk21-backport-admission</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>M3 JDK21 backport admission and verification</name>

  <properties>
    <python.executable>python3</python.executable>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <executions>
          <execution>
            <id>verify-backport-catalogue</id>
            <phase>validate</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${python.executable}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>verify.py</argument>
                <argument>--root</argument>
                <argument>${project.basedir}/../..</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>compile-backport-recipe-dag</id>
            <phase>validate</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${python.executable}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>backport_recipe_dag.py</argument>
                <argument>--root</argument>
                <argument>${project.basedir}/../..</argument>
                <argument>--out</argument>
                <argument>${project.build.directory}/backport-recipe-dag.tsv</argument>
                <argument>--summary</argument>
                <argument>${project.build.directory}/backport-recipe-dag.json</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>emit-backport-program-status</id>
            <phase>verify</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${python.executable}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>program_status.py</argument>
                <argument>--root</argument>
                <argument>${project.basedir}/../..</argument>
                <argument>--json-out</argument>
                <argument>${project.build.directory}/program-status.json</argument>
                <argument>--tsv-out</argument>
                <argument>${project.build.directory}/program-status.tsv</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>test-backport-inventory</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${python.executable}</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>-m</argument>
                <argument>unittest</argument>
                <argument>discover</argument>
                <argument>-s</argument>
                <argument>.</argument>
                <argument>-p</argument>
                <argument>test_*.py</argument>
                <argument>-v</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
