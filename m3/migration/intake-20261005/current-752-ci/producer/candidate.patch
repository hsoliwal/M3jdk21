index 4047196..e5b3206 100644
--- a/m3/backports/test_compatibility_policy.py
+++ b/m3/backports/test_compatibility_policy.py
@@ -139,6 +139,34 @@ com.synexia.rewrite.CiRecipeTest$1
             _load_rows([row])
 
 
+    def test_nul_tokens_are_rejected_but_literal_escape_text_is_preserved(self) -> None:
+        original = _row(
+            jep="458",
+            release="22",
+            classification="COMPATIBLE_TOOLING",
+            default_java21="OPT_IN",
+        )
+        fields = (
+            "title", "classification", "default_java21",
+            "owner_lane", "evidence_url", "note",
+        )
+        for field in fields:
+            value = original[field]
+            for position in (0, len(value) // 2, len(value)):
+                with self.subTest(field=field, position=position):
+                    row = dict(original)
+                    row[field] = value[:position] + "\x00" + value[position:]
+                    with self.assertRaisesRegex(ValueError, f"^invalid {field}$"):
+                        _load_rows([row])
+
+        for field in ("title", "note"):
+            with self.subTest(literal_escape_field=field):
+                row = dict(original)
+                row[field] = r"literal \x00 text"
+                entries = _load_rows([row])
+                self.assertEqual(row[field], getattr(entries[0], field))
+
+
 def _row(
     *,
     jep: str,
