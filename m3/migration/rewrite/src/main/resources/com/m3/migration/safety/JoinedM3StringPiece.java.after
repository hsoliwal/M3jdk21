package com.m3.text;

import java.util.Arrays;
import java.util.Objects;

/** Flat immutable leaf directory. Join is O(S), not constant-allocation concatenation. */
final class JoinedM3StringPiece implements M3StringPiece {
    private final LocalM3StringPiece[] leaves;
    private final int[] ends;
    private final int length;
    // A bounded hint only; every read verifies its range before using it.
    private volatile int hotLeaf;

    JoinedM3StringPiece(M3StringPiece[] input) {
        Objects.requireNonNull(input);
        M3StringPiece[] pieces = input.clone();
        int count = 0;
        int units = 0;
        // Validate the complete length before result-sized descriptor arrays are allocated.
        for (M3StringPiece piece : pieces) {
            Objects.requireNonNull(piece);
            units = Math.addExact(units, piece.length());
            count = Math.addExact(count, piece instanceof JoinedM3StringPiece joined
                    ? joined.leaves.length : piece.length() == 0 ? 0 : 1);
        }
        LocalM3StringPiece[] directory = new LocalM3StringPiece[count];
        int used = 0;
        for (M3StringPiece piece : pieces) {
            if (piece instanceof JoinedM3StringPiece joined) {
                for (LocalM3StringPiece leaf : joined.leaves) used = append(directory, used, leaf);
            } else if (piece.length() != 0) {
                used = append(directory, used, (LocalM3StringPiece) piece);
            }
        }
        leaves = used == count ? directory : Arrays.copyOf(directory, used);
        ends = new int[used];
        int end = 0;
        for (int i = 0; i < used; i++) ends[i] = end = Math.addExact(end, leaves[i].length());
        if (end != units) throw new IllegalStateException("descriptor length mismatch");
        length = units;
    }

    private static int append(LocalM3StringPiece[] directory, int used, LocalM3StringPiece leaf) {
        if (used > 0 && directory[used - 1].adjacentTo(leaf)) {
            directory[used - 1] = directory[used - 1].coalesce(leaf);
            return used;
        }
        directory[used] = leaf;
        return used + 1;
    }

    @Override public int length() { return length; }

    int leafIndex(int index) {
        int hint = hotLeaf;
        if (hint < ends.length && index >= leafOrigin(hint) && index < ends[hint]) return hint;
        int lo = 0, hi = ends.length;
        while (lo < hi) {
            int middle = (lo + hi) >>> 1;
            if (ends[middle] <= index) lo = middle + 1; else hi = middle;
        }
        hotLeaf = lo;
        return lo;
    }

    LocalM3StringPiece leafAt(int index) { return leaves[index]; }
    int leafOrigin(int index) { return index == 0 ? 0 : ends[index - 1]; }

    @Override public char charAt(int index) {
        Objects.checkIndex(index, length);
        int leaf = leafIndex(index);
        return leaves[leaf].charAt(index - leafOrigin(leaf));
    }

    @Override public M3StringPiece subSequence(int start, int end) {
        Objects.checkFromToIndex(start, end, length);
        if (start == end) return new JoinedM3StringPiece(new M3StringPiece[0]);
        int first = leafIndex(start), last = leafIndex(end - 1);
        LocalM3StringPiece[] ranges = new LocalM3StringPiece[last - first + 1];
        for (int i = first; i <= last; i++) {
            int origin = leafOrigin(i);
            int a = Math.max(start, origin), b = Math.min(end, ends[i]);
            ranges[i - first] = leaves[i].subSequence(a - origin, b - origin);
        }
        return new JoinedM3StringPiece(ranges);
    }

    @Override public String toString() { return flatten(); }
}
