<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.synexia.receiving</groupId><artifactId>jdt-array-nodelist-source</artifactId><version>20261019</version></parent>
  <artifactId>jdt-exact-core-source</artifactId>
  <properties><maven.compiler.release>${jdt.core.release}</maven.compiler.release></properties>
  <dependencies>
    <dependency><groupId>com.synexia.receiving</groupId><artifactId>jdt-exact-compiler-source</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.core.resources</artifactId><version>3.24.100</version></dependency>
    <dependency><groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.core.runtime</artifactId><version>3.35.0</version></dependency>
    <dependency><groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.core.filesystem</artifactId><version>1.11.500</version></dependency>
    <dependency><groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.text</artifactId><version>3.14.800</version></dependency>
    <dependency><groupId>org.eclipse.platform</groupId><artifactId>org.eclipse.team.core</artifactId><version>3.10.1100</version></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <sourceDirectory>${project.build.directory}/generated-sources/jdt</sourceDirectory>
    <testSourceDirectory>${project.basedir}/../src/test/java</testSourceDirectory>
    <resources>
      <resource><directory>${jdt.source}/org.eclipse.jdt.core/codeassist</directory><excludes><exclude>**/*.java</exclude></excludes></resource>
      <resource><directory>${jdt.source}/org.eclipse.jdt.core/eval</directory><excludes><exclude>**/*.java</exclude></excludes></resource>
      <resource><directory>${jdt.source}/org.eclipse.jdt.core/formatter</directory><excludes><exclude>**/*.java</exclude></excludes></resource>
      <resource><directory>${jdt.source}/org.eclipse.jdt.core/dom</directory><excludes><exclude>**/*.java</exclude></excludes></resource>
      <resource><directory>${jdt.source}/org.eclipse.jdt.core/search</directory><excludes><exclude>**/*.java</exclude></excludes></resource>
      <resource><directory>${jdt.source}/org.eclipse.jdt.core/model</directory><excludes><exclude>**/*.java</exclude></excludes></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
        <executions><execution><id>verify-exact-source-custody</id><phase>validate</phase><goals><goal>exec</goal></goals><configuration>
          <executable>python3</executable><arguments><argument>${project.basedir}/../verify-source.py</argument><argument>${jdt.source}</argument></arguments>
        </configuration></execution></executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution><id>stage-unchanged-core-source</id><phase>generate-sources</phase><goals><goal>copy-resources</goal></goals><configuration>
            <outputDirectory>${project.build.directory}/generated-sources/jdt</outputDirectory><overwrite>true</overwrite>
            <resources>
              <resource><directory>${jdt.source}/org.eclipse.jdt.core/codeassist</directory><filtering>false</filtering><includes><include>**/*.java</include></includes><excludes><exclude>org/eclipse/jdt/core/dom/ASTNode.java</exclude><exclude>org/eclipse/jdt/internal/core/builder/JavaBuilder.java</exclude></excludes></resource>
              <resource><directory>${jdt.source}/org.eclipse.jdt.core/eval</directory><filtering>false</filtering><includes><include>**/*.java</include></includes><excludes><exclude>org/eclipse/jdt/core/dom/ASTNode.java</exclude><exclude>org/eclipse/jdt/internal/core/builder/JavaBuilder.java</exclude></excludes></resource>
              <resource><directory>${jdt.source}/org.eclipse.jdt.core/formatter</directory><filtering>false</filtering><includes><include>**/*.java</include></includes><excludes><exclude>org/eclipse/jdt/core/dom/ASTNode.java</exclude><exclude>org/eclipse/jdt/internal/core/builder/JavaBuilder.java</exclude></excludes></resource>
              <resource><directory>${jdt.source}/org.eclipse.jdt.core/dom</directory><filtering>false</filtering><includes><include>**/*.java</include></includes><excludes><exclude>org/eclipse/jdt/core/dom/ASTNode.java</exclude><exclude>org/eclipse/jdt/internal/core/builder/JavaBuilder.java</exclude></excludes></resource>
              <resource><directory>${jdt.source}/org.eclipse.jdt.core/search</directory><filtering>false</filtering><includes><include>**/*.java</include></includes><excludes><exclude>org/eclipse/jdt/core/dom/ASTNode.java</exclude><exclude>org/eclipse/jdt/internal/core/builder/JavaBuilder.java</exclude></excludes></resource>
              <resource><directory>${jdt.source}/org.eclipse.jdt.core/model</directory><filtering>false</filtering><includes><include>**/*.java</include></includes><excludes><exclude>org/eclipse/jdt/core/dom/ASTNode.java</exclude><exclude>org/eclipse/jdt/internal/core/builder/JavaBuilder.java</exclude></excludes></resource>
            </resources>
          </configuration></execution>
          <execution><id>stage-recipe-generated-owning-source</id><phase>generate-sources</phase><goals><goal>copy-resources</goal></goals><configuration>
            <outputDirectory>${project.build.directory}/generated-sources/jdt</outputDirectory><overwrite>true</overwrite>
            <resources><resource><directory>${project.basedir}/../src/main/java</directory><filtering>false</filtering><includes><include>org/eclipse/jdt/core/dom/ASTNode.java</include><include>org/eclipse/jdt/internal/core/builder/JavaBuilder.java</include></includes></resource></resources>
          </configuration></execution>
        </executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><configuration>
        <testIncludes><testInclude>**/ASTNodeListArrayTest.java</testInclude><testInclude>**/ASTNodeListStorageProbe.java</testInclude><testInclude>**/JdtSourceCompatibilityTest.java</testInclude></testIncludes>
      </configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration>
        <includes><include>**/ASTNodeListArrayTest.java</include><include>**/JdtSourceCompatibilityTest.java</include></includes>
      </configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><executions><execution>
        <goals><goal>test-jar</goal></goals><configuration><archive><manifestEntries>
          <Premain-Class>org.eclipse.jdt.core.tests.dom.ASTNodeListStorageProbe</Premain-Class>
        </manifestEntries></archive></configuration>
      </execution></executions></plugin>
    </plugins>
  </build>
</project>
