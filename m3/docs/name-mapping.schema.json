{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hsoliwal/M3jdk21/m3/docs/name-mapping.schema.json",
  "title": "MIndex to M3 permanent migration mapping v2",
  "type": "object",
  "required": [
    "schema",
    "mapping_schema",
    "mappings",
    "legacy_mappings",
    "capability_gates",
    "source_inventory_ref",
    "coverage_roots"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "mapping_schema": {
      "const": "mindex-to-m3/v2"
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mapping_id",
          "sources",
          "destinations",
          "mapping_kind",
          "canonical_owner",
          "identity_rules",
          "contract_differences",
          "compatibility_obligations",
          "format_abi",
          "bootstrap_constraints",
          "dependencies",
          "downstream_consumers",
          "materialization_boundaries",
          "cached_fact_owner",
          "recipe",
          "tests",
          "license_provenance",
          "last_synchronized",
          "target_adaptations",
          "conflicts",
          "pending_changes",
          "rationale",
          "port_direction",
          "status"
        ],
        "properties": {
          "mapping_id": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "repository",
                "commit",
                "module",
                "path",
                "symbol",
                "signature",
                "sha256"
              ],
              "properties": {
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "destinations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "repository",
                "commit",
                "module",
                "path",
                "symbol",
                "signature",
                "sha256"
              ],
              "properties": {
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "mapping_kind": {
            "enum": [
              "direct_port",
              "rename",
              "adapter",
              "consolidation",
              "specialization",
              "dependency_reuse",
              "pending",
              "excluded"
            ]
          },
          "status": {
            "type": "string"
          },
          "recipe": {
            "type": "object",
            "required": [
              "id",
              "version",
              "preconditions",
              "before_hashes",
              "after_hashes",
              "rollback"
            ]
          },
          "tests": {
            "type": "object",
            "required": [
              "differential",
              "acceptance",
              "evidence"
            ]
          },
          "upstream_mapping_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "coverage_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_inventory_ref": {
      "type": "object",
      "required": [
        "repository",
        "commit",
        "path",
        "visibility",
        "pending_item_count"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "pending_item_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
