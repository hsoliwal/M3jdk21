  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <failIfNoTests>true</failIfNoTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openrewrite.maven</groupId>
        <artifactId>rewrite-maven-plugin</artifactId>
        <version>5.23.1</version>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>m3-coverage-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>m3-coverage-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>m3-coverage-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <includes>
                <include>com/m3/rewrite/scope/*</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.99</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.99</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Canonical reusable recipes are owned by hsoliwal/com.synexia.
      This profile is intentionally opt-in so a missing/unpublished local Synexia snapshot cannot
      break the default M3JDK21 receiver build. Install the pinned Synexia reactor first, then
      activate this profile and select a com.synexia.* recipe explicitly.
    -->
    <profile>
      <id>m3-synexia-recipe-ownership-audit</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.synexia</groupId>
                <artifactId>synexia-openrewrite-recipes</artifactId>
                <version>${m3.synexia.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <exportDatatables>true</exportDatatables>
              <activeRecipes combine.self="override">
                <recipe>com.synexia.rewrite.M3Jdk21RecipeOwnershipAudit</recipe>
              </activeRecipes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>m3-synexia-canonical-recipes</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.synexia</groupId>
                <artifactId>synexia-openrewrite-recipes</artifactId>
                <version>${m3.synexia.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>m3-synexia-atom-pattern</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>5.23.1</version>
            <dependencies>
              <dependency>
                <groupId>com.synexia</groupId>
                <artifactId>synexia-openrewrite-recipes</artifactId>
                <version>1.0.0-SNAPSHOT</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-synexia-atom-pattern-verify</id>
                <phase>verify</phase>
                <goals>
                  <goal>dryRun</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <activeRecipes>
                <recipe>com.synexia.m3.EveryModuleAtomPatternApplication</recipe>
              </activeRecipes>
              <exportDatatables>true</exportDatatables>
              <runPerSubmodule>false</runPerSubmodule>
              <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
              <failOnDryRunResults>false</failOnDryRunResults>
              <additionalPlainTextMasks>
                <additionalPlainTextMask>**/*.md</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.markdown</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.adoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.asciidoc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.c</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.h</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cc</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hpp</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.hxx</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.gradle.kts</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.sh</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bash</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.cmd</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.bat</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ps1</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.py</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.pyi</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.csv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.tsv</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.ndjson</additionalPlainTextMask>
                <additionalPlainTextMask>**/*.txt</additionalPlainTextMask>
                <additionalPlainTextMask>**/README</additionalPlainTextMask>
                <additionalPlainTextMask>**/LICENSE</additionalPlainTextMask>
                <additionalPlainTextMask>**/NOTICE</additionalPlainTextMask>
              </additionalPlainTextMasks>
              <exclusions>
                <exclusion>**/target/**</exclusion>
                <exclusion>**/generated-sources/**</exclusion>
                <exclusion>**/out/**</exclusion>
                <exclusion>**/scratch/**</exclusion>
                <exclusion>**/.merge-preserved/**</exclusion>
                <exclusion>**/.superset/**</exclusion>
                <exclusion>**/.m3/maven-superset-*/**</exclusion>
                <exclusion>**/archive-maven-projects/**</exclusion>
                <exclusion>**/tasks/**</exclusion>
                <exclusion>**/verification/**</exclusion>
                <exclusion>**/evidence/**</exclusion>
                <exclusion>**/history/**</exclusion>
                <exclusion>**/template-history/**</exclusion>
                <exclusion>**/receiving-input/**</exclusion>
                <exclusion>**/input-epoch/**</exclusion>
                <exclusion>**/src/test/resources/**</exclusion>
                <exclusion>**/upstream-excluded/**</exclusion>
                <exclusion>**/*custody*/**</exclusion>
                <exclusion>**/vendor/**</exclusion>
              </exclusions>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
