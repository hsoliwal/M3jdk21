# SPDX-License-Identifier: Apache-2.0
# m3vcpu_webgpu_embed.cmake - embeds the WGSL twin kernels into the webgpu backend.
#   cmake -DWGSL=<x.wgsl> -DHEADER=<m3k_portability.h> -DKERNEL=<x.cl> -DENTRY=<kernel> -DOUT_DIR=<dir> -P this
# Admission gate: the WGSL file must carry "m3k-twin-of: <kernel file> sha256=<hex>" equal to the
# SHA-256 of KERNEL; otherwise the build stops (the twin is not admitted for changed semantics).
# Outputs in OUT_DIR:
#   m3vcpu_webgpu_kernels.c     WGSL bytes + sha256, and the sha256 of the OpenCL C bundle blob
#                               (HEADER bytes + KERNEL bytes, computed exactly like
#                               cmake/m3vcpu_embed_kernel.cmake) that the twin is paired with
#   webgpu-kernel-bundle.tsv    entry, format, size, sha256, paired blob sha256, pinned source sha256
cmake_minimum_required(VERSION 3.20)
foreach(var WGSL HEADER KERNEL ENTRY OUT_DIR)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "m3vcpu_webgpu_embed: ${var} not set")
  endif()
endforeach()

function(m3_c_bytes hex out)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " bytes "${bytes}")
  set(${out} "${bytes}" PARENT_SCOPE)
endfunction()

get_filename_component(kernel_name "${KERNEL}" NAME)
file(READ "${WGSL}" wgsl_text)
string(REGEX MATCH "m3k-twin-of: ([A-Za-z0-9_.]+) sha256=([0-9a-f]+)" pin "${wgsl_text}")
set(pin_file "${CMAKE_MATCH_1}")
set(pin_sha "${CMAKE_MATCH_2}")
file(SHA256 "${KERNEL}" kernel_sha)
if(NOT pin_file STREQUAL kernel_name OR NOT pin_sha STREQUAL kernel_sha)
  message(FATAL_ERROR "WGSL twin ${WGSL} is pinned to '${pin_file}' sha256 ${pin_sha}, but ${kernel_name} "
                      "is sha256 ${kernel_sha}. Restate the change in WGSL, run the RV32IM suite on the webgpu "
                      "backend, then update the m3k-twin-of pin.")
endif()

file(MAKE_DIRECTORY "${OUT_DIR}")
file(READ "${HEADER}" header_text)
file(READ "${KERNEL}" kernel_text)
set(cl_path "${OUT_DIR}/${ENTRY}.paired.opencl.cl")
file(WRITE "${cl_path}" "${header_text}${kernel_text}")
file(SHA256 "${cl_path}" cl_sha)
file(READ "${WGSL}" wgsl_hex HEX)
file(SHA256 "${WGSL}" wgsl_sha)
file(SIZE "${WGSL}" wgsl_size)
string(HEX "${ENTRY}" entry_hex)

m3_c_bytes("${wgsl_hex}" wgsl_bytes)
m3_c_bytes("${wgsl_sha}" wgsl_sha_bytes)
m3_c_bytes("${cl_sha}" cl_sha_bytes)

file(WRITE "${OUT_DIR}/m3vcpu_webgpu_kernels.c"
"/* SPDX-License-Identifier: Apache-2.0 */
/* Generated by src/backends/webgpu/m3vcpu_webgpu_embed.cmake from kernels/ - do not edit. */
#include \"m3vcpu_webgpu_kernels.h\"

static const uint8_t m3_${ENTRY}_wgsl[${wgsl_size}] = {
    ${wgsl_bytes}};

const m3_wg_twin m3_wg_twins[] = {
    {\"${ENTRY}\", 4u, m3_${ENTRY}_wgsl, sizeof m3_${ENTRY}_wgsl,
     {${wgsl_sha_bytes}},
     {${cl_sha_bytes}}},
};
const size_t m3_wg_twin_count = 1u;
")

file(WRITE "${OUT_DIR}/webgpu-kernel-bundle.tsv"
"entry\tformat\tsize\tsha256\tpaired_opencl_blob_sha256\ttwin_of\ttwin_of_sha256
${ENTRY}\tM3K_WGSL\t${wgsl_size}\t${wgsl_sha}\t${cl_sha}\t${kernel_name}\t${kernel_sha}
")
message(STATUS "m3vcpu webgpu bundle: ${ENTRY} wgsl ${wgsl_size} B sha256 ${wgsl_sha}; paired opencl blob ${cl_sha}")
