# SPDX-License-Identifier: Apache-2.0
# m3vcpu_embed_kernel.cmake - builds the content-addressed kernel bundle compiled into the core.
#   cmake -DHEADER=<m3k_portability.h> -DKERNEL=<x.cl> -DENTRY=<kernel> -DOUT_DIR=<dir> -P this
# Outputs in OUT_DIR:
#   <ENTRY>.opencl.cl       OpenCL C blob = portability header bytes + kernel bytes
#   m3vcpu_bundle_data.c    byte arrays + m3k_blob table (sha256 computed here, re-verified at load)
#   kernel-bundle.tsv       entry, format, min_isa, size, sha256
cmake_minimum_required(VERSION 3.20)
foreach(var HEADER KERNEL ENTRY OUT_DIR)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "m3vcpu_embed_kernel: ${var} not set")
  endif()
endforeach()

function(m3_c_bytes hex out)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " bytes "${bytes}")
  set(${out} "${bytes}" PARENT_SCOPE)
endfunction()

file(MAKE_DIRECTORY "${OUT_DIR}")
file(READ "${HEADER}" header_text)
file(READ "${KERNEL}" kernel_text)
set(cl_path "${OUT_DIR}/${ENTRY}.opencl.cl")
file(WRITE "${cl_path}" "${header_text}${kernel_text}")
file(READ "${cl_path}" cl_hex HEX)
file(SHA256 "${cl_path}" cl_sha)
file(SIZE "${cl_path}" cl_size)
string(HEX "${ENTRY}" sym_hex)
string(SHA256 sym_sha "${ENTRY}")
string(LENGTH "${ENTRY}" sym_size)

m3_c_bytes("${cl_hex}" cl_bytes)
m3_c_bytes("${cl_sha}" cl_sha_bytes)
m3_c_bytes("${sym_hex}" sym_bytes)
m3_c_bytes("${sym_sha}" sym_sha_bytes)

file(WRITE "${OUT_DIR}/m3vcpu_bundle_data.c"
"/* SPDX-License-Identifier: Apache-2.0 */
/* Generated by cmake/m3vcpu_embed_kernel.cmake from kernels/ - do not edit. */
#include \"m3vcpu_internal.h\"

static const uint8_t m3_${ENTRY}_opencl[${cl_size}] = {
    ${cl_bytes}};
static const uint8_t m3_${ENTRY}_cpu[${sym_size}] = {
    ${sym_bytes}};

static const m3k_blob m3_${ENTRY}_blobs[2] = {
    {M3K_OPENCL_C, 120u, m3_${ENTRY}_opencl, sizeof m3_${ENTRY}_opencl, {
    ${cl_sha_bytes}}},
    {M3K_CPU_SYMBOL, 0u, m3_${ENTRY}_cpu, sizeof m3_${ENTRY}_cpu, {
    ${sym_sha_bytes}}},
};

const m3vcpu_bundle_entry m3vcpu_bundle[] = {
    {\"${ENTRY}\", m3_${ENTRY}_blobs, 2u},
};
const size_t m3vcpu_bundle_count = 1u;
")

file(WRITE "${OUT_DIR}/kernel-bundle.tsv"
"entry\tformat\tmin_isa\tsize\tsha256
${ENTRY}\tM3K_OPENCL_C\t120\t${cl_size}\t${cl_sha}
${ENTRY}\tM3K_CPU_SYMBOL\t0\t${sym_size}\t${sym_sha}
")
message(STATUS "m3vcpu bundle: ${ENTRY} opencl ${cl_size} B sha256 ${cl_sha}")
