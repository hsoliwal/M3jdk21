# Hard rule 1: no linked vendor runtime or dependency outside the platform OS/CRT allowlist.
# cmake -DTOOL=<readelf|llvm-readobj|otool> -DFORMAT=<ELF|COFF|MACHO> -DFILES="a|b" -P this
# Native runtime/device tests remain separate from successful object-file inspection.
cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED TOOL OR TOOL STREQUAL "" OR NOT DEFINED FILES OR FILES STREQUAL "")
  message(FATAL_ERROR "m3vcpu_check_imports: nonempty TOOL and FILES required")
endif()
if(NOT DEFINED FORMAT)
  # Preserve direct invocations of the original checker; builds pass the target format explicitly.
  get_filename_component(tool_name "${TOOL}" NAME)
  if(tool_name MATCHES "readelf")
    set(FORMAT ELF)
  elseif(tool_name MATCHES "otool")
    set(FORMAT MACHO)
  else()
    set(FORMAT COFF)
  endif()
endif()
if(NOT FORMAT MATCHES "^(ELF|COFF|MACHO)$")
  message(FATAL_ERROR "m3vcpu_check_imports: unsupported FORMAT '${FORMAT}'")
endif()

set(forbidden "^nvcuda" "^opencl" "^libopencl" "^vulkan-1" "^libvulkan" "^ze_loader" "^libze_loader"
              "^amdhip64" "^libamdhip64" "^cudart" "^libcuda" "^nvrtc" "^libnvrtc" "^igdrcl" "^nvopencl")
if(FORMAT STREQUAL "ELF")
  set(allowed "^libm3vcpu[.]so([.][0-9]+)*$" "^libc[.]so([.][0-9]+)*$"
              "^libdl[.]so([.][0-9]+)*$" "^libpthread[.]so([.][0-9]+)*$"
              "^libm[.]so([.][0-9]+)*$" "^ld-linux[^/]*[.]so([.][0-9]+)*$")
elseif(FORMAT STREQUAL "MACHO")
  set(allowed "^/usr/lib/libsystem[.]b[.]dylib$"
              "^@(rpath|loader_path)/libm3vcpu[.]dylib$")
else()
  set(allowed "^kernel32[.]dll$" "^vcruntime140(_1)?d?[.]dll$" "^ucrtbased?[.]dll$"
              "^api-ms-win-crt-.*[.]dll$" "^msvcrt[.]dll$" "^m3vcpu[.]dll$")
endif()
# Retain the explicit WebGPU OS/CRT extension; it never exempts a forbidden vendor import.
if(DEFINED EXTRA_ALLOWED AND NOT EXTRA_ALLOWED STREQUAL "")
  string(REPLACE "|" ";" extra_allowed "${EXTRA_ALLOWED}")
  list(APPEND allowed ${extra_allowed})
endif()

string(REPLACE "|" ";" files "${FILES}")
set(failures 0)
foreach(f IN LISTS files)
  get_filename_component(base "${f}" NAME)
  if(NOT EXISTS "${f}" OR IS_DIRECTORY "${f}")
    message(SEND_ERROR "${base}: import input is not a file: ${f}")
    math(EXPR failures "${failures} + 1")
    continue()
  endif()
  if(FORMAT STREQUAL "ELF")
    set(inspect_arg -d)
  elseif(FORMAT STREQUAL "MACHO")
    set(inspect_arg -l)
  else()
    set(inspect_arg --coff-imports)
  endif()
  execute_process(COMMAND "${TOOL}" "${inspect_arg}" "${f}"
                  OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  if(NOT rc STREQUAL "0")
    message(SEND_ERROR "${base}: ${TOOL} failed (${rc}): ${err}")
    math(EXPR failures "${failures} + 1")
    continue()
  endif()

  set(names "")
  set(parse_ok TRUE)
  if(FORMAT STREQUAL "ELF")
    if(NOT out MATCHES "Dynamic section at offset")
      set(parse_ok FALSE)
    endif()
    string(REGEX MATCHALL "[^\r\n]*[(]NEEDED[)][^\r\n]*" lines "${out}")
    foreach(line IN LISTS lines)
      if(line MATCHES "Shared library: \\[([^]]+)\\]")
        list(APPEND names "${CMAKE_MATCH_1}")
      else()
        set(parse_ok FALSE)
      endif()
    endforeach()
  elseif(FORMAT STREQUAL "MACHO")
    if(NOT out MATCHES "Load command [0-9]+")
      set(parse_ok FALSE)
    endif()
    string(REPLACE "\r" "" out "${out}")
    string(REPLACE "\n" ";" lines "${out}")
    set(needs_name FALSE)
    foreach(line IN LISTS lines)
      string(STRIP "${line}" line)
      if(line MATCHES "^Load command [0-9]+$" OR line MATCHES "^cmd ")
        if(needs_name)
          set(parse_ok FALSE)
        endif()
        set(needs_name FALSE)
      endif()
      if(line MATCHES "^cmd LC_(LOAD_DYLIB|LOAD_WEAK_DYLIB|REEXPORT_DYLIB|LOAD_UPWARD_DYLIB|LAZY_LOAD_DYLIB)$")
        set(needs_name TRUE)
      elseif(needs_name AND line MATCHES "^name (.+) [(]offset [0-9]+[)]$")
        list(APPEND names "${CMAKE_MATCH_1}")
        set(needs_name FALSE)
      endif()
    endforeach()
    if(needs_name)
      set(parse_ok FALSE)
    endif()
  else()
    if(NOT out MATCHES "Format: COFF-")
      set(parse_ok FALSE)
    endif()
    string(REPLACE "\r" "" out "${out}")
    string(REPLACE "\n" ";" lines "${out}")
    set(in_import FALSE)
    set(import_has_name FALSE)
    foreach(line IN LISTS lines)
      string(STRIP "${line}" line)
      if(line MATCHES "^(Delay)?Import [{]$")
        if(in_import)
          set(parse_ok FALSE)
        endif()
        set(in_import TRUE)
        set(import_has_name FALSE)
      elseif(in_import AND line MATCHES "^Name: (.+)$")
        if(import_has_name)
          set(parse_ok FALSE)
        endif()
        list(APPEND names "${CMAKE_MATCH_1}")
        set(import_has_name TRUE)
      elseif(in_import AND line STREQUAL "}")
        if(NOT import_has_name)
          set(parse_ok FALSE)
        endif()
        set(in_import FALSE)
      endif()
    endforeach()
    if(in_import)
      set(parse_ok FALSE)
    endif()
  endif()
  if(NOT parse_ok OR NOT names)
    message(SEND_ERROR "${base}: no complete ${FORMAT} dependency inspection; empty or unrecognized tool output")
    math(EXPR failures "${failures} + 1")
    continue()
  endif()
  list(REMOVE_DUPLICATES names)
  string(REPLACE ";" ", " shown "${names}")
  message(STATUS "${base}: imports: ${shown}")
  foreach(name IN LISTS names)
    string(TOLOWER "${name}" low)
    get_filename_component(import_base "${low}" NAME)
    foreach(pattern IN LISTS forbidden)
      if(import_base MATCHES "${pattern}")
        message(SEND_ERROR "${base}: VENDOR RUNTIME IMPORTED: ${name}")
        math(EXPR failures "${failures} + 1")
      endif()
    endforeach()
    set(ok FALSE)
    foreach(pattern IN LISTS allowed)
      if(low MATCHES "${pattern}")
        set(ok TRUE)
      endif()
    endforeach()
    if(NOT ok)
      message(SEND_ERROR "${base}: import outside the platform OS/CRT allowlist: ${name}")
      math(EXPR failures "${failures} + 1")
    endif()
  endforeach()
endforeach()
if(failures GREATER 0)
  message(FATAL_ERROR "import-table gate: ${failures} violation(s)")
endif()
message(STATUS "import-table gate: PASS (inspected ${FORMAT}; no vendor runtime linked)")
