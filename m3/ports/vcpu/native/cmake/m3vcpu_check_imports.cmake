# m3vcpu_check_imports.cmake - hard rule 1 gate: no vendor runtime in any import table.
#   cmake -DTOOL=<llvm-readobj|readelf> -DFILES="a|b|c" -P this
# Fails when a library imports a vendor runtime (nvcuda, OpenCL, vulkan-1, ze_loader, amdhip64,
# cudart, nvrtc, ...) or anything outside the kernel32/CRT/libc allowlist (plus m3vcpu itself).
cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED TOOL OR NOT DEFINED FILES)
  message(FATAL_ERROR "m3vcpu_check_imports: TOOL and FILES required")
endif()
string(REPLACE "|" ";" files "${FILES}")
set(forbidden "^nvcuda" "^opencl" "^libopencl" "^vulkan-1" "^libvulkan" "^ze_loader" "^libze_loader"
              "^amdhip64" "^libamdhip64" "^cudart" "^libcuda" "^nvrtc" "^libnvrtc" "^igdrcl" "^nvopencl")
set(allowed "^kernel32\\.dll$" "^vcruntime140(_1)?d?\\.dll$" "^ucrtbased?\\.dll$" "^api-ms-win-crt-.*\\.dll$"
            "^msvcrt\\.dll$" "^m3vcpu\\.dll$" "^libm3vcpu\\.so$" "^libc\\.so" "^libdl\\.so" "^libpthread\\.so"
            "^libm\\.so" "^ld-linux")
set(failures 0)
foreach(f IN LISTS files)
  get_filename_component(base "${f}" NAME)
  if(TOOL MATCHES "readelf")
    execute_process(COMMAND "${TOOL}" -d "${f}" OUTPUT_VARIABLE out RESULT_VARIABLE rc)
    string(REGEX MATCHALL "Shared library: \\[[^]]+\\]" lines "${out}")
    set(names "")
    foreach(l IN LISTS lines)
      string(REGEX REPLACE "Shared library: \\[([^]]+)\\]" "\\1" n "${l}")
      list(APPEND names "${n}")
    endforeach()
  else()
    execute_process(COMMAND "${TOOL}" --coff-imports "${f}" OUTPUT_VARIABLE out RESULT_VARIABLE rc)
    string(REGEX MATCHALL "Name: [^\r\n]+" lines "${out}")
    set(names "")
    foreach(l IN LISTS lines)
      string(REGEX REPLACE "Name: " "" n "${l}")
      list(APPEND names "${n}")
    endforeach()
  endif()
  if(NOT rc EQUAL 0)
    message(SEND_ERROR "${base}: ${TOOL} failed (${rc})")
    math(EXPR failures "${failures} + 1")
    continue()
  endif()
  list(REMOVE_DUPLICATES names)
  string(REPLACE ";" ", " shown "${names}")
  message(STATUS "${base}: imports: ${shown}")
  foreach(n IN LISTS names)
    string(TOLOWER "${n}" low)
    foreach(p IN LISTS forbidden)
      if(low MATCHES "${p}")
        message(SEND_ERROR "${base}: VENDOR RUNTIME IMPORTED: ${n}")
        math(EXPR failures "${failures} + 1")
      endif()
    endforeach()
    set(ok FALSE)
    foreach(p IN LISTS allowed)
      if(low MATCHES "${p}")
        set(ok TRUE)
      endif()
    endforeach()
    if(NOT ok)
      message(SEND_ERROR "${base}: import outside the kernel32/CRT allowlist: ${n}")
      math(EXPR failures "${failures} + 1")
    endif()
  endforeach()
endforeach()
if(failures GREATER 0)
  message(FATAL_ERROR "import-table gate: ${failures} violation(s)")
endif()
message(STATUS "import-table gate: PASS (no vendor runtime linked)")
