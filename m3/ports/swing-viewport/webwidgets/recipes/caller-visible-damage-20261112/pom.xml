<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.synexia.m3</groupId>
  <artifactId>caller-visible-damage-20261112</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Selected caller producer qualification and apply</name>
  <dependencies>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-core</artifactId>
      <version>8.17.1</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.9</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
  <build>
    <directory>${m3.caller.outputRoot}/maven-controller</directory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions><execution>
          <id>validate-selected-producer-inputs</id><phase>validate</phase>
          <goals><goal>enforce</goal></goals>
          <configuration><fail>true</fail><rules>
            <requireJavaVersion><version>[21,22)</version></requireJavaVersion>
            <requireProperty><property>m3.caller.receiverRoot</property><regex>(?:[A-Za-z]:[\\/].*|/.*|\\\\.+)</regex><regexMessage>m3.caller.receiverRoot must be an absolute path</regexMessage></requireProperty>
            <requireProperty><property>m3.caller.recipeRoot</property><regex>(?:[A-Za-z]:[\\/].*|/.*|\\\\.+)</regex><regexMessage>m3.caller.recipeRoot must be an absolute path</regexMessage></requireProperty>
            <requireProperty><property>m3.caller.outputRoot</property><regex>(?:[A-Za-z]:[\\/].*|/.*|\\\\.+)</regex><regexMessage>m3.caller.outputRoot must be an absolute path</regexMessage></requireProperty>
            <requireProperty><property>m3.caller.mode</property><regex>qualify|apply</regex></requireProperty>
            <requireFilesDontExist><files><file>${m3.caller.outputRoot}</file></files><message>Use a fresh outputRoot; retained results are never reused.</message></requireFilesDontExist>
          </rules></configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <executions><execution>
          <id>selected-producer-and-result-check</id><phase>test</phase>
          <goals><goal>run</goal></goals>
          <configuration><target>
            <checksum file="${m3.caller.receiverRoot}/m3/ports/swing-viewport/webwidgets/GENERATED.tsv" algorithm="SHA-256" property="caller.ledger.before"/>
            <condition property="caller.ledger.admitted"><or>
              <equals arg1="${caller.ledger.before}" arg2="8cb45f082b5c18347549b486d84ca311cdc6aef5476e6446677a1efaf3b6f205"/>
              <equals arg1="${caller.ledger.before}" arg2="1085e4679fb7624127d08d27bf62a07c5daeff7c0482e47c9b1cbd4072406a8e"/>
            </or></condition>
            <fail unless="caller.ledger.admitted">Unadmitted GENERATED.tsv preimage.</fail>
            <checksum file="${m3.caller.recipeRoot}/resources/manifest-pins.tsv" algorithm="SHA-256" property="caller.manifest.pins.before"/>
            <available file="${m3.caller.recipeRoot}/validation/selected-producer.jsh" type="file" property="caller.driver.present"/>
            <fail unless="caller.driver.present">Missing selected producer driver.</fail>
            <checksum file="${m3.caller.recipeRoot}/bindings.tsv" algorithm="SHA-256" property="caller.bindings.before"/>
            <mkdir dir="${m3.caller.outputRoot}/maven-controller/tmp"/>
            <mkdir dir="${m3.caller.outputRoot}/maven-controller/jshell-home"/>
            <exec executable="${java.home}/bin/jshell" inputstring="" timeout="120000" failonerror="true" failifexecutionfails="true"
                  output="${m3.caller.outputRoot}/jshell.stdout.log" error="${m3.caller.outputRoot}/jshell.stderr.log">
              <arg value="-J-Xmx256m"/>
              <arg value="-R-Xmx256m"/>
              <arg value="-J-Duser.home=${m3.caller.outputRoot}/maven-controller/jshell-home"/>
              <arg value="-J-Djava.util.prefs.userRoot=${m3.caller.outputRoot}/maven-controller/jshell-home/prefs"/>
              <arg value="-J-Djava.util.prefs.systemRoot=${m3.caller.outputRoot}/maven-controller/jshell-home/system-prefs"/>
              <arg value="-J-Djava.io.tmpdir=${m3.caller.outputRoot}/maven-controller/tmp"/>
              <arg value="-R-Duser.home=${m3.caller.outputRoot}/maven-controller/jshell-home"/>
              <arg value="-R-Djava.util.prefs.userRoot=${m3.caller.outputRoot}/maven-controller/jshell-home/prefs"/>
              <arg value="-R-Djava.util.prefs.systemRoot=${m3.caller.outputRoot}/maven-controller/jshell-home/system-prefs"/>
              <arg value="-R-Djava.io.tmpdir=${m3.caller.outputRoot}/maven-controller/tmp"/>
              <arg value="-R-Dm3.caller.receiverRoot=${m3.caller.receiverRoot}"/>
              <arg value="-R-Dm3.caller.recipeRoot=${m3.caller.recipeRoot}"/>
              <arg value="-R-Dm3.caller.outputRoot=${m3.caller.outputRoot}/selected-producer"/>
              <arg value="-R-Dm3.caller.mode=${m3.caller.mode}"/>
              <arg value="--no-startup"/>
              <arg value="--feedback"/><arg value="silent"/>
              <arg value="--add-modules"/><arg value="jdk.compiler,jdk.jdeps"/>
              <arg value="${m3.caller.recipeRoot}/validation/selected-producer.jsh"/>
            </exec>
            <checksum file="${m3.caller.recipeRoot}/bindings.tsv" algorithm="SHA-256" property="caller.bindings.after"/>
            <loadfile property="caller.pass.actual" srcFile="${m3.caller.outputRoot}/selected-producer/PASS.sentinel" encoding="UTF-8"/>
            <condition property="caller.pass.valid"><and>
              <equals arg1="${caller.bindings.before}" arg2="${caller.bindings.after}"/>
              <equals arg1="${caller.pass.actual}" arg2="M3_CALLER_SELECTED_PRODUCER_PASS&#10;mode=${m3.caller.mode}&#10;bindingsSha256=${caller.bindings.before}&#10;" trim="false" casesensitive="true"/>
            </and></condition>
            <fail unless="caller.pass.valid">Missing or mismatched selected-producer completion proof.</fail>
            <mkdir dir="${project.build.outputDirectory}"/>
            <path id="caller.metadata.classpath">
              <path refid="maven.runtime.classpath"/>
              <pathelement location="${m3.caller.recipeRoot}/resources"/>
            </path>
            <property name="caller.metadata.cp" refid="caller.metadata.classpath"/>
            <exec executable="${java.home}/bin/jshell" inputstring="" timeout="120000" failonerror="true" failifexecutionfails="true"
                  output="${m3.caller.outputRoot}/ledger.stdout.log" error="${m3.caller.outputRoot}/ledger.stderr.log">
              <arg value="-J-Xmx256m"/>
              <arg value="-R-Xmx256m"/>
              <arg value="-J-Duser.home=${m3.caller.outputRoot}/maven-controller/jshell-home"/>
              <arg value="-J-Djava.util.prefs.userRoot=${m3.caller.outputRoot}/maven-controller/jshell-home/prefs"/>
              <arg value="-J-Djava.util.prefs.systemRoot=${m3.caller.outputRoot}/maven-controller/jshell-home/system-prefs"/>
              <arg value="-J-Djava.io.tmpdir=${m3.caller.outputRoot}/maven-controller/tmp"/>
              <arg value="-R-Duser.home=${m3.caller.outputRoot}/maven-controller/jshell-home"/>
              <arg value="-R-Djava.util.prefs.userRoot=${m3.caller.outputRoot}/maven-controller/jshell-home/prefs"/>
              <arg value="-R-Djava.util.prefs.systemRoot=${m3.caller.outputRoot}/maven-controller/jshell-home/system-prefs"/>
              <arg value="-R-Djava.io.tmpdir=${m3.caller.outputRoot}/maven-controller/tmp"/>
              <arg value="-R-Dm3.caller.receiverRoot=${m3.caller.receiverRoot}"/>
              <arg value="-R-Dm3.caller.recipeRoot=${m3.caller.recipeRoot}"/>
              <arg value="-R-Dm3.caller.outputRoot=${m3.caller.outputRoot}"/>
              <arg value="-R-Dm3.caller.mode=${m3.caller.mode}"/>
              <arg value="--class-path"/><arg value="${caller.metadata.cp}"/>
              <arg value="--no-startup"/>
              <arg value="--feedback"/><arg value="silent"/>
              <arg value="--add-modules"/><arg value="jdk.compiler,jdk.jdeps"/>
              <arg value="${m3.caller.recipeRoot}/validation/generated-ledger.jsh"/>
            </exec>
            <checksum file="${m3.caller.recipeRoot}/resources/manifest-pins.tsv" algorithm="SHA-256" property="caller.manifest.pins.after"/>
            <loadfile property="caller.manifest.pass" srcFile="${m3.caller.outputRoot}/manifest/PASS.sentinel" encoding="UTF-8"/>
            <condition property="caller.manifest.valid"><and>
              <equals arg1="${caller.manifest.pins.before}" arg2="${caller.manifest.pins.after}"/>
              <equals arg1="${caller.manifest.pass}" arg2="M3_CALLER_GENERATED_LEDGER_PASS&#10;mode=${m3.caller.mode}&#10;manifestPinsSha256=${caller.manifest.pins.before}&#10;ledgerAfterSha256=1085e4679fb7624127d08d27bf62a07c5daeff7c0482e47c9b1cbd4072406a8e&#10;" trim="false" casesensitive="true"/>
            </and></condition>
            <fail unless="caller.manifest.valid">Missing or mismatched ledger completion proof.</fail>

          </target></configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
