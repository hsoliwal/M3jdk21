package @PKG@;

import java.util.Arrays;
import java.util.function.UnaryOperator;

/**
 * Item lanes of an M3 web widget model (pattern M3P-CORE-1, DOOP): flags, value, aux, group and
 * rect lanes are parallel int arrays indexed by item id; texts are the only objects. Every mutation
 * marks the item's rect as damage and fires one delta; nothing is repainted here.
 */
//FLLDCIM: DOOP — structure of arrays; objects only for text
public abstract class M3WebLanes implements M3WebApi {
	public static final int D_STATE = 1, D_VALUE = 2, D_TEXT = 4, D_LAYOUT = 8, D_THEME = 16, D_ANIM = 32, D_ITEMS = 64, D_ACTION = 128,
			D_LOAD = 256;
	protected final M3WebTheme theme = new M3WebTheme();
	protected int count, widgetFlags, width, height, variant, size = M3WebStates.SIZE_M, focus = -1, hover = -1, pressed = -1;
	protected int[] flags = new int[8], value = new int[8], aux = new int[8], group = new int[8], rects = new int[32];
	protected String[] text = new String[8], detail = new String[8];
	protected boolean rtl;
	private String[] keys;
	private int dx0 = Integer.MAX_VALUE, dy0 = Integer.MAX_VALUE, dx1 = Integer.MIN_VALUE, dy1 = Integer.MIN_VALUE, generation;
	private M3WebDelta delta;

	@Override
	public int add(String label) {
		return add(label, null);
	}

	@Override
	public int add(String label, String det) {
		if (count == flags.length) {
			grow(count * 2);
		}
		text[count] = label;
		detail[count] = det;
		flags[count] = value[count] = aux[count] = group[count] = 0;
		count++;
		relayout(count - 1, D_ITEMS);
		return count - 1;
	}

	protected void grow(int cap) {
		flags = Arrays.copyOf(flags, cap); value = Arrays.copyOf(value, cap); aux = Arrays.copyOf(aux, cap);
		group = Arrays.copyOf(group, cap); rects = Arrays.copyOf(rects, cap * 4);
		text = Arrays.copyOf(text, cap); detail = Arrays.copyOf(detail, cap);
		keys = keys == null ? null : Arrays.copyOf(keys, cap);
	}

	@Override
	public void remove(int item) {
		check(item);
		int tail = count - item - 1;
		for (int[] lane : new int[][] { flags, value, aux, group }) {
			System.arraycopy(lane, item + 1, lane, item, tail);
		}
		System.arraycopy(text, item + 1, text, item, tail);
		System.arraycopy(detail, item + 1, detail, item, tail);
		count--;
		focus = Math.min(focus, count - 1);
		relayout(item, D_ITEMS);
	}

	@Override
	public void clear() {
		count = 0;
		focus = hover = pressed = -1;
		relayout(-1, D_ITEMS);
	}

	@Override
	public int count() {
		return count;
	}

	@Override
	public String text(int item) {
		check(item);
		return text[item];
	}

	@Override
	public void setText(int item, String s) {
		check(item);
		text[item] = s;
		relayout(item, D_TEXT);
	}

	@Override
	public String detail(int item) {
		check(item);
		return detail[item];
	}

	@Override
	public void setDetail(int item, String s) {
		check(item);
		detail[item] = s;
		relayout(item, D_TEXT);
	}

	@Override
	public int value(int item) {
		check(item);
		return value[item];
	}

	@Override
	public void setValue(int item, int v) {
		check(item);
		value[item] = clampValue(item, v);
		relayout(item, D_VALUE);
	}

	/** Family hook: bounds a value before it is stored. */
	protected int clampValue(int item, int v) {
		return v;
	}

	@Override
	public int aux(int item) {
		check(item);
		return aux[item];
	}

	@Override
	public void setAux(int item, int v) {
		check(item);
		aux[item] = v;
		relayout(item, D_VALUE);
	}

	@Override
	public int group(int item) {
		check(item);
		return group[item];
	}

	@Override
	public void setGroup(int item, int g) {
		check(item);
		group[item] = g;
		relayout(item, D_LAYOUT);
	}

	@Override
	public boolean is(int item, int state) {
		return ((item < 0 ? widgetFlags : flags[checked(item)]) & state) != 0;
	}

	@Override
	public void setState(int item, int state, boolean on) {
		int old = item < 0 ? widgetFlags : flags[checked(item)];
		int now = on ? old | state : old & ~state;
		if (now == old) {
			return;
		}
		if (item < 0) {
			widgetFlags = now;
			damageAll();
		} else {
			flags[item] = now;
			damageItem(item);
		}
		fire(item, D_STATE);
	}

	@Override
	public void localize(UnaryOperator<String> translator) {
		if (keys == null) {
			keys = Arrays.copyOf(text, flags.length);
		}
		for (int i = 0; i < count; i++) {
			text[i] = keys[i] == null ? null : translator.apply(keys[i]);
		}
		relayout(-1, D_TEXT);
	}

	@Override
	public void setDelta(M3WebDelta d) {
		delta = d;
	}

	@Override
	public int generation() {
		return generation;
	}

	/** Fires one delta; the generation counts every change. */
	protected void fire(int item, int mask) {
		generation++;
		if (delta != null) {
			delta.changed(item, mask);
		}
	}

	/** Layout changed: recompute rects, damage everything, fire. */
	protected void relayout(int item, int mask) {
		layout(width, height);
		fire(item, mask);
	}

	protected void damage(int x, int y, int w, int h) {
		dx0 = Math.min(dx0, x); dy0 = Math.min(dy0, y);
		dx1 = Math.max(dx1, x + w); dy1 = Math.max(dy1, y + h);
	}

	protected void damageItem(int item) {
		int b = item * 4;
		damage(rects[b] - 3, rects[b + 1] - 3, rects[b + 2] + 6, rects[b + 3] + 6);
	}

	protected void damageAll() {
		damage(0, 0, width, height);
	}

	@Override
	public boolean takeDamage(int[] out) {
		if (dx0 > dx1 || dy0 > dy1) {
			return false;
		}
		out[0] = Math.max(0, dx0); out[1] = Math.max(0, dy0);
		out[2] = Math.min(width, dx1) - out[0]; out[3] = Math.min(height, dy1) - out[1];
		dx0 = dy0 = Integer.MAX_VALUE; dx1 = dy1 = Integer.MIN_VALUE;
		return true;
	}

	@Override
	public int itemRect(int item, int k) {
		return rects[checked(item) * 4 + k];
	}

	protected void setRect(int item, int x, int y, int w, int h) {
		int b = item * 4;
		rects[b] = x; rects[b + 1] = y; rects[b + 2] = w; rects[b + 3] = h;
	}

	protected final int checked(int item) {
		check(item);
		return item;
	}

	protected final void check(int item) {
		if (item < 0 || item >= count) {
			throw new IndexOutOfBoundsException("item " + item + " of " + count);
		}
	}

	/** Lanes as one array, header first, then flags, value, aux, group, rects and text hashes. */
	protected int[] lanes(int[] header) {
		int[] out = Arrays.copyOf(header, header.length + count * 9);
		int o = header.length;
		for (int i = 0; i < count; i++, o += 9) {
			out[o] = flags[i]; out[o + 1] = value[i]; out[o + 2] = aux[i]; out[o + 3] = group[i];
			System.arraycopy(rects, i * 4, out, o + 4, 4);
			out[o + 8] = (text[i] == null ? 0 : text[i].hashCode()) ^ (detail[i] == null ? 0 : detail[i].hashCode() * 31);
		}
		return out;
	}
}
