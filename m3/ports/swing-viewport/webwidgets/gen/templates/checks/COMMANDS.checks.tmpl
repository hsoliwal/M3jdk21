package @PKG@;

import static @PKG@.M3WebChecks.check;
import static @PKG@.M3WebStates.*;

/** Family contract of the grouped command buttons (pattern M3P-COMMANDS-1). */
public final class M3CommandsChecks {
	private M3CommandsChecks() {
	}

	public static void run(M3CommandsModel m) {
		sample(m);
		edges(m);
	}

	private static void sample(M3CommandsModel m) {
		m.layout(480, 160);
		M3WebPaint p = new M3WebPaint();
		m.setCaptions("Clipboard", "Font");
		m.setKind(m.count() - 1, M3CommandsModel.TOGGLE);
		m.setFocus(m.count() - 1);
		m.key(KEY_ENTER, 0, 0);
		check(m.is(m.count() - 1, CHECKED), "toggle command");
		m.paint(p);
		m.setRtl(true);
		m.paint(p);
		clickArrow(m, p);
		m.setRtl(false);
		clickArrow(m, p);
		m.setKind(0, M3CommandsModel.DROPDOWN);
		click(m, 0, 2);
		m.setKind(0, M3CommandsModel.PUSH);
		click(m, 0, 2);
		menuKeys(m, p);
	}

	private static void clickArrow(M3CommandsModel m, M3WebPaint p) {
		m.setKind(0, M3CommandsModel.SPLIT_KIND);
		int w = m.itemRect(0, 2), h = m.itemRect(0, 3);
		click(m, 0, m.isRtl() ? 2 : w - 2);
		check(m.isMenuOpen() || h == 0, "arrow opens the menu");
		m.paint(p);
		check(m.key(KEY_ESCAPE, 0, 0) && !m.isMenuOpen(), "escape closes the menu");
		click(m, 0, m.isRtl() ? w - 2 : 2);
		m.paint(p);
	}

	private static void click(M3CommandsModel m, int item, int dx) {
		int x = m.itemRect(item, 0) + dx, y = m.itemRect(item, 1) + 2;
		m.pointer(P_DOWN, x, y, 0);
		m.pointer(P_UP, x, y, 0);
	}

	private static void menuKeys(M3CommandsModel m, M3WebPaint p) {
		m.setMenuOpen(false);
		m.setFocus(0);
		boolean opened = m.key(KEY_DOWN, 0, 0);
		check(opened == (m.mode == M3CommandsModel.SPLIT), "down opens a split menu");
		m.paint(p);
		if (m.count() > 1 && m.isMenuOpen()) {
			m.key(KEY_ENTER, 0, 0);
			check(!m.isMenuOpen(), "choosing a menu item closes the menu");
		}
		m.setMenuOpen(false);
		check(!m.key(KEY_ESCAPE, 0, 0), "escape without a menu");
	}

	/** Edges: small third fields, toggle kinds by key, drop-down kinds by pointer (open and close), their paint. */
	private static void edges(M3CommandsModel m) {
		m.load("0~Paste~S;0~Cut~L;1~Bold");
		m.layout(360, 120);
		m.setKind(1, M3CommandsModel.TOGGLE);
		m.setKind(2, M3CommandsModel.DROPDOWN);
		M3WebPaint p = new M3WebPaint();
		m.setFocus(1);
		m.key(KEY_ENTER, 0, 0);
		check(m.is(1, CHECKED), "toggle kind checks");
		m.paint(p);
		m.key(KEY_ENTER, 0, 0);
		check(!m.is(1, CHECKED), "toggle kind unchecks");
		boolean open = m.isMenuOpen();
		M3WebChecks.clickItem(m, 2);
		m.paint(p);
		M3WebChecks.clickItem(m, 2);
		check(m.isMenuOpen() == open, "a drop-down kind toggles the menu");
	}
}
