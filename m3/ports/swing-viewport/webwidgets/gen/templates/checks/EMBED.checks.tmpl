package @PKG@;

import static @PKG@.M3WebChecks.check;
import static @PKG@.M3WebStates.*;

/** Family contract of the facades over real elements (pattern M3P-EMBED-1). */
public final class M3EmbedChecks {
	private M3EmbedChecks() {
	}

	public static void run(M3EmbedModel m) {
		m.layout(360, 240);
		M3WebPaint p = new M3WebPaint();
		m.paint(p);
		check(M3EmbedModel.clock(65).equals("1:05") && M3EmbedModel.clock(600).equals("10:00"), "clock");
		media(m, p);
		map(m, p);
		m.pointer(P_DOWN, 10, 10, 0);
		m.pointer(P_UP, 10, 10, 0);
		m.markdown("# Title\n## Sub\n- one\n* two\n```\ncode line\n```\n\nplain");
		check(m.count() == 6 && m.aux(0) == M3EmbedModel.HEADING && m.value(1) == 2 && m.aux(2) == M3EmbedModel.BULLET
				&& m.aux(4) == M3EmbedModel.CODE && m.aux(5) == M3EmbedModel.PARAGRAPH, "markdown blocks: " + m.count());
		m.layout(360, 240);
		m.setRtl(true);
		m.paint(p);
		m.setRtl(false);
		m.paint(p);
	}

	private static void media(M3EmbedModel m, M3WebPaint p) {
		m.load("clip.mp4~3");
		m.layout(360, 240);
		m.key(KEY_SPACE, 0, 0);
		check(m.mode != M3EmbedModel.VIDEO || m.isPlaying(), "space plays");
		for (int i = 0; i < 400 && m.tick(16); i++) {
			m.paint(p);
		}
		check(!m.isPlaying() && (m.mode != M3EmbedModel.VIDEO || m.aux(0) == 3), "plays to the end");
		m.key(KEY_LEFT, 0, 0);
		m.key(KEY_RIGHT, 0, 0);
		m.seek(-5);
		check(m.aux(0) == 0, "seek clamps");
		m.play(true);
		m.key(KEY_ENTER, 0, 0);
		m.paint(p);
		m.clear();
		m.play(true);
		m.seek(3);
		m.zoom(1);
		check(!m.isPlaying(), "nothing to play");
		m.paint(p);
	}

	private static void map(M3EmbedModel m, M3WebPaint p) {
		m.load("1,2~12");
		for (int k : new int[] { KEY_LEFT, KEY_RIGHT, KEY_UP, KEY_DOWN, KEY_PAGE_UP, KEY_PAGE_DOWN, KEY_HOME }) {
			m.key(k, 0, 0);
		}
		m.pointer(P_WHEEL, 0, -1, 0);
		m.zoom(99);
		check(m.value(0) == 20 || m.mode == M3EmbedModel.UPLOAD || m.mode == M3EmbedModel.MARKDOWN, "zoom clamps");
		m.pan(-1000, 7);
		m.paint(p);
		m.load("a.pdf~40;b.png~100");
		m.layout(360, 240);
		m.setState(-1, DRAGGING, true);
		m.paint(p);
		m.setState(-1, DRAGGING, false);
	}
}
