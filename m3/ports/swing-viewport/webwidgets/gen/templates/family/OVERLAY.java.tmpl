package @PKG@;

import static @PKG@.M3WebStates.*;

/**
 * Overlay planes (pattern M3P-OVERLAY-1): one plane anchored to an edge, a corner, a target rect or the
 * centre; an open bit and a slide phase; a modal backdrop; a focus trap; tour steps. The plane lives on
 * the OVERLAY plane: sliding moves the plane offset, so each frame damages only the plane's old and new
 * bounds, never the body. Members: drawer, bottom-sheet, sheet-dialog, fab, hover-card, tour, backdrop,
 * popover, toast, affix.
 */
public class M3OverlayModel extends M3WebModel implements M3OverlayApi {
	public static final int EDGE_START = 0, EDGE_END = 1, EDGE_TOP = 2, EDGE_BOTTOM = 3, CORNER_END = 4, TARGET = 5, TOUR = 6,
			BACKDROP = 7, STICKY = 8, TOAST = 9, CENTER = 10;
	private final int[] target = { 40, 40, 80, 24 };
	private int extent = 280, step;
	private boolean trap = true;

	public M3OverlayModel(String concept, int role, int mode, int shape, int variant) {
		super(concept, role, mode, shape, variant);
	}

	@Override
	public int aspects() {
		return A_D | A_P;
	}

	@Override
	public void load(String sample) {
		clear();
		for (String s : sample.split(";")) {
			String[] f = s.split("~", -1);
			add(f[0], f.length > 1 ? f[1] : null);
		}
		step = 0;
	}

	@Override
	public boolean isOpen() {
		return is(-1, OPEN);
	}

	@Override
	public void open() {
		if (!isOpen()) {
			setState(-1, OPEN, true);
			animate();
		}
	}

	@Override
	public void close() {
		if (isOpen()) {
			setState(-1, OPEN, false);
			animate();
		}
	}

	@Override
	public void setTarget(int x, int y, int w, int h) {
		target[0] = x; target[1] = y; target[2] = w; target[3] = h;
		relayout(-1, D_LAYOUT);
	}

	@Override
	public void setExtent(int px) {
		extent = Math.max(rowHeight(), px);
		relayout(-1, D_LAYOUT);
	}

	@Override
	public void setTrap(boolean on) {
		trap = on;
	}

	@Override
	public int step() {
		return step;
	}

	@Override
	public void setStep(int s) {
		step = Math.max(0, Math.min(count - 1, s));
		relayout(step, D_VALUE);
	}

	/** True for modes with a modal backdrop. */
	public boolean modal() {
		return mode <= EDGE_BOTTOM || mode == TOUR || mode == BACKDROP || mode == CENTER;
	}

	/** Floating modes stay painted while closed. */
	protected boolean persistent() {
		return mode == CORNER_END || mode == STICKY;
	}

	@Override
	protected void doLayout() {
		int[] r = planeRect();
		setPlane(OVERLAY, r[0], r[1], r[2], r[3]);
		for (int i = 0; i < count; i++) {
			boolean shown = mode != TOUR || i == step;
			setRect(i, r[0], r[1], shown ? r[2] : 0, shown ? r[3] : 0);
		}
		slide();
	}

	private int[] planeRect() {
		int e = Math.min(extent, Math.max(rowHeight(), mode == EDGE_START || mode == EDGE_END ? width : height));
		int r = rowHeight() * 3 / 2, w2 = Math.min(width, Math.max(extent, 160));
		switch (mode) {
		case EDGE_START: return new int[] { 0, 0, e, height };
		case EDGE_END: return new int[] { width - e, 0, e, height };
		case EDGE_TOP: return new int[] { 0, 0, width, e };
		case EDGE_BOTTOM: return new int[] { 0, height - e, width, e };
		case CORNER_END: case STICKY: return new int[] { width - r - pad(), height - r - pad(), r, r };
		case TOAST: return new int[] { width - w2 - pad(), height - 2 * rowHeight() - pad(), w2, 2 * rowHeight() };
		case TARGET: case TOUR: return new int[] { target[0], target[1] + target[3] + 8, w2, 3 * rowHeight() };
		case BACKDROP: return new int[] { 0, 0, width, height };
		default: return new int[] { (width - w2) / 2, (height - 3 * rowHeight()) / 2, w2, 3 * rowHeight() };
		}
	}

	/** Moves the plane to the slide phase: closed planes sit off their anchor edge. */
	private void slide() {
		int hidden = 1000 - phase;
		int dx = mode == EDGE_START ? -plane(OVERLAY, 2) * hidden / 1000 : mode == EDGE_END ? plane(OVERLAY, 2) * hidden / 1000 : 0;
		int dy = mode == EDGE_TOP ? -plane(OVERLAY, 3) * hidden / 1000 : mode == EDGE_BOTTOM || mode == TOAST ? plane(OVERLAY, 3) * hidden / 1000 : 0;
		if (rtl && (mode == EDGE_START || mode == EDGE_END)) {
			dx = -dx;
		}
		if (dx != plane(OVERLAY, 4) || dy != plane(OVERLAY, 5)) {
			movePlane(OVERLAY, dx, dy);
		}
	}

	@Override
	protected boolean advance(int ms) {
		phase = isOpen() ? Math.min(1000, phase + ms * 6) : Math.max(0, phase - ms * 6);
		slide();
		return isOpen() ? phase < 1000 : phase > 0;
	}

	@Override
	public boolean tick(int ms) {
		if (!animating) {
			return false;
		}
		animating = advance(ms);
		if (modal()) {
			damageAll();
		}
		fire(-1, D_ANIM);
		return animating;
	}

	@Override
	protected void emit(M3WebPaint p) {
		if (!persistent() && phase == 0 && !isOpen()) {
			return;
		}
		if (modal()) {
			p.rect(0, 0, width, height, M3WebTheme.mix(theme.slot(M3WebTheme.SHADOW), theme.slot(M3WebTheme.BG), phase * 35 / 1000));
		}
		if (mode == BACKDROP) {
			return;
		}
		p.translate(plane(OVERLAY, 4), plane(OVERLAY, 5));
		for (int i = 0; i < count; i++) {
			int b = i * 4;
			if (rects[b + 2] > 0) {
				panel(p, i, rects[b], rects[b + 1], rects[b + 2], rects[b + 3]);
			}
		}
		p.translate(0, 0);
	}

	private void panel(M3WebPaint p, int i, int x, int y, int w, int h) {
		p.round(x + 2, y + 4, w, h, radius(), theme.shadow());
		surface(p, i, x, y, w, h);
		if (mode == CORNER_END || mode == STICKY) {
			M3WebGlyphs.glyph(p, mode == STICKY ? M3WebGlyphs.I_UP : M3WebGlyphs.I_PLUS, x, y, w, theme.ink(variant, flags[i]));
			return;
		}
		label(p, i, text[i], x + pad(), y + pad() / 2, w - 2 * pad(), rowHeight(), M3WebPaint.BOLD);
		muted(p, detail[i], x + pad(), y + rowHeight(), w - 2 * pad(), rowHeight(), 0);
		if (mode == TOUR) {
			muted(p, (step + 1) + " / " + count, x + pad(), y + h - rowHeight(), w / 2, rowHeight(), 0);
			M3WebGlyphs.glyph(p, M3WebGlyphs.I_NEXT, x + w - rowHeight(), y + h - rowHeight(), rowHeight(), theme.slot(M3WebTheme.ACCENT));
		}
		if (mode == TARGET || mode == TOUR) {
			int ax = Math.max(x + 8, Math.min(x + w - 16, target[0] + target[2] / 2));
			p.poly(new int[] { ax - 6, y, ax, y - 7, ax + 6, y }, 0, 3, theme.line(variant, 0));
		}
	}

	@Override
	public void pointer(int kind, int x, int y, int mods) {
		if (kind == P_UP && pressed < 0 && hitTest(x, y) < 0 && isOpen() && modal()) {
			close();
			return;
		}
		super.pointer(kind, x, y, mods);
	}

	@Override
	protected void activate(int item) {
		if (mode == TOUR) {
			if (step == count - 1) {
				close();
			} else {
				setStep(step + 1);
			}
		} else if (mode == CORNER_END || mode == TARGET || mode == STICKY) {
			if (isOpen()) {
				close();
			} else {
				open();
			}
		}
		fire(item, D_ACTION);
	}

	@Override
	protected boolean onKey(int key, int ch, int mods) {
		if (key == KEY_TAB && trap && modal() && isOpen()) {
			return moveFocus((mods & MOD_SHIFT) != 0 ? -1 : 1) || focusFirst();
		}
		if (mode == TOUR && (key == KEY_LEFT || key == KEY_RIGHT)) {
			setStep(step + ((key == KEY_RIGHT) != rtl ? 1 : -1));
			return true;
		}
		return false;
	}

	private boolean focusFirst() {
		int first = nextEnabled(-1, 1);
		if (first >= 0) {
			setFocus(first);
		}
		return true;
	}

	@Override
	protected boolean onEscape() {
		boolean was = isOpen();
		close();
		return was;
	}
}
