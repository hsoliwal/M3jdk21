package @PKG@;

import static @PKG@.M3WebStates.*;

/**
 * Lane-driven animated values (pattern M3P-ANIMVALUE-1): skeleton rows with a moving shimmer band,
 * a spinner of eight dots (or a determinate arc when a value is set) and an eased transition. The
 * phase lane advances on the toolkit's frame clock only while the part is visible. Members: skeleton,
 * spinner-loading, transition-anim.
 */
public class M3AnimvalueModel extends M3WebModel implements M3AnimvalueApi {
	public static final int SKELETON = 0, SPINNER = 1, TRANSITION = 2;
	private static final int[] COS = { 1000, 707, 0, -707, -1000, -707, 0, 707 }, SIN = { 0, 707, 1000, 707, 0, -707, -1000, -707 };
	private int max = 100;
	private boolean forward = true;

	public M3AnimvalueModel(String concept, int role, int mode, int shape, int variant) {
		super(concept, role, mode, shape, variant);
	}

	@Override
	public int aspects() {
		return A_D;
	}

	@Override
	public void load(String sample) {
		clear();
		for (String s : sample.split(";")) {
			add(s);
		}
		if (mode != TRANSITION) {
			animate();
		}
	}

	@Override
	public void setMax(int m) {
		max = Math.max(1, m);
		relayout(-1, D_VALUE);
	}

	@Override
	public int max() {
		return max;
	}

	@Override
	public void setProgress(int v) {
		if (count > 0) {
			setValue(0, v);
		}
	}

	@Override
	protected int clampValue(int item, int v) {
		return Math.max(0, Math.min(max, v));
	}

	/** Ease-in-out cubic of the phase, 0..1000. */
	@Override
	public int eased() {
		long t = phase;
		return (int) (t < 500 ? 4 * t * t * t / 1_000_000 : 1000 - 4 * (1000 - t) * (1000 - t) * (1000 - t) / 1_000_000);
	}

	@Override
	public void play() {
		forward = !forward || phase == 0;
		animate();
	}

	@Override
	protected void doLayout() {
		int y = 0, r = rowHeight();
		for (int i = 0; i < count; i++) {
			int w = mode == SKELETON ? rowWidth(i) : mode == TRANSITION ? 2 * r : 2 * r + gap() + textWidth(text[i], font());
			int h = mode == SKELETON ? ("avatar".equals(text[i]) ? r : r / 2) : 2 * r;
			int x = mode == TRANSITION ? (Math.max(0, width - w)) * eased() / 1000 : 0;
			setRect(i, x, y, w, h);
			y += h + gap();
		}
	}

	private int rowWidth(int i) {
		if ("avatar".equals(text[i])) {
			return rowHeight();
		}
		return "title".equals(text[i]) ? width * 3 / 5 : i == count - 1 ? width * 4 / 5 : width;
	}

	@Override
	protected void emit(M3WebPaint p) {
		for (int i = 0; i < count; i++) {
			int b = i * 4;
			switch (mode) {
			case SKELETON: shimmer(p, rects[b], rects[b + 1], rects[b + 2], rects[b + 3]); break;
			case SPINNER: spinner(p, i, rects[b], rects[b + 1], rects[b + 3]); break;
			default: box(p, i, rects[b], rects[b + 1], rects[b + 2], rects[b + 3]);
			}
		}
	}

	private void shimmer(M3WebPaint p, int x, int y, int w, int h) {
		int base = M3WebTheme.mix(theme.slot(M3WebTheme.BORDER), theme.slot(M3WebTheme.SURFACE), 70);
		int hi = M3WebTheme.mix(theme.slot(M3WebTheme.SURFACE), base, 70);
		p.round(x, y, w, h, Math.min(h / 2, 6), base);
		int band = Math.max(8, w / 3), bx = x - band + (w + band) * phase / 1000;
		int l = Math.max(x, bx), m = Math.min(x + w, bx + band / 2), r = Math.min(x + w, bx + band);
		if (m > l) {
			p.gradient(l, y, m - l, h, base, hi);
		}
		if (r > Math.max(l, m)) {
			p.gradient(Math.max(l, m), y, r - Math.max(l, m), h, hi, base);
		}
	}

	private void spinner(M3WebPaint p, int i, int x, int y, int h) {
		int c = h / 2, rad = h * 2 / 5, d = Math.max(2, h / 8), accent = theme.slot(M3WebTheme.ACCENT);
		if (value[i] > 0) {
			p.ovalLine(x + c - rad, y + c - rad, 2 * rad, 2 * rad, theme.slot(M3WebTheme.BORDER));
			p.arc(x + c - rad, y + c - rad, 2 * rad, 2 * rad, 90, -value[i] * 360 / max, accent);
		} else {
			for (int k = 0; k < 8; k++) {
				int fade = Math.floorMod(k * 125 - phase, 1000) / 10;
				p.oval(x + c + COS[k] * rad / 1000 - d / 2, y + c - SIN[k] * rad / 1000 - d / 2, d, d,
						M3WebTheme.mix(accent, theme.slot(M3WebTheme.SURFACE), 100 - fade));
			}
		}
		label(p, i, text[i], x + h + gap(), y, Math.max(0, rects[i * 4 + 2] - h - gap()), h, 0);
	}

	private void box(M3WebPaint p, int i, int x, int y, int w, int h) {
		int e = eased();
		p.round(x, y, w, h, radius(), M3WebTheme.mix(theme.fill(V_PRIMARY, flags[i]), theme.slot(M3WebTheme.BG), 20 + e * 80 / 1000));
		p.text(x, y, w, h, 0xffffff, font() | M3WebPaint.CENTER, text[i]);
	}

	@Override
	protected void activate(int item) {
		if (mode == TRANSITION) {
			play();
		}
		fire(item, D_ACTION);
	}

	@Override
	protected boolean advance(int ms) {
		if (mode != TRANSITION) {
			return super.advance(ms);
		}
		phase = forward ? Math.min(1000, phase + ms * 4) : Math.max(0, phase - ms * 4);
		layout(width, height);
		return forward ? phase < 1000 : phase > 0;
	}
}
