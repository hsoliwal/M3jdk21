package @WPKG@.adapter;

import static @PKG@.M3WebChecks.check;

import org.eclipse.swt.SWT;
import org.eclipse.swt.widgets.Canvas;
import org.eclipse.swt.widgets.Combo;
import org.eclipse.swt.widgets.Composite;
import org.eclipse.swt.widgets.Label;
import org.eclipse.swt.widgets.Shell;
import org.eclipse.swt.widgets.Slider;
import org.eclipse.swt.widgets.Table;
import org.eclipse.swt.widgets.Tree;
import org.eclipse.swt.widgets.TreeItem;
import org.junit.Test;

/** Measure-kind edges of the SWT adapters (pattern M3P-ADAPTER-1) on the hidden test desktop: headers, top items, empty and hidden items, undeclared aspects. */
public class M3ViewportKinds_Test {
	@Test
	public void edges() {
		Shell shell = M3ViewportAdapterChecks.shell();
		try {
			rows(shell);
			bounded(shell);
			resolution(shell);
			quiet(shell);
		} finally {
			shell.dispose();
		}
	}

	private static void rows(Shell shell) {
		Table table = new Table(M3ViewportAdapterChecks.panel(shell), SWT.VIRTUAL);
		table.setHeaderVisible(true);
		table.setItemCount(100);
		Tree tree = new Tree(M3ViewportAdapterChecks.panel(shell), SWT.NONE);
		tree.setHeaderVisible(true);
		for (int i = 0; i < 30; i++) {
			new TreeItem(tree, SWT.NONE).setText("node " + i);
		}
		tree.setTopItem(tree.getItem(3));
		shell.layout(true, true);
		int[] out = new int[4];
		M3ViewportKind.TABLE.rect(table, table, 99, out);
		check(M3ViewportKind.TABLE.viewport(table, table) >= 0 && out[3] == 0, "a row below the window has no box");
		check(M3ViewportKind.TREE.first(tree, tree) >= 0 && M3ViewportKind.TREE.viewport(tree, tree) >= 0, "tree top item and header");
		Slider slider = new Slider(M3ViewportAdapterChecks.panel(shell), SWT.HORIZONTAL);
		M3ViewportKind.RANGE.rect(slider, slider, 10_000, out);
		check(M3ViewportKind.RANGE.count(slider, slider) > 1 && out[2] == 0, "slider positions; a position past the end has no box");
		Combo combo = M3ViewportFills.fill(new Combo(M3ViewportAdapterChecks.panel(shell), SWT.DROP_DOWN), "strings");
		M3ViewportKind.COMBO.rect(combo, combo, 10_000, out);
		check(out[2] == 0, "a drop-down row past the end has no box");
	}

	private static void bounded(Shell shell) {
		Composite empty = M3ViewportAdapterChecks.panel(shell);
		check(M3ViewportKind.CHILDREN.extent(empty, empty) >= 1 && M3ViewportKind.CHILDREN.visible(empty, empty) == 0, "no children");
		Composite kids = M3ViewportAdapterChecks.panel(shell);
		kids.setLayout(null);
		new Label(kids, SWT.NONE).setBounds(0, 0, 0, 10);
		new Label(kids, SWT.NONE).setBounds(0, 0, 10, 0);
		new Label(kids, SWT.NONE).setBounds(5000, 5000, 10, 10);
		check(M3ViewportKind.CHILDREN.first(kids, kids) == 0 && M3ViewportKind.CHILDREN.visible(kids, kids) == 0, "zero-size and outside children are not shown");
		try {
			M3ViewportKind.SURFACE.bounds(kids, kids, 0);
			check(false, "one-item kinds have no item bounds");
		} catch (UnsupportedOperationException expected) {
			// SURFACE and PLANE answer with the host area instead
		}
	}

	private static void resolution(Shell shell) {
		Canvas plain = new Canvas(M3ViewportAdapterChecks.panel(shell), SWT.NONE);
		check(M3ViewportKind.of(plain) == M3ViewportKind.SURFACE && M3ViewportKind.SCROLL.count(plain, plain) == 0
				&& M3ViewportKind.SCROLL.first(plain, plain) == 0 && M3ViewportKind.SCROLL.extent(plain, plain) >= 1, "no bar: SURFACE, SCROLL reads nothing");
		Canvas idle = new Canvas(M3ViewportAdapterChecks.panel(shell), SWT.V_SCROLL);
		idle.getVerticalBar().setValues(0, 0, 10, 10, 1, 10);
		check(M3ViewportKind.of(idle) == M3ViewportKind.SURFACE, "a bar without range does not scroll");
		Label label = new Label(M3ViewportAdapterChecks.panel(shell), SWT.NONE);
		Tree empty = new Tree(M3ViewportAdapterChecks.panel(shell), SWT.NONE);
		check(M3ViewportKind.of(label) == M3ViewportKind.SURFACE && M3ViewportKind.TREE.first(empty, empty) == 0, "a plain control is one surface; an empty tree starts at 0");
	}

	private static void quiet(Shell shell) {
		Composite host = M3ViewportAdapterChecks.panel(shell);
		M3ViewportAdapter a = new M3ViewportAdapter(host, host, M3ViewportKind.SURFACE, M3ViewportAdapter.R);
		check(a.attach() && !a.itemChanged(0) && !a.movePlane(0, 0, 4, 4) && a.redraws() == 0, "undeclared D and P stay quiet");
		a.detach();
	}
}
