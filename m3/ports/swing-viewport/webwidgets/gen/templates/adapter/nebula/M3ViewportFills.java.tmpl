package @WPKG@.adapter;

import java.util.Arrays;

import org.eclipse.swt.SWT;
import org.eclipse.swt.custom.CTabFolder;
import org.eclipse.swt.custom.CTabItem;
import org.eclipse.swt.custom.ScrolledComposite;
import org.eclipse.swt.custom.StyledText;
import org.eclipse.swt.layout.GridLayout;
import org.eclipse.swt.widgets.Combo;
import org.eclipse.swt.widgets.Composite;
import org.eclipse.swt.widgets.Control;
import org.eclipse.swt.widgets.ExpandBar;
import org.eclipse.swt.widgets.ExpandItem;
import org.eclipse.swt.widgets.Label;
import org.eclipse.swt.widgets.List;
import org.eclipse.swt.widgets.Menu;
import org.eclipse.swt.widgets.MenuItem;
import org.eclipse.swt.widgets.ProgressBar;
import org.eclipse.swt.widgets.Scale;
import org.eclipse.swt.widgets.Spinner;
import org.eclipse.swt.widgets.Table;
import org.eclipse.swt.widgets.Text;
import org.eclipse.swt.widgets.ToolBar;
import org.eclipse.swt.widgets.ToolItem;
import org.eclipse.swt.widgets.Tree;

/** Item fills of the adapter tests (spec/ADAPTERS.tsv fill column): rows, lines, values, tabs, tools, sections, children. */
public final class M3ViewportFills {
	private M3ViewportFills() {
	}

	/** Fills a created widget with items of the given kind (spec/ADAPTERS.tsv fill column). */
	public static <W> W fill(W w, String kind) {
		switch (kind) {
		case "count": count(w); break;
		case "strings": strings(w); break;
		case "lines": lines(w); break;
		case "range": range(w); break;
		case "tabs": tabs((CTabFolder) w); break;
		case "tools": tools((ToolBar) w); break;
		case "expand": expand((ExpandBar) w); break;
		case "menu": menu((Menu) w); break;
		case "scrolled": scrolled((ScrolledComposite) w); break;
		case "children": case "tablist": children((Composite) w, kind.equals("tablist")); break;
		default: break;
		}
		return w;
	}

	private static void count(Object w) {
		if (w instanceof Table t) {
			t.setItemCount(10_000);
		} else {
			((Tree) w).setItemCount(10_000);
		}
	}

	private static void strings(Object w) {
		String[] items = new String[200];
		Arrays.setAll(items, i -> "item " + i);
		if (w instanceof List l) {
			l.setItems(items);
		} else {
			((Combo) w).setItems(items);
		}
	}

	private static void lines(Object w) {
		StringBuilder b = new StringBuilder();
		for (int i = 0; i < 200; i++) {
			b.append("line ").append(i).append('\n');
		}
		if (w instanceof Text t) {
			t.setText(b.toString());
		} else {
			((StyledText) w).setText(b.toString());
		}
	}

	private static void range(Object w) {
		if (w instanceof Scale s) {
			s.setMaximum(1000);
			s.setSelection(500);
		} else if (w instanceof Spinner s) {
			s.setValues(500, 0, 1000, 0, 1, 10);
		} else {
			((ProgressBar) w).setMaximum(1000);
			((ProgressBar) w).setSelection(500);
		}
	}

	private static void tabs(CTabFolder f) {
		for (int i = 0; i < 30; i++) {
			new CTabItem(f, SWT.NONE).setText("tab " + i);
		}
		f.setSelection(0);
	}

	private static void tools(ToolBar t) {
		for (int i = 0; i < 40; i++) {
			new ToolItem(t, SWT.PUSH).setText("tool " + i);
		}
	}

	private static void expand(ExpandBar bar) {
		for (int i = 0; i < 12; i++) {
			ExpandItem item = new ExpandItem(bar, SWT.NONE);
			item.setText("section " + i);
			item.setControl(new Label(bar, SWT.NONE));
			item.setHeight(40);
		}
	}

	private static void menu(Menu m) {
		for (int i = 0; i < 12; i++) {
			new MenuItem(m, SWT.PUSH).setText("command " + i);
		}
	}

	private static void scrolled(ScrolledComposite s) {
		Composite content = new Composite(s, SWT.NONE);
		content.setSize(340, 5000);
		s.setContent(content);
		s.setMinSize(340, 5000);
		s.setExpandHorizontal(true);
	}

	static void children(Composite c, boolean tabList) {
		Control[] kids = new Control[24];
		for (int i = 0; i < kids.length; i++) {
			kids[i] = new Label(c, SWT.NONE);
			((Label) kids[i]).setText("child " + i);
		}
		if (c.getLayout() == null) {
			c.setLayout(new GridLayout(1, false));
		}
		if (tabList) {
			c.setTabList(kids);
		}
	}

}
