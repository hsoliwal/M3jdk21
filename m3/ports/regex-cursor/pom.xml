<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId>
  <artifactId>m3-regex-cursor</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>M3JDK :: Regex Cursor Port</name>
  <description>Regex over M3 strings and token-id lanes through a chunk cursor (pattern port of
    helix-editor/regex-cursor): precompute and literal gates, lazy DFA, PikeVM, stock
    java.util.regex as oracle and last-resort engine. No java.base change.</description>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- CI without the vendored universe may pass -Djunit.artifact.version=5.10.2 -->
    <junit.artifact.version>5.10.2-m3-source-1</junit.artifact.version>
    <jacoco.version>0.8.12</jacoco.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.artifact.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <proc>none</proc>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <argLine>-Xmx1g @{argLine}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>test</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.99</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>m3-recipe-boot</id>
      <activation>
        <file>
          <exists>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</exists>
        </file>
      </activation>
      <properties>
        <m3.recipe.boot.skip>false</m3.recipe.boot.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <inherited>true</inherited>
            <dependencies>
              <dependency>
                <groupId>com.synexia.m3</groupId>
                <artifactId>m3-pr-stack-preservation</artifactId>
                <version>1.0.0-m3boot20261021</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>m3-recipe-boot</id>
                <phase>validate</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <skip>${m3.recipe.boot.skip}</skip>
                  <mainClass>com.synexia.m3.prstack.M3RecipeBoot</mainClass>
                  <includeProjectDependencies>false</includeProjectDependencies>
                  <includePluginDependencies>true</includePluginDependencies>
                  <arguments>
                    <argument>${maven.multiModuleProjectDirectory}/.m3/recipe-boot.properties</argument>
                    <argument>${project.basedir}</argument>
                    <argument>${session.projects[0].basedir.absolutePath}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
