<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId><artifactId>m3-jfx-viewport</artifactId><version>0.1.0-SNAPSHOT</version>
  <name>M3JDK21 optional JavaFX viewport adapter</name>
  <description>Opt-in JavaFX 21 adapter to the existing indexed M3 Swing viewport kernel.</description>
  <properties><maven.compiler.release>21</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
    <dependency><groupId>com.m3</groupId><artifactId>m3-swing-viewport</artifactId><version>0.1.0-SNAPSHOT</version></dependency>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>21.0.8</version></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
      <configuration><release>21</release><compilerArgs><arg>-Xlint:all,-module,-serial,-this-escape</arg><arg>-Werror</arg></compilerArgs></configuration>
    </plugin>
  </plugins></build>
</project>
