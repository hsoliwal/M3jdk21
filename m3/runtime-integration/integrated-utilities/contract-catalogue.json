  "categories": [
    {
      "category": "IO/byte-and-character-transfer",
      "owner": "java.io.IOUtils",
      "algorithms": [
        "existing transferTo dispatch",
        "bounded buffer loop",
        "short-read accumulation",
        "exact skip with scalar progress fallback",
        "Arrays.mismatch"
      ],
      "selection": "Retain specialized JDK transfer dispatch for unbounded copies; use bounded primitive arrays only when a range limit or cross-stream comparison requires it. Reuse existing skipNBytes and String encoding/decoding owners.",
      "complexity": "O(n) element processing; bounded copy at most 8192 scratch elements, equality two 8192-element buffers; full-read caller array is reused; decoding/encoding deliberately materializes O(n) data.",
      "alternatives": [
        {
          "candidate": "InputStream.transferTo and Reader.transferTo",
          "disposition": "REUSE",
          "reason": "Canonical owner preserves optimized subclass dispatch; it does not itself expose bounded range transfer."
        },
        {
          "candidate": "Apache Commons IO API family",
          "disposition": "EVIDENCE_ONLY",
          "reason": "Conventional naming and resource/transfer problem categories only; no Apache implementation text copied into GPL product sources."
        },
        {
          "candidate": "single-element loops for complete copy/comparison",
          "disposition": "REJECT",
          "reason": "Unnecessary per-element virtual calls; preserve bounded buffering and intrinsic-capable Arrays.mismatch."
        }
      ],
      "public_operation_count": 16
    },
    {
      "category": "STREAMS/source-adaptation-and-pairing",
      "owner": "java.util.stream.Streams",
      "algorithms": [
        "existing source spliterators",
        "Spliterators unknown-size iterator batching",
        "Enumeration.asIterator",
        "unsplittable pair traversal",
        "existing composedClose"
      ],
      "selection": "Extend the pre-existing Streams owner in place. Preserve iterable metadata; keep zip serial at the source so stateful one-shot input traversal has a simple bounded contract, with close exception composition reused exactly.",
      "complexity": "Iterable factory O(1) except source spliterator construction; iterator adaptation O(1) persistent utility state with existing optional parallel batching; zip O(min(n,m)) pairing and O(1) persistent pairing state.",
      "alternatives": [
        {
          "candidate": "existing StreamSupport, Spliterators, and Streams.composedClose",
          "disposition": "REUSE",
          "reason": "Already own pipeline construction, source adaptation, and close failure semantics."
        },
        {
          "candidate": "parallel splitting zip with independently indexed inputs",
          "disposition": "PENDING",
          "reason": "Requires additional split-boundary, resource, and unsized-input evidence; not needed for the stated serial pair contract."
        },
        {
          "candidate": "Guava Streams utility family",
          "disposition": "EVIDENCE_ONLY",
          "reason": "Public shape reference only; no Apache implementation text copied."
        }
      ],
      "public_operation_count": 6
    },
    {
      "category": "REFLECTION/type-and-metadata-inspection",
      "owner": "java.lang.reflect.Reflection",
      "algorithms": [
        "lazy superclass iteration",
        "breadth-first interface closure",
        "identity cycle detection",
        "bounded iterative generic-array resolution",
        "existing annotation/executable accessors"
      ],
      "selection": "Reuse Class and reflection metadata owners without changing access state. Resolve only concrete raw types, retain unresolved Type evidence, and bound generic-array traversal by the JVM array dimension limit.",
      "complexity": "Hierarchy O(h) lazy traversal; interface closure O(V+E) traversal and O(V+E) temporary queue/snapshot storage; raw generic-array resolution O(d) with d <= 255 and identity-cycle detection; metadata streams retain existing owner snapshots.",
      "alternatives": [
        {
          "candidate": "Class, AnnotatedElement, ParameterizedType, Executable APIs",
          "disposition": "REUSE",
          "reason": "Canonical type identity, annotation presence, generic signatures, and resolution exceptions remain authoritative."
        },
        {
          "candidate": "naive Method.invoke / getDeclared* bootstrap utility wrappers",
          "disposition": "REJECT",
          "reason": "Caller-sensitive behavior could replace the original caller with java.base; a separate proven caller-context forwarding atom is required."
        },
        {
          "candidate": "Spring/Commons reflection utilities",
          "disposition": "EVIDENCE_ONLY",
          "reason": "Problem taxonomy only; their access-enabling or exception-translation policies are not imported."
        }
      ],
      "public_operation_count": 12
    },
    {
      "category": "STRINGS/documentation-contract",
      "owner": "java.util.Strings.isNullOrBlank",
      "algorithms": [
        "unchanged Character.isWhitespace code-point traversal"
      ],
      "selection": "Correct the misleading Javadoc from no-whitespace to all-whitespace; keep the source method body byte-for-byte unchanged.",
      "complexity": "No implementation or resource change.",
      "public_operation_count": 0
    }
  ],
