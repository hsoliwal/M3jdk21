+                        binaryNameIds,
+                        simpleNameIds,
+                        canonicalNameIds,
+                        packageNameIds,
+                        moduleNameIds,
+                        typeNameIds,
+                        modifiers,
+                        flags,
+                        superclassRows,
+                        componentTypeRows,
+                        nestHostRows,
+                        declaringClassRows,
+                        enclosingClassRows,
+                        structuralHashes,
