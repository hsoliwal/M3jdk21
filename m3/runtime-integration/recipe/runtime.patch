+            int utf8Length,
+            int codePointCount,
+            int unpairedSurrogateCount,
+            int javaHash,
+            int hash31Power,
+            char firstUtf16Unit,
+            char lastUtf16Unit,
+            long bitSignal64,
+            boolean ascii,
+            boolean latin1,
+            int asciiUpperHash,
+            int asciiLowerHash,
+            int asciiTitleHash,
+            long prefix4,
+            long suffix4,
+            long bigramSignal64,
+            long trigramSignal64,
+            int trimStart,
+            int trimEnd,
+            int stripStart,
+            int stripEnd) {
