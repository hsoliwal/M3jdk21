+                            interfaceOffsets,
+                            interfaceRows,
+                            classAnnotationOffsets,
+                            classAnnotationNameIds,
+                            permittedOffsets,
+                            permittedNameIds,
+                            memberOffsets,
+                            memberKinds,
+                            memberNameIds,
+                            memberDescriptorIds,
+                            memberModifiers,
