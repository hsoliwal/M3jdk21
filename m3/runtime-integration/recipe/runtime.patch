+  const jbyte kind = storage_kind(storage);
+  if (kind == LOCAL) {
+    typeArrayOop value = local_value(storage);
+    if (coder(storage) == java_lang_String::CODER_LATIN1) {
+      return ((jchar)value->byte_at(index)) & 0xff;
