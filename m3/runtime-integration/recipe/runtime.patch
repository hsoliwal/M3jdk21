+        for (int row = 0; row < size(); row++) {
+            if (declaringClassRows[row] == checked) result[output++] = row;
+        }
+        return result;
+    }
+
+    public int[] nestMemberRows(int classRow) {
+        int checked = checkClassRow(classRow);
