+    final int asciiUpperHash;
+    final int asciiLowerHash;
+    final int asciiTitleHash;
+    /** First four UTF-16 units, left aligned. */
+    final long prefix4;
+    /** Last four UTF-16 units, right aligned. */
+    final long suffix4;
+    final long bigramSignal64;
+    final long trigramSignal64;
