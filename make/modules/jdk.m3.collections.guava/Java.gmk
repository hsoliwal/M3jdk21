# jdk.m3.collections.guava: Guava 33.4.8 under the JDK's own package names (src/jdk.m3.collections.guava/share/legal/guava.md).
# The same settings as jdk.m3.collections: the module name's "m3" component is the one lint kind disabled.

DISABLED_WARNINGS_java += module

# Doclint as java.base runs it, without the "missing" group (the Javadoc is Guava's).
DOCLINT += -Xdoclint:all/protected,-missing
