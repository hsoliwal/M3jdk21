<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.m3</groupId>
  <artifactId>m3-intern</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>M3JDK :: Intern Space</name>
  <description>jdk.internal.m3.intern (module org.m3jdk.intern): the owner-scoped primitive intern space M3InternSpace (ByteStore,
    TupleStore, GraphStore over 64-KiB byte and 8,192-long pages, page-bounded Arrays.mismatch collision checks, the
    deterministic insertion-order archive with magic M3IS version 1), the typed structural shapes M3InternShapes, the
    prefix-sharing lexical path trie M3InternPathTrie and the bounded SHA-256 archive container M3InternArchiveGuard.
    Pure Java 21, java.base only. Relocated by recipe (recipe/intern-space-20261106/relocate.py with RELOCATION_MAP.tsv
    and PROVENANCE.tsv) from the first-party donor at develop fd9a233680b4 (2026-11-06); the seven donor proofs run in
    the test phase. The typed, bit-exact canonical literal pool M3CanonicalLiteralPool (nine named kinds as CONSTANT
    tuples of one space; a pool only, never a JVM constant-pool or ldc replacement) is relocated the same way by
    recipe/canonical-literals-20261106 from develop b259ec9f5606; its ten donor JUnit tests run in the test phase. The class-space family (M3ClassSpace: owner-scoped, budgeted,
    failure-atomic exact-byte store of immutable classfile-byte candidates with a SHA-256 lane; M3ClassSpaceArchive:
    the immutable M3CSIMG1 archive with per-entry and root SHA-256, mapped and pinned views; M3ClassFileAtoms: the
    read-only constant-pool scanner; never a class loader, Klass table or CDS archive) is relocated the same way by
    recipe/class-space-20261107 from develop d5ad5090d87e; its donor oracles run in the test phase.</description>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.artifact.version>5.11.4</junit.artifact.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.artifact.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- MOVE_TO_JDK_MODULE v1.1 (keep-pom mode, make/m3/tooling/jdk-naming/move_area.py): the sources live in
           java.base (jdk.internal.m3.intern) and the tests in test/jdk; this pom keeps its own configuration. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>jdk-module-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../../../src/java.base/share/classes/jdk/internal/m3/intern</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>jdk-module-test-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../../../test/jdk/jdk/internal/m3/intern</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <proc>none</proc>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs combine.children="append">
                <!-- test scope only (class-space oracles): javax.tools in-memory javac fixtures (java.compiler) and the
                     allocation probe's com.sun.management.ThreadMXBean (jdk.management); the product descriptor
                     requires neither -->
                <arg>--add-modules</arg>
                <arg>java.compiler,jdk.management</arg>
                <arg>--add-reads</arg>
                <arg>org.m3jdk.intern=java.compiler,jdk.management</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <!-- the proofs reach the private arenas through reflection: classpath run, the descriptor is for consumers -->
          <useModulePath>false</useModulePath>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
    </plugins>
  </build>
</project>
