## Every member row of the view kind (each): the annotation type names read through view(member).${atom}(k) for
## k < annotationCount() equal ReflectOracle.annotationNames of the reflective element.
each((member, d) -> {
    TreeSet<String> got = new TreeSet<>();
    for (int k = 0; k < view(member).annotationCount(); k++) got.add(view(member).${atom}(k));
    assertEquals(ReflectOracle.annotationNames(d.element()), got);
});
