@atom M3CI.reverseHierarchy 1 SCENARIO java.util.TreeSet(reverse-edges)
setup <<<
MethodHandle atom = st("reverseHierarchy", MethodType.methodType(int[][].class, int.class, int[].class, int[][].class));
SplittableRandom random = M3AtomKit.random("reverseHierarchy");
>>>
check <<<
for (int c = 0; c < M3AtomKit.CASES; c++) {
    int[] supers = random.ints(MODEL_ROWS, -1, MODEL_ROWS).toArray();
    int[][] interfaces = new int[MODEL_ROWS][];
    for (int r = 0; r < MODEL_ROWS; r++) {
        int superRow = supers[r];
        interfaces[r] = Arrays.stream(randomRows(random, MODEL_ROWS)).filter(i -> i != superRow).toArray();
    }
    int[][] got = (int[][]) atom.invoke(MODEL_ROWS, supers, interfaces);
    for (int t = 0; t < MODEL_ROWS; t++) {
        TreeSet<Integer> expected = new TreeSet<>();
        for (int r = 0; r < MODEL_ROWS; r++) {
            if (supers[r] == t) expected.add(r);
            for (int i : interfaces[r]) if (i == t) expected.add(r);
        }
        assertArrayEquals(expected.stream().mapToInt(Integer::intValue).toArray(), got[t]);
    }
}
>>>

@atom M3CI.transitiveSupertypes 1 SCENARIO fixed-point-closure
setup <<<
MethodHandle atom = st("transitiveSupertypes", MethodType.methodType(int[][].class, int.class, int[].class, int[][].class, int[].class, int.class));
SplittableRandom random = M3AtomKit.random("transitiveSupertypes");
>>>
check <<<
for (int c = 0; c < M3AtomKit.CASES; c++) {
    int[] supers = new int[MODEL_ROWS];
    int[][] interfaces = new int[MODEL_ROWS][];
    int[] flags = new int[MODEL_ROWS];
    for (int r = 0; r < MODEL_ROWS; r++) {
        supers[r] = r == 0 ? -1 : random.nextInt(-1, r);
        interfaces[r] = r == 0 ? new int[0] : randomRows(random, r);
        flags[r] = random.nextInt(INTERFACE_ODDS) == 0 ? jdk.internal.mindex.M3ClassFlags.INTERFACE : 0;
    }
    int[][] got = (int[][]) atom.invoke(MODEL_ROWS, supers, interfaces, flags, 0);
    for (int r = 0; r < MODEL_ROWS; r++) {
        TreeSet<Integer> closure = new TreeSet<>(List.of(r));
        if (flags[r] != 0) closure.add(0);
        boolean changed = true;
        while (changed) {
            changed = false;
            for (int x : new ArrayList<>(closure)) {
                if (supers[x] >= 0) changed |= closure.add(supers[x]);
                for (int i : interfaces[x]) changed |= closure.add(i);
            }
        }
        assertArrayEquals(closure.stream().mapToInt(Integer::intValue).toArray(), got[r], "row " + r);
    }
}
>>>

@atom M3CI.buildNameIndex 1 SCENARIO java.util.TreeMap(grouped-rows)
setup <<<
MethodHandle atom = st("buildNameIndex", MethodType.methodType(NAME_INDEX, int[].class));
MethodHandle keys = M3AtomKit.findVirtual(NAME_INDEX, "keys", MethodType.methodType(int[].class));
MethodHandle offsets = M3AtomKit.findVirtual(NAME_INDEX, "offsets", MethodType.methodType(int[].class));
MethodHandle rows = M3AtomKit.findVirtual(NAME_INDEX, "rows", MethodType.methodType(int[].class));
int[] ids = M3AtomKit.random("buildNameIndex").ints(MODEL_ROWS, 0, MODEL_ROWS / ROWS_PER_NAME).toArray();
>>>
check <<<
Object index = atom.invoke(ids);
TreeMap<Integer, List<Integer>> model = new TreeMap<>();
for (int r = 0; r < ids.length; r++) model.computeIfAbsent(ids[r], k -> new ArrayList<>()).add(r);
int[] k = (int[]) keys.invoke(index), o = (int[]) offsets.invoke(index), rs = (int[]) rows.invoke(index);
assertArrayEquals(model.keySet().stream().mapToInt(Integer::intValue).toArray(), k);
int at = 0;
for (List<Integer> group : model.values()) {
    assertEquals(group, Arrays.stream(Arrays.copyOfRange(rs, o[at], o[at + 1])).boxed().toList());
    at++;
}
assertEquals(ids.length, o[o.length - 1]);
>>>

@atom M3CI.classHash 1 SCENARIO producer-of-structuralHash64
setup <<<
Method atom = Arrays.stream(OWNER.getDeclaredMethods()).filter(m -> m.getName().equals("classHash")).findFirst().orElseThrow();
atom.setAccessible(true);
String[] lanes = {"loaderSpaces", "binaryNameIds", "simpleNameIds", "canonicalNameIds", "packageNameIds", "moduleNameIds",
        "typeNameIds", "modifiers", "flags", "superclassRows", "componentTypeRows", "nestHostRows", "declaringClassRows",
        "enclosingClassRows", "interfaceOffsets", "interfaceRows", "classAnnotationOffsets", "classAnnotationNameIds",
        "permittedOffsets", "permittedNameIds", "memberOffsets"};
String[] memberLanes = {"memberNameIds", "memberDescriptorIds", "memberModifiers", "memberFlags"};
>>>
check <<<
for (int row = 0; row < CI.size(); row++) {
    Object[] args = new Object[atom.getParameterCount()];
    args[0] = row;
    for (int k = 0; k < lanes.length; k++) args[k + 1] = lane(lanes[k]);
    int at = lanes.length + 1;
    args[at++] = M3AtomKit.findGetter(OWNER, "memberKinds", byte[].class).invoke(CI);
    for (String name : memberLanes) args[at++] = lane(name);
    assertEquals(CI.structuralHash64(row), (long) atom.invoke(null, args), CLASSES[row].getName());
}
>>>

