extra = assertEquals("int[][]", CI.typeName(row(int[][].class)));

@atom M3CI.flags 1 CI_ROW_DIFF java.lang.Class.isXxx
expected = ReflectOracle.classFlags(CLASSES[row])
label = , CLASSES[row].getName()

@atom M3CI.superclassRow 1 CI_ROW_DIFF java.lang.Class.getSuperclass
expected = row(CLASSES[row].getSuperclass())
extra = assertEquals(-1, CI.superclassRow(row(Object.class)));

@atom M3CI.componentTypeRow 1 CI_ROW_DIFF java.lang.Class.getComponentType
expected = row(CLASSES[row].getComponentType())
extra = assertEquals(row(int[].class), CI.componentTypeRow(row(int[][].class)));

@atom M3CI.nestHostRow 1 CI_ROW_DIFF java.lang.Class.getNestHost
expected = row(CLASSES[row].getNestHost())
extra = assertEquals(row(ReflectOracle.class), CI.nestHostRow(row(ReflectOracle.Derived.Inner.class)));

@atom M3CI.declaringClassRow 1 CI_ROW_DIFF java.lang.Class.getDeclaringClass
expected = row(CLASSES[row].getDeclaringClass())

@atom M3CI.enclosingClassRow 1 CI_ROW_DIFF java.lang.Class.getEnclosingClass
expected = row(CLASSES[row].getEnclosingClass())
extra = assertEquals(row(ReflectOracle.class), CI.enclosingClassRow(row(ReflectOracle.local())), "local class encloses in its method's class");

@atom M3CI.structuralHash64 1 SCENARIO deterministic+distinct
setup <<<
M3CI again = ReflectOracle.snapshot();
Set<Long> distinct = new HashSet<>();
>>>
check <<<
for (int row = 0; row < CI.size(); row++) {
    assertEquals(CI.structuralHash64(row), again.structuralHash64(row), "deterministic for " + CLASSES[row].getName());
    distinct.add(CI.structuralHash64(row));
}
assertEquals(CI.size(), distinct.size(), "no two rows share a structural hash");
>>>

@atom M3CI.interfaceCount 1 CI_ROW_DIFF java.lang.Class.getInterfaces
expected = CLASSES[row].getInterfaces().length

@atom M3CI.interfaceRow 1 SCENARIO java.lang.Class.getInterfaces(order)
check <<<
for (int row = 0; row < CI.size(); row++) {
    Class<?>[] interfaces = CLASSES[row].getInterfaces();
    for (int k = 0; k < interfaces.length; k++) assertEquals(row(interfaces[k]), CI.interfaceRow(row, k), "declaration order");
    int r = row;
    M3AtomKit.expect(IndexOutOfBoundsException.class, () -> CI.interfaceRow(r, interfaces.length));
}
>>>

@atom M3CI.directSubtypeCount 1 CI_ROW_DIFF reverse-of-getSuperclass+getInterfaces
setup <<<
int[] expected = new int[CI.size()];
for (Class<?> c : CLASSES) {
    if (ROWS.containsKey(c.getSuperclass())) expected[row(c.getSuperclass())]++;
    for (Class<?> i : c.getInterfaces()) expected[row(i)]++;
}
>>>
expected = expected[row]
label = , CLASSES[row].getName()

@atom M3CI.directSubtypeRow 1 SCENARIO java.util.TreeSet(reverse-hierarchy)
check <<<
for (int row = 0; row < CI.size(); row++) {
    TreeSet<Integer> expected = new TreeSet<>();
    for (int r = 0; r < CI.size(); r++) {
        Class<?> c = CLASSES[r];
        if (c.getSuperclass() == CLASSES[row] || Arrays.asList(c.getInterfaces()).contains(CLASSES[row])) expected.add(r);
    }
    List<Integer> got = new ArrayList<>();
    for (int k = 0; k < CI.directSubtypeCount(row); k++) got.add(CI.directSubtypeRow(row, k));
    assertEquals(new ArrayList<>(expected), got, CLASSES[row].getName());
}
>>>

@atom M3CI.supertypeCount 1 SCENARIO transitive-closure
check <<<
for (int row = 0; row < CI.size(); row++) {
    assertEquals(ReflectOracle.supertypes(ROWS, CLASSES[row]).size(), CI.supertypeCount(row), CLASSES[row].getName());
}
>>>

@atom M3CI.supertypeRow 1 SCENARIO java.util.TreeSet(transitive-closure)
check <<<
for (int row = 0; row < CI.size(); row++) {
    List<Integer> got = new ArrayList<>();
    for (int k = 0; k < CI.supertypeCount(row); k++) got.add(CI.supertypeRow(row, k));
    assertEquals(new ArrayList<>(ReflectOracle.supertypes(ROWS, CLASSES[row])), got, CLASSES[row].getName());
    for (int s : got) assertTrue(CI.isAssignableFrom(s, row), "a supertype row is assignable");
}
>>>

@atom M3CI.classAnnotationCount 1 SCENARIO getDeclaredAnnotations
