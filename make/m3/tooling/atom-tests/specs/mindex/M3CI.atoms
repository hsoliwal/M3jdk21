@atom M3CI.permittedSubclassRows 1 SCENARIO java.lang.Class.getPermittedSubclasses(rows)
check <<<
for (int row = 0; row < CI.size(); row++) {
    Class<?>[] permitted = CLASSES[row].getPermittedSubclasses();
    int[] expected = permitted == null ? new int[0] : Arrays.stream(permitted).mapToInt(c -> row(c)).toArray();
    assertArrayEquals(expected, CI.permittedSubclassRows(row), CLASSES[row].getName());
}
>>>

@atom M3CI.memberRows 1 SCENARIO declared-members-by-name
check <<<
for (int row = 0; row < CI.size(); row++) {
    Map<String, Set<String>> byName = new TreeMap<>();
    for (ReflectOracle.Declared d : ReflectOracle.declared(CLASSES[row])) {
        byName.computeIfAbsent(d.name(), n -> new TreeSet<>()).add(d.kind() + d.descriptor());
    }
    for (Map.Entry<String, Set<String>> e : byName.entrySet()) {
        int[] rows = CI.memberRows(row, e.getKey());
        Set<String> got = new TreeSet<>();
        for (int k = 0; k < rows.length; k++) {
            if (k > 0) assertEquals(rows[k - 1] + 1, rows[k], "contiguous rows");
            got.add(CI.memberKind(rows[k]) + CI.memberDescriptor(rows[k]));
        }
        assertEquals(e.getValue(), got, CLASSES[row].getName() + "#" + e.getKey());
    }
    assertEquals(0, CI.memberRows(row, "no such member name").length);
}
>>>

@atom M3CI.memberRows 2 SCENARIO declared-members-by-kind
check <<<
for (int row = 0; row < CI.size(); row++) {
    for (M3MemberKind kind : M3MemberKind.values()) {
        long expected = ReflectOracle.declared(CLASSES[row]).stream().filter(d -> d.kind() == kind).count();
        int[] rows = CI.memberRows(row, kind);
        assertEquals(expected, rows.length, CLASSES[row].getName() + " " + kind);
        for (int m : rows) assertEquals(kind, CI.memberKind(m));
    }
}
M3AtomKit.expectMessage(NullPointerException.class, "kind", () -> CI.memberRows(0, (M3MemberKind) null));
>>>

@atom M3CI.memberRow 1 SCENARIO (kind,name,descriptor)-lookup
check <<<
forEachMember((member, d) -> {
    assertEquals(d.name(), CI.memberName(member));
    assertEquals(d.descriptor(), CI.memberDescriptor(member));
    assertEquals(d.kind(), CI.memberKind(member));
});
int base = row(ReflectOracle.Base.class);
assertEquals(-1, CI.memberRow(base, M3MemberKind.METHOD, "sum", "(J)I"), "unknown descriptor");
assertEquals(-1, CI.memberRow(base, M3MemberKind.FIELD, "sum", "([I)I"), "kind mismatch");
>>>

