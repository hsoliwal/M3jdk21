for (int k = 1; k < classes.length; k++) {
    int a = CI.loaderSpaceId(k - 1), b = CI.loaderSpaceId(k);
    assertTrue(a < b || a == b && classes[k - 1].getName().compareTo(classes[k].getName()) < 0, "sorted by loader then name");
}
MethodHandle atom = st("discover", MethodType.methodType(DISCOVERY, java.util.Collection.class, int.class, M3VI.Progress.class));
M3AtomKit.expectMessage(IllegalArgumentException.class, "exceeds maxClasses", () -> atom.invoke(ReflectOracle.ROOTS, 1, M3VI.Progress.none()));
>>>

