@atom M3CI.binaryNameKey 1 SCENARIO key-set=binary-names
setup <<<
MethodHandle key = vi("binaryNameKey", MethodType.methodType(String.class, int.class));
int count = (int) vi("binaryNameKeyCount", MethodType.methodType(int.class)).invoke(CI);
>>>
check <<<
Set<String> got = new TreeSet<>();
for (int k = 0; k < count; k++) got.add((String) key.invoke(CI, k));
Set<String> expected = new TreeSet<>();
for (Class<?> c : CLASSES) expected.add(c.getName());
assertEquals(expected, got);
M3AtomKit.expect(IndexOutOfBoundsException.class, () -> key.invoke(CI, count));
