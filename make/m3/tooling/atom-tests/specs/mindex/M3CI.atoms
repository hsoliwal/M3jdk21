@atom M3CI.fingerprintSha256Hex 1 GETTER_DIFF java.util.HexFormat+determinism
setup = M3CI other = M3CI.compile(List.of(String.class), M3CI.Options.standard(), null);
expected = HexFormat.of().formatHex(CI.fingerprintSha256())
receiver = CI
extra <<<
assertEquals(SHA256_HEX, CI.fingerprintSha256Hex().length());
assertEquals(ReflectOracle.snapshot().fingerprintSha256Hex(), CI.fingerprintSha256Hex(), "deterministic");
assertNotEquals(other.fingerprintSha256Hex(), CI.fingerprintSha256Hex(), "different closure, different fingerprint");
>>>

@atom M3CI.primitivePayloadBytes 1 GETTER_DIFF lane-accounting-identity
setup <<<
long size = CI.size(), members = CI.memberSize();
long interfaces = 0, subtypes = 0, supertypes = 0, annotations = 0, permitted = 0;
for (int row = 0; row < size; row++) {
    interfaces += CI.interfaceCount(row);
    subtypes += CI.directSubtypeCount(row);
    supertypes += CI.supertypeCount(row);
    annotations += CI.classAnnotationCount(row);
    permitted += CI.permittedSubclassCount(row);
}
long memberAnnotations = 0, exceptions = 0;
for (int m = 0; m < members; m++) {
    memberAnnotations += CI.memberAnnotationCount(m);
    exceptions += CI.memberExceptionCount(m);
}
int keys = (int) M3AtomKit.findVirtual(OWNER, "binaryNameKeyCount", MethodType.methodType(int.class)).invoke(CI);
long ints = PER_CLASS_LANES * size + OFFSET_LANES * (size + 1) + interfaces + subtypes + supertypes + annotations + permitted
        + keys + (keys + 1) + size + PER_MEMBER_LANES * members + MEMBER_OFFSET_LANES * (members + 1) + memberAnnotations
        + exceptions;
long longs = size + members;
>>>
expected = ints * Integer.BYTES + longs * Long.BYTES + members
receiver = CI

@atom M3CI.binaryNameKeyCount 1 SCENARIO distinct-binary-names
check <<<
Set<String> names = new HashSet<>();
for (Class<?> c : CLASSES) names.add(c.getName());
assertEquals(names.size(), (int) vi("binaryNameKeyCount", MethodType.methodType(int.class)).invoke(CI));
