@atom M3CI.rowsForBinaryNameKey 1 SCENARIO rows-grouped-by-name
setup <<<
MethodHandle key = vi("binaryNameKey", MethodType.methodType(String.class, int.class));
MethodHandle rows = vi("rowsForBinaryNameKey", MethodType.methodType(int[].class, int.class));
int count = (int) vi("binaryNameKeyCount", MethodType.methodType(int.class)).invoke(CI);
>>>
check <<<
int total = 0;
for (int k = 0; k < count; k++) {
    String name = (String) key.invoke(CI, k);
    int[] got = (int[]) rows.invoke(CI, k);
    for (int r : got) assertEquals(name, CI.binaryName(r));
    assertArrayEquals(CI.classRows(name), got);
    total += got.length;
}
assertEquals(CI.size(), total, "every row under exactly one key");
>>>

@atom M3CI.uniqueMemberNameIds 1 SCENARIO distinct-member-names
