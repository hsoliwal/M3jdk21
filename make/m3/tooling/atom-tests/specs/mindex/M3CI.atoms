// CLASS_ONLY atoms of M3CI.java (primitive projection of class and declared-member metadata).
// Oracle: java.lang.Class / java.lang.reflect over the snapshot closure of ReflectOracle fixtures; java.util models
// (TreeSet, TreeMap, Arrays.binarySearch semantics) for the private lane builders; FNV-1a and SHA-256 references.
#class M3CIAtomTest
#summary Per-atom contracts of jdk.internal.mindex.M3CI against java.lang.Class/java.lang.reflect and java.util models
#build ReflectOracle
#import jdk.internal.mindex.M3CI jdk.internal.mindex.M3MemberKind jdk.internal.mindex.M3VI java.lang.reflect.AnnotatedElement java.lang.reflect.Field java.lang.reflect.Method java.security.MessageDigest java.util.ArrayList java.util.Arrays java.util.HashSet java.util.HexFormat java.util.IdentityHashMap java.util.List java.util.Map java.util.Optional java.util.Set java.util.SplittableRandom java.util.TreeMap java.util.TreeSet
#const int BASE_ANNOTATIONS = 2 // annotations ReflectOracle.Base declares
#const int SHAPE_PERMITTED = 2 // Circle and Square, the permitted subclasses of ReflectOracle.Shape
#const int PER_CLASS_LANES = 14 // int lanes with one entry per class row (loaderSpaces .. enclosingClassRows)
#const int OFFSET_LANES = 6 // int offset lanes with one entry per class row plus one
#const int PER_MEMBER_LANES = 5 // int lanes with one entry per member row (declaring row .. flags)
#const int MEMBER_OFFSET_LANES = 2 // int offset lanes with one entry per member row plus one
#const int MAX_CLASSES = 2 // queue limit of the enqueue check: String and Integer fit, Long does not
#const int DUPLICATE_TYPE = 2 // index of the second IOException in the exception types
#const int INTERFACE_ODDS = 4 // one generated row in INTERFACE_ODDS is an interface
#const int ROWS_PER_NAME = 4 // name ids are drawn from [0, MODEL_ROWS / ROWS_PER_NAME): about four rows per name
#const int DRAFT_OWNER = 3 // owner row of the member draft
#const int DRAFT_NAME_ID = 11 // name id of the member draft
#const int DRAFT_DESCRIPTOR_ID = 12 // descriptor id of the member draft
#const int DRAFT_MODIFIERS = 0x9 // modifiers of the member draft (public static)
#const int DRAFT_FLAGS = 0x4 // member flags of the member draft
#const int DRAFT_ANNOTATION_A = 5 // first annotation name id of the member draft
#const int DRAFT_ANNOTATION_B = 6 // second annotation name id of the member draft
#const int DRAFT_EXCEPTION_ID = 7 // exception descriptor id of the member draft
#const int[][] RAGGED = {{1, 2}, {}, {3, 4, 5}} // rows of lengths 2, 0 and 3 (the empty row in the middle)
#const int[] RAGGED_OFFSETS = {0, 2, 2, 5} // prefix sums of the RAGGED row lengths
#const int[] RAGGED_FLAT = {1, 2, 3, 4, 5} // the RAGGED rows concatenated
#const int[] PREFIX_INPUT = {0, 2, 0, 3, 1} // input of the in-place prefix sum
#const int[] PREFIX_SUMS = {0, 2, 2, 5, 6} // PREFIX_INPUT after the in-place prefix sum
#const int DUPLICATE_FACTOR = 2 // values are drawn from [0, MODEL_ROWS / DUPLICATE_FACTOR): duplicates are likely
#const int STRING_ROW = 4 // row the identity map gives String.class
#const int[] TOTAL_LENGTHS = {1, 2, 3} // lengths of the arrays summed by totalLength
#const int[] SORTED_RUNS = {1, 3, 3, 3, 7, 9} // sorted lane with a run of three equal values
#const int PROBE_MAX = 10 // probes 0..PROBE_MAX cover both ends and every gap of SORTED_RUNS
#const int RUN_VALUE = 3 // the value of the run of SORTED_RUNS
#const int WINDOW_FROM = 2 // first index of the searched window, inside the run
#const int WINDOW_TO = 4 // end of the searched window
#const byte[] SUPPLIED_DIGEST = {1, 2, 3} // a fingerprint digest supplied by the caller
#const byte CLOBBER = 9 // value the caller writes into its digest after the call
#helper <<<
    private static final M3CI CI = ReflectOracle.snapshot();
    private static final Class<?>[] CLASSES = ReflectOracle.classes(CI);
    private static final Map<Class<?>, Integer> ROWS = ReflectOracle.rows(CI);
    private static final Class<?> OWNER = M3CI.class;
    private static final Class<?> SYMBOLS = M3AtomKit.type("M3CI$Symbols");
    private static final Class<?> DISCOVERY = M3AtomKit.type("M3CI$Discovery");
    private static final Class<?> FROZEN = M3AtomKit.type("M3CI$Frozen");
    private static final Class<?> DRAFT = M3AtomKit.type("M3CI$MemberDraft");
    private static final Class<?> NAME_INDEX = M3AtomKit.type("M3CI$NameIndex");
    /** FNV-1a 64 offset basis and prime (the documented structural hash). */
    private static final long FNV_SEED = 0xcbf29ce484222325L;
    private static final long FNV_PRIME = 0x100000001b3L;
    private static final int BYTE_MASK = 0xff;
    /** Length of a SHA-256 fingerprint in hex digits. */
    private static final int SHA256_HEX = 64;
    /** Generated model sizes of the private lane-builder checks. */
    private static final int MODEL_ROWS = 40;
    private static final int MODEL_FANOUT = 3;

    private static MethodHandle st(String name, MethodType type) {
        return M3AtomKit.findStatic(OWNER, name, type);
    }

    private static MethodHandle vi(String name, MethodType type) {
        return M3AtomKit.findVirtual(OWNER, name, type);
    }

    private static int row(Class<?> c) {
        return ReflectOracle.rowOf(ROWS, c);
    }

    private static Object symbols() throws Throwable {
        return M3AtomKit.findConstructor(SYMBOLS, MethodType.methodType(void.class)).invoke();
    }

    private static List<String> symbolValues(Object symbols) throws Throwable {
        return (List<String>) M3AtomKit.findGetter(SYMBOLS, "values", ArrayList.class).invoke(symbols);
    }

    private static long fnv(long current, int value) {
        long hash = current;
        for (int shift = 0; shift < Integer.SIZE; shift += Byte.SIZE) {
            hash ^= (value >>> shift) & BYTE_MASK;
            hash *= FNV_PRIME;
        }
        return hash;
    }

    private static Object discoverRoots() throws Throwable {
        return st("discover", MethodType.methodType(DISCOVERY, java.util.Collection.class, int.class, M3VI.Progress.class))
                .invoke(ReflectOracle.ROOTS, M3CI.Options.standard().maxClasses(), M3VI.Progress.none());
    }

    private static Object freezeWith(Object discovery, boolean retain) throws Throwable {
        return st("freeze", MethodType.methodType(FROZEN, DISCOVERY, boolean.class, M3VI.Progress.class))
                .invoke(discovery, retain, M3VI.Progress.none());
    }

    private static M3CI fromFrozen(Object frozen) throws Throwable {
        return (M3CI) M3AtomKit.findConstructor(OWNER, "M3CI", MethodType.methodType(void.class, FROZEN)).invoke(frozen);
    }

    private static int[] lane(String name) throws Throwable {
        return (int[]) M3AtomKit.findGetter(OWNER, name, int[].class).invoke(CI);
    }

    private static int[] randomRows(SplittableRandom random, int bound) {
        return random.ints(random.nextInt(MODEL_FANOUT + 1), 0, bound).distinct().toArray();
    }

    /** Asserts one lane of every member row against its reflective element. */
    private static void forEachMember(MemberCheck check) throws Throwable {
        int seen = 0;
        for (int row = 0; row < CI.size(); row++) {
            for (ReflectOracle.Declared d : ReflectOracle.declared(CLASSES[row])) {
                int member = ReflectOracle.memberRow(CI, row, d);
                assertTrue(member >= 0, "indexed " + d);
                check.accept(member, d);
                seen++;
            }
        }
        assertEquals(CI.memberSize(), seen, "every member row checked");
    }

    @FunctionalInterface
    interface MemberCheck {
        void accept(int member, ReflectOracle.Declared declared) throws Throwable;
    }
>>>

@atom M3CI.M3CI 1 SCENARIO discover+freeze+ctor=compile
check <<<
M3CI direct = fromFrozen(freezeWith(discoverRoots(), true));
assertEquals(CI.size(), direct.size());
assertEquals(CI.memberSize(), direct.memberSize());
assertEquals(CI.fingerprintSha256Hex(), direct.fingerprintSha256Hex(), "same lanes, same fingerprint");
for (int row = 0; row < CI.size(); row++) assertEquals(CI.binaryName(row), direct.binaryName(row));
>>>

@atom M3CI.simpleName 1 CI_ROW_DIFF java.lang.Class.getSimpleName
expected = CLASSES[row].getSimpleName()
label = , CLASSES[row].getName()
extra = M3AtomKit.expect(IndexOutOfBoundsException.class, () -> CI.simpleName(CI.size()));

@atom M3CI.packageName 1 CI_ROW_DIFF java.lang.Class.getPackageName
expected = CLASSES[row].getPackageName()

@atom M3CI.moduleName 1 SCENARIO java.lang.Module.getName
check <<<
for (int row = 0; row < CI.size(); row++) {
    assertEquals(Optional.ofNullable(CLASSES[row].getModule().getName()), CI.moduleName(row), CLASSES[row].getName());
}
assertEquals(Optional.of("java.base"), CI.moduleName(row(Object.class)));
assertEquals(Optional.empty(), CI.moduleName(row(ReflectOracle.class)), "unnamed module");
>>>

