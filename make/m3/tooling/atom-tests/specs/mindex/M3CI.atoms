@atom M3CI.optionalText 1 SCENARIO java.util.Optional
setup <<<
MethodHandle atom = vi("optionalText", MethodType.methodType(Optional.class, int.class));
int id = (int) vi("findText", MethodType.methodType(int.class, CharSequence.class)).invoke(CI, "java.lang.Object");
>>>
check <<<
assertEquals(Optional.empty(), atom.invoke(CI, -1));
