// CLASS_ONLY atoms of M3Method.java (method view; mirrors java.lang.reflect.Method).
#class M3MethodAtomTest
#summary Per-atom contracts of jdk.internal.mindex.M3Method against java.lang.reflect.Method
#build ReflectOracle
#import jdk.internal.mindex.M3CI jdk.internal.mindex.M3Method jdk.internal.mindex.M3MemberKind java.lang.reflect.Method java.util.TreeSet
#helper <<<
    private static final M3CI CI = ReflectOracle.snapshot();
    private static final MethodHandle NEW = M3AtomKit.findConstructor(M3Method.class, "M3Method",
            MethodType.methodType(void.class, M3CI.class, int.class));

    private static M3Method view(int member) throws Throwable {
        return (M3Method) NEW.invoke(CI, member);
    }

    private static void each(ReflectOracle.MemberCheck check) throws Throwable {
        assertTrue(ReflectOracle.forEachMember(CI, M3MemberKind.METHOD, check) > 0);
    }

    private static Method reflective(ReflectOracle.Declared d) {
        return (Method) d.element();
    }
>>>

@atom M3Method.M3Method 1 SCENARIO kind-checked-constructor
setup <<<
int other = ReflectOracle.firstMember(CI, M3MemberKind.CONSTRUCTOR);
>>>
check <<<
each((member, d) -> assertEquals(member, view(member).row()));
M3AtomKit.expectMessage(IllegalArgumentException.class, "not a method", () -> NEW.invoke(CI, other));
>>>

@atom M3Method.isSynthetic 1 MEMBER_VIEW_DIFF Method.isSynthetic
expected = reflective(d).isSynthetic()
label = , d.toString()

@atom M3Method.isVarArgs 1 MEMBER_VIEW_DIFF Method.isVarArgs
expected = reflective(d).isVarArgs()
label = , d.toString()

@atom M3Method.isDefault 1 MEMBER_VIEW_DIFF Method.isDefault
expected = reflective(d).isDefault()
label = , d.toString()

@atom M3Method.annotationCount 1 MEMBER_VIEW_DIFF getDeclaredAnnotations
expected = reflective(d).getDeclaredAnnotations().length
label = , d.toString()

@atom M3Method.annotationTypeNameAt 1 MEMBER_ANNOTATION_NAMES getDeclaredAnnotations(type-names)

@atom M3Method.exceptionCount 1 MEMBER_VIEW_DIFF Method.getExceptionTypes
expected = reflective(d).getExceptionTypes().length

@atom M3Method.exceptionTypeDescriptorAt 1 SCENARIO Class.descriptorString(exceptions)
check <<<
each((member, d) -> {
    Class<?>[] expected = reflective(d).getExceptionTypes();
    for (int k = 0; k < expected.length; k++) assertEquals(expected[k].descriptorString(), view(member).exceptionTypeDescriptorAt(k));
});
>>>

@atom M3Method.structuralHash64 1 MEMBER_VIEW_DIFF delegates-to-M3CI
expected = CI.memberStructuralHash64(member)
