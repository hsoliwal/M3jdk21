// Atoms of M3Boundary.java (weak JVM boundary of a frozen M3CI).
// Oracle: the class/loader arrays it was built from, java.lang.ref.WeakReference probes (cleared atomically
// with the boundary's own weak references) and M3CI.compile as the public producer.
#class M3BoundaryAtomTest
#summary Per-atom contracts of jdk.internal.mindex.M3Boundary against its source arrays and WeakReference probes
#import jdk.internal.mindex.M3Boundary jdk.internal.mindex.M3CI java.lang.invoke.MethodHandles java.lang.ref.WeakReference java.util.List java.util.Optional
#const int FIXTURE_LOADER_SPACES = 2 // loader spaces of the constructor fixture: bootstrap (null) and APP
#const int DETACHED_CLASSES = 7 // class count given to a boundary without references
#const int DETACHED_LOADER_SPACES = 3 // loader-space count given to a boundary without references
#const int COMPACT_SOURCE_CLASSES = 2 // classes of the compact source {String.class, null}
#const int OTHER_SPACE = 2 // loader space of OTHER in LOADERS {null, APP, OTHER}
#const int LIVE_CLASSES = 2 // String and the hidden seed class, both reachable
#const int LIVE_LOADERS = 3 // bootstrap, APP and the transient loader, all reachable
#const int LOADERS_AFTER_COLLECT = 2 // bootstrap and APP once the transient loader is collected
#helper <<<
    private static final Class<?> OWNER = M3AtomKit.type("M3Boundary");
    private static final MethodHandle OF = M3AtomKit.findStatic(OWNER, "of",
            MethodType.methodType(OWNER, Class[].class, ClassLoader[].class, boolean.class));
    /** Collection attempts of the weak-boundary check. */
    private static final int GC_ATTEMPTS = 20;
    /** Pause between collection attempts, in milliseconds. */
    private static final long GC_PAUSE_MILLIS = 50;

    private static final Class<?>[] CLASSES = {String.class, Integer.class, M3BoundaryAtomTest.class};
    private static final ClassLoader APP = M3BoundaryAtomTest.class.getClassLoader();
    private static final ClassLoader OTHER = new ClassLoader(APP) { };
    private static final ClassLoader[] LOADERS = {null, APP, OTHER};

    private static M3Boundary boundaryOf(Class<?>[] classes, ClassLoader[] loaders, boolean retain) throws Throwable {
        return (M3Boundary) OF.invoke(classes, loaders, retain);
    }

    private static M3Boundary retainedBoundary() throws Throwable {
        return boundaryOf(CLASSES, LOADERS, true);
    }

    private static M3Boundary compactBoundary() throws Throwable {
        return boundaryOf(CLASSES, LOADERS, false);
    }

    /** Class-file magic number. */
    private static final int CLASS_MAGIC = 0xCAFEBABE;
    /** Class-file major version of Java 21. */
    private static final int JAVA_21_MAJOR = 65;
    /** Constant-pool tags and access flags of the minimal top-level seed class. */
    private static final int CONSTANT_UTF8 = 1;
    private static final int CONSTANT_CLASS = 7;
    private static final int ACC_FINAL_SUPER = 0x0011;
    /** Constant-pool entries #1..#4 of the seed; the count field is entries + 1. */
    private static final int POOL_COUNT = 5;
    private static final int THIS_CLASS = 1;
    private static final int SUPER_CLASS = 3;

    /** Same minimal top-level class file as M3ClassFlagsAtomTest: a collectable hidden class. */
    private static Class<?> hiddenClass(String name) throws Exception {
        java.io.ByteArrayOutputStream bytes = new java.io.ByteArrayOutputStream();
        java.io.DataOutputStream out = new java.io.DataOutputStream(bytes);
        out.writeInt(CLASS_MAGIC);
        out.writeShort(0);
        out.writeShort(JAVA_21_MAJOR);
        out.writeShort(POOL_COUNT);
        out.writeByte(CONSTANT_CLASS);
        out.writeShort(THIS_CLASS + 1);
        out.writeByte(CONSTANT_UTF8);
        out.writeUTF(name);
        out.writeByte(CONSTANT_CLASS);
        out.writeShort(SUPER_CLASS + 1);
        out.writeByte(CONSTANT_UTF8);
        out.writeUTF("java/lang/Object");
        out.writeShort(ACC_FINAL_SUPER);
        out.writeShort(THIS_CLASS);
        out.writeShort(SUPER_CLASS);
        out.writeShort(0);
        out.writeShort(0);
        out.writeShort(0);
        out.writeShort(0);
        out.flush();
        return MethodHandles.lookup().defineHiddenClass(bytes.toByteArray(), false).lookupClass();
    }

    private static void collect(WeakReference<?> probe) throws InterruptedException {
        for (int i = 0; i < GC_ATTEMPTS && probe.get() != null; i++) {
            System.gc();
            Thread.sleep(GC_PAUSE_MILLIS);
        }
    }
>>>

@atom M3Boundary.M3Boundary 1 SCENARIO private-constructor-fields
setup <<<
MethodHandle ctor = M3AtomKit.findConstructor(OWNER, MethodType.methodType(void.class,
        WeakReference[].class, WeakReference[].class, int.class, int.class));
WeakReference<?>[] classes = {new WeakReference<>(String.class)};
WeakReference<?>[] loaders = {new WeakReference<>(null), new WeakReference<>(APP)};
>>>
check <<<
M3Boundary boundary = (M3Boundary) ctor.invoke(classes, loaders, 1, FIXTURE_LOADER_SPACES);
assertTrue(boundary.retained());
assertEquals(1, boundary.classCount());
assertEquals(FIXTURE_LOADER_SPACES, boundary.loaderSpaceCount());
assertEquals(Optional.of(String.class), boundary.classAt(0));
assertEquals(Optional.of(APP), boundary.loaderAt(1));
M3Boundary detached = (M3Boundary) ctor.invoke(new WeakReference<?>[0], new WeakReference<?>[0], DETACHED_CLASSES, DETACHED_LOADER_SPACES);
assertFalse(detached.retained());
assertEquals(DETACHED_CLASSES, detached.classCount(), "counts are kept without references");
assertEquals(DETACHED_LOADER_SPACES, detached.loaderSpaceCount());
>>>

@atom M3Boundary.of 1 SCENARIO source-arrays+M3CI.compile
setup <<<
M3CI standard = M3CI.compile(List.of(String.class, M3BoundaryAtomTest.class), M3CI.Options.standard(), null);
M3CI compactIndex = M3CI.compile(List.of(String.class, M3BoundaryAtomTest.class), M3CI.Options.compact(), null);
>>>
check <<<
M3Boundary boundary = retainedBoundary();
for (int row = 0; row < CLASSES.length; row++) assertEquals(Optional.of(CLASSES[row]), boundary.classAt(row));
assertTrue(compactBoundary().classAt(0).isEmpty(), "compact keeps no class handle");
assertTrue(standard.boundary().retained());
assertFalse(compactIndex.boundary().retained());
assertEquals(standard.size(), standard.boundary().classCount());
assertEquals(compactIndex.size(), compactIndex.boundary().classCount());
for (int row = 0; row < standard.size(); row++) {
    assertEquals(standard.binaryName(row), standard.boundary().classAt(row).orElseThrow().getName());
}
M3AtomKit.expectMessage(NullPointerException.class, "classes", () -> boundaryOf(null, LOADERS, true));
M3AtomKit.expectMessage(NullPointerException.class, "loaders", () -> boundaryOf(CLASSES, null, false));
M3AtomKit.expectMessage(NullPointerException.class, "classes[1]", () -> boundaryOf(new Class<?>[] {String.class, null}, LOADERS, true));
assertEquals(COMPACT_SOURCE_CLASSES, boundaryOf(new Class<?>[] {String.class, null}, LOADERS, false).classCount(), "compact does not inspect elements");
>>>

@atom M3Boundary.retained 1 SCENARIO retain-flag
check <<<
assertTrue(retainedBoundary().retained());
assertFalse(compactBoundary().retained());
assertFalse(boundaryOf(new Class<?>[0], LOADERS, true).retained(), "an empty class lane retains nothing");
>>>

@atom M3Boundary.classCount 1 GETTER_DIFF source-array-length
expected = CLASSES.length
receiver = retainedBoundary()
extra <<<
assertEquals(CLASSES.length, compactBoundary().classCount());
assertEquals(0, boundaryOf(new Class<?>[0], new ClassLoader[0], true).classCount());
>>>

@atom M3Boundary.loaderSpaceCount 1 GETTER_DIFF source-array-length
expected = LOADERS.length
receiver = retainedBoundary()
extra = assertEquals(LOADERS.length, compactBoundary().loaderSpaceCount());

@atom M3Boundary.classAt 1 SCENARIO java.util.Optional+Objects.checkIndex
setup <<<
M3Boundary boundary = retainedBoundary();
M3Boundary compact = compactBoundary();
>>>
check <<<
for (int row = 0; row < CLASSES.length; row++) {
    assertSame(CLASSES[row], boundary.classAt(row).orElseThrow());
    assertEquals(Optional.empty(), compact.classAt(row));
}
M3AtomKit.expect(IndexOutOfBoundsException.class, () -> boundary.classAt(-1));
M3AtomKit.expect(IndexOutOfBoundsException.class, () -> boundary.classAt(CLASSES.length));
M3AtomKit.expect(IndexOutOfBoundsException.class, () -> compact.classAt(CLASSES.length));
>>>

@atom M3Boundary.loaderAt 1 SCENARIO java.util.Optional+bootstrap-zero
setup <<<
M3Boundary boundary = retainedBoundary();
>>>
check <<<
assertEquals(Optional.empty(), boundary.loaderAt(0), "bootstrap space has no loader object");
assertSame(APP, boundary.loaderAt(1).orElseThrow());
assertSame(OTHER, boundary.loaderAt(OTHER_SPACE).orElseThrow());
assertEquals(Optional.empty(), compactBoundary().loaderAt(1));
M3AtomKit.expect(IndexOutOfBoundsException.class, () -> boundary.loaderAt(LOADERS.length));
M3AtomKit.expect(IndexOutOfBoundsException.class, () -> boundary.loaderAt(-1));
>>>

@atom M3Boundary.loaderSpaceOf 1 SCENARIO identity-search
setup <<<
M3Boundary boundary = retainedBoundary();
ClassLoader stranger = new ClassLoader(APP) { };
>>>
check <<<
assertEquals(0, boundary.loaderSpaceOf(null), "bootstrap is always zero");
assertEquals(1, boundary.loaderSpaceOf(APP));
assertEquals(OTHER_SPACE, boundary.loaderSpaceOf(OTHER));
assertEquals(-1, boundary.loaderSpaceOf(stranger), "unknown loader");
assertEquals(-1, compactBoundary().loaderSpaceOf(APP), "detached snapshot");
assertEquals(0, compactBoundary().loaderSpaceOf(null));
>>>

@atom M3Boundary.liveClassCount 1 GETTER_DIFF java.lang.ref.WeakReference-atomic-clear
setup <<<
Class<?> hidden = hiddenClass("M3BoundaryLiveSeed");
M3Boundary boundary = boundaryOf(new Class<?>[] {String.class, hidden}, LOADERS, true);
WeakReference<Class<?>> probe = new WeakReference<>(hidden);
>>>
expected = LIVE_CLASSES
receiver = boundary
extra <<<
hidden = null;
collect(probe);
boolean collected = probe.get() == null;
assertEquals(collected ? 1 : LIVE_CLASSES, boundary.liveClassCount(), "boundary references clear with the probe");
assertEquals(!collected, boundary.classAt(1).isPresent());
assertEquals(0, compactBoundary().liveClassCount());
>>>

@atom M3Boundary.liveLoaderCount 1 GETTER_DIFF java.lang.ref.WeakReference-atomic-clear
setup <<<
ClassLoader transientLoader = new ClassLoader(APP) { };
M3Boundary boundary = boundaryOf(CLASSES, new ClassLoader[] {null, APP, transientLoader}, true);
WeakReference<ClassLoader> probe = new WeakReference<>(transientLoader);
>>>
expected = LIVE_LOADERS
receiver = boundary
label = , "bootstrap counts as live"
extra <<<
transientLoader = null;
collect(probe);
assertEquals(probe.get() == null ? LOADERS_AFTER_COLLECT : LIVE_LOADERS, boundary.liveLoaderCount());
assertEquals(0, compactBoundary().liveLoaderCount());
>>>

@atom M3Boundary.retainedReferenceCount 1 GETTER_DIFF array-lengths
expected = CLASSES.length + LOADERS.length
receiver = retainedBoundary()
extra = assertEquals(0, compactBoundary().retainedReferenceCount());
