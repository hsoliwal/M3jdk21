<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <groupId>com.m3.proof</groupId>
 <artifactId>regex-precompute-receiver</artifactId>
 <version>1.0-SNAPSHOT</version>
 <packaging>pom</packaging>
 <properties>
  <m3.test.jdk>${java.home}</m3.test.jdk>
  <m3.python>python3</m3.python>
 </properties>
 <build>
  <plugins>
   <plugin>
    <groupId>org.codehaus.mojo</groupId>
    <artifactId>exec-maven-plugin</artifactId>
    <version>3.3.0</version>
    <executions>
     <execution>
      <id>verify-product-runner-contracts</id>
      <phase>test</phase>
      <goals><goal>exec</goal></goals>
      <configuration>
       <executable>${m3.python}</executable>
       <arguments>
        <argument>-B</argument>
        <argument>-m</argument>
        <argument>unittest</argument>
        <argument>discover</argument>
        <argument>-s</argument>
        <argument>${project.basedir}</argument>
        <argument>-p</argument>
        <argument>test_verify.py</argument>
        <argument>-v</argument>
       </arguments>
      </configuration>
     </execution>
     <execution>
      <id>verify-canonical-postimages-and-fixture</id>
      <phase>verify</phase>
      <goals>
       <goal>exec</goal>
      </goals>
      <configuration>
       <executable>${m3.python}</executable>
       <arguments>
        <argument>-B</argument>
        <argument>${project.basedir}/verify.py</argument>
        <argument>--target</argument>
        <argument>${project.basedir}/../../../..</argument>
        <argument>--java-home</argument>
        <argument>${m3.test.jdk}</argument>
        <argument>--output</argument>
        <argument>${project.build.directory}/product-verification</argument>
       </arguments>
      </configuration>
     </execution>
    </executions>
   </plugin>
  </plugins>
 </build>
</project>
