	static int [][] runs (boolean [] kept, boolean descending) {
		int [] starts = new int [kept.length], lengths = new int [kept.length];
		int count = 0;
		for (int i = 0; i < kept.length; i++) {
			if (kept [i]) continue;
			int start = i;
			while (i + 1 < kept.length && !kept [i + 1]) i++;
			starts [count] = start;
			lengths [count++] = i - start + 1;
		}
