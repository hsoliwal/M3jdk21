"""Fail-closed reverse reconstruction of Object.toAdapter's three source images.

SOURCE_CUSTODY_ONLY: does not replace historical admission, JDK builds or JNI tests.
"""
from __future__ import annotations

import hashlib
import json
from pathlib import Path

import check_object_adapter_progress_receiver_20261017 as historical

ROOT = Path(__file__).resolve().parents[2]
TARGET = "src/java.base/share/classes/java/lang/Object.java"
LEDGER = "make/m3/qualification/object-adapter-selfcast/OBJECT_SOURCE_LINEAGE_20261104.json"
LEDGER_GIT_BLOB = "949c7db8f195cab7fed92d402b99fba6bd6d58f0"
STAGES = (
    ("2026-10-17", "829fb37093cf3e8d11b3c1e3d42f898f0c86f3b697e7a66cefe09934be3bb259",
     "2bfef3101224112c40957c954592a100dc59a3fc", 28923,
     "com.synexia.m3.ObjectAdapterProgress20261017", "e76b8d2ff204960960c9f63c0bc42ade1d44aec9"),
    ("2026-10-18", "014671527cd647d90f8cab6d6dbd0ca127d918c5a8f38d1ec50be6140eb63735",
     "a9899e1c2970f6d5e9172ffb12f5b7399d052b68", 29530,
     "com.synexia.m3.ObjectDoopEvents20261018", "4e15c478161c81aee6538dbe4b183e653172eca2"),
    ("2026-11-02", "bd21f3da2ff9f8365576946cfe2d5b5557acaace76de2146277e9d1baa436bd4",
     "c703c72bea6e792a378bb6d3babc96f22dbf6cb4", 29557,
     "com.synexia.m3.ObjectToAdapterSelfCast20261102", "080b16eaad789cab14e3303338aed260c56a385d"),
)


def sha256(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def git_blob(raw: bytes) -> str:
    return hashlib.sha1(b"blob " + str(len(raw)).encode("ascii") + b"\0" + raw,
                        usedforsecurity=False).hexdigest()


def unique_object(pairs: list[tuple[str, object]]) -> dict:
    result: dict = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate lineage JSON field: " + key)
        result[key] = value
    return result


def parse_ledger(raw: bytes, expected_blob: str = LEDGER_GIT_BLOB) -> dict:
    if git_blob(raw) != expected_blob:
        raise RuntimeError("Object lineage ledger Git blob drift")
    if not raw.endswith(b"\n") or b"\0" in raw or b"\r" in raw:
        raise RuntimeError("invalid lineage ledger encoding")
    try:
        model = json.loads(raw.decode("utf-8", errors="strict"), object_pairs_hook=unique_object)
    except (UnicodeError, ValueError, TypeError) as failure:
        raise RuntimeError("invalid Object lineage JSON") from failure
    if (not isinstance(model, dict) or set(model) != {
            "format", "current_source_path", "authority", "stages", "reverse_steps"}
            or model["format"] != "M3_OBJECT_TOADAPTER_EXACT_REVERSE_SOURCE_V1"
            or model["current_source_path"] != TARGET
            or not isinstance(model["authority"], str)
            or len(model["stages"]) != 3 or len(model["reverse_steps"]) != 2):
        raise RuntimeError("Object lineage schema or coverage drift")
    for entry, (name, digest, blob, _size, recipe, manifest) in zip(model["stages"], STAGES):
        if not isinstance(entry, dict) or entry != {
            "label": name, "sha256": digest, "git_blob": blob,
            "recipe_id": recipe, "recipe_manifest_git_blob": manifest}:
            raise RuntimeError("Object lineage stage authority drift: " + name)
    return model


def check_source(image: str, stage: tuple) -> None:
    stage_name, digest, blob, chars, *_ = stage
    if len(image) != chars:
        raise RuntimeError("Object source length drift: " + stage_name)
    raw = image.encode("utf-8", errors="strict")
    if sha256(raw) != digest or git_blob(raw) != blob:
        raise RuntimeError("Object source hash drift: " + stage_name)


def rewind(image: str, step: dict, later: tuple, earlier: tuple) -> str:
    if not isinstance(step, dict) or set(step) != {
            "from_stage", "to_stage", "prefix_chars", "suffix_chars",
            "current_length_chars", "previous_length_chars",
            "current_fragment", "previous_fragment"}:
        raise RuntimeError("Object reverse atom schema drift")
    if (step["from_stage"] != later[0] or step["to_stage"] != earlier[0]
            or step["current_length_chars"] != later[3]
            or step["previous_length_chars"] != earlier[3]):
        raise RuntimeError("Object reverse atom identity drift")
    start, suffix = step["prefix_chars"], step["suffix_chars"]
    old_fragment, new_fragment = step["previous_fragment"], step["current_fragment"]
    if (not isinstance(start, int) or isinstance(start, bool) or start < 0
            or not isinstance(suffix, int) or isinstance(suffix, bool) or suffix < 0
            or start + suffix > len(image)
            or not isinstance(new_fragment, str) or not isinstance(old_fragment, str)):
        raise RuntimeError("Object reverse atom bounds drift")
    end = len(image) - suffix
    if image[start:end] != new_fragment:
        raise RuntimeError("Object reverse atom current fragment drift")
    previous = image[:start] + old_fragment + image[end:]
    if len(previous) != earlier[3]:
        raise RuntimeError("Object reconstructed length drift")
    check_source(previous, earlier)
    roundtrip = previous[:start] + new_fragment + previous[len(previous) - suffix:]
    if roundtrip != image:
        raise RuntimeError("Object forward replay differs")
    return previous


def verify(root: Path = ROOT) -> int:
    ledger = parse_ledger(historical.contained_file(root, LEDGER).read_bytes())
    historic = historical.read_manifest(root, historical.BASE_MANIFEST,
                                        historical.BASE_MANIFEST_SHA256, 11)
    if historic[TARGET][1] != STAGES[0][1]:
        raise RuntimeError("Object lineage does not join historical progress receipt")
    current = historical.contained_file(root, TARGET).read_bytes().decode("utf-8", errors="strict")
    check_source(current, STAGES[2])
    middle = rewind(current, ledger["reverse_steps"][0], STAGES[2], STAGES[1])
    original = rewind(middle, ledger["reverse_steps"][1], STAGES[1], STAGES[0])
    if original == current:
        raise RuntimeError("Object lineage unexpected fixed point")
    print("SOURCE_LINEAGE_ONLY Object.java 2026-11-02 -> 2026-10-18 -> 2026-10-17")
    print("SOURCE_LINEAGE_3_OF_3 full Java source SHA-256 and Git blobs verified")
    print("HOLD historical progress admission, seven other divergences, Java/JNI runtime")
    return 3


if __name__ == "__main__":
    verify()
