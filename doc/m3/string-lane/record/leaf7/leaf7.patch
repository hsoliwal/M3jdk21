+/*
+ * Copyright (c) 2026, Hitesh Soliwal. All rights reserved.
+ * GPLv2 with the Classpath exception.
+ *
+ * @test
+ * @summary Single-unit search of short and very long M3-backed Strings matches a flat peer
+ * @modules java.base/java.lang:+open
+ * @run main/othervm -XX:+UnlockExperimentalVMOptions -XX:+UseM3StringStorage M3StringLinearUnitSearchTest
+ * @run main/othervm -XX:+UnlockExperimentalVMOptions -XX:+UseM3StringStorage -XX:-CompactStrings M3StringLinearUnitSearchTest
+ */
+
+import java.lang.reflect.Field;
+import java.util.Arrays;
+import java.util.List;
+import java.util.stream.IntStream;
+
+/**
+ * Sources under 256 and over 32,768 units are searched through bulk windows that start at 32
+ * units and double. Hits sit on both sides of every window seam. Each text is checked as a whole
+ * admitted String, as a range of a longer one and as a concatenation of two halves, against a
+ * flat peer: indexOf and lastIndexOf from every hit, a unit that is absent, a unit that Latin-1
+ * storage cannot hold, and split on the unit.
+ */
+public class M3StringLinearUnitSearchTest {
+    private static final List<Integer> SEAMS = List.of(32, 96, 224, 480, 992, 2016, 4064, 8160);
+    private static final List<Integer> LENGTHS = List.of(
+            0, 1, 31, 32, 33, 95, 96, 97, 200, 255, 33_000, 40_000);
+    private static final char HIT = 'x';
+    private static final char ABSENT = 'q';
+    private static final char WIDE = (char) 0x100;
+    private static int checks;
+
+    public static void main(String[] args) throws Exception {
+        for (int length : LENGTHS) {
+            for (char filler : new char[] {'a', (char) 0x3B1}) {
+                char[] units = text(length, filler);
+                String flat = flat(units);
+                checkAll(new String(units), flat, units);
+                checkAll(range(units), flat, units);
+                checkAll(halves(units), flat, units);
+            }
+        }
+        System.out.println("PASS checks=" + checks);
+    }
+
+    /** The filler with a hit before, at and after every seam, and at both ends. */
+    private static char[] text(int length, char filler) {
+        char[] units = new char[length];
+        Arrays.fill(units, filler);
+        hits(length).forEach(index -> units[index] = HIT);
+        return units;
+    }
+
+    private static IntStream hits(int length) {
+        IntStream seams = SEAMS.stream()
+                .flatMapToInt(seam -> IntStream.rangeClosed(seam - 1, seam + 1));
+        return IntStream.concat(seams, IntStream.of(0, length - 1))
+                .filter(index -> index >= 0 && index < length).distinct();
+    }
+
+    private static String range(char[] units) {
+        String framed = new String(("xx" + new String(units) + "xx").toCharArray());
+        return framed.substring(2, 2 + units.length);
+    }
+
+    private static String halves(char[] units) {
+        int middle = units.length / 2;
+        String left = new String(units, 0, middle);
+        return left.concat(new String(units, middle, units.length - middle));
+    }
+
+    private static void checkAll(String subject, String flat, char[] units) {
+        int length = units.length;
+        IntStream starts = IntStream.concat(
+                hits(length).flatMap(hit -> IntStream.of(hit, hit + 1)),
+                IntStream.of(-1, 0, length, length + 1));
+        starts.forEach(from -> List.of(HIT, ABSENT, WIDE).forEach(unit -> {
+            same(subject.indexOf(unit, from), flat.indexOf(unit, from), "indexOf", from);
+            same(subject.lastIndexOf(unit, from), flat.lastIndexOf(unit, from),
+                    "lastIndexOf", from);
+            int begin = Math.clamp(from, 0, length);
+            same(subject.indexOf(unit, begin, length), flat.indexOf(unit, begin, length),
+                    "indexOf to end", begin);
+        }));
+        same(subject.split("x", -1).length, flat.split("x", -1).length, "split count", 0);
+        same(Arrays.hashCode(lengths(subject.split("x", -1))),
+                Arrays.hashCode(lengths(flat.split("x", -1))), "split piece lengths", 0);
+    }
+
+    private static int[] lengths(String[] pieces) {
+        return Arrays.stream(pieces).mapToInt(String::length).toArray();
+    }
+
+    private static void same(int actual, int expected, String label, int from) {
+        checks++;
+        if (actual != expected) {
+            throw new AssertionError(label + " from " + from + ": expected " + expected
+                    + " but was " + actual);
+        }
+    }
+
+    /** The per-thread admission guard gives a flat peer, as a bootstrap or refused String is. */
+    @SuppressWarnings("unchecked")
+    private static String flat(char[] units) throws Exception {
+        Field field = optionalField("java.lang.M3String", "ADMITTING");
+        if (field == null) return new String(units);
+        ThreadLocal<Boolean> admitting = (ThreadLocal<Boolean>) field.get(null);
+        Boolean previous = admitting.get();
+        admitting.set(Boolean.TRUE);
+        try {
+            return new String(units);
+        } finally {
+            if (previous == null) admitting.remove();
+            else admitting.set(previous);
+        }
+    }
+
+    /** Null on a JDK without the M3 String owners, so the oracle itself can run anywhere. */
+    private static Field optionalField(String owner, String name) {
+        try {
+            Field field = Class.forName(owner).getDeclaredField(name);
+            field.setAccessible(true);
+            return field;
+        } catch (ClassNotFoundException | NoSuchFieldException absent) {
+            return null;
+        }
+    }
+}
